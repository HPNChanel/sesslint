{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesslint.dev/schemas/sesslint.scan-report/v1",
  "title": "SessLint Scan Report Format v1",
  "description": "Directory scan report with 5-bucket totals for SessLint.",
  "type": "object",
  "required": [
    "files",
    "root_path",
    "schema_version",
    "totals"
  ],
  "properties": {
    "schema_version": {
      "const": "sesslint.scan-report/v1"
    },
    "root_path": {
      "type": "string"
    },
    "totals": {
      "type": "object",
      "required": [
        "healthy",
        "invalid",
        "skipped",
        "total",
        "unreadable",
        "unsupported"
      ],
      "properties": {
        "healthy": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unreadable": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_reasons": {
          "type": "object",
          "description": "Aggregate counts of skipped_reason values across skipped files.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "error_count",
          "path",
          "verdict",
          "warning_count"
        ],
        "properties": {
          "error_count": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "healthy",
              "invalid",
              "unsupported",
              "unreadable",
              "skipped"
            ]
          },
          "warning_count": {
            "type": "integer",
            "minimum": 0
          },
          "skipped_reason": {
            "type": "string",
            "minLength": 1
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "fingerprint",
                "remediation",
                "repairability",
                "severity",
                "span"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "SL001",
                    "SL002",
                    "SL003",
                    "SL004",
                    "SL005",
                    "SL006",
                    "SL007",
                    "SL008",
                    "SL009",
                    "SL010",
                    "SL011",
                    "SL101",
                    "SL102",
                    "SL103",
                    "SL104",
                    "SL105",
                    "SL106",
                    "SL107",
                    "SL108",
                    "SL201",
                    "SL202",
                    "SL203",
                    "SL204",
                    "SL205",
                    "SL206",
        "SL207",
                    "SL301",
                    "SL302",
                    "SL303",
                    "SL304",
                    "SL305",
                    "SL401",
                    "SL402"
                  ]
                },
                "fingerprint": {
                  "type": "string",
                  "minLength": 1
                },
                "remediation": {
                  "type": "string"
                },
                "repairability": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "span": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": ["integer", "null"]
                    },
                    "byte": {
                      "type": ["integer", "null"]
                    }
                  }
                },
                "evidence": {
                  "type": ["object", "null"]
                }
              }
            }
          }
        }
      }
    }
  }
}
