{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesslint.dev/schemas/sesslint.repair-manifest/v1",
  "title": "SessLint Repair Manifest Format v1",
  "description": "Deterministic repair manifest schema capturing state transformations, loss declarations, and idempotency binding.",
  "type": "object",
  "required": [
    "schema_version",
    "input_fingerprint",
    "output_fingerprint",
    "policy",
    "actions",
    "declared_loss",
    "revalidate_report",
    "idempotency_key",
    "revalidation",
    "assurance_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "sesslint.repair-manifest/v1"
    },
    "input_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "output_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "string",
      "enum": [
        "conservative",
        "salvage"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "declared_loss": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revalidate_report": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_fingerprint": {
      "type": "string"
    },
    "assurance": {
      "type": "string"
    },
    "recipe_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "profile_version": {
      "type": "string"
    },
    "adapter_id": {
      "type": "string"
    },
    "adapter_version": {
      "type": "string"
    },
    "assurance_ceiling": {
      "type": "string",
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4"
      ]
    },
    "revalidation": {
      "type": "object",
      "required": [
        "assurance",
        "error_count",
        "warning_count",
        "profile_id",
        "profile_version"
      ],
      "properties": {
        "assurance": {
          "type": "string",
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3",
            "A4"
          ]
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "report_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "byte_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "record_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    }
  },
  "additionalProperties": false
}
