---
import { asset, href, other, t, type Lang } from "../i18n";
import { REPO_URL } from "../lib/repo";
import { site } from "../lib/site";

type Props = { lang: Lang; route: string; section?: string | undefined };
const { lang, route, section } = Astro.props;
const d = t(lang);
const { latest } = site();

const links = [
  { path: "/download", label: d.nav.download },
  { path: "/pricing", label: d.nav.pricing },
  { path: "/changelog", label: d.nav.changelog },
  { path: "/rules", label: d.nav.rules },
] as const;

const isCurrent = (p: string) => route === p || route.startsWith(`${p}/`);
const prompt = route === "/" ? "" : route.replace(/^\//, "").replace(/\/$/, "").replace(/\//g, " ");
const man = section ? `SESSLINT-${section}(1)` : null;
---

<header class="bar">
  <div class="wrap bar-row">
    <a class="logo" href={href(lang, "/")} aria-label="SessLint home">
      <span class="caret" aria-hidden="true"></span>sesslint
    </a>
    <span class="prompt mono" aria-hidden="true"><span class="mute">~/sesslint</span> <span class="pass">$</span> {prompt}<span class="cursor"></span></span>

    <nav class="links" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={href(lang, l.path)} aria-current={isCurrent(l.path) ? "page" : undefined}>{l.label}</a></li>
        ))}
        <li><a href={asset("/docs/")}>{d.nav.docs}</a></li>
      </ul>
    </nav>

    <div class="tools">
      <button class="tool palette-open" type="button" data-palette-open aria-label={d.nav.palette} aria-keyshortcuts="Control+K Meta+K">
        <kbd>⌘K</kbd>
      </button>
      <a class="tool" href={href(other(lang), route)} hreflang={other(lang)} lang={other(lang)} aria-label={d.nav.lang} data-lang-switch>{d.nav.langShort}</a>
      <button class="tool" type="button" data-theme-toggle aria-label={d.nav.theme}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" /></svg>
      </button>
      {latest && (
        <a class="ver chip" href={href(lang, `/changelog/${latest.version}`)}>
          <span class="dot" aria-hidden="true"></span>v{latest.version}
          {latest.date && <span class="mute ver-ago">· <time datetime={latest.date} data-ago={lang}>{latest.date}</time></span>}
        </a>
      )}
      <details class="menu">
        <summary class="tool" aria-label={d.nav.menu}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.4" /></svg>
        </summary>
        <ul class="menu-list">
          {links.map((l) => (
            <li><a href={href(lang, l.path)} aria-current={isCurrent(l.path) ? "page" : undefined}>{l.label}</a></li>
          ))}
          <li><a href={asset("/docs/")}>{d.nav.docs}</a></li>
          <li><a href={REPO_URL}>{d.nav.github}</a></li>
        </ul>
      </details>
    </div>
  </div>
  {man && (
    <div class="man" aria-hidden="true">
      <div class="wrap man-row mono"><span>{man}</span><span class="man-mid">SessLint Manual</span><span>{man}</span></div>
    </div>
  )}
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom: 1px solid var(--line);
  }
  .bar-row {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: 56px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .caret {
    width: 8px;
    height: 18px;
    background: var(--pass);
  }
  .prompt {
    font-size: 0.8rem;
    color: var(--dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.18em;
    background: var(--dim);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .links {
    margin-left: auto;
  }
  .links ul,
  .menu-list {
    display: flex;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a,
  .menu-list a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 10px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--dim);
    text-decoration: none;
    border-radius: var(--radius);
  }
  .links a:hover,
  .menu-list a:hover {
    color: var(--fg);
    background: var(--sunken);
  }
  .links a[aria-current="page"],
  .menu-list a[aria-current="page"] {
    color: var(--fg);
    box-shadow: inset 0 -2px 0 var(--pass);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    list-style: none;
  }
  .tool:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }
  .tool kbd {
    border: 0;
    background: none;
    padding: 0;
    min-width: 0;
    font-size: 0.78rem;
  }
  .ver {
    text-decoration: none;
  }
  .menu {
    position: relative;
    display: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu-list {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    flex-direction: column;
    min-width: 200px;
    padding: var(--s-2);
    border: 1px solid var(--line-strong);
    background: var(--raised);
    box-shadow: var(--shadow);
  }
  .man {
    border-top: 1px dashed var(--line);
  }
  .man-row {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: 4px;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--mute);
  }
  @media (max-width: 1080px) {
    .prompt {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .links,
    .ver-ago {
      display: none;
    }
    .menu {
      display: block;
    }
    .tools {
      margin-left: auto;
    }
  }
  @media (max-width: 520px) {
    .palette-open,
    .ver,
    .man-mid {
      display: none;
    }
  }
</style>
