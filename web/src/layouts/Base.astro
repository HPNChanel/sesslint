---
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/be-vietnam-pro/400.css";
import "@fontsource/be-vietnam-pro/500.css";
import "@fontsource/be-vietnam-pro/600.css";
import "@fontsource-variable/fraunces/opsz.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import StatusBar from "../components/StatusBar.astro";
import StatusLine from "../components/StatusLine.astro";
import CommandPalette from "../components/CommandPalette.astro";
import { HTML_LANG, LANGS, absolute, asset, href, routeOf, t, type Lang } from "../i18n";

type Props = {
  lang: Lang;
  title?: string;
  description?: string;
  /** Route without locale prefix, e.g. "/pricing". */
  route: string;
  /** man-page section name shown in the header strip, e.g. "PRICING". */
  section?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
};

const { lang, title, description, route, section, jsonLd, noindex = false } = Astro.props;
const d = t(lang);
const fullTitle = title ? `${title} · SessLint` : d.meta.title;
const desc = description ?? d.meta.description;
const canonical = absolute(href(lang, route));
const og = absolute(asset("/og.png"));
const current = routeOf(Astro.url.pathname);
---

<!doctype html>
<html lang={HTML_LANG[lang]} data-route={current}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={absolute(href(l, route))} />)}
        <link rel="alternate" hreflang="x-default" href={absolute(href("en", route))} />
      </>
    )}
    <link rel="alternate" type="application/atom+xml" title="SessLint changelog" href={asset("/changelog.xml")} />
    <link rel="icon" href={asset("/favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#0b0d0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f1e8" media="(prefers-color-scheme: light)" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SessLint" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={lang === "vi" ? "vi_VN" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Apply the stored theme before first paint (no flash).
      try {
        var s = localStorage.getItem("sl-theme");
        if (s === "light" || s === "dark") document.documentElement.dataset.theme = s;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{d.meta.skip}</a>
    <StatusBar lang={lang} route={route} section={section} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <StatusLine lang={lang} route={route} />
    <CommandPalette lang={lang} route={route} />
    <script>
      import "../scripts/global";
    </script>
  </body>
</html>
