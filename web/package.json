{
  "name": "sesslint-web",
  "private": true,
  "type": "module",
  "description": "SessLint marketing site: landing, download, pricing, changelog. Not shipped with the package.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo": "uv run --project .. python scripts/capture_demo.py",
