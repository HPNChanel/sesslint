def prove_sweeps(mod: Any, challenger: str) -> None:
    invalid = function_named(challenger, "test_forged_step_invalid_target_index")
    if "plan" in call_names(invalid):
        raise SystemExit("invalid-index sweep plans")
    indexes = loop_indexes(invalid)
    if indexes != [-1, 999, "bad", True, False]:
        raise SystemExit("invalid-index sweep drifted")
    if raises_matches(invalid) != ["missing or invalid target_index"]:
        raise SystemExit("invalid-index match drifted")
    events = raw_events(invalid)
    for index in indexes:
        got = run_apply(
            mod,
            events,
            fields_for(target_index=index, params={"parent_id": "e0"}),
        )
        if got != INVALID:
            raise SystemExit("invalid-index sweep message drifted")
    corrupted = function_named(challenger, "test_corrupted_params_variations")
    if call_names(corrupted).count("apply_proven_unique_parent_restore") != 2:
        raise SystemExit("corrupted params apply count")
    if raises_matches(corrupted) != ["missing parent_id", "missing parent_id"]:
        raise SystemExit("corrupted params match drifted")
    events = raw_events(corrupted)
    steps = plan_step_calls(corrupted)
    if len(steps) != 2:
        raise SystemExit("corrupted params step count")
    for fields in steps:
        got = run_apply(mod, events, fields)
        if got != MISSING:
            raise SystemExit("corrupted params message drifted")
    mutated = function_named(challenger, "test_events_mutated_in_memory_before_apply")
    if raises_matches(mutated) != ["no_full_match", "cross_segment", "cross_branch"]:
        raise SystemExit("mutated sweep matches drifted")
    if call_names(mutated).count("apply_proven_unique_parent_restore") != 3:
        raise SystemExit("mutated sweep apply count")


def assert_has_payload(label: str, events: list[Any]) -> None:
    if not any(isinstance(item, dict) and "payload" in item for item in events):
        raise SystemExit(f"{label} lost payload")


def prove_fixture(mod: Any, text: str, fixture: dict[str, Any]) -> None:
    fn = function_named(text, "test_proven_unique_parent_restore_fixture")
    if call_names(fn).count("apply_proven_unique_parent_restore") != 2:
        raise SystemExit("fixture apply count")
    if call_names(fn).count("canonical_json_bytes") != 2:
        raise SystemExit("fixture canonical count")
    happy = fixture["happy_path"]
    happy_fields = {
        "seq": happy["step"]["seq"],
        "recipe": happy["step"]["recipe"],
        "target_finding_fp": happy["step"]["target_finding_fp"],
        "target_index": happy["step"]["target_index"],
        "params": happy["step"]["params"],
    }
    out = run_ok(mod, happy["input_events"], happy_fields)
    if out != happy["expected_events"]:
        raise SystemExit("pin fixture apply did not match expected events")
    assert_has_payload("fixture input", happy["input_events"])
    assert_has_payload("fixture output", out)
    stripped_happy = run_outcome(mod, without_payload(happy["input_events"]), happy_fields)
    del stripped_happy
    ambig = fixture["refusal_ambiguous"]
    ambig_fields = {
        "seq": ambig["step"]["seq"],
        "recipe": ambig["step"]["recipe"],
        "target_finding_fp": ambig["step"]["target_finding_fp"],
        "target_index": ambig["step"]["target_index"],
        "params": ambig["step"]["params"],
    }
    message = run_apply(mod, ambig["input_events"], ambig_fields)
    if "ambiguous candidates" not in message:
        raise SystemExit("fixture ambiguous match drifted")
    require_later(message, "fixture ambiguous")
    assert_has_payload("fixture ambiguous", ambig["input_events"])
    stripped = run_outcome(mod, without_payload(ambig["input_events"]), ambig_fields)
    del stripped


def prove_apply_success(mod: Any, fn: ast.FunctionDef) -> None:
    if "raises" in call_names(fn):
        raise SystemExit(f"{fn.name} is not a success")
    if "plan" not in call_names(fn):
        raise SystemExit(f"{fn.name} does not plan")
    if "apply_proven_unique_parent_restore" not in call_names(fn):
        raise SystemExit(f"{fn.name} does not apply")
    events = raw_events(fn)
    current: list[Any] = events
    for evidence in finding_evidence(fn):
        if "index" not in evidence or "parent_id" not in evidence:
            raise SystemExit(f"{fn.name} evidence drifted")
        current = run_ok(
            mod,
            current,
            fields_for(
                target_index=evidence["index"],
                params={"parent_id": evidence["parent_id"]},
            ),
        )
    parents = [
        item.get("parent_id")
        for item in current
        if isinstance(item, dict)
    ]
    for evidence in finding_evidence(fn):
        if evidence["parent_id"] not in parents:
            raise SystemExit(f"{fn.name} restored parent drifted")


