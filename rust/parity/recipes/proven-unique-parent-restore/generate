    register = function_named(text, "test_conservative_recipes_registration_and_handles")
    if "apply_proven_unique_parent_restore" in call_names(register):
        raise SystemExit("registration test calls apply")
    if RECIPE not in string_constants(register):
        raise SystemExit("registration test lost the recipe name")
    multiset = function_named(text, "test_no_synthetic_success_multiset_proof")
    if "apply_proven_unique_parent_restore" in call_names(multiset):
        raise SystemExit("multiset test calls apply")
    if "canonical_json_bytes" not in call_names(multiset):
        raise SystemExit("multiset test lost canonical_json_bytes")
    if not any("recipe_parent_restore" in item for item in string_constants(multiset)):
        raise SystemExit("multiset test lost the fixture")
    lifecycle = function_named(challenger, "test_forged_step_through_executor_lifecycle")
    if "apply_proven_unique_parent_restore" in call_names(lifecycle):
        raise SystemExit("executor lifecycle calls apply")
    if "plan" not in call_names(lifecycle):
        raise SystemExit("executor lifecycle does not plan")
    tampered = function_named(challenger, "test_plan_tampered_detected")
    if "apply_proven_unique_parent_restore" in call_names(tampered):
        raise SystemExit("tampered plan calls apply")
    if "plan" not in call_names(tampered):
        raise SystemExit("tampered plan does not plan")


def coverage_note(fn: ast.FunctionDef) -> str:
    if fn.name == "test_proven_unique_parent_restore_fixture":
        return FIXTURE_NOTE
    if fn.name in {
        "test_parent_restore_refusal_zero_candidates",
        "test_parent_restore_refusal_self_candidate",
        "test_parent_restore_refusal_cross_branch",
        "test_parent_restore_refusal_cross_segment",
        "test_parent_restore_excludes_successor_candidates",
    }:
        return CANDIDATE_NOTE
    if fn.name == "test_plan_and_apply_parent_restore_full_flow":
        return FULL_NOTE
    if fn.name == "test_no_synthetic_success_multiset_proof":
        return MULTISET_NOTE
    if fn.name == "test_conservative_recipes_registration_and_handles":
        return REGISTER_NOTE
    if touches_recipe(fn):
        raise SystemExit(f"unclassified parent-restore test {fn.name}")
    return DIFFERENT_NOTE


def discover_coverage(text: str) -> list[dict[str, Any]]:
    functions = test_functions(text)
    if len(functions) != PINNED_TEST_COUNT:
        raise SystemExit(f"pinned test count {len(functions)}")
    touched = {fn.name for fn in functions if touches_recipe(fn)}
    if touched != set(TOUCHES):
        raise SystemExit("parent-restore test set drifted")
    rows: list[dict[str, Any]] = []
    for fn in functions:
        covered = fn.name in COVERED
        rows.append(
            {
                "test": f"{TEST_FILE}::{fn.name}",
                "column": "column_0",
                "status": "covered" if covered else "not_applicable",
                "vector_id": COVERED[fn.name] if covered else None,
                "note": "" if covered else coverage_note(fn),
            }
        )
    covered_count = sum(row["status"] == "covered" for row in rows)
    if covered_count != len(COVERED):
        raise SystemExit("covered count drifted")
    return rows


def payload_strings(node: Any) -> list[str]:
    found: list[str] = []
    if isinstance(node, dict):
        for key, value in node.items():
            if key == "payload":
                found.extend(collect_strings(value))
            else:
                found.extend(payload_strings(value))
    elif isinstance(node, list):
        for item in node:
            found.extend(payload_strings(item))
    return found


def collect_strings(node: Any) -> list[str]:
    if isinstance(node, str):
        return [node] if node else []
    if isinstance(node, dict):
        found: list[str] = []
        for value in node.values():
            found.extend(collect_strings(value))
        return found
    if isinstance(node, list):
        found = []
        for item in node:
            found.extend(collect_strings(item))
        return found
    return []


def dump(doc: Any, banned_payload: list[str]) -> str:
    text = json.dumps(doc, indent=2, ensure_ascii=False) + "\n"
    if "\r" in text or _SBP.search(text):
        raise SystemExit("refusing CR or sbp hash in JSON")
    if "02694d5" in text:
        raise SystemExit("refusing the wrong pin in JSON")
    for seam in _SEAMS:
        if seam in text:
            raise SystemExit("refusing a seam sentence in JSON")
    if '"t": "bool"' in text:
        raise SystemExit("refusing a tagged bool in JSON")
    if '"payload"' in text:
        raise SystemExit("refusing a payload field in JSON")
    for banned in _BANNED_PATH:
        if banned in text:
            raise SystemExit("refusing a path fragment in JSON")
    for item in banned_payload:
        if item and item in text:
            digest = hashlib.sha256(item.encode("utf-8")).hexdigest()
            raise SystemExit(f"refusing fixture payload content length {len(item)} sha {digest}")
    return text


def write_text(path: Path, text: str) -> None:
    path.write_bytes(text.encode("utf-8"))


