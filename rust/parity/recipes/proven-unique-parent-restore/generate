def confirm_docs_and_callers() -> None:
    docs = git_show_bytes(f"{PYTHON_COMMIT}:{DOCS}").decode("utf-8")
    if RECIPE not in docs or "SL004" not in docs:
        raise SystemExit("pin recipe doc drifted")
    if "recipe_parent_restore.json" not in docs:
        raise SystemExit("pin recipe doc lost the fixture")
    abstention = git_show_bytes(f"{PYTHON_COMMIT}:{ABSTENTION_FILE}").decode("utf-8")
    for name in (
        "def test_region_functions_totality_fuzz",
        "def test_scenario_3_unknown_side_effects_on_relink_target",
        "def test_parent_restore_disjoint_from_intermediate_mutating_tool",
    ):
        if name not in abstention:
            raise SystemExit(f"pin abstention test missing {name}")
    if "affected_region_proven_unique_parent_restore" not in abstention:
        raise SystemExit("pin abstention file lost the region function")
    if "parametrize" not in abstention:
        raise SystemExit("pin totality test is not a sweep")
    sl004 = git_show_bytes(f"{PYTHON_COMMIT}:{SL004_FILE}").decode("utf-8")
    for name in (
        "def test_adversarial_decoy_prefix_collision",
        "def test_adversarial_decoy_cross_branch",
        "def test_adversarial_decoy_cross_segment",
        "def test_adversarial_decoy_duplicate_candidates",
        "def test_exact_match_helper_plan_is_refused_when_source_finding_disagrees",
    ):
        require_function(sl004, name.removeprefix("def "))
    if "apply_proven_unique_parent_restore" not in sl004:
        raise SystemExit("pin sl004 file lost apply")
    confinement = git_show_bytes(f"{PYTHON_COMMIT}:{CONFINEMENT_FILE}").decode("utf-8")
    for name in (
        "test_apply_refuses_out_of_bounds_target_index",
        "test_apply_refuses_cross_branch_tampered_step",
        "test_apply_refuses_cross_segment_tampered_step",
        "test_apply_refuses_prefix_tampered_step",
        "test_apply_refuses_ambiguous_tampered_step",
        "test_e2e_executor_fails_closed_on_coercion_attempt",
    ):
        require_function(confinement, name)
    if "class TestCrossLayerCoercionAttacks" not in confinement:
        raise SystemExit("pin confinement class drifted")


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    confirm_docs_and_callers()
    test_text = git_show_bytes(f"{PYTHON_COMMIT}:{TEST_FILE}").decode("utf-8")
    challenger = git_show_bytes(f"{PYTHON_COMMIT}:{CHALLENGER_FILE}").decode("utf-8")
    fixture = json.loads(git_show_bytes(f"{PYTHON_COMMIT}:{FIXTURE}").decode("utf-8"))
    banned_payload = payload_strings(fixture)
    if not banned_payload:
        raise SystemExit("fixture payload strings missing")
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/recipes_conservative.py")
    py_sha = hashlib.sha256(py_blob).hexdigest()
    if py_sha != KNOWN_PY_SHA:
        raise SystemExit("recipes_conservative.py sha drifted")
    mod = load_mod()
    prove_shapes(test_text, challenger)
    prove_fixture(mod, test_text, fixture)
    prove_successes(mod, test_text, challenger)
    prove_graph_refusals(mod, test_text, challenger)
    prove_sweeps(mod, challenger)
    prove_index_edges(mod)
    prove_parent_edges(mod)
    recipe = recipe_vector(mod)
    extras = stored_refusals(mod)
    if COVERED:
        raise SystemExit("covered map must stay empty")
    vectors = [recipe, *extras]
    for vector in vectors:
        if vector["construct"]["entire_test"] is not False:
            raise SystemExit("entire_test must stay false")
    doc = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_conservative_py_sha256": py_sha,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = dump(doc, banned_payload)
    write_text(OUT / "vectors.json", payload)
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    rows = discover_coverage(test_text)
    coverage = {
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "test_file": TEST_FILE,
        "covered_count": sum(row["status"] == "covered" for row in rows),
        "not_applicable_count": sum(row["status"] == "not_applicable" for row in rows),
        "rows": rows,
    }
    if coverage["covered_count"] != 0 or coverage["not_applicable_count"] != PINNED_TEST_COUNT:
        raise SystemExit("coverage counts drifted")
    write_text(OUT / "coverage.json", dump(coverage, banned_payload))
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic proven-unique-parent-restore parity. Refusal messages "
            "come from the pinned blob. Candidate walks, fixture output, and "
            "planner results stay uncovered. No fixture diff is stored."
        ),
        "generator": GENERATOR,
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "PROVENANCE.json", dump(provenance, banned_payload))
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_conservative_py_sha256": py_sha,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": GENERATOR,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "manifest.json", dump(manifest, banned_payload))
    print(
        f"{len(vectors)} {digest} covered={coverage['covered_count']} "
        f"not_applicable={coverage['not_applicable_count']} py={py_sha}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
