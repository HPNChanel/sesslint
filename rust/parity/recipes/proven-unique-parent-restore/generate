    one = [bare("evt-only")]
    pair = [bare("evt-a", 0), bare("evt-b", 1)]
    child = [bare("evt-child")]
    null_parent = [
        {"id": "evt-null", "kind": "message", "seq": 0, "parent_id": None},
    ]
    empty_parent = [
        {"id": "evt-empty", "kind": "message", "seq": 0, "parent_id": ""},
    ]
    cases: list[tuple[str, list[dict[str, Any]], Any, Any, str]] = [
        ("restore_refusal_missing_index", one, None, {}, INVALID),
        ("restore_refusal_empty_events", [], 0, {}, INVALID),
        ("restore_refusal_negative_index", one, -1, {}, INVALID),
        ("restore_refusal_index_out_of_bounds", pair, 9, {}, INVALID),
        (
            "restore_refusal_param_index_out_of_bounds",
            pair,
            None,
            {"index": 9},
            INVALID,
        ),
        (
            "restore_refusal_negative_at_index",
            pair,
            None,
            {"at_index": -2},
            INVALID,
        ),
        (
            "restore_refusal_non_int_index_hides_at_index",
            one,
            None,
            {"index": "skip", "at_index": 0},
            INVALID,
        ),
        ("restore_refusal_params_not_mapping", one, None, None, INVALID),
        ("restore_refusal_missing_parent", child, 0, {}, MISSING),
        ("restore_refusal_null_parent", null_parent, 0, {}, MISSING),
        ("restore_refusal_empty_parent_string", empty_parent, 0, {}, MISSING),
        (
            "restore_refusal_empty_parent_param",
            child,
            0,
            {"parent_id": ""},
            MISSING,
        ),
        (
            "restore_refusal_empty_prefix",
            child,
            0,
            {"parent_fingerprint_prefix": ""},
            MISSING,
        ),
        (
            "restore_refusal_zero_parent_param",
            child,
            0,
            {"parent_id": 0},
            MISSING,
        ),
        (
            "restore_refusal_empty_parent_list",
            child,
            0,
            {"parent_id": []},
            MISSING,
        ),
        (
            "restore_refusal_empty_parent_map",
            child,
            0,
            {"parent_id": {}},
            MISSING,
        ),
        (
            "restore_refusal_at_index_zero_missing_parent",
            child,
            None,
            {"index": None, "at_index": 0},
            MISSING,
        ),
        ("restore_refusal_not_mapping_missing_parent", child, 0, None, MISSING),
        (
            "restore_refusal_param_index_zero_missing_parent",
            child,
            None,
            {"index": 0},
            MISSING,
        ),
    ]
    vectors: list[dict[str, Any]] = []
    for vector_id, events, target_index, params, message in cases:
        got = run_apply(mod, events, fields_for(target_index=target_index, params=params))
        require_early(got)
        if got != message:
            raise SystemExit(f"{vector_id} pin message drifted")
        vectors.append(
            refusal_vector(
                vector_id,
                events=events,
                target_index=target_index,
                params=params,
                message=got,
            )
        )
    return vectors


def prove_index_edges(mod: Any) -> None:
    events = [bare("evt-edge")]
    probed = {
        "bool-true": fields_for(target_index=True, params={}),
        "bool-false": fields_for(target_index=False, params={}),
        "text": fields_for(target_index="bad", params={}),
        "float": fields_for(target_index=1.5, params={}),
        "param-bool": fields_for(
            target_index=None,
            params={"index": True, "at_index": 0},
        ),
    }
    for label, fields in probed.items():
        got = run_apply(mod, events, fields)
        if got != INVALID:
            raise SystemExit(f"{label} was not an invalid target")


def prove_parent_edges(mod: Any) -> None:
    child = [bare("evt-child")]
    false_param = run_apply(
        mod,
        child,
        fields_for(target_index=0, params={"parent_id": False}),
    )
    if false_param != MISSING:
        raise SystemExit("falsy parent param was not missing")
    true_param = run_outcome(
        mod,
        child,
        fields_for(target_index=0, params={"parent_id": True}),
    )
    require_later(true_param, "truthy parent param")
    for label, params in (
        ("float-param", {"parent_id": 1.5}),
        ("list-param", {"parent_id": [1]}),
        ("map-param", {"parent_id": {"k": 1}}),
    ):
        message = run_outcome(mod, child, fields_for(target_index=0, params=params))
        require_later(message, label)
    integer_parent = [
        {"id": "evt-int", "kind": "message", "seq": 0, "parent_id": 0},
    ]
    require_later(
        run_outcome(mod, integer_parent, fields_for(target_index=0, params={})),
        "integer event parent",
    )
    float_parent = [
        {"id": "evt-float", "kind": "message", "seq": 0, "parent_id": 1.5},
    ]
    require_later(
        run_outcome(mod, float_parent, fields_for(target_index=0, params={})),
        "float event parent",
    )
    ready = [
        {"id": "evt-root", "kind": "message", "seq": 0, "parent_id": None},
        bare("evt-child", 1),
    ]
    require_later(
        run_outcome(
            mod,
            ready,
            fields_for(target_index=1, params={"parent_id": "evt-root"}),
        ),
        "ready parent id",
    )


def prove_named_refusal(
    mod: Any,
    fn: ast.FunctionDef,
    match: str,
) -> None:
    assert_whole_refusal(fn)
    if raises_matches(fn) != [match]:
        raise SystemExit(f"{fn.name} match drifted")
    message = run_apply(mod, raw_events(fn), step_from_test(fn))
    if re.search(match, message) is None:
        raise SystemExit(f"{fn.name} pin match drifted")
    require_later(message, fn.name)


