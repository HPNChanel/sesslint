class CheckoutImportRefused(Exception):
    """A sesslint import missed the pin and must not fall through to the checkout."""


class _PinOnly(importlib.abc.MetaPathFinder):
    """Reject any sesslint import that was not already executed from the pin."""

    def find_spec(
        self,
        fullname: str,
        path: object = None,
        target: object = None,
    ) -> None:
        del path, target
        if fullname == "sesslint" or fullname.startswith("sesslint."):
            raise CheckoutImportRefused(fullname)
        return None


def git_show_bytes(rev_path: str) -> bytes:
    if "02694d5" in rev_path:
        raise SystemExit("refusing 02694d5")
    if not rev_path.startswith(f"{PYTHON_COMMIT}:"):
        raise SystemExit("git show is limited to the pin")
    return subprocess.check_output(["git", "show", rev_path], cwd=ROOT)


def fullname_for(path: str) -> str:
    return path.removeprefix("src/").removesuffix(".py").replace("/", ".")


def ensure_pkg(name: str) -> None:
    if name not in sys.modules:
        mod = types.ModuleType(name)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[name] = mod


def exec_blob(blob: bytes, fullname: str) -> types.ModuleType:
    fd, tmp = tempfile.mkstemp(suffix=".py")
    try:
        os.write(fd, blob)
        os.close(fd)
        fd = -1
        spec = importlib.util.spec_from_file_location(fullname, tmp)
        if spec is None or spec.loader is None:
            raise SystemExit(f"spec failed {fullname}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[fullname] = mod
        spec.loader.exec_module(mod)
    finally:
        if fd >= 0:
            os.close(fd)
        Path(tmp).unlink(missing_ok=True)
    parent = fullname.rsplit(".", 1)[0] if "." in fullname else ""
    if parent:
        parent_mod = sys.modules.setdefault(parent, types.ModuleType(parent))
        setattr(parent_mod, fullname.split(".")[-1], mod)
    file_name = getattr(mod, "__file__", None)
    if not isinstance(file_name, str):
        raise SystemExit(f"{fullname} has no temp file")
    resolved = Path(file_name).resolve()
    if resolved == ROOT or ROOT in resolved.parents:
        raise SystemExit(f"{fullname} loaded from the checkout")
    return mod


def assert_pin_modules() -> None:
    temp_root = str(Path(tempfile.gettempdir())).lower()
    for name, mod in sys.modules.items():
        if name != "sesslint" and not name.startswith("sesslint."):
            continue
        file = getattr(mod, "__file__", None)
        if file is None:
            continue
        if not str(file).lower().startswith(temp_root):
            raise SystemExit(f"non-pin module {name}")


def load_mod() -> Any:
    sys.dont_write_bytecode = True
    blocked = {str(ROOT), str(ROOT / "src"), "", "."}
    sys.path[:] = [item for item in sys.path if item not in blocked]
    sys.meta_path.insert(0, _PinOnly())
    for rel in PIN_CLOSURE:
        if rel == "repair/recipes_conservative.py":
            continue
        path = f"src/sesslint/{rel}"
        blob = git_show_bytes(f"{PYTHON_COMMIT}:{path}")
        fullname = fullname_for(path)
        parts = fullname.split(".")
        for index in range(1, len(parts)):
            ensure_pkg(".".join(parts[:index]))
        exec_blob(blob, fullname)
    ensure_pkg("sesslint.repair")
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/recipes_conservative.py")
    mod = exec_blob(py_blob, MODULE)
    assert_pin_modules()
    if mod.apply_terminal_suffix_discard.__module__ != MODULE:
        raise SystemExit("apply function is not the pin blob")
    if mod.terminal_suffix_discard is not mod.apply_terminal_suffix_discard:
        raise SystemExit("pin alias is not the apply function")
    return mod


def tagged(value: Any) -> dict[str, Any]:
    if value is None:
        return {"t": "null"}
    if type(value) is bool:
        raise SystemExit("refusing a tagged bool")
    if type(value) is int:
        return {"t": "int", "v": value}
    if isinstance(value, str):
        return {"t": "str", "v": value}
    if isinstance(value, float):
        raise SystemExit("float is not a pinned scalar in this set")
    if isinstance(value, dict):
        return {
            "t": "map",
            "entries": [[key, tagged(inner)] for key, inner in value.items()],
        }
    if isinstance(value, (list, tuple)):
        return {"t": "list", "items": [tagged(inner) for inner in value]}
    raise SystemExit(f"unencodable {type(value)!r}")


def require_bool(label: str, value: Any) -> bool:
    if type(value) is not bool:
        raise SystemExit(f"{label} is not a bool")
    return value


def test_functions(text: str) -> list[ast.FunctionDef]:
    tree = ast.parse(text)
    return [
        node
        for node in tree.body
        if isinstance(node, ast.FunctionDef) and node.name.startswith("test_")
    ]


def function_named(text: str, name: str) -> ast.FunctionDef:
    for node in test_functions(text):
        if node.name == name:
            return node
    raise SystemExit(f"missing {name}")


def call_names(fn: ast.AST) -> list[str]:
    names: list[str] = []
    for node in ast.walk(fn):
        if not isinstance(node, ast.Call):
            continue
        if isinstance(node.func, ast.Name):
            names.append(node.func.id)
        elif isinstance(node.func, ast.Attribute):
            names.append(node.func.attr)
    return names


def string_constants(fn: ast.FunctionDef) -> set[str]:
    docstring = None
    if (
        fn.body
        and isinstance(fn.body[0], ast.Expr)
        and isinstance(fn.body[0].value, ast.Constant)
        and isinstance(fn.body[0].value.value, str)
    ):
        docstring = fn.body[0]
    found: set[str] = set()
    for node in ast.walk(fn):
        if node is docstring:
            continue
        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            found.add(node.value)
    return found


def touches_recipe(fn: ast.FunctionDef) -> bool:
    names = set(call_names(fn))
    constants = string_constants(fn)
    if "apply_terminal_suffix_discard" in names:
        return True
    if RECIPE in constants:
        return True
    return any("recipe_suffix_discard" in item for item in constants)


def assigned(fn: ast.FunctionDef, name: str) -> ast.AST:
    for stmt in fn.body:
        if not isinstance(stmt, ast.Assign) or len(stmt.targets) != 1:
            continue
        target = stmt.targets[0]
        if isinstance(target, ast.Name) and target.id == name:
            return stmt.value
    raise SystemExit(f"{fn.name} missing {name}")


def raises_match(fn: ast.FunctionDef) -> str:
    found: list[str] = []
    for node in ast.walk(fn):
        if not isinstance(node, ast.Call):
            continue
        func = node.func
        if not isinstance(func, ast.Attribute) or func.attr != "raises":
            continue
        for keyword in node.keywords:
            if keyword.arg == "match":
                value = ast.literal_eval(keyword.value)
                if not isinstance(value, str):
                    raise SystemExit(f"{fn.name} match is not a string")
                found.append(value)
    if len(found) != 1:
        raise SystemExit(f"{fn.name} match count")
    return found[0]


def assert_whole_refusal(fn: ast.FunctionDef) -> None:
    names = call_names(fn)
    if names.count("apply_terminal_suffix_discard") != 1:
        raise SystemExit(f"{fn.name} is not one apply call")
    if "plan" in names or "repair" in names or "canonical_json_bytes" in names:
        raise SystemExit(f"{fn.name} is not only the refusal")
    if names.count("raises") != 1:
        raise SystemExit(f"{fn.name} raises count")
    if any(isinstance(node, ast.Assert) for node in ast.walk(fn)):
        raise SystemExit(f"{fn.name} has another assert")
    kinds: list[str] = []
    for stmt in fn.body:
        if (
            isinstance(stmt, ast.Expr)
            and isinstance(stmt.value, ast.Constant)
            and isinstance(stmt.value.value, str)
        ):
            continue
        kinds.append(type(stmt).__name__)
    if kinds != ["Assign", "Assign", "With"]:
        raise SystemExit(f"{fn.name} shape {kinds}")


def step_from_test(fn: ast.FunctionDef) -> dict[str, Any]:
    value = assigned(fn, "step")
    if not isinstance(value, ast.Call):
        raise SystemExit(f"{fn.name} step is not a call")
    found: dict[str, Any] = {}
    for keyword in value.keywords:
        if keyword.arg is None:
            raise SystemExit(f"{fn.name} step keyword must be explicit")
        found[keyword.arg] = ast.literal_eval(keyword.value)
    for key in ("seq", "recipe", "target_finding_fp", "target_index", "params"):
        if key not in found:
            raise SystemExit(f"{fn.name} step missing {key}")
    if not isinstance(found["params"], dict):
        raise SystemExit(f"{fn.name} params are not a dict")
    return found


def raw_events(fn: ast.FunctionDef) -> list[dict[str, Any]]:
    raw = ast.literal_eval(assigned(fn, "events"))
    if not isinstance(raw, list) or not raw:
        raise SystemExit(f"{fn.name} events are empty")
    events: list[dict[str, Any]] = []
    for item in raw:
        if not isinstance(item, dict):
            raise SystemExit(f"{fn.name} event is not a dict")
        events.append(item)
    return events


def events_from_test(fn: ast.FunctionDef) -> list[dict[str, Any]]:
    events = raw_events(fn)
    for item in events:
        if "payload" in item:
            raise SystemExit(f"{fn.name} event stores payload content")
    return events


def finding_evidence(fn: ast.FunctionDef) -> dict[str, Any]:
    found: list[dict[str, Any]] = []
    for node in ast.walk(fn):
        if not isinstance(node, ast.Call):
            continue
        func = node.func
        if not isinstance(func, ast.Name) or func.id != "_make_test_finding":
            continue
        for keyword in node.keywords:
            if keyword.arg == "evidence":
                value = ast.literal_eval(keyword.value)
                if not isinstance(value, dict):
                    raise SystemExit(f"{fn.name} evidence is not a dict")
                found.append(value)
    if len(found) != 1:
        raise SystemExit(f"{fn.name} evidence count")
    return found[0]


def plan_policy(fn: ast.FunctionDef) -> str:
    for node in ast.walk(fn):
        if not isinstance(node, ast.Call):
            continue
        func = node.func
        if not isinstance(func, ast.Name) or func.id != "plan":
            continue
        for keyword in node.keywords:
            if keyword.arg == "policy":
                value = ast.literal_eval(keyword.value)
                if not isinstance(value, str):
                    raise SystemExit(f"{fn.name} policy is not a string")
                return value
    raise SystemExit(f"{fn.name} plan policy missing")


def reject_payload(events: list[dict[str, Any]]) -> None:
    for item in events:
        if "payload" in item:
            raise SystemExit("refusing payload content in a stored vector")


def make_step(mod: Any, *, target_index: Any, params: Any) -> Any:
    return mod.PlanStep(
        seq=0,
        recipe=RECIPE,
        target_finding_fp="f0",
        target_index=target_index,
        params=params,
    )


def run_apply(mod: Any, events: list[Any], *, target_index: Any, params: Any) -> str:
    try:
        mod.apply_terminal_suffix_discard(
            events,
            make_step(mod, target_index=target_index, params=params),
        )
    except mod.PreconditionFailed as exc:
        return str(exc)
    raise SystemExit("pin apply returned Ok for a refusal proof")


def run_ok(mod: Any, events: list[Any], *, target_index: Any, params: Any) -> list[Any]:
    try:
        out = mod.apply_terminal_suffix_discard(
            events,
            make_step(mod, target_index=target_index, params=params),
        )
    except mod.PreconditionFailed:
        raise SystemExit("pin success apply refused") from None
    if not isinstance(out, list):
        raise SystemExit("pin success apply did not return a list")
    return out


def note(event_id: str, seq: int = 0) -> dict[str, Any]:
    return {"id": event_id, "kind": "message", "seq": seq}


def refusal_vector(
    vector_id: str,
    *,
    entire_test: bool,
    events: list[dict[str, Any]],
    target_index: Any,
    params: Any,
    message: str,
) -> dict[str, Any]:
    if type(entire_test) is not bool:
        raise SystemExit("entire_test is not a bool")
    if type(target_index) is bool:
        raise SystemExit("refusing a bool target_index in a stored vector")
    reject_payload(events)
    return {
        "id": vector_id,
        "construct": {
            "type": "apply_refusal",
            "fn": "apply_terminal_suffix_discard",
            "entire_test": entire_test,
            "assert_count": 1,
            "events": [tagged(event) for event in events],
            "step": {
                "target_index": tagged(target_index),
                "params": tagged(params),
            },
        },
        "expected": {
            "mode": "refusal",
            "error_type": "PreconditionFailed",
            "message": message,
        },
    }


def recipe_vector(mod: Any) -> dict[str, Any]:
    recipe = mod.RECIPE_TERMINAL_SUFFIX_DISCARD
    if recipe.name != RECIPE:
        raise SystemExit("pin recipe name mismatch")
    if recipe.apply is not mod.apply_terminal_suffix_discard:
        raise SystemExit("pin apply is not the recipe apply")
    if recipe.affected_region is not None:
        raise SystemExit("pin recipe grew an affected region")
    handles = list(recipe.handles)
    preconditions = list(recipe.preconditions)
    if handles != ["SL005"]:
        raise SystemExit("pin handles drifted")
    if preconditions != ["no_prior_safe_tool_after_cut"]:
        raise SystemExit("pin preconditions drifted")
    if recipe.min_policy != "salvage":
        raise SystemExit("pin min_policy drifted")
    return {
        "id": "recipe_terminal_suffix_discard",
        "construct": {
            "type": "recipe_constant",
            "fn": "RECIPE_TERMINAL_SUFFIX_DISCARD",
            "entire_test": False,
        },
        "expected": {
            "mode": "recipe",
            "name": recipe.name,
            "handles": handles,
            "preconditions": preconditions,
            "lossy": require_bool("lossy", recipe.lossy),
            "salvage_only": require_bool("salvage_only", recipe.salvage_only),
            "min_policy": recipe.min_policy,
            "version": recipe.version,
            "excludes_execution_dependence": require_bool(
                "excludes_execution_dependence",
                recipe.excludes_execution_dependence,
            ),
            "apply_present": require_bool("apply_present", recipe.apply is not None),
            "affected_region_present": require_bool(
                "affected_region_present",
                recipe.affected_region is not None,
            ),
        },
    }


def covered_vectors(mod: Any, text: str) -> list[dict[str, Any]]:
    vectors: list[dict[str, Any]] = []
    seen: set[str] = set()
    for name, vector_id in COVERED.items():
        fn = function_named(text, name)
        assert_whole_refusal(fn)
        events = events_from_test(fn)
        fields = step_from_test(fn)
        if fields["recipe"] != RECIPE:
            raise SystemExit(f"{name} recipe drifted")
        message = run_apply(
            mod,
            events,
            target_index=fields["target_index"],
            params=fields["params"],
        )
        pattern = raises_match(fn)
        if re.search(pattern, message) is None:
            raise SystemExit(f"{name} pin message does not match the test")
        if message in seen:
            raise SystemExit(f"{name} message is not distinct")
        seen.add(message)
        vectors.append(
            refusal_vector(
                vector_id,
                entire_test=True,
                events=events,
                target_index=fields["target_index"],
                params=fields["params"],
                message=message,
            )
        )
    return vectors


