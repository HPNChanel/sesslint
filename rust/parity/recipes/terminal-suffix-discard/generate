        ("suffix_refusal_cut_equals_length", pair, 2, {}),
        ("suffix_refusal_empty_events_past_end", [], 1, {}),
        ("suffix_refusal_param_cut_past_end", pair, None, {"cut_index": 9}),
        ("suffix_refusal_checkpoint", marked, 1, {}),
    ]
    vectors: list[dict[str, Any]] = []
    seen = set(covered_messages)
    for vector_id, events, target_index, params in cases:
        message = run_apply(mod, events, target_index=target_index, params=params)
        if message in seen:
            raise SystemExit(f"{vector_id} message is not distinct")
        seen.add(message)
        if vector_id == "suffix_refusal_missing_cut" and message != INVALID:
            raise SystemExit("missing cut message drifted")
        if vector_id == "suffix_refusal_checkpoint" and (
            "checkpoint at index 2 cannot be discarded" not in message
        ):
            raise SystemExit("checkpoint message drifted")
        vectors.append(
            refusal_vector(
                vector_id,
                entire_test=False,
                events=events,
                target_index=target_index,
                params=params,
                message=message,
            )
        )
    return vectors


def prove_same_message(
    mod: Any,
    message: str,
    events: list[Any],
    *,
    target_index: Any,
    params: Any,
    label: str,
) -> None:
    got = run_apply(mod, events, target_index=target_index, params=params)
    if got != message:
        raise SystemExit(f"{label} pin message drifted")


def prove_invalid_and_aliases(mod: Any, covered: list[dict[str, Any]]) -> None:
    by_id = {item["id"]: item["expected"]["message"] for item in covered}
    empty = by_id["suffix_discard_refusal_empty_session"]
    bounds = by_id["suffix_discard_refusal_out_of_bounds"]
    one = [note("evt-only")]
    probes: tuple[tuple[Any, Any], ...] = (
        (True, {}),
        (False, {}),
        ("bad", {}),
        (1.5, {}),
        (None, {"cut_index": True}),
        (None, {"cut_index": False}),
        (None, {"cut_index": 1.5}),
        (None, {"cut_index": "skip"}),
        (None, {"cut_index": [1]}),
        (None, None),
        (None, "nope"),
    )
    for target_index, params in probes:
        got = run_apply(mod, one, target_index=target_index, params=params)
        if got != INVALID:
            raise SystemExit("invalid cut probe drifted")
    prove_same_message(mod, empty, [], target_index=0, params={}, label="empty list cut")
    prove_same_message(
        mod,
        empty,
        one,
        target_index=None,
        params={"cut_index": 0},
        label="param cut zero",
    )
    prove_same_message(
        mod,
        bounds,
        one,
        target_index=None,
        params={"cut_index": 5},
        label="param cut five",
    )
    kept = run_ok(
        mod,
        [note("evt-a", 0), note("evt-b", 1), note("evt-c", 2)],
        target_index=2,
        params={"cut_index": True},
    )
    if [item["id"] for item in kept] != ["evt-a", "evt-b"]:
        raise SystemExit("target index did not win over a bool param")
    del kept


def prove_kind_gap(mod: Any) -> None:
    prefix = note("evt-keep")
    for label, kind in (
        ("float", 1.5),
        ("list", [1]),
        ("map", {"k": 1}),
    ):
        events = [prefix, {"id": "evt-tail", "kind": kind, "seq": 1}]
        out = run_ok(mod, events, target_index=1, params={})
        if [item["id"] for item in out] != ["evt-keep"]:
            raise SystemExit(f"{label} kind did not keep the prefix")
        del out
    for label, kind in (("bool-true", True), ("bool-false", False), ("int", 1)):
        events = [prefix, {"id": "evt-tail", "kind": kind, "seq": 1}]
        out = run_ok(mod, events, target_index=1, params={})
        if len(out) != 1:
            raise SystemExit(f"{label} kind did not keep the prefix")
        del out


def prove_checkpoint_test(mod: Any, text: str) -> None:
    fn = function_named(text, "test_suffix_discard_refusal_checkpoint_in_suffix")
    assert_whole_refusal(fn)
    events = raw_events(fn)
    if not any("payload" in item for item in events):
        raise SystemExit("checkpoint test lost payload")
    fields = step_from_test(fn)
    message = run_apply(
        mod,
        events,
        target_index=fields["target_index"],
        params=fields["params"],
    )
    if re.search(raises_match(fn), message) is None:
        raise SystemExit("checkpoint test pin match drifted")
    stripped = [
        {key: value for key, value in item.items() if key != "payload"} for item in events
    ]
    reject_payload(stripped)
    stripped_message = run_apply(
        mod,
        stripped,
        target_index=fields["target_index"],
        params=fields["params"],
    )
    if stripped_message != message:
        raise SystemExit("checkpoint refusal changed when payload was removed")
    del events, stripped


def prove_fixture(mod: Any, text: str, fixture: dict[str, Any]) -> None:
    fn = function_named(text, "test_terminal_suffix_discard_fixture")
    names = call_names(fn)
    if names.count("apply_terminal_suffix_discard") != 1:
        raise SystemExit("fixture apply count")
    if names.count("canonical_json_bytes") != 2:
        raise SystemExit("fixture canonical count")
    if "plan" in names:
        raise SystemExit("fixture test grew a plan")
    step = fixture["step"]
    out = mod.apply_terminal_suffix_discard(
        fixture["input_events"],
        mod.PlanStep(
            seq=step["seq"],
            recipe=step["recipe"],
            target_finding_fp=step["target_finding_fp"],
            target_index=step["target_index"],
            params=step["params"],
        ),
    )
    if out != fixture["expected_events"]:
        raise SystemExit("pin fixture apply did not match expected events")
    if len(fixture["input_events"]) - len(out) != fixture["expected_loss_count"]:
        raise SystemExit("pin fixture loss count drifted")
    if not isinstance(fixture.get("expected_loss_class"), str) or not fixture["expected_loss_class"]:
        raise SystemExit("pin fixture loss class drifted")
    if not any(isinstance(item, dict) and "payload" in item for item in fixture["input_events"]):
        raise SystemExit("fixture input lost payload")
    if not any(isinstance(item, dict) and "payload" in item for item in out):
        raise SystemExit("fixture output lost payload")
    del out


def compared_literals(fn: ast.FunctionDef) -> list[Any]:
    found: list[Any] = []
    for node in ast.walk(fn):
        if not isinstance(node, ast.Compare) or len(node.ops) != 1:
            continue
        if not isinstance(node.ops[0], ast.Eq):
            continue
        try:
            found.append(ast.literal_eval(node.comparators[0]))
        except (ValueError, TypeError):
            continue
    return found


def prove_entry(mod: Any, text: str) -> None:
    fn = function_named(text, "test_terminal_suffix_discard_sl005_entry_index")
    names = call_names(fn)
    if names.count("plan") != 1 or names.count("apply_terminal_suffix_discard") != 1:
        raise SystemExit("entry test shape drifted")
    if "canonical_json_bytes" in names:
        raise SystemExit("entry test grew a canonical compare")
    if plan_policy(fn) != "salvage":
        raise SystemExit("entry policy drifted")
    evidence = finding_evidence(fn)
    if evidence.get("entry_index") != 2:
        raise SystemExit("entry index drifted")
    literals = compared_literals(fn)
    if RECIPE not in literals or 1 not in literals or ["e0", "e1"] not in literals:
        raise SystemExit("entry asserts drifted")
    events = events_from_test(fn)
    out = run_ok(mod, events, target_index=2, params={})
    if len(out) != 2 or [item["id"] for item in out] != ["e0", "e1"]:
        raise SystemExit("pin entry apply drifted")
    del out


def coverage_note(fn: ast.FunctionDef) -> str:
    if fn.name == "test_terminal_suffix_discard_fixture":
        return FIXTURE_NOTE
    if fn.name == "test_suffix_discard_refusal_checkpoint_in_suffix":
        return CHECKPOINT_NOTE
    if fn.name == "test_terminal_suffix_discard_sl005_entry_index":
        return ENTRY_NOTE
    if fn.name == "test_no_synthetic_success_multiset_proof":
        return MULTISET_NOTE
    if fn.name == "test_conservative_recipes_registration_and_handles":
        return REGISTER_NOTE
    if touches_recipe(fn):
        raise SystemExit(f"unclassified suffix-discard test {fn.name}")
    return DIFFERENT_NOTE


def discover_coverage(text: str) -> list[dict[str, Any]]:
    functions = test_functions(text)
    if len(functions) != PINNED_TEST_COUNT:
        raise SystemExit(f"pinned test count {len(functions)}")
    touched = {fn.name for fn in functions if touches_recipe(fn)}
    if touched != set(TOUCHES):
        raise SystemExit(f"suffix-discard test set drifted {sorted(touched)}")
    rows: list[dict[str, Any]] = []
    for fn in functions:
        covered = fn.name in COVERED
        rows.append(
            {
                "test": f"{TEST_FILE}::{fn.name}",
                "column": "column_0",
                "status": "covered" if covered else "not_applicable",
                "vector_id": COVERED[fn.name] if covered else None,
                "note": "" if covered else coverage_note(fn),
            }
        )
    covered_count = sum(row["status"] == "covered" for row in rows)
    if covered_count != len(COVERED):
        raise SystemExit("covered count drifted")
    return rows


def payload_strings(node: Any) -> list[str]:
    found: list[str] = []
    if isinstance(node, dict):
        for key, value in node.items():
            if key == "payload":
                found.extend(collect_strings(value))
            else:
                found.extend(payload_strings(value))
    elif isinstance(node, list):
        for item in node:
            found.extend(payload_strings(item))
    return found


def collect_strings(node: Any) -> list[str]:
    if isinstance(node, str):
        return [node] if node else []
    if isinstance(node, dict):
        found: list[str] = []
        for value in node.values():
            found.extend(collect_strings(value))
        return found
    if isinstance(node, list):
        found = []
        for item in node:
            found.extend(collect_strings(item))
        return found
    return []


def dump(doc: Any, banned_payload: list[str]) -> str:
    text = json.dumps(doc, indent=2, ensure_ascii=False) + "\n"
    if "\r" in text or _SBP.search(text):
        raise SystemExit("refusing CR or sbp hash in JSON")
    if "02694d5" in text:
        raise SystemExit("refusing the wrong pin in JSON")
    for seam in _SEAMS:
        if seam in text:
            raise SystemExit("refusing a seam sentence in JSON")
    if '"t": "bool"' in text:
        raise SystemExit("refusing a tagged bool in JSON")
    if '"payload"' in text:
        raise SystemExit("refusing a payload field in JSON")
    for banned in _BANNED_PATH:
        if banned in text:
            raise SystemExit("refusing a path fragment in JSON")
    for item in banned_payload:
        if item and item in text:
            digest = hashlib.sha256(item.encode("utf-8")).hexdigest()
            raise SystemExit(f"refusing fixture payload content length {len(item)} sha {digest}")
    return text


def write_text(path: Path, text: str) -> None:
    path.write_bytes(text.encode("utf-8"))


def require_function(text: str, name: str) -> None:
    if f"def {name}" not in text:
        raise SystemExit(f"pin test missing {name}")


def confirm_docs_and_callers(py_blob: bytes) -> None:
    source = py_blob.decode("utf-8")
    if "def apply_terminal_suffix_discard" not in source:
        raise SystemExit("pin apply function missing")
    if "def affected_region_terminal_suffix_discard" in source:
        raise SystemExit("pin grew a suffix-discard region function")
    if "affected_region_torn_terminal_record_discard" not in source:
        raise SystemExit("pin lost the torn-record region import")
    docs = git_show_bytes(f"{PYTHON_COMMIT}:{DOCS}").decode("utf-8")
    for needle in (
        RECIPE,
        "SL005",
        "no_prior_safe_tool_after_cut",
        "fixtures/repair/recipe_suffix_discard.json",
    ):
        if needle not in docs:
            raise SystemExit(f"pin recipe doc lost {needle}")
    abstention = git_show_bytes(f"{PYTHON_COMMIT}:{ABSTENTION_FILE}").decode("utf-8")
    if "def test_region_functions_totality_fuzz" not in abstention:
        raise SystemExit("pin totality test missing")
    if "parametrize" not in abstention:
        raise SystemExit("pin totality test is not a sweep")
    if "affected_region_terminal_suffix_discard" in abstention:
        raise SystemExit("pin totality test grew a suffix-discard region")
    executor = git_show_bytes(f"{PYTHON_COMMIT}:{EXECUTOR_FILE}").decode("utf-8")
    for name in ("test_tampered_plan", "test_cli_dry_run_with_tampered_plan_refuses"):
        require_function(executor, name)
    if "apply_terminal_suffix_discard" in executor:
        raise SystemExit("pin executor file calls apply")
    if executor.count(f'recipe="{RECIPE}"') < 1 and f'"{RECIPE}"' not in executor:
        raise SystemExit("pin executor file lost the recipe name")
    release = git_show_bytes(f"{PYTHON_COMMIT}:{RELEASE_FILE}").decode("utf-8")
    require_function(release, "test_public_repair_matrix")
    if '"recipe_suffix_discard"' not in release:
        raise SystemExit("pin release matrix lost the scenario")


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/recipes_conservative.py")
    py_sha = hashlib.sha256(py_blob).hexdigest()
    if py_sha != KNOWN_PY_SHA:
        raise SystemExit("recipes_conservative.py sha drifted")
    confirm_docs_and_callers(py_blob)
    test_text = git_show_bytes(f"{PYTHON_COMMIT}:{TEST_FILE}").decode("utf-8")
    fixture = json.loads(git_show_bytes(f"{PYTHON_COMMIT}:{FIXTURE}").decode("utf-8"))
    banned_payload = payload_strings(fixture)
    if not banned_payload:
        raise SystemExit("fixture payload strings missing")
    mod = load_mod()
    prove_fixture(mod, test_text, fixture)
    prove_entry(mod, test_text)
    prove_checkpoint_test(mod, test_text)
    prove_kind_gap(mod)
    recipe = recipe_vector(mod)
    covered = covered_vectors(mod, test_text)
    prove_invalid_and_aliases(mod, covered)
    extras = extra_refusals(mod, {item["expected"]["message"] for item in covered})
    vectors = [recipe, *extras, *covered]
    for vector in vectors:
        if vector["id"] in set(COVERED.values()):
            if vector["construct"]["entire_test"] is not True:
                raise SystemExit("covered vector lost entire_test")
        elif vector["construct"]["entire_test"] is not False:
            raise SystemExit("entire_test must stay false outside covered rows")
    doc = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_conservative_py_sha256": py_sha,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = dump(doc, banned_payload)
    write_text(OUT / "vectors.json", payload)
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    rows = discover_coverage(test_text)
    coverage = {
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "test_file": TEST_FILE,
        "covered_count": sum(row["status"] == "covered" for row in rows),
        "not_applicable_count": sum(row["status"] == "not_applicable" for row in rows),
        "rows": rows,
    }
    if coverage["covered_count"] != 2 or coverage["not_applicable_count"] != 33:
        raise SystemExit("coverage counts drifted")
    write_text(OUT / "coverage.json", dump(coverage, banned_payload))
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic terminal-suffix-discard parity. Refusal messages come "
            "from the pinned blob. Fixture output, a planner result, and a "
            "non-string suffix kind stay uncovered. No fixture diff is stored."
        ),
        "generator": GENERATOR,
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "PROVENANCE.json", dump(provenance, banned_payload))
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_conservative_py_sha256": py_sha,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": GENERATOR,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "manifest.json", dump(manifest, banned_payload))
    print(
        f"{len(vectors)} {digest} covered={coverage['covered_count']} "
        f"not_applicable={coverage['not_applicable_count']} py={py_sha}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
