    if "raises" in call_names(rewrite) or "canonical_json_bytes" in call_names(rewrite):
        raise SystemExit("rewrite test shape drifted")
    if not any(isinstance(node, ast.Assert) for node in ast.walk(rewrite)):
        raise SystemExit("rewrite test has no assert")
    boundary = function_named(text, "test_duplicate_collapse_refusal_checkpoint_or_boundary")
    mixed = function_named(text, "test_duplicate_collapse_refusal_mixed_kinds")
    assert_whole_refusal(boundary)
    assert_whole_refusal(mixed)
    multiset = function_named(text, "test_no_synthetic_success_multiset_proof")
    if "apply_identical_duplicate_collapse" in call_names(multiset):
