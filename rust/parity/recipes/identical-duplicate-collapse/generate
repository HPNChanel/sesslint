    second = function_named(text, "test_duplicate_collapse_second_index_resolves_and_collapses")
    assert_call_count(second, "apply_identical_duplicate_collapse", 1)
    if "raises" in call_names(second) or "canonical_json_bytes" in call_names(second):
        raise SystemExit("second-index test shape drifted")
