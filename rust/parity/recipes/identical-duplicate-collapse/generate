        raise SystemExit("pin recipe doc lost the fixture")
    text = git_show_bytes(f"{PYTHON_COMMIT}:{ABSTENTION_FILE}").decode("utf-8")
    if "def test_region_functions_totality_fuzz" not in text:
        raise SystemExit("pin totality test missing")
    if "affected_region_identical_duplicate_collapse" not in text:
        raise SystemExit("pin abstention file lost the region function")
