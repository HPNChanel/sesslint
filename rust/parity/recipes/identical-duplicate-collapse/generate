def extra_refusals(mod: Any, text: str) -> list[dict[str, Any]]:
    empty = run_apply(mod, [], fields_for(target_index=None, params={}))
    one_events = [note_event("evt-only", "note", 0)]
    one = run_apply(mod, one_events, fields_for(target_index=None, params={}))
    bounds_events = [
        note_event("evt-a", "note", 0),
        note_event("evt-b", "note", 1),
    ]
    high = run_apply(mod, bounds_events, fields_for(target_index=9, params={}))
    negative = run_apply(
        mod,
        bounds_events,
        fields_for(target_index=None, params={"at_index": -2}),
    )
    skipped = run_apply(
        mod,
        bounds_events,
        fields_for(target_index=None, params={"at_index": "skip", "index": 9}),
    )
    differ_events = [
        note_event("evt-kept", "note", 0, "hash-left"),
        note_event("evt-drop", "note", 1, "hash-right"),
    ]
    differ = run_apply(mod, differ_events, fields_for(target_index=0, params={}))
    missing_events = [
        {"id": "evt-none", "seq": 0},
        note_event("evt-note", "note", 1),
    ]
    missing = run_apply(mod, missing_events, fields_for(target_index=0, params={}))
    scan_events = [
        note_event("evt-scan-a", "note", 0),
        note_event("evt-scan-b", "tool_result", 1),
    ]
    scan = run_apply(mod, scan_events, fields_for(target_index=None, params={}))
    note_mismatch = run_apply(mod, scan_events, fields_for(target_index=0, params={}))
    boundary_scan_events = [
        note_event("evt-bound-a", "checkpoint", 0),
        note_event("evt-bound-b", "checkpoint", 1),
    ]
    boundary_scan = run_apply(
        mod, boundary_scan_events, fields_for(target_index=None, params={})
    )
    compact_events = [
        note_event("evt-comp-a", "compaction_boundary", 0),
        note_event("evt-comp-b", "compaction_boundary", 1),
    ]
    compact = run_apply(mod, compact_events, fields_for(target_index=0, params={}))
    boundary_fn = function_named(text, "test_duplicate_collapse_refusal_checkpoint_or_boundary")
    mixed_fn = function_named(text, "test_duplicate_collapse_refusal_mixed_kinds")
    boundary_original = raw_events(boundary_fn)
    mixed_original = raw_events(mixed_fn)
    boundary_fields = step_from_test(boundary_fn)
    mixed_fields = step_from_test(mixed_fn)
    boundary = run_apply(mod, boundary_original, boundary_fields)
