    for name in (
        "def test_scenario_1_completed_mutating_call_elsewhere_disjoint_repair",
        "def test_scenario_4_ambiguous_call_adjacent_but_outside_region_boundary_pin",
        "def test_multistep_conservative_repair_no_index_drift_in_executor",
