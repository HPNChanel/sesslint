def prove_bool_and_payload_gaps(mod: Any) -> None:
    scan_events = [
        note_event("evt-bool-a", "note", 0),
        note_event("evt-bool-b", "tool_result", 1),
    ]
    scanned = run_apply(mod, scan_events, fields_for(target_index=None, params={}))
    as_bool = run_apply(mod, scan_events, fields_for(target_index=True, params={}))
    indexed = run_apply(mod, scan_events, fields_for(target_index=0, params={}))
    if scanned != NO_ELIGIBLE or as_bool != NO_ELIGIBLE or indexed != MISMATCH_NOTE:
        raise SystemExit("pin bool target_index did not stay on the scan path")
    param_bool = run_apply(
        mod,
        scan_events,
        fields_for(target_index=None, params={"at_index": True, "index": 0}),
    )
    if param_bool != MISMATCH_NOTE:
        raise SystemExit("pin bool param index was not skipped")
    payload_events = [
        {"id": "evt-pay-a", "kind": "note", "seq": 0, "payload": {"n": 1}},
        {"id": "evt-pay-b", "kind": "note", "seq": 1, "payload": {"n": 2}},
    ]
    payload = run_apply(mod, payload_events, fields_for(target_index=0, params={}))
    if payload != DIFFER:
        raise SystemExit("pin payload fingerprint refusal drifted")


def assert_has_payload(label: str, events: list[Any]) -> None:
    if not any(isinstance(item, dict) and "payload" in item for item in events):
        raise SystemExit(f"{label} lost payload")


def prove_successes(mod: Any, text: str, fixture: dict[str, Any]) -> None:
    step = fixture["step"]
    out = run_ok(
        mod,
        fixture["input_events"],
        {
            "seq": step["seq"],
            "recipe": step["recipe"],
            "target_finding_fp": step["target_finding_fp"],
            "target_index": step["target_index"],
            "params": step["params"],
        },
    )
    if out != fixture["expected_events"]:
        raise SystemExit("pin fixture apply did not match expected events")
    assert_has_payload("fixture input", fixture["input_events"])
    assert_has_payload("fixture output", out)
    second = function_named(text, "test_duplicate_collapse_second_index_resolves_and_collapses")
    second_events = raw_events(second)
    second_out = run_ok(mod, second_events, step_from_test(second))
    if [item["id"] for item in second_out] != ["e0", "e1", "e3"]:
        raise SystemExit("pin second-index collapse drifted")
    assert_has_payload("second-index input", second_events)
    assert_has_payload("second-index output", second_out)
    rewrite = function_named(text, "test_duplicate_collapse_rewrites_child_parent_pointers")
    rewrite_events = raw_events(rewrite)
    rewrite_out = run_ok(mod, rewrite_events, step_from_test(rewrite))
    child = next(item for item in rewrite_out if item["id"] == "msg-2")
    if child["parent_id"] != "msg-1a" or len(rewrite_out) != 3:
        raise SystemExit("pin child-pointer rewrite drifted")
    assert_has_payload("rewrite input", rewrite_events)
    assert_has_payload("rewrite output", rewrite_out)


