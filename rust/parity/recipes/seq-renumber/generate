#!/usr/bin/env python3
"""Generate seq-renumber parity vectors from the pinned blob (stdlib only).

Subprocess is limited to ``git show`` of PYTHON_COMMIT. The blob is executed
from a temporary file. This script does not import the checkout package.
"""

from __future__ import annotations

