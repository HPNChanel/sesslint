) -> dict[str, Any]:
    reject_payload(events)
    reject_payload(out)
    return {
        "id": vector_id,
        "construct": {
            "type": "apply_ok",
            "fn": FN,
            "entire_test": False,
            "assert_count": 1,
            "events": [tagged(event) for event in events],
            "step": step_doc(target_index, params),
        },
        "expected": {
            "mode": "ok",
            "events_out": [tagged(event) for event in out],
            "loss": tagged(loss),
        },
    }


def recipe_vector(mod: Any) -> dict[str, Any]:
    recipe = mod.RECIPE_TORN_COMPACTION_PROJECT
    if recipe.name != RECIPE:
        raise SystemExit("pin recipe name mismatch")
    if recipe.apply is not mod.apply_torn_compaction_project:
        raise SystemExit("pin apply is not the recipe apply")
    if recipe.affected_region is not None:
        raise SystemExit("pin project region is present")
    handles = [item for item in recipe.handles]
    preconditions = [item for item in recipe.preconditions]
    if any(type(item) is not str for item in handles):
        raise SystemExit("pin handle is not a str")
    if any(type(item) is not str for item in preconditions):
        raise SystemExit("pin precondition is not a str")
    if handles != ["SL108"]:
        raise SystemExit("pin handles drifted")
    if preconditions != ["salvage_policy", "sl108_present"]:
        raise SystemExit("pin preconditions drifted")
    if recipe.min_policy != "salvage" or recipe.version != "1.0.0":
        raise SystemExit("pin recipe policy drifted")
    return {
        "id": "recipe_torn_compaction_project",
        "construct": {
            "type": "recipe_constant",
            "fn": "RECIPE_TORN_COMPACTION_PROJECT",
            "entire_test": False,
        },
        "expected": {
            "mode": "recipe",
            "name": recipe.name,
            "handles": handles,
            "preconditions": preconditions,
            "lossy": require_bool("lossy", recipe.lossy),
            "salvage_only": require_bool("salvage_only", recipe.salvage_only),
            "min_policy": recipe.min_policy,
            "version": recipe.version,
            "excludes_execution_dependence": require_bool(
                "excludes_execution_dependence",
                recipe.excludes_execution_dependence,
            ),
            "apply_present": require_bool("apply_present", recipe.apply is not None),
            "affected_region_present": False,
        },
    }


def require_validation_shape(fn: ast.FunctionDef) -> None:
    names = call_names(fn)
    if names.count(FN) != 3 or FN_LOSS in names or "plan" in names:
        raise SystemExit("validation test is not three apply calls")
    if "canonical_json_bytes" in names:
        raise SystemExit("validation test calls canonical_json_bytes")
    if any(isinstance(node, ast.Assert) for node in ast.walk(fn)):
        raise SystemExit("validation test has an assert outside pytest.raises")
    if raises_matches(fn) != [
        "empty session",
        "not a compaction_boundary",
        "no split pairs or orphaned",
    ]:
        raise SystemExit("validation matches drifted")
    constants = string_constants(fn)
    for needle in (
        RECIPE,
        "m0",
        "cb0",
        TS,
        TS_NEXT,
        "user",
        "system",
        "message",
        "compaction_boundary",
        "fp",
    ):
        if needle not in constants:
            raise SystemExit(f"validation test missing {needle}")


def validation_vector(mod: Any, canon: Any, planner: Any) -> dict[str, Any]:
    step = make_step(planner, 0, {})
    step_cb = make_step(planner, 1, {})
    message = canon.SessionEvent(
        id="m0",
        parent_id=None,
        seq=0,
        ts=TS,
        actor="user",
        kind="message",
    )
    boundary = canon.SessionEvent(
        id="cb0",
        parent_id="m0",
        seq=1,
        ts=TS_NEXT,
        actor="system",
        kind="compaction_boundary",
    )
    message_row = validation_message()
    boundary_row = validation_boundary()
    reject_payload([message_row, boundary_row])
    session_cases = (
        ([], step),
        ([message], step),
        ([message, boundary], step_cb),
    )
    mapping_cases = (
        ([], 0, {}),
        ([message_row], 0, {}),
        ([message_row, boundary_row], 1, {}),
    )
    calls: list[dict[str, Any]] = []
    for (session_events, session_step), (events, index, params) in zip(
        session_cases,
        mapping_cases,
        strict=True,
    ):
        session_result = require_refusal(
            run_pair(mod, session_events, session_step),
            "validation session",
        )
        mapping_result = require_refusal(
            run_pair(mod, events, make_step(planner, index, params)),
            "validation mapping",
        )
        if session_result != mapping_result:
            raise SystemExit("mapping refusal drifted from the SessionEvent call")
        error_type, message_text = mapping_result
        if error_type != "PreconditionFailed":
            raise SystemExit("validation test is not a precondition refusal")
        calls.append(
            {
                "events": [tagged(event) for event in events],
                "step": step_doc(index, params),
                "error_type": error_type,
                "message": message_text,
            }
        )
    if len({item["message"] for item in calls}) != 3:
        raise SystemExit("validation sweep collapsed")
    if "empty session" not in calls[0]["message"]:
        raise SystemExit("empty-session message drifted")
    if "not a compaction_boundary" not in calls[1]["message"]:
        raise SystemExit("non-boundary message drifted")
    if "index 0" not in calls[1]["message"]:
        raise SystemExit("index-zero message drifted")
    if "no split pairs or orphaned" not in calls[2]["message"]:
        raise SystemExit("no-split message drifted")
    if "index 1" not in calls[2]["message"]:
        raise SystemExit("boundary-index message drifted")
    for item in calls:
        if "." in item["message"]:
            raise SystemExit("validation message looks rendered")
    return {
        "id": COVERED_VECTOR,
        "construct": {
            "type": "apply_refusals",
            "fn": FN,
            "entire_test": True,
            "assert_count": 3,
            "calls": calls,
        },
        "expected": {
            "mode": "refusals",
            "error_type": "PreconditionFailed",
            "fn": FN,
        },
    }


def stored_edges(mod: Any, planner: Any) -> list[dict[str, Any]]:
    notes = plain_notes()
    single = one_note()
    boundaries = two_boundaries()
    spanned = tie_events()
    cases: list[tuple[str, list[dict[str, Any]], Any, Any]] = [
        ("project_refusal_missing_index", notes, None, {}),
        ("project_refusal_negative_index", notes, -2, {}),
        (
            "project_refusal_param_out_of_bounds",
            notes,
            None,
            {"boundary_index": 9},
        ),
        ("project_refusal_two_boundaries", boundaries, 50, {}),
        ("project_refusal_true_index_len_one", single, True, {}),
        (
            "project_refusal_params_without_boundary",
            notes,
            None,
            {"marker": 1},
        ),
        (
            "project_type_string_boundary",
            spanned,
            None,
            {"boundary_index": "not-an-index"},
        ),
        ("project_type_list_boundary", spanned, None, {"boundary_index": [1]}),
        (
            "project_type_dict_boundary",
            spanned,
            None,
            {"boundary_index": {"k": 1}},
        ),
        ("project_type_in_range_float", spanned, 1.0, {}),
    ]
    vectors: list[dict[str, Any]] = []
    for vector_id, rows, index, params in cases:
        error_type, message = require_refusal(
            run_pair(mod, rows, make_step(planner, index, params)),
            vector_id,
        )
        if vector_id == "project_type_in_range_float" and message != LIST_MESSAGE:
            raise SystemExit("in-range float message drifted")
        if vector_id.endswith("_float") and error_type != "TypeError":
            raise SystemExit("in-range float was not TypeError")
        if "type_" in vector_id and error_type != "TypeError":
            raise SystemExit(f"{vector_id} was not TypeError")
        if "refusal_" in vector_id and error_type != "PreconditionFailed":
            raise SystemExit(f"{vector_id} was not PreconditionFailed")
        if vector_id == "project_refusal_true_index_len_one" and message != (
            "Invalid compaction boundary index True"
        ):
            raise SystemExit("len-one True message drifted")
        vectors.append(refusal_vector(vector_id, rows, index, params, error_type, message))
    return vectors


def stored_successes(mod: Any, planner: Any) -> list[dict[str, Any]]:
    spanned = tie_events()
    kept = [spanned[0]]
    loss = {"projected-orphans": 2}
    cases: list[tuple[str, list[dict[str, Any]], Any, Any]] = [
        ("project_ok_tie_trailing", spanned, 1, {}),
        ("project_ok_out_of_range_falls_back", spanned, 99, {}),
        ("project_ok_missing_index_falls_back", spanned, None, {}),
        (
            "project_ok_float_param_falls_back",
            spanned,
            None,
            {"boundary_index": 4.0},
        ),
    ]
    vectors: list[dict[str, Any]] = []
    for vector_id, rows, index, params in cases:
        out, got = require_ok(
            run_pair(mod, rows, make_step(planner, index, params)),
            vector_id,
        )
        if out != kept or got != loss:
            raise SystemExit(f"{vector_id} projection drifted")
        vectors.append(ok_vector(vector_id, rows, index, params, out, got))
    leading = leading_events()
    out, got = require_ok(
        run_pair(mod, leading, make_step(planner, 1, {})),
        "project_ok_leading_minority",
    )
    if [item["id"] for item in out] != ["evt-result-a", "evt-result-b"]:
        raise SystemExit("leading minority ids drifted")
    if got != {"projected-orphans": 2}:
        raise SystemExit("leading minority loss drifted")
    vectors.append(ok_vector("project_ok_leading_minority", leading, 1, {}, out, got))
    return vectors


def prove_unclaimed(mod: Any, canon: Any, planner: Any) -> None:
    spanned = tie_events()
    true_cut = require_ok(
        run_pair(mod, spanned, make_step(planner, True, {})),
        "true index",
    )
    if [item["id"] for item in true_cut[0]] != ["evt-call"]:
        raise SystemExit("pin True index did not select the boundary")
    if true_cut[1] != {"projected-orphans": 2}:
        raise SystemExit("pin True index loss drifted")
    del true_cut
    error_type, message = require_refusal(
        run_pair(mod, spanned, make_step(planner, False, {})),
        "false index",
    )
    if error_type != "PreconditionFailed":
        raise SystemExit("pin False index was not a precondition refusal")
    if message != "Event at index False is not a compaction_boundary":
        raise SystemExit("pin False index message drifted")
    if message == "Invalid compaction boundary index False":
        raise SystemExit("pin False index matched the published refusal")
    del message
    false_kept, false_loss = require_ok(
        run_pair(mod, false_boundary_events(), make_step(planner, False, {})),
        "false boundary",
    )
    if [item["id"] for item in false_kept] != ["evt-result"]:
        raise SystemExit("pin False boundary did not project")
    if false_loss != {"projected-orphans": 1}:
        raise SystemExit("pin False boundary loss drifted")
    del false_kept, false_loss
    notes = plain_notes()
    for label, index in (("neg-float", -1.5), ("oob-float", 9.0)):
        error_type, message = require_refusal(
            run_pair(mod, notes, make_step(planner, index, {})),
            label,
        )
        if error_type != "PreconditionFailed" or "." not in message:
            raise SystemExit(f"{label} was not a rendered refusal")
        del message
    zero_type, zero_message = require_refusal(
        run_pair(mod, notes, make_step(planner, 0.0, {})),
        "zero float",
    )
    if zero_type != "TypeError" or zero_message != LIST_MESSAGE:
        raise SystemExit("zero float was not the in-range TypeError")
    del zero_message
    float_kind = [
        {"kind": 1.5, "id": "evt-float-kind"},
        {"kind": "compaction_boundary", "id": "evt-boundary"},
    ]
    kind_type, kind_message = require_refusal(
        run_pair(mod, float_kind, make_step(planner, 1, {})),
        "float kind",
    )
    if kind_type != "PreconditionFailed" or "no split pairs" not in kind_message:
        raise SystemExit("float kind was not the pin no-split refusal")
    del kind_message
    session = canon.SessionEvent(
        id="evt-call",
        parent_id=None,
        seq=0,
        ts=TS,
        actor="assistant",
        kind="tool_call",
        correlation_id=CORR,
    )
    copied, loss = require_ok(
        run_pair(
            mod,
            [session, spanned[1], spanned[2]],
            make_step(planner, 1, {}),
        ),
        "session copy",
        allow_payload=True,
    )
    if [item.get("id") for item in copied] != ["evt-call"]:
        raise SystemExit("session copy did not keep the call")
    if loss != {"projected-orphans": 2}:
        raise SystemExit("session copy loss drifted")
    if copied == [spanned[0]]:
        raise SystemExit("session copy collapsed to the mapping")
    del copied, loss


def prove_fixture(mod: Any, canon: Any, planner: Any, fixture: dict[str, Any]) -> None:
    raw_events = fixture["events"]
    if not isinstance(raw_events, list) or len(raw_events) != 5:
        raise SystemExit("fixture event count drifted")
    if not any(isinstance(item, dict) and "payload" in item for item in raw_events):
        raise SystemExit("fixture lost payload")
    kinds = [item.get("kind") for item in raw_events if isinstance(item, dict)]
    if kinds != [
        "message",
        "tool_call",
        "compaction_boundary",
        "tool_result",
        "message",
    ]:
        raise SystemExit("fixture kinds drifted")
    ids = [item.get("id") for item in raw_events if isinstance(item, dict)]
    if ids != ["m0", "tc1", "cb1", "tr2", "m1"]:
        raise SystemExit("fixture ids drifted")
    step_raw = fixture["expected_plan"]["steps"][0]
    if step_raw["recipe"] != RECIPE or step_raw["target_index"] != 2:
        raise SystemExit("fixture step drifted")
    if step_raw.get("loss") != {"projected-orphans": 2}:
        raise SystemExit("fixture step loss drifted")
    fingerprint = fixture["expected_plan"]["fingerprint"]
    if not isinstance(fingerprint, str) or len(fingerprint) != 64:
        raise SystemExit("fixture fingerprint shape drifted")
    del fingerprint
    conservative = fixture["expected_conservative_plan"]["fingerprint"]
    if not isinstance(conservative, str) or len(conservative) != 64:
        raise SystemExit("fixture conservative fingerprint shape drifted")
    del conservative
    step = planner.PlanStep(
        seq=step_raw["seq"],
        recipe=step_raw["recipe"],
        target_finding_fp=step_raw["target_finding_fp"],
        target_index=step_raw["target_index"],
        params=dict(step_raw.get("params") or {}),
        lossy=True,
        min_policy=step_raw["min_policy"],
        recipe_version=step_raw["recipe_version"],
    )
    events = [canon.SessionEvent(**item) for item in raw_events]
    out, loss = require_ok(run_pair(mod, events, step), "fixture", allow_payload=True)
    if [item["id"] for item in out] != ["m0", "tc1", "m1"]:
        raise SystemExit("fixture kept ids drifted")
    if loss != {"projected-orphans": 2}:
        raise SystemExit("fixture loss drifted")
    if not any("payload" in item for item in out):
        raise SystemExit("fixture output lost payload")
    del out
    stripped: list[dict[str, Any]] = []
    for item in raw_events:
        if not isinstance(item, dict):
            raise SystemExit("fixture event is not a dict")
        stripped.append({key: value for key, value in item.items() if key != "payload"})
    stripped_events = [canon.SessionEvent(**item) for item in stripped]
    stripped_result = run_pair(mod, stripped_events, step)
    if not is_error(stripped_result):
        stripped_out, _stripped_loss = require_ok(
            stripped_result,
            "stripped fixture",
            allow_payload=True,
        )
        if [item["id"] for item in stripped_out] != ["m0", "tc1", "m1"]:
            raise SystemExit("stripped fixture ids drifted")
        del stripped_out
    del stripped_result


def prove_shapes(text: str) -> None:
    functions = test_functions(text)
    if len(functions) != PINNED_TEST_COUNT:
        raise SystemExit(f"pinned test count {len(functions)}")
    expected = list(NOTES)[:13] + [COVERED_TEST] + list(NOTES)[13:]
    if [fn.name for fn in functions] != expected:
        raise SystemExit("test order drifted")
    for fn in functions:
        names = call_names(fn)
        wrapper = names.count(FN)
        with_loss = names.count(FN_LOSS)
        if fn.name == COVERED_TEST:
            require_validation_shape(fn)
            continue
        if fn.name == "test_salvage_recipe_applications":
            if wrapper or with_loss != 1 or "plan" not in names:
                raise SystemExit("applications test shape drifted")
            continue
        if wrapper or with_loss:
            raise SystemExit(f"unexpected project call in {fn.name}")
        if fn.name not in NOTES:
            raise SystemExit(f"unclassified test {fn.name}")
    applications = function_named(text, "test_salvage_recipe_applications")
    app_names = call_names(applications)
    if "plan" not in app_names or app_names.count(FN_LOSS) != 1:
        raise SystemExit("applications test calls drifted")
    if "apply_unresolvable_branch_amputate_with_loss" not in app_names:
        raise SystemExit("applications test lost the other recipes")
    if "apply_side_effect_unknown_truncate_with_loss" not in app_names:
        raise SystemExit("applications test lost the truncate recipe")
    if "salvage_project.json" not in string_constants(applications):
        raise SystemExit("applications test lost the fixture")
    opt_in = function_named(text, "test_salvage_opt_in")
    if "plan" not in call_names(opt_in) or RECIPE not in string_constants(opt_in):
        raise SystemExit("opt-in test shape drifted")
    if "salvage_project.json" not in string_constants(opt_in):
        raise SystemExit("opt-in test lost the fixture")
    conservative = function_named(text, "test_conservative_default_blocks_salvage")
    if "plan" not in call_names(conservative):
        raise SystemExit("conservative test shape drifted")
    if "salvage_project.json" not in string_constants(conservative):
        raise SystemExit("conservative test lost the fixture")
    if FN in call_names(conservative) or FN_LOSS in call_names(conservative):
        raise SystemExit("conservative test calls apply")


def confirm_docs_and_mentions() -> None:
    docs = git_show_bytes(f"{PYTHON_COMMIT}:{DOCS}").decode("utf-8")
    if RECIPE not in docs or "SL108" not in docs:
        raise SystemExit("pin recipe doc drifted")
    if "fixtures/repair/salvage_project.json" not in docs:
        raise SystemExit("pin recipe doc lost the fixture")
    for rel in MENTION_FILES:
        text = git_show_bytes(f"{PYTHON_COMMIT}:{rel}").decode("utf-8")
        if FN in text or FN_LOSS in text:
            raise SystemExit(f"{rel} calls the project function")


def discover_coverage(text: str) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for fn in test_functions(text):
        covered = fn.name == COVERED_TEST
        rows.append(
            {
                "test": f"{TEST_FILE}::{fn.name}",
                "column": "column_0",
                "status": "covered" if covered else "not_applicable",
                "vector_id": COVERED_VECTOR if covered else None,
                "note": "" if covered else NOTES[fn.name],
            }
        )
    covered_count = sum(row["status"] == "covered" for row in rows)
    if covered_count != 1 or len(rows) != PINNED_TEST_COUNT:
        raise SystemExit("coverage counts drifted")
    return rows


def leaks_payload(text: str, item: str) -> bool:
    if f'"{item}"' in text:
        return True
    if len(item) >= 8 and item in text:
        return True
    distinctive = any(ch.isspace() or not ch.isalnum() for ch in item)
    return bool(distinctive and item in text)


def dump(doc: Any, banned_payload: list[str]) -> str:
    text = json.dumps(doc, indent=2, ensure_ascii=False) + "\n"
    if "\r" in text or _SBP.search(text):
        raise SystemExit("refusing CR or sbp hash in JSON")
    if "02694d5" in text:
        raise SystemExit("refusing the wrong pin in JSON")
    if "0 diff" in text:
        raise SystemExit("refusing a zero-diff claim in JSON")
    for seam in _SEAMS:
        if seam in text:
            raise SystemExit("refusing a seam sentence in JSON")
    if '"payload"' in text:
        raise SystemExit("refusing a payload field in JSON")
    for banned in _BANNED_PATH:
        if banned in text:
            raise SystemExit("refusing a path fragment in JSON")
    for item in banned_payload:
        if item and leaks_payload(text, item):
            digest = hashlib.sha256(item.encode("utf-8")).hexdigest()
            raise SystemExit(f"refusing payload content length {len(item)} sha {digest}")
    return text


def write_text(path: Path, text: str) -> None:
    path.write_bytes(text.encode("utf-8"))


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    confirm_docs_and_mentions()
    test_text = git_show_bytes(f"{PYTHON_COMMIT}:{TEST_FILE}").decode("utf-8")
    prove_shapes(test_text)
    fixture = json.loads(git_show_bytes(f"{PYTHON_COMMIT}:{FIXTURE}").decode("utf-8"))
    banned_payload = payload_strings(fixture) + payload_literals(test_text)
    if len(banned_payload) < 1:
        raise SystemExit("payload strings missing")
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/recipes_salvage.py")
    py_sha = hashlib.sha256(py_blob).hexdigest()
    if py_sha != KNOWN_PY_SHA:
        raise SystemExit("recipes_salvage.py sha drifted")
    mod = load_mod()
    canon = sys.modules["sesslint.canonical"]
    planner = sys.modules["sesslint.repair.planner"]
    prove_unclaimed(mod, canon, planner)
    prove_fixture(mod, canon, planner, fixture)
    recipe = recipe_vector(mod)
    covered = validation_vector(mod, canon, planner)
    edges = stored_edges(mod, planner)
    successes = stored_successes(mod, planner)
    vectors = [recipe, covered, *edges, *successes]
    entire = [item for item in vectors if item["construct"]["entire_test"] is True]
    if [item["id"] for item in entire] != [COVERED_VECTOR]:
        raise SystemExit("entire_test drifted")
    doc = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_salvage_py_sha256": py_sha,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = dump(doc, banned_payload)
    write_text(OUT / "vectors.json", payload)
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    rows = discover_coverage(test_text)
    coverage = {
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "test_file": TEST_FILE,
        "covered_count": sum(row["status"] == "covered" for row in rows),
        "not_applicable_count": sum(row["status"] == "not_applicable" for row in rows),
        "rows": rows,
    }
    if coverage["covered_count"] != 1 or coverage["not_applicable_count"] != 23:
        raise SystemExit("coverage counts drifted")
    write_text(OUT / "coverage.json", dump(coverage, banned_payload))
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic torn-compaction-project parity. Refusal messages come "
            "from the pinned blob. Plan results, fixture payload, and "
            "SessionEvent copies stay uncovered. No fixture diff is stored."
        ),
        "generator": GENERATOR,
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "PROVENANCE.json", dump(provenance, banned_payload))
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_salvage_py_sha256": py_sha,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": GENERATOR,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "manifest.json", dump(manifest, banned_payload))
    print(
        f"{len(vectors)} {digest} covered={coverage['covered_count']} "
        f"not_applicable={coverage['not_applicable_count']} py={py_sha}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
