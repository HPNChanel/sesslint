def test_functions(text: str) -> list[ast.FunctionDef]:
    tree = ast.parse(text)
    return [
        node
        for node in tree.body
        if isinstance(node, ast.FunctionDef) and node.name.startswith("test_")
    ]


def function_named(text: str, name: str) -> ast.FunctionDef:
    for node in test_functions(text):
        if node.name == name:
            return node
    raise SystemExit(f"missing {name}")


def call_names(fn: ast.AST) -> list[str]:
    names: list[str] = []
    for node in ast.walk(fn):
        if not isinstance(node, ast.Call):
            continue
        if isinstance(node.func, ast.Name):
            names.append(node.func.id)
        elif isinstance(node.func, ast.Attribute):
            names.append(node.func.attr)
    return names


def string_constants(fn: ast.FunctionDef) -> set[str]:
    found: set[str] = set()
    for node in ast.walk(fn):
        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            found.add(node.value)
    return found


def raises_matches(fn: ast.FunctionDef) -> list[str]:
    found: list[str] = []
    for node in ast.walk(fn):
        if not isinstance(node, ast.With):
            continue
        for item in node.items:
            call = item.context_expr
            if not isinstance(call, ast.Call):
                continue
            func = call.func
            if not isinstance(func, ast.Attribute) or func.attr != "raises":
                continue
            for keyword in call.keywords:
                if keyword.arg == "match":
                    value = ast.literal_eval(keyword.value)
                    if not isinstance(value, str):
                        raise SystemExit(f"{fn.name} match is not a string")
                    found.append(value)
    return found


def payload_strings(node: Any) -> list[str]:
    found: list[str] = []
    if isinstance(node, dict):
        for key, value in node.items():
            if key == "payload":
                found.extend(collect_strings(value))
            else:
                found.extend(payload_strings(value))
    elif isinstance(node, list):
        for item in node:
            found.extend(payload_strings(item))
    return found


def collect_strings(node: Any) -> list[str]:
    if isinstance(node, str):
        return [node] if node else []
    if isinstance(node, dict):
        found: list[str] = []
        for value in node.values():
            found.extend(collect_strings(value))
        return found
    if isinstance(node, list):
        found = []
        for item in node:
            found.extend(collect_strings(item))
        return found
    return []


def const_strings(node: ast.AST) -> list[str]:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return [node.value] if node.value else []
    if isinstance(node, ast.JoinedStr):
        found: list[str] = []
        for value in node.values:
            found.extend(const_strings(value))
        return found
    if isinstance(node, ast.Dict):
        found = []
        for value in node.values:
            if value is not None:
                found.extend(const_strings(value))
        return found
    if isinstance(node, (ast.List, ast.Tuple, ast.Set)):
        found = []
        for value in node.elts:
            found.extend(const_strings(value))
        return found
    return []


def payload_literals(text: str) -> list[str]:
    found: list[str] = []
    for node in ast.walk(ast.parse(text)):
        if isinstance(node, ast.keyword) and node.arg == "payload":
            found.extend(const_strings(node.value))
    return found


