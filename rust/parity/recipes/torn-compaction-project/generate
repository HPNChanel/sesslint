def run_pair(
    mod: Any, events: list[Any], step: Any
) -> tuple[str, str] | tuple[list[Any], dict[str, int]]:
    try:
        listed = mod.apply_torn_compaction_project(events, step)
        with_loss = mod.apply_torn_compaction_project_with_loss(events, step)
    except mod.PreconditionFailed as exc:
        message = str(exc)
        try:
            mod.apply_torn_compaction_project_with_loss(events, step)
        except mod.PreconditionFailed as other:
            if str(other) != message:
                raise SystemExit("with_loss message drifted") from other
        else:
            raise SystemExit("with_loss returned Ok for a refusal")
        return ("PreconditionFailed", message)
    except TypeError as exc:
        message = str(exc)
        try:
            mod.apply_torn_compaction_project_with_loss(events, step)
        except TypeError as other:
            if str(other) != message:
                raise SystemExit("with_loss type message drifted") from other
        else:
            raise SystemExit("with_loss returned Ok for a type error")
        return ("TypeError", message)
    if not isinstance(listed, list) or not isinstance(with_loss, tuple):
        raise SystemExit("pin success shape drifted")
    out, loss = with_loss
    if listed != out:
        raise SystemExit("wrapper list drifted from with_loss")
    if not isinstance(loss, dict):
        raise SystemExit("pin loss is not a dict")
    return (out, loss)


def is_error(result: tuple[Any, ...] | list[Any]) -> bool:
    return (
        isinstance(result, tuple)
        and len(result) == 2
        and isinstance(result[0], str)
        and result[0] in {"PreconditionFailed", "TypeError"}
    )


def require_refusal(result: tuple[Any, ...] | list[Any], label: str) -> tuple[str, str]:
    if not is_error(result):
        raise SystemExit(f"{label} did not refuse")
    error_type, message = result
    if not isinstance(error_type, str) or not isinstance(message, str) or not message:
        raise SystemExit(f"{label} message drifted")
    if any(seam in message for seam in _SEAMS):
        raise SystemExit(f"{label} message is a seam")
    return error_type, message


def require_ok(
    result: tuple[Any, ...] | list[Any],
    label: str,
    *,
    allow_payload: bool = False,
) -> tuple[list[dict[str, Any]], dict[str, int]]:
    if is_error(result):
        raise SystemExit(f"{label} refused")
    if not isinstance(result, tuple) or len(result) != 2:
        raise SystemExit(f"{label} success shape drifted")
    out, loss = result
    if not isinstance(out, list) or not isinstance(loss, dict):
        raise SystemExit(f"{label} success types drifted")
    rows: list[dict[str, Any]] = []
    for item in out:
        if not isinstance(item, dict):
            raise SystemExit(f"{label} event is not a dict")
        rows.append(item)
    if not allow_payload:
        reject_payload(rows)
    counts: dict[str, int] = {}
    for key, value in loss.items():
        if type(value) is not int:
            raise SystemExit(f"{label} loss count is not an int")
        counts[str(key)] = value
    return rows, counts


def step_doc(target_index: Any, params: Any) -> dict[str, Any]:
    return {"target_index": tagged(target_index), "params": tagged(params)}


def refusal_vector(
    vector_id: str,
    events: list[dict[str, Any]],
    target_index: Any,
    params: Any,
    error_type: str,
    message: str,
) -> dict[str, Any]:
    reject_payload(events)
    if "." in message:
        raise SystemExit(f"{vector_id} message looks rendered")
    return {
        "id": vector_id,
        "construct": {
            "type": "apply_refusal",
            "fn": FN,
            "entire_test": False,
            "assert_count": 1,
            "events": [tagged(event) for event in events],
            "step": step_doc(target_index, params),
        },
        "expected": {
            "mode": "refusal",
            "error_type": error_type,
            "message": message,
        },
    }


