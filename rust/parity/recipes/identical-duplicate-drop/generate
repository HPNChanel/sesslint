def make_step(cons: Any, case: dict[str, Any]) -> Any:
    if case["params_kind"] == "mapping":
        params: Any = copy.deepcopy(case["params"])
    elif case["params_kind"] == "not_mapping":
        params = "not-a-mapping"
    else:
        raise SystemExit(f"bad params_kind {case['params_kind']}")
    return cons.PlanStep(
        seq=0,
        recipe="identical-duplicate-drop",
        target_finding_fp="fp",
        target_index=case["target_index"],
        params=params,
    )


def run_case(cons: Any, case: dict[str, Any]) -> dict[str, Any]:
    events = copy.deepcopy(case["events"])
    step = make_step(cons, case)
    try:
        out = cons.apply_identical_duplicate_drop(events, step)
    except cons.PreconditionFailed as exc:
        return {
            "mode": "comparable",
            "pin": {
                "mode": "precondition",
                "error_type": "PreconditionFailed",
                "message": str(exc),
            },
        }
    return {"mode": "comparable", "pin": {"mode": "ok", "events": out}}


def construct_of(case: dict[str, Any]) -> dict[str, Any]:
    return {
        "type": "apply",
        "fn": "apply_identical_duplicate_drop",
        "recipe": "identical-duplicate-drop",
        "target_finding_fp": "fp",
        "target_index": case["target_index"],
        "params_kind": case["params_kind"],
        "params": case["params"],
        "events": case["events"],
    }


def test_bodies(text: str) -> list[tuple[str, str]]:
    matches = list(re.finditer(r"^def (test_\w+)\(", text, re.M))
    found: list[tuple[str, str]] = []
    for index, match in enumerate(matches):
        start = match.start()
        end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
        found.append((match.group(1), text[start:end]))
    return found


def require_entire_conflicting_test(body: str) -> None:
    if body.count("pytest.raises") != 1:
        raise SystemExit("conflicting-variant test is not a single raises")
    if re.search(r"^\s*assert ", body, re.M):
        raise SystemExit("conflicting-variant test has another assert")
    needles = (
        "apply_identical_duplicate_drop",
        "PreconditionFailed",
        "conflicting-duplicate",
        '[{"id": "x"}] * 4',
        '"record_indexes": [1, 2]',
        "target_index=1",
        'target_finding_fp="fp"',
        'recipe="identical-duplicate-drop"',
    )
    for needle in needles:
        if needle not in body:
            raise SystemExit(f"pinned test missing {needle}")
    if "payload" in body or "api." in body:
        raise SystemExit("conflicting-variant test is no longer one apply refusal")


def assertion_count(body: str) -> int:
    return body.count("pytest.raises") + len(re.findall(r"^\s*assert ", body, re.M))


def classify(name: str, body: str, vector_ids: set[str]) -> dict[str, Any]:
    key = f"{TEST_FILE}::{name}"
    if name == "test_drop_fails_closed_on_conflicting_variant":
        require_entire_conflicting_test(body)
        vid = "drop_refusal_conflicting_variant"
        if vid not in vector_ids:
            raise SystemExit("missing covered vector")
        return {
            "test": key,
            "column": "column_0",
            "status": "covered",
            "vector_id": vid,
            "note": "",
        }
    if "payload" in body and "apply_identical_duplicate_drop" in body:
        note = (
            "single apply_identical_duplicate_drop refusal on payload events "
            "without content_hash; that failure mode is not the content_hash "
            "refusal in this set"
        )
    elif "apply_seq_renumber" in body and "apply_identical_duplicate_drop" not in body:
        note = "apply_seq_renumber multi-assert sweep; different function"
    elif "api.plan" in body or "api.repair" in body or "planner_plan(" in body:
        if assertion_count(body) > 1:
            note = "multi-assert planner or repair sweep; planner seam remains"
        else:
            note = (
                "planner or repair entry point; seam remains, no plan or "
                "fixture diff is stored"
            )
    else:
        raise SystemExit(f"unclassified pinned test {name}")
    return {
        "test": key,
        "column": "column_0",
        "status": "not_applicable",
        "vector_id": None,
        "note": note,
    }


def dump(doc: Any) -> str:
    text = json.dumps(doc, indent=2, ensure_ascii=False, sort_keys=True) + "\n"
    if "\r" in text:
        raise SystemExit("CR in JSON")
    if SEAM_SENTENCE in text:
        raise SystemExit("rust seam sentence stored in JSON")
    if SBP.search(text):
        raise SystemExit("sbp_ token in JSON")
    if "FOR_WORK" in text or "sesslint-wt" in text or re.search(r"[A-Za-z]:[\\/]", text):
        raise SystemExit("absolute path in JSON")
    return text


def write(name: str, text: str) -> None:
    path = OUT / name
    path.write_bytes(text.encode("utf-8"))


def main() -> int:
    sys.dont_write_bytecode = True
    blocked = {str(ROOT), str(ROOT / "src")}
    sys.path[:] = [item for item in sys.path if item not in blocked and item not in {"", "."}]
    OUT.mkdir(parents=True, exist_ok=True)
    cons = load_mod()
    vectors: list[dict[str, Any]] = []
    for case in CASES:
        vectors.append(
            {
                "id": case["id"],
                "construct": construct_of(case),
                "expected": run_case(cons, case),
            }
        )
    doc = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PIN,
        "recipe": "identical-duplicate-drop",
        "known_parity_gaps": GAPS,
        "vectors": vectors,
    }
    payload = dump(doc)
    write("vectors.json", payload)
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    ids = {item["id"] for item in vectors}
    test_text = git_show_bytes(f"{PIN}:{TEST_FILE}").decode("utf-8")
    bodies = test_bodies(test_text)
    if len(bodies) != PINNED_TEST_COUNT:
        raise SystemExit(f"pinned test count {len(bodies)}")
    rows = [classify(name, body, ids) for name, body in bodies]
    covered = sum(1 for row in rows if row["status"] == "covered")
    skipped = sum(1 for row in rows if row["status"] == "not_applicable")
    if covered + skipped != len(rows):
        raise SystemExit("coverage status gap")
    cov = {
        "module": MODULE,
        "python_commit": PIN,
        "test_file": TEST_FILE,
        "covered_count": covered,
        "not_applicable_count": skipped,
        "rows": rows,
    }
    write("coverage.json", dump(cov))
    prov = {
        "contains_real_data": False,
        "description": "Synthetic identical-duplicate-drop refusal parity vectors.",
        "generator": GENERATOR,
        "origin": "synthetic",
        "python_commit": PIN,
        "known_parity_gaps": GAPS,
    }
    write("PROVENANCE.json", dump(prov))
    man = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PIN,
        "recipe": "identical-duplicate-drop",
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": GENERATOR,
        "known_parity_gaps": GAPS,
    }
    write("manifest.json", dump(man))
    print(len(vectors), digest, covered, skipped)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
