def coverage_note(fn: ast.FunctionDef) -> str:
    if fn.name == "test_compaction_projection_reunion_fixture":
        return FIXTURE_NOTE
    if fn.name == "test_purity_and_immutability":
        return PURITY_NOTE
    if fn.name == "test_plan_and_apply_compaction_reunion_full_flow":
        return PLAN_NOTE
    if fn.name == "test_no_synthetic_success_multiset_proof":
        return MULTISET_NOTE
    if fn.name == "test_conservative_recipes_registration_and_handles":
        return REGISTER_NOTE
    if touches_recipe(fn):
        raise SystemExit(f"unclassified reunion test {fn.name}")
    return DIFFERENT_NOTE


def discover_coverage(text: str) -> list[dict[str, Any]]:
    functions = test_functions(text)
    if len(functions) != PINNED_TEST_COUNT:
        raise SystemExit(f"pinned test count {len(functions)}")
    touched = {fn.name for fn in functions if touches_recipe(fn)}
    if touched != set(TOUCHES):
        raise SystemExit(f"reunion test set drifted {sorted(touched)}")
    rows: list[dict[str, Any]] = []
    for fn in functions:
        covered = fn.name in COVERED
        rows.append(
            {
                "test": f"{TEST_FILE}::{fn.name}",
                "column": "column_0",
                "status": "covered" if covered else "not_applicable",
                "vector_id": COVERED[fn.name] if covered else None,
                "note": "" if covered else coverage_note(fn),
            }
        )
    covered_count = sum(row["status"] == "covered" for row in rows)
    if covered_count != len(COVERED):
        raise SystemExit("covered count drifted")
    return rows


def payload_strings(node: Any) -> list[str]:
    found: list[str] = []
    if isinstance(node, dict):
        for key, value in node.items():
            if key == "payload":
                found.extend(collect_strings(value))
            else:
                found.extend(payload_strings(value))
    elif isinstance(node, list):
        for item in node:
            found.extend(payload_strings(item))
    return found


def collect_strings(node: Any) -> list[str]:
    if isinstance(node, str):
        return [node] if node else []
    if isinstance(node, dict):
        found: list[str] = []
        for value in node.values():
            found.extend(collect_strings(value))
        return found
    if isinstance(node, list):
        found = []
        for item in node:
            found.extend(collect_strings(item))
        return found
    return []


def dump(doc: Any, banned_payload: list[str]) -> str:
    text = json.dumps(doc, indent=2, ensure_ascii=False) + "\n"
    if "\r" in text or _SBP.search(text):
        raise SystemExit("refusing CR or sbp hash in JSON")
    if "02694d5" in text or SEAM_REGION in text or SEAM_DETERMINISM in text or SEAM_CODEC in text:
        raise SystemExit("refusing banned sentence in JSON")
    if '"t": "bool"' in text:
        raise SystemExit("refusing a tagged bool in JSON")
    for banned in _BANNED_PATH:
        if banned in text:
            raise SystemExit(f"refusing path fragment in JSON: {banned}")
    for item in banned_payload:
        if item and item in text:
            raise SystemExit("refusing fixture payload content in JSON")
    return text


def write_text(path: Path, text: str) -> None:
    path.write_bytes(text.encode("utf-8"))


def confirm_abstention() -> None:
    text = git_show_bytes(f"{PYTHON_COMMIT}:{ABSTENTION_FILE}").decode("utf-8")
    if "def test_region_functions_totality_fuzz" not in text:
        raise SystemExit("pin totality test missing")
    if "affected_region_compaction_projection_reunion" not in text:
        raise SystemExit("pin abstention file lost the region function")
    if "parametrize" not in text:
        raise SystemExit("pin totality test is not a sweep")


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    confirm_abstention()
    test_text = git_show_bytes(f"{PYTHON_COMMIT}:{TEST_FILE}").decode("utf-8")
    fixture = json.loads(git_show_bytes(f"{PYTHON_COMMIT}:{FIXTURE}").decode("utf-8"))
    banned_payload = payload_strings(fixture)
    if not banned_payload:
        raise SystemExit("fixture payload strings missing")
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/recipes_conservative.py")
    py_sha = hashlib.sha256(py_blob).hexdigest()
    mod = load_mod()
    prove_bool_gap(mod)
    recipe = recipe_vector(mod)
    covered = covered_vectors(mod, test_text)
    extras = extra_refusals(mod, {item["expected"]["message"] for item in covered})
    vectors = [recipe, *extras, *covered]
    doc = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_conservative_py_sha256": py_sha,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = dump(doc, banned_payload)
    write_text(OUT / "vectors.json", payload)
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    rows = discover_coverage(test_text)
    coverage = {
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "test_file": TEST_FILE,
        "covered_count": sum(row["status"] == "covered" for row in rows),
        "not_applicable_count": sum(row["status"] == "not_applicable" for row in rows),
        "rows": rows,
    }
    write_text(OUT / "coverage.json", dump(coverage, banned_payload))
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic compaction-projection-reunion parity. Refusal messages "
            "come from the pinned blob. Fixture output, fingerprints, and "
            "planner results stay uncovered. No fixture diff is stored."
        ),
        "generator": GENERATOR,
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "PROVENANCE.json", dump(provenance, banned_payload))
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_conservative_py_sha256": py_sha,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": GENERATOR,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "manifest.json", dump(manifest, banned_payload))
    covered_count = coverage["covered_count"]
    skipped = coverage["not_applicable_count"]
    print(f"{len(vectors)} {digest} covered={covered_count} not_applicable={skipped}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
