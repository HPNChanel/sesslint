def extra_refusals(mod: Any) -> list[dict[str, Any]]:
    corr = {"correlation_id": "corr-synthetic"}
    missing_events: list[dict[str, Any]] = []
    missing = run_apply(mod, missing_events, fields_for(target_index=None, params={}))
    zero_events = [
        {"id": "evt-note", "kind": "message", "seq": 0},
    ]
    zero = run_apply(mod, zero_events, fields_for(target_index=None, params=corr))
    one_events = [result_event("evt-only", "hash-left", 0)]
    one = run_apply(mod, one_events, fields_for(target_index=None, params=corr))
    differ_events = [
        result_event("evt-kept", "hash-left", 0),
        result_event("evt-drop", "hash-right", 1),
    ]
    differ = run_apply(mod, differ_events, fields_for(target_index=None, params=corr))
    messages = (missing, zero, one, differ)
    if len(set(messages)) != 4:
        raise SystemExit("refusal messages are not distinct")
    if missing != MISSING or zero != FOUND_0 or one != FOUND_1 or differ != DIFFER:
        raise SystemExit("pin refusal text drifted")
    return [
        refusal_vector(
            "removal_refusal_missing_correlation_id",
            entire_test=False,
            events=missing_events,
            target_index=None,
            params={},
            message=missing,
        ),
        refusal_vector(
            "removal_refusal_zero_results",
            entire_test=False,
            events=zero_events,
            target_index=None,
            params=corr,
            message=zero,
        ),
        refusal_vector(
            "removal_refusal_one_result",
            entire_test=False,
            events=one_events,
            target_index=None,
            params=corr,
            message=one,
        ),
        refusal_vector(
            "removal_refusal_fingerprints_differ",
            entire_test=False,
            events=differ_events,
            target_index=None,
            params=corr,
            message=differ,
        ),
    ]


def prove_bool_gap(mod: Any) -> None:
    events = [
        result_event("evt-bool-kept", "hash-a", 0),
        result_event("evt-bool-mid", "hash-b", 1),
        result_event("evt-bool-later", "hash-a", 2),
    ]
    message = run_apply(
        mod,
        events,
        fields_for(target_index=True, params={"correlation_id": "corr-synthetic"}),
    )
    if message != DIFFER:
        raise SystemExit("pin bool target_index did not refuse the selected row")


def prove_payload_gap(mod: Any, text: str) -> None:
    fn = function_named(text, "test_duplicate_projection_removal_differing_fingerprints")
    assert_whole_refusal(fn)
    events = raw_events(fn)
    if not any("payload" in item for item in events):
        raise SystemExit("payload refusal test has no payload")
    fields = step_from_test(fn)
    message = run_apply(mod, events, fields)
    pattern = raises_match(fn)
    if re.search(pattern, message) is None:
        raise SystemExit("payload refusal message does not match the test")
    if message != DIFFER:
        raise SystemExit("payload refusal message drifted")


def assert_call_count(fn: ast.FunctionDef, name: str, count: int) -> None:
    if call_names(fn).count(name) != count:
        raise SystemExit(f"{fn.name} {name} count drifted")


def prove_shapes(text: str) -> None:
    fixture = function_named(text, "test_duplicate_projection_removal_fixture")
    assert_call_count(fixture, "apply_duplicate_projection_removal", 1)
    assert_call_count(fixture, "canonical_json_bytes", 2)
    if "raises" in call_names(fixture):
        raise SystemExit("fixture test is not a success")
    rewrite = function_named(
        text, "test_duplicate_projection_removal_rewrites_child_parent_pointers"
    )
    assert_call_count(rewrite, "apply_duplicate_projection_removal", 1)
    if "raises" in call_names(rewrite) or "canonical_json_bytes" in call_names(rewrite):
        raise SystemExit("rewrite test shape drifted")
    if not any(isinstance(node, ast.Assert) for node in ast.walk(rewrite)):
        raise SystemExit("rewrite test has no assert")
    idem = function_named(text, "test_idempotence_where_defined")
    assert_call_count(idem, "apply_duplicate_projection_removal", 2)
    assert_call_count(idem, "raises", 1)
    planned = function_named(text, "test_plan_and_apply_duplicate_projection_full_flow")
    assert_call_count(planned, "plan", 1)
    assert_call_count(planned, "apply_duplicate_projection_removal", 1)
    multiset = function_named(text, "test_no_synthetic_success_multiset_proof")
    if "apply_duplicate_projection_removal" in call_names(multiset):
        raise SystemExit("multiset test calls apply")
    if "canonical_json_bytes" not in call_names(multiset):
        raise SystemExit("multiset test lost canonical_json_bytes")
    register = function_named(text, "test_conservative_recipes_registration_and_handles")
    if "apply_duplicate_projection_removal" in call_names(register):
        raise SystemExit("registration test calls apply")
    if RECIPE not in string_constants(register):
        raise SystemExit("registration test lost the recipe name")


def coverage_note(fn: ast.FunctionDef) -> str:
    if fn.name == "test_duplicate_projection_removal_fixture":
        return FIXTURE_NOTE
    if fn.name == "test_duplicate_projection_removal_rewrites_child_parent_pointers":
        return REWRITE_NOTE
    if fn.name == "test_idempotence_where_defined":
        return IDEMPOTENCE_NOTE
    if fn.name == "test_plan_and_apply_duplicate_projection_full_flow":
        return PLAN_NOTE
    if fn.name == "test_no_synthetic_success_multiset_proof":
        return MULTISET_NOTE
    if fn.name == "test_duplicate_projection_removal_differing_fingerprints":
        return FINGERPRINT_NOTE
    if fn.name == "test_conservative_recipes_registration_and_handles":
        return REGISTER_NOTE
    if touches_recipe(fn):
        raise SystemExit(f"unclassified removal test {fn.name}")
    return DIFFERENT_NOTE


def discover_coverage(text: str) -> list[dict[str, Any]]:
    functions = test_functions(text)
    if len(functions) != PINNED_TEST_COUNT:
        raise SystemExit(f"pinned test count {len(functions)}")
    touched = {fn.name for fn in functions if touches_recipe(fn)}
    if touched != set(TOUCHES):
        raise SystemExit(f"removal test set drifted {sorted(touched)}")
    rows: list[dict[str, Any]] = []
    for fn in functions:
        covered = fn.name in COVERED
        rows.append(
            {
                "test": f"{TEST_FILE}::{fn.name}",
                "column": "column_0",
                "status": "covered" if covered else "not_applicable",
                "vector_id": COVERED[fn.name] if covered else None,
                "note": "" if covered else coverage_note(fn),
            }
        )
    covered_count = sum(row["status"] == "covered" for row in rows)
    if covered_count != len(COVERED):
        raise SystemExit("covered count drifted")
    return rows


def payload_strings(node: Any) -> list[str]:
    found: list[str] = []
    if isinstance(node, dict):
        for key, value in node.items():
            if key == "payload":
                found.extend(collect_strings(value))
            else:
                found.extend(payload_strings(value))
    elif isinstance(node, list):
        for item in node:
            found.extend(payload_strings(item))
    return found


def collect_strings(node: Any) -> list[str]:
    if isinstance(node, str):
        return [node] if node else []
    if isinstance(node, dict):
        found: list[str] = []
        for value in node.values():
            found.extend(collect_strings(value))
        return found
    if isinstance(node, list):
        found = []
        for item in node:
            found.extend(collect_strings(item))
        return found
    return []


def dump(doc: Any, banned_payload: list[str]) -> str:
    text = json.dumps(doc, indent=2, ensure_ascii=False) + "\n"
    if "\r" in text or _SBP.search(text):
        raise SystemExit("refusing CR or sbp hash in JSON")
    if "02694d5" in text or SEAM_REGION in text or SEAM_DETERMINISM in text or SEAM_CODEC in text:
        raise SystemExit("refusing banned sentence in JSON")
    if '"t": "bool"' in text:
        raise SystemExit("refusing a tagged bool in JSON")
    if '"payload"' in text:
        raise SystemExit("refusing a payload field in JSON")
    for banned in _BANNED_PATH:
        if banned in text:
            raise SystemExit(f"refusing path fragment in JSON: {banned}")
    for item in banned_payload:
        if item and item in text:
            raise SystemExit("refusing fixture payload content in JSON")
    return text


def write_text(path: Path, text: str) -> None:
    path.write_bytes(text.encode("utf-8"))


def confirm_docs_and_abstention() -> None:
    docs = git_show_bytes(
        f"{PYTHON_COMMIT}:docs/recipes/duplicate-projection-removal.md"
    ).decode("utf-8")
    if "duplicate-projection-removal" not in docs or "SL104" not in docs:
        raise SystemExit("pin recipe doc drifted")
    if "recipe_projection_removal.json" not in docs:
        raise SystemExit("pin recipe doc lost the fixture")
    text = git_show_bytes(f"{PYTHON_COMMIT}:{ABSTENTION_FILE}").decode("utf-8")
    if "def test_region_functions_totality_fuzz" not in text:
        raise SystemExit("pin totality test missing")
    if "affected_region_duplicate_projection_removal" not in text:
        raise SystemExit("pin abstention file lost the region function")
    if "parametrize" not in text:
        raise SystemExit("pin totality test is not a sweep")
    if (
        "def test_duplicate_projection_removal_disjoint_from_intermediate_mutating_tool"
        not in text
    ):
        raise SystemExit("pin disjoint removal test missing")


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    confirm_docs_and_abstention()
    test_text = git_show_bytes(f"{PYTHON_COMMIT}:{TEST_FILE}").decode("utf-8")
    fixture = json.loads(git_show_bytes(f"{PYTHON_COMMIT}:{FIXTURE}").decode("utf-8"))
    banned_payload = payload_strings(fixture)
    if not banned_payload:
        raise SystemExit("fixture payload strings missing")
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/recipes_conservative.py")
    py_sha = hashlib.sha256(py_blob).hexdigest()
    mod = load_mod()
    prove_shapes(test_text)
    prove_payload_gap(mod, test_text)
    prove_bool_gap(mod)
    recipe = recipe_vector(mod)
    extras = extra_refusals(mod)
    if COVERED:
        raise SystemExit("covered map must stay empty")
    vectors = [recipe, *extras]
    doc = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_conservative_py_sha256": py_sha,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = dump(doc, banned_payload)
    write_text(OUT / "vectors.json", payload)
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    rows = discover_coverage(test_text)
    coverage = {
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "test_file": TEST_FILE,
        "covered_count": sum(row["status"] == "covered" for row in rows),
        "not_applicable_count": sum(row["status"] == "not_applicable" for row in rows),
        "rows": rows,
    }
    if coverage["covered_count"] != 0 or coverage["not_applicable_count"] != PINNED_TEST_COUNT:
        raise SystemExit("coverage counts drifted")
    write_text(OUT / "coverage.json", dump(coverage, banned_payload))
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic duplicate-projection-removal parity. Refusal messages "
            "come from the pinned blob. Fixture output, payload fingerprints, "
            "and planner results stay uncovered. No fixture diff is stored."
        ),
        "generator": GENERATOR,
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "PROVENANCE.json", dump(provenance, banned_payload))
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_conservative_py_sha256": py_sha,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": GENERATOR,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "manifest.json", dump(manifest, banned_payload))
    print(
        f"{len(vectors)} {digest} covered={coverage['covered_count']} "
        f"not_applicable={coverage['not_applicable_count']} py={py_sha}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
