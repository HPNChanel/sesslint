class CheckoutImportRefused(Exception):
    """A sesslint import missed the pin and must not fall through to the checkout."""


class _PinOnly(importlib.abc.MetaPathFinder):
    """Reject any sesslint import that was not already executed from the pin."""

    def find_spec(
        self,
        fullname: str,
        path: object = None,
        target: object = None,
    ) -> None:
        del path, target
        if fullname == "sesslint" or fullname.startswith("sesslint."):
            raise CheckoutImportRefused(fullname)
        return None


def git_show_bytes(rev_path: str) -> bytes:
    if "02694d5" in rev_path:
        raise SystemExit("refusing 02694d5")
    if not rev_path.startswith(f"{PYTHON_COMMIT}:"):
        raise SystemExit("git show is limited to the pin")
    return subprocess.check_output(["git", "show", rev_path], cwd=ROOT)


def fullname_for(path: str) -> str:
    return path.removeprefix("src/").removesuffix(".py").replace("/", ".")


def ensure_pkg(name: str) -> None:
    if name not in sys.modules:
        mod = types.ModuleType(name)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[name] = mod


def exec_blob(blob: bytes, fullname: str) -> types.ModuleType:
    fd, tmp = tempfile.mkstemp(suffix=".py")
    try:
        os.write(fd, blob)
        os.close(fd)
        fd = -1
        spec = importlib.util.spec_from_file_location(fullname, tmp)
        if spec is None or spec.loader is None:
            raise SystemExit(f"spec failed {fullname}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[fullname] = mod
        spec.loader.exec_module(mod)
    finally:
        if fd >= 0:
            os.close(fd)
        Path(tmp).unlink(missing_ok=True)
    parent = fullname.rsplit(".", 1)[0] if "." in fullname else ""
    if parent:
        parent_mod = sys.modules.setdefault(parent, types.ModuleType(parent))
        setattr(parent_mod, fullname.split(".")[-1], mod)
    file_name = getattr(mod, "__file__", None)
    if not isinstance(file_name, str):
        raise SystemExit(f"{fullname} has no temp file")
    resolved = Path(file_name).resolve()
    if resolved == ROOT or ROOT in resolved.parents:
        raise SystemExit(f"{fullname} loaded from the checkout")
    return mod


def assert_pin_modules() -> None:
    temp_root = str(Path(tempfile.gettempdir())).lower()
    for name, mod in sys.modules.items():
        if name != "sesslint" and not name.startswith("sesslint."):
            continue
        file = getattr(mod, "__file__", None)
        if file is None:
            continue
        if not str(file).lower().startswith(temp_root):
            raise SystemExit(f"non-pin module {name}")


def load_mod() -> Any:
    sys.dont_write_bytecode = True
    blocked = {str(ROOT), str(ROOT / "src"), "", "."}
    sys.path[:] = [item for item in sys.path if item not in blocked]
    sys.meta_path.insert(0, _PinOnly())
    for rel in PIN_CLOSURE:
        if rel == "repair/recipes_sl002.py":
            continue
        path = f"src/sesslint/{rel}"
        blob = git_show_bytes(f"{PYTHON_COMMIT}:{path}")
        fullname = fullname_for(path)
        parts = fullname.split(".")
        for index in range(1, len(parts)):
            ensure_pkg(".".join(parts[:index]))
        exec_blob(blob, fullname)
    ensure_pkg("sesslint.repair")
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/recipes_sl002.py")
    mod = exec_blob(py_blob, MODULE)
    assert_pin_modules()
    if mod.apply_torn_terminal_record_discard.__module__ != MODULE:
        raise SystemExit("apply function is not the pin blob")
    return mod


def tagged(value: Any) -> dict[str, Any]:
    if value is None:
        return {"t": "null"}
    if type(value) is bool:
        return {"t": "bool", "v": value}
    if type(value) is int:
        return {"t": "int", "v": value}
    if isinstance(value, str):
        return {"t": "str", "v": value}
    if isinstance(value, float):
        return {"t": "float", "v": value}
    if isinstance(value, dict):
        return {
            "t": "map",
            "entries": [[key, tagged(inner)] for key, inner in value.items()],
        }
    if isinstance(value, (list, tuple)):
        return {"t": "list", "items": [tagged(inner) for inner in value]}
    raise SystemExit(f"unencodable {type(value)!r}")


def require_bool(label: str, value: Any) -> bool:
    if type(value) is not bool:
        raise SystemExit(f"{label} is not a bool")
    return value


def test_functions(text: str) -> list[ast.FunctionDef | ast.AsyncFunctionDef]:
    found: list[ast.FunctionDef | ast.AsyncFunctionDef] = []
    for node in ast.walk(ast.parse(text)):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            if node.name.startswith("test_"):
                found.append(node)
    return found


def function_named(text: str, name: str) -> ast.AST:
    for node in test_functions(text):
        if node.name == name:
            return node
    raise SystemExit(f"missing {name}")


def call_names(fn: ast.AST) -> list[str]:
    names: list[str] = []
    for node in ast.walk(fn):
        if not isinstance(node, ast.Call):
            continue
        if isinstance(node.func, ast.Name):
            names.append(node.func.id)
        elif isinstance(node.func, ast.Attribute):
            names.append(node.func.attr)
    return names


def string_constants(fn: ast.AST) -> set[str]:
    found: set[str] = set()
    for node in ast.walk(fn):
        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            found.add(node.value)
        elif isinstance(node, ast.Name):
            found.add(node.id)
        elif isinstance(node, ast.Attribute):
            found.add(node.attr)
    return found


def has_pytest_raises(fn: ast.AST) -> bool:
    for node in ast.walk(fn):
        if not isinstance(node, ast.With):
            continue
        for item in node.items:
            call = item.context_expr
            if isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute):
                if call.func.attr == "raises":
                    return True
    return False


def has_except(fn: ast.AST) -> bool:
    return any(isinstance(node, ast.ExceptHandler) for node in ast.walk(fn))


def content_strings(node: Any) -> list[str]:
    found: list[str] = []
    if isinstance(node, dict):
        for key, value in node.items():
            if key in CONTENT_KEYS:
                found.extend(collect_strings(value))
            else:
                found.extend(content_strings(value))
    elif isinstance(node, list):
        for item in node:
            found.extend(content_strings(item))
    return found


def collect_strings(node: Any) -> list[str]:
    if isinstance(node, str):
        return [node] if node else []
    if isinstance(node, dict):
        found: list[str] = []
        for value in node.values():
            found.extend(collect_strings(value))
        return found
    if isinstance(node, list):
        found = []
        for item in node:
            found.extend(collect_strings(item))
        return found
    return []


def const_strings(node: ast.AST) -> list[str]:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return [node.value] if node.value else []
    if isinstance(node, ast.JoinedStr):
        found: list[str] = []
        for value in node.values:
            found.extend(const_strings(value))
        return found
    if isinstance(node, ast.Dict):
        found = []
        for value in node.values:
            if value is not None:
                found.extend(const_strings(value))
        return found
    if isinstance(node, (ast.List, ast.Tuple, ast.Set)):
        found = []
        for value in node.elts:
            found.extend(const_strings(value))
        return found
    return []


def payload_literals(text: str) -> list[str]:
    found: list[str] = []
    for node in ast.walk(ast.parse(text)):
        if isinstance(node, ast.keyword) and node.arg == "payload":
            found.extend(const_strings(node.value))
    return found


def reject_payload(events: list[dict[str, Any]]) -> None:
    for item in events:
        if "payload" in item:
            raise SystemExit("refusing payload content in a stored vector")
        event_id = item.get("id")
        if not isinstance(event_id, str) or not event_id.startswith("evt-"):
            raise SystemExit("stored id drifted")


def ev(event_id: str, seq: int | None = None) -> dict[str, Any]:
    row: dict[str, Any] = {"id": event_id, "kind": "message"}
    if seq is not None:
        row["seq"] = seq
    return row


def run_apply(mod: Any, events: list[Any], target: Any, params: Any) -> tuple[str, Any]:
    step = SimpleNamespace(target_index=target, params=params)
    try:
        out = mod.apply_torn_terminal_record_discard(events, step)
    except IndexError as exc:
        return ("IndexError", str(exc))
    except Exception as exc:
        return (type(exc).__name__, str(exc))
    if not isinstance(out, list):
        raise SystemExit("pin success is not a list")
    rows: list[dict[str, Any]] = []
    for item in out:
        if not isinstance(item, dict):
            raise SystemExit("pin event is not a dict")
        rows.append(dict(item))
    return ("ok", rows)


def step_doc(target: Any, params: Any) -> dict[str, Any]:
    if params == "not_mapping":
        encoded: dict[str, Any] = {"t": "not_mapping"}
    elif isinstance(params, list):
        encoded = {
            "t": "map",
            "entries": [[key, tagged(value)] for key, value in params],
        }
    else:
        encoded = tagged(params)
    if target == "other":
        target_doc: dict[str, Any] = {"t": "other"}
    else:
        target_doc = tagged(target)
    return {"target_index": target_doc, "params": encoded}


def pin_params(params: Any) -> Any:
    if params == "not_mapping":
        return "not-a-mapping"
    if isinstance(params, list):
        folded: dict[str, Any] = {}
        for key, value in params:
            folded[key] = value
        return folded
    return params


def pin_target(target: Any) -> Any:
    if target == "other":
        return "synthetic-scalar"
    return target


def ok_vector(
    vector_id: str,
    events: list[dict[str, Any]],
    target: Any,
    params: Any,
    out: list[dict[str, Any]],
) -> dict[str, Any]:
    reject_payload(events)
    reject_payload(out)
    return {
        "id": vector_id,
        "construct": {
            "type": "apply_ok",
            "fn": FN,
            "entire_test": False,
            "assert_count": 1,
            "events": [tagged(event) for event in events],
            "step": step_doc(target, params),
        },
        "expected": {
            "mode": "ok",
            "events_out": [tagged(event) for event in out],
        },
    }


def index_vector(
    vector_id: str,
    events: list[dict[str, Any]],
    target: Any,
    params: Any,
    message: str,
) -> dict[str, Any]:
    reject_payload(events)
    if message != POP_MESSAGE:
        raise SystemExit(f"{vector_id} is not the empty pop")
    return {
        "id": vector_id,
        "construct": {
            "type": "apply_index_error",
            "fn": FN,
            "entire_test": False,
            "assert_count": 1,
            "events": [tagged(event) for event in events],
            "step": step_doc(target, params),
        },
        "expected": {
            "mode": "index_error",
            "error_type": "IndexError",
            "message": message,
        },
    }


def recipe_vector(mod: Any) -> dict[str, Any]:
    recipe = mod.RECIPE_TORN_TERMINAL_RECORD_DISCARD
    codes = sys.modules["sesslint.codes"]
    if recipe.name != RECIPE:
        raise SystemExit("pin recipe name mismatch")
    if recipe.apply is not mod.apply_torn_terminal_record_discard:
        raise SystemExit("pin apply is not the recipe apply")
    if recipe.affected_region is not mod.affected_region_torn_terminal_record_discard:
        raise SystemExit("pin region callable drifted")
    handles = [item for item in recipe.handles]
    preconditions = [item for item in recipe.preconditions]
    if handles != [codes.SL002] or codes.SL002 != "SL002":
        raise SystemExit("pin handles drifted")
    if preconditions != ["no_sl203", "torn_terminal_record"]:
        raise SystemExit("pin preconditions drifted")
    if recipe.min_policy != "conservative" or recipe.version != "1.0.0":
        raise SystemExit("pin recipe policy drifted")
    if recipe.lossy or recipe.salvage_only or recipe.excludes_execution_dependence:
        raise SystemExit("pin recipe flags drifted")
    return {
        "id": "recipe_torn_terminal_record_discard",
        "construct": {
            "type": "recipe_constant",
            "fn": "RECIPE_TORN_TERMINAL_RECORD_DISCARD",
            "entire_test": False,
        },
        "expected": {
            "mode": "recipe",
            "name": recipe.name,
            "handles": handles,
            "preconditions": preconditions,
            "lossy": require_bool("lossy", recipe.lossy),
            "salvage_only": require_bool("salvage_only", recipe.salvage_only),
            "min_policy": recipe.min_policy,
            "version": recipe.version,
            "excludes_execution_dependence": require_bool(
                "excludes_execution_dependence",
                recipe.excludes_execution_dependence,
            ),
            "apply_present": require_bool("apply_present", recipe.apply is not None),
            "affected_region_present": require_bool(
                "affected_region_present",
                recipe.affected_region is not None,
            ),
        },
    }


def require_ok(
    mod: Any,
    label: str,
    events: list[dict[str, Any]],
    target: Any,
    params: Any,
) -> list[dict[str, Any]]:
    kind, value = run_apply(mod, events, pin_target(target), pin_params(params))
    if kind != "ok":
        raise SystemExit(f"{label} did not return Ok")
    reject_payload(value)
    return value


def require_pop(
    mod: Any,
    label: str,
    events: list[dict[str, Any]],
    target: Any,
    params: Any,
) -> str:
    kind, value = run_apply(mod, events, pin_target(target), pin_params(params))
    if kind != "IndexError" or value != POP_MESSAGE:
        raise SystemExit(f"{label} was not the empty pop")
    return value


def stored_vectors(mod: Any) -> list[dict[str, Any]]:
    rows = [ev("evt-a", 0), ev("evt-b", 1)]
    three = [ev("evt-a", 0), ev("evt-b", 1), ev("evt-c", 2)]
    same = [ev("evt-same"), ev("evt-same")]
    single = [ev("evt-only")]
    cases: list[tuple[str, list[dict[str, Any]], Any, Any, str]] = [
        ("discard_named_last", three, 2, {"cut_index": 2}, "discard"),
        ("reader_minted_keeps", [ev("evt-a"), ev("evt-torn")], None, {"cut_index": 1}, "keep"),
        ("shared_id_discards_last", same, 1, {"cut_index": 1}, "discard"),
        ("shared_id_index_zero_keeps", same, 0, {"cut_index": 0}, "keep"),
        ("bool_cut_keeps", rows, 1, {"cut_index": True}, "keep"),
        ("bool_true_discards_index_one", rows, True, {"cut_index": 1}, "discard"),
        ("bool_false_clears_singleton", single, False, {"cut_index": 0}, "clear"),
        ("bool_true_keeps_singleton", single, True, {"cut_index": 0}, "keep"),
        ("not_mapping_keeps", rows, 1, "not_mapping", "keep"),
        ("other_target_keeps", rows, "other", {"cut_index": 1}, "keep"),
        (
            "ignores_region_fallback",
            rows,
            1,
            {"first_unsafe_index": 1},
            "keep",
        ),
        (
            "duplicate_cut_last_wins",
            rows,
            1,
            [("cut_index", 0), ("cut_index", 1)],
            "discard",
        ),
        ("float_cut_keeps", rows, 1, {"cut_index": 1.0}, "keep"),
        ("string_cut_keeps", rows, 1, {"cut_index": "1"}, "keep"),
        ("list_cut_keeps", rows, 1, {"cut_index": [1]}, "keep"),
        ("cut_past_end_keeps", rows, 9, {"cut_index": 9}, "keep"),
        ("negative_cut_keeps", rows, -2, {"cut_index": -2}, "keep"),
        ("target_mismatch_keeps", three, 1, {"cut_index": 2}, "keep"),
        ("missing_cut_keeps", rows, 1, {}, "keep"),
        ("null_cut_keeps", rows, 1, {"cut_index": None}, "keep"),
        ("empty_no_cut_keeps", [], None, "not_mapping", "empty"),
        ("empty_zero_is_not_pop", [], 0, {"cut_index": 0}, "empty"),
        ("other_target_empty_is_not_pop", [], "other", {"cut_index": -1}, "empty"),
    ]
    vectors: list[dict[str, Any]] = []
    for vector_id, events, target, params, expect in cases:
        out = require_ok(mod, vector_id, events, target, params)
        if expect == "keep" and out != events:
            raise SystemExit(f"{vector_id} discarded")
        if expect == "discard" and out != events[:-1]:
            raise SystemExit(f"{vector_id} did not drop only the last event")
        if expect == "clear" and out != []:
            raise SystemExit(f"{vector_id} did not clear the singleton")
        if expect == "empty" and out != []:
            raise SystemExit(f"{vector_id} did not stay empty")
        vectors.append(ok_vector(vector_id, events, target, params, out))
    message = require_pop(mod, "empty_pop", [], -1, {"cut_index": -1})
    vectors.append(index_vector("empty_pop", [], -1, {"cut_index": -1}, message))
    return vectors


def prove_unclaimed(mod: Any) -> None:
    canon = sys.modules["sesslint.canonical"]
    session = canon.SessionEvent(
        id="evt-kept",
        parent_id=None,
        seq=0,
        ts=TS,
        actor="user",
        kind="message",
    )
    kind, value = run_apply(mod, [session], 0, {"cut_index": 0})
    if kind != "ok" or value != []:
        raise SystemExit("pin SessionEvent discard did not succeed")
    kept_kind, kept = run_apply(mod, [session, ev("evt-b")], None, {"cut_index": 1})
    if kept_kind != "ok" or [item.get("id") for item in kept] != ["evt-kept", "evt-b"]:
        raise SystemExit("pin SessionEvent keep did not succeed")
    del kept
    float_kind, floated = run_apply(mod, [ev("evt-a"), ev("evt-b")], 1.0, {"cut_index": 1})
    if float_kind != "ok" or [item.get("id") for item in floated] != ["evt-a"]:
        raise SystemExit("pin float target did not discard")
    del floated
    empty_kind, empty_message = run_apply(mod, [], -1.0, {"cut_index": -1})
    if empty_kind != "IndexError" or empty_message != POP_MESSAGE:
        raise SystemExit("pin float target on empty was not IndexError")
    del empty_message
    bare = SimpleNamespace(params={"cut_index": 1})
    try:
        mod.apply_torn_terminal_record_discard([ev("evt-a"), ev("evt-b")], bare)
    except AttributeError:
        pass
    else:
        raise SystemExit("pin missing target_index did not raise")
    for alien in ("abc", 7):
        alien_kind, _alien_message = run_apply(mod, [alien], 0, {"cut_index": 0})
        if alien_kind not in {"ValueError", "TypeError"}:
            raise SystemExit("pin dict fallback did not raise")
        del _alien_message


def prove_fixture(fixture_bytes: bytes, expectations: dict[str, Any]) -> list[str]:
    if b"\r" in fixture_bytes or b"payload" in fixture_bytes:
        raise SystemExit("fixture bytes drifted")
    lines = fixture_bytes.splitlines()
    if len(lines) != 3 or lines[-1].endswith(b"}"):
        raise SystemExit("fixture shape drifted")
    banned: list[str] = [lines[-1].decode("utf-8")]
    for line in lines[:-1]:
        item = json.loads(line)
        if not isinstance(item, dict) or "payload" in item or "message" not in item:
            raise SystemExit("fixture record drifted")
        banned.extend(content_strings(item))
    spec = expectations.get("torn_final.jsonl")
    if not isinstance(spec, dict):
        raise SystemExit("expectations lost torn_final")
    if spec.get("code") != "SL002" or spec.get("repairable") is not True:
        raise SystemExit("torn_final expectations drifted")
    description = spec.get("description")
    if isinstance(description, str) and description:
        banned.append(description)
    return banned


def prove_shapes(blobs: dict[str, str]) -> None:
    if list(NOTES) != [item["test"] for item in SHAPES]:
        raise SystemExit("shape order drifted")
    for shape in SHAPES:
        test_id = shape["test"]
        rel, name = test_id.split("::", 1)
        fn = function_named(blobs[rel], name)
        names = call_names(fn)
        constants = string_constants(fn)
        source = ast.get_source_segment(blobs[rel], fn) or ""
        tokens = set(names) | constants
        for call in shape["calls"]:
            if call not in tokens and call not in source:
                raise SystemExit(f"{name} lost {call}")
        for needle in shape["strings"]:
            if needle not in tokens and needle not in source:
                raise SystemExit(f"{name} lost {needle}")
        for needle in shape["absent"]:
            if needle in tokens:
                raise SystemExit(f"{name} gained {needle}")
        if has_pytest_raises(fn) != shape["raises"]:
            raise SystemExit(f"{name} raises drifted")
        if shape.get("except") and not has_except(fn):
            raise SystemExit(f"{name} lost its handler")
        if FN in names:
            raise SystemExit(f"{name} calls {FN} directly")


def confirm_docs() -> None:
    docs = git_show_bytes(f"{PYTHON_COMMIT}:{DOCS}").decode("utf-8")
    for needle in (RECIPE, "SL002", "no_sl203", "torn_terminal_record", FIXTURE):
        if needle not in docs:
            raise SystemExit(f"pin recipe doc lost {needle}")


def discover_coverage() -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for test_id in NOTES:
        rows.append(
            {
                "test": test_id,
                "column": "column_0",
                "status": "not_applicable",
                "vector_id": None,
                "note": NOTES[test_id],
            }
        )
    return rows


def leaks_content(text: str, item: str) -> bool:
    if len(item) >= 8 and item in text:
        return True
    distinctive = any(ch.isspace() or not ch.isalnum() for ch in item)
    if distinctive and len(item) >= 4 and item in text:
        return True
    return len(item) >= 4 and f'"{item}"' in text


def dump(doc: Any, banned_content: list[str]) -> str:
    text = json.dumps(doc, indent=2, ensure_ascii=False) + "\n"
    if "\r" in text or _SBP.search(text):
        raise SystemExit("refusing CR or sbp hash in JSON")
    if "02694d5" in text:
        raise SystemExit("refusing the wrong pin in JSON")
    if "0 diff" in text:
        raise SystemExit("refusing a zero-diff claim in JSON")
    for seam in _SEAMS:
        if seam in text:
            raise SystemExit("refusing a seam sentence in JSON")
    if '"payload"' in text:
        raise SystemExit("refusing a payload field in JSON")
    for banned in _BANNED_PATH:
        if banned in text:
            raise SystemExit("refusing a path fragment in JSON")
    allow = {
        RECIPE,
        FN,
        "SL002",
        "no_sl203",
        "torn_terminal_record",
        "seq-renumber",
        "IndexError",
        POP_MESSAGE,
        MODULE,
        SCHEMA,
        PYTHON_COMMIT,
        GENERATOR,
        FIXTURE,
    }
    for item in banned_content:
        if not item or item in allow:
            continue
        if leaks_content(text, item):
            digest = hashlib.sha256(item.encode("utf-8")).hexdigest()
            raise SystemExit(f"refusing content length {len(item)} sha {digest}")
    return text


def write_text(path: Path, text: str) -> None:
    path.write_bytes(text.encode("utf-8"))


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    confirm_docs()
    files = sorted({item["test"].split("::", 1)[0] for item in SHAPES})
    blobs = {rel: git_show_bytes(f"{PYTHON_COMMIT}:{rel}").decode("utf-8") for rel in files}
    prove_shapes(blobs)
    fixture_bytes = git_show_bytes(f"{PYTHON_COMMIT}:{FIXTURE}")
    expectations = json.loads(git_show_bytes(f"{PYTHON_COMMIT}:{EXPECTATIONS}"))
    banned = prove_fixture(fixture_bytes, expectations)
    for text in blobs.values():
        banned.extend(payload_literals(text))
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/recipes_sl002.py")
    py_sha = hashlib.sha256(py_blob).hexdigest()
    if py_sha != KNOWN_PY_SHA:
        raise SystemExit("recipes_sl002.py sha drifted")
    mod = load_mod()
    prove_unclaimed(mod)
    recipe = recipe_vector(mod)
    vectors = [recipe, *stored_vectors(mod)]
    if any(item["construct"]["entire_test"] for item in vectors):
        raise SystemExit("entire_test must stay false")
    if sum(item["expected"]["mode"] == "index_error" for item in vectors) != 1:
        raise SystemExit("EmptyPop must be one vector")
    doc = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_sl002_py_sha256": py_sha,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = dump(doc, banned)
    write_text(OUT / "vectors.json", payload)
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    rows = discover_coverage()
    coverage = {
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "test_file": "tests",
        "covered_count": 0,
        "not_applicable_count": len(rows),
        "rows": rows,
    }
    if len(rows) != len(NOTES) or coverage["not_applicable_count"] != len(NOTES):
        raise SystemExit("coverage counts drifted")
    write_text(OUT / "coverage.json", dump(coverage, banned))
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic torn-terminal-record-discard parity. Apply results "
            "come from the pinned blob. Plan results, fixture message text, "
            "and SessionEvent copies stay uncovered. No fixture diff is stored."
        ),
        "generator": GENERATOR,
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "PROVENANCE.json", dump(provenance, banned))
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "recipe": RECIPE,
        "python_commit": PYTHON_COMMIT,
        "recipes_sl002_py_sha256": py_sha,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": GENERATOR,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    write_text(OUT / "manifest.json", dump(manifest, banned))
    print(f"{len(vectors)} {digest} covered=0 not_applicable={len(rows)} py={py_sha}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
