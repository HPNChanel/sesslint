class CheckoutImportRefused(Exception):
    """A sesslint import missed the pin and must not fall through to the checkout."""


class _PinOnly(importlib.abc.MetaPathFinder):
    """Reject any sesslint import that was not already executed from the pin."""

    def find_spec(
        self,
        fullname: str,
        path: object = None,
        target: object = None,
    ) -> None:
        del path, target
        if fullname == "sesslint" or fullname.startswith("sesslint."):
            raise CheckoutImportRefused(fullname)
        return None


def git_show_bytes(rev_path: str) -> bytes:
    if "02694d5" in rev_path:
        raise SystemExit("refusing 02694d5")
    if not rev_path.startswith(f"{PYTHON_COMMIT}:"):
        raise SystemExit("git show is limited to the pin")
    return subprocess.check_output(["git", "show", rev_path], cwd=ROOT)


def fullname_for(path: str) -> str:
    return path.removeprefix("src/").removesuffix(".py").replace("/", ".")


def ensure_pkg(name: str) -> None:
    if name not in sys.modules:
        mod = types.ModuleType(name)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[name] = mod


def exec_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile.NamedTemporaryFile("wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp = handle.name
    spec = importlib.util.spec_from_file_location(fullname, tmp)
    if spec is None or spec.loader is None:
        raise SystemExit(f"spec failed {fullname}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[fullname] = mod
    try:
        spec.loader.exec_module(mod)
    finally:
        Path(tmp).unlink(missing_ok=True)
    parent = fullname.rsplit(".", 1)[0] if "." in fullname else ""
    if parent:
        parent_mod = sys.modules.setdefault(parent, types.ModuleType(parent))
        setattr(parent_mod, fullname.split(".")[-1], mod)
    file_name = getattr(mod, "__file__", None)
    if not isinstance(file_name, str):
        raise SystemExit(f"{fullname} has no temp file")
    resolved = Path(file_name).resolve()
    if resolved == ROOT or ROOT in resolved.parents:
        raise SystemExit(f"{fullname} loaded from the checkout")
    return mod


def assert_pin_modules() -> None:
    temp_root = str(Path(tempfile.gettempdir())).lower()
    for name, mod in sys.modules.items():
        if name != "sesslint" and not name.startswith("sesslint."):
            continue
        file = getattr(mod, "__file__", None)
        if file is None:
            continue
        if not str(file).lower().startswith(temp_root):
            raise SystemExit(f"non-pin module {name}")


def load_mod() -> Any:
    sys.dont_write_bytecode = True
    blocked = {str(ROOT), str(ROOT / "src"), "", "."}
    sys.path[:] = [item for item in sys.path if item not in blocked]
    sys.meta_path.insert(0, _PinOnly())
    rs = ROOT / "rust" / "crates" / "repair" / "src" / "recipes_salvage.rs"
    if hashlib.sha256(rs.read_bytes()).hexdigest() != RS_SHA:
        raise SystemExit("rs sha mismatch")
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/recipes_salvage.py")
    if hashlib.sha256(py_blob).hexdigest() != PY_SHA:
        raise SystemExit("py pin sha mismatch")
    for rel in PIN_CLOSURE:
        if rel == "repair/recipes_salvage.py":
            continue
        path = f"src/sesslint/{rel}"
        blob = git_show_bytes(f"{PYTHON_COMMIT}:{path}")
        fullname = fullname_for(path)
        parts = fullname.split(".")
        for index in range(1, len(parts)):
            ensure_pkg(".".join(parts[:index]))
        exec_blob(blob, fullname)
    ensure_pkg("sesslint.repair")
    mod = exec_blob(py_blob, MODULE)
    assert_pin_modules()
    if mod.apply_torn_record_excision.__module__ != MODULE:
        raise SystemExit("apply function is not the pin blob")
    if mod.sl001_excisable.__module__ != MODULE:
        raise SystemExit("precondition function is not the pin blob")
    return mod


def tagged(value: Any) -> dict[str, Any]:
    if value is None:
        return {"t": "null"}
    if type(value) is bool:
        return {"t": "bool", "v": value}
    if type(value) is int:
        return {"t": "int", "v": value}
    if isinstance(value, str):
        return {"t": "str", "v": value}
    if isinstance(value, float):
        raise SystemExit("float is not a pinned scalar in this set")
    if isinstance(value, dict):
        return {
            "t": "map",
            "entries": [[key, tagged(inner)] for key, inner in value.items()],
        }
    if isinstance(value, (list, tuple)):
        return {"t": "list", "items": [tagged(inner) for inner in value]}
    raise SystemExit(f"unencodable {type(value)!r}")


def session_tagged(event: Any) -> dict[str, Any]:
    payload = event.payload
    if not isinstance(payload, dict):
        payload = dict(payload)
    return {
        "t": "session",
        "id": event.id,
        "parent_id": tagged(event.parent_id),
        "seq": tagged(event.seq),
        "ts": event.ts,
        "actor": event.actor,
        "kind": event.kind,
        "payload": tagged(payload),
    }


def test_functions(text: str) -> list[ast.FunctionDef]:
    tree = ast.parse(text)
    return [
        node
        for node in tree.body
        if isinstance(node, ast.FunctionDef) and node.name.startswith("test_")
    ]


def helper_source(text: str) -> str:
    tree = ast.parse(text)
    wanted = {"_TORN_EVIDENCE", "_ev", "_sl001_finding", "_ctx"}
    parts = ["from __future__ import annotations"]
    for node in tree.body:
        name = ""
        if isinstance(node, ast.Assign) and len(node.targets) == 1:
            target = node.targets[0]
            if isinstance(target, ast.Name):
                name = target.id
        elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
            name = node.target.id
        elif isinstance(node, ast.FunctionDef):
            name = node.name
        if name not in wanted:
            continue
        segment = ast.get_source_segment(text, node)
        if segment is None:
            raise SystemExit(f"missing source for {name}")
        parts.append(segment)
        wanted.remove(name)
    if wanted:
        raise SystemExit(f"pin helpers missing {sorted(wanted)}")
    return "\n\n".join(parts) + "\n"


def load_helpers(text: str) -> dict[str, Any]:
