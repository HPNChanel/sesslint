#!/usr/bin/env python3
"""Generate sesslint.cli.outcome parity vectors from pinned blobs (stdlib only)."""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import re
import subprocess
import sys
import tempfile
import types
from argparse import ArgumentTypeError
from contextlib import contextmanager
from pathlib import Path as FsPath
from typing import Any, Iterator

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "02694d537104659df66cdd084354739f3cccc440"
OUTCOME_PY_SHA256 = (
    "ad73e1f3e61a981a442bffa6df20b660d1c590568bf85314b3868c29447f0bec"
)
OUTCOME_RS_SHA256 = (
    "95df454d4d8b81995e1903387db1cde0d3b251e526e9040baf751924eecaaa2f"
)
MODULE = "sesslint.cli.outcome"
DEFAULT_MAX_FILE_BYTES = 100 * 1024 * 1024

GAP_PARSE_INSTANT = "GAP-cli-outcome-parse-instant"
GAP_OUTCOME_RUNTIME = "GAP-cli-outcome-runtime"
RUST_INSTANT = "sesslint.outcome.snapshot.parse_instant is not available"
RUST_RUN = "sesslint.outcome evaluation/report/load exports are not available"

KNOWN_PARITY_GAPS = [
    (
        f"{GAP_PARSE_INSTANT}: Python `_instant` imports "
        "`sesslint.outcome.snapshot.parse_instant` before validating text; Rust "
        f"`instant()` returns Display `{RUST_INSTANT}` before reading inputs."
    ),
    (
        f"{GAP_OUTCOME_RUNTIME}: Python `run` imports `sesslint.outcome` "
        "evaluation/load/report exports before contract or snapshot I/O; Rust "
        f"`run()` returns Display `{RUST_RUN}` before args or context use. "
        "No exit code or emit_text parity is claimed."
    ),
]

_BANNED_PAT = re.compile(
    rb"(?:sk_live_|sk_test_|rk_live_|rk_test_|sbp_[0-9a-f]{40}|sesslint-wt-|FOR_WORK)"
)


def repo_root() -> FsPath:
    return FsPath(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def verify_digest(blob: bytes, expected: str, label: str) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != expected:
        raise SystemExit(f"{label} pin sha256 mismatch: expected {expected}, got {digest}")


def exec_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile_named_blob(blob) as tmp_path:
        spec = importlib.util.spec_from_file_location(fullname, tmp_path)
        if spec is None or spec.loader is None:
            raise SystemExit(f"failed to create import spec for {fullname}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[fullname] = mod
        spec.loader.exec_module(mod)
        return mod


@contextmanager
def tempfile_named_blob(blob: bytes) -> Iterator[str]:
    with tempfile.NamedTemporaryFile(mode="wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp_path = handle.name
    try:
        yield tmp_path
    finally:
        FsPath(tmp_path).unlink(missing_ok=True)


class _Ctx:
    def __init__(self) -> None:
        self.errors: list[str] = []

    def error(self, message: str) -> None:
        self.errors.append(message)


def install_package_tree() -> None:
    pkg = types.ModuleType("sesslint")
    pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint"] = pkg

    io_mod = types.ModuleType("sesslint.io")
    io_mod.DEFAULT_MAX_FILE_BYTES = DEFAULT_MAX_FILE_BYTES
    sys.modules["sesslint.io"] = io_mod
    pkg.io = io_mod

    adapters = types.ModuleType("sesslint.adapters")
    adapters.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.adapters"] = adapters
    pkg.adapters = adapters

    detect = types.ModuleType("sesslint.adapters.detect")
    detect.VALID_FORMAT_OPTIONS = frozenset(
        {
            "auto",
            "canonical",
            "claude-code-jsonl",
            "codex-rollout",
            "openai-agents",
        }
    )
    sys.modules["sesslint.adapters.detect"] = detect
    adapters.detect = detect

    cli_pkg = types.ModuleType("sesslint.cli")
    cli_pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.cli"] = cli_pkg
    pkg.cli = cli_pkg

    context = types.ModuleType("sesslint.cli._context")
    context.CliContext = _Ctx
    sys.modules["sesslint.cli._context"] = context
    cli_pkg._context = context

    common = types.ModuleType("sesslint.cli._common")

    def _output_format(_args: Any) -> str:
        return "human"

    common._output_format = _output_format
    sys.modules["sesslint.cli._common"] = common
    cli_pkg._common = common

    output_mod = types.ModuleType("sesslint.cli._output")

    def emit_text(
        _ctx: _Ctx,
        _args: Any,
        _text: str,
        *,
        inputs: tuple[Any, ...] = (),
        summary: str = "",
    ) -> None:
        _ = (inputs, summary)

    output_mod.emit_text = emit_text
    sys.modules["sesslint.cli._output"] = output_mod
    cli_pkg._output = output_mod

    options_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_options.py")
    options = exec_blob(options_blob, "sesslint.cli._options")
    sys.modules["sesslint.cli._options"] = options
    cli_pkg._options = options


def load_outcome_module() -> types.ModuleType:
    install_package_tree()
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/outcome.py")
    verify_digest(blob, OUTCOME_PY_SHA256, "cli/outcome.py")
    outcome = exec_blob(blob, "sesslint.cli.outcome")
    sys.modules["sesslint.cli"].outcome = outcome
    return outcome


def encode_action(action: argparse.Action) -> str:
    if action.const is True and action.nargs == 0:
        return "store_true"
    return "store"


def type_name(action: argparse.Action) -> str | None:
    if action.type is None:
        return None
    if hasattr(action.type, "__name__"):
        name = action.type.__name__
        if name == "Path":
            return "Path"
        if action.type is getattr(
            sys.modules.get("sesslint.cli._options"), "_validate_positive_int", None
        ):
            return "_validate_positive_int"
        if name == "_validate_positive_int":
            return "_validate_positive_int"
        if name == "_instant":
            return "_instant"
        return name
    return None


def pin_default_fields(dest: str) -> tuple[bool, Any] | None:
    """Match Rust outcome.rs configure() default_keyword and DefaultValue."""
    if dest in {"explain", "hash_keys", "all_conditions", "json"}:
        return (False, "false")
    if dest in {
        "as_of",
        "source_observed_at",
        "source_completeness",
        "source_origin",
        "target_observed_at",
        "target_completeness",
        "target_origin",
        "session",
        "output_format",
    }:
        return (True, "none")
    if dest in {"source", "target", "contract"}:
        return (False, "none")
    if dest == "max_file_bytes":
        return (True, {"int": DEFAULT_MAX_FILE_BYTES})
    return None


def encode_outcome_argument(action: argparse.Action) -> dict[str, Any]:
    if not action.option_strings:
        flags = [action.dest]
    else:
        flags = list(action.option_strings)
    choices = list(action.choices) if action.choices is not None else None
    override = pin_default_fields(action.dest)
    if override is not None:
        default_keyword, default = override
    elif action.const is True and action.default is False:
        default_keyword, default = False, "false"
    elif action.default is None and action.option_strings:
        default_keyword, default = True, "none"
    else:
        default_keyword, default = False, "none"
    required = bool(action.required)
    if action.dest == "contract":
        required = True
    return {
        "flags": flags,
        "dest": action.dest,
        "action": encode_action(action),
        "type_name": type_name(action),
        "choices": choices,
        "help": action.help,
        "default_keyword": default_keyword,
        "default": default,
        "required": required,
    }


def encode_report_output(action: argparse.Action) -> dict[str, Any]:
    return {
        "option_strings": list(action.option_strings),
        "dest": action.dest,
        "action": encode_action(action),
        "type_name": type_name(action),
        "metavar": action.metavar,
        "help": action.help,
        "default_keyword": {"present": "none"},
        "effective_default": "none",
    }


def configure_expected(outcome: types.ModuleType) -> dict[str, Any]:
    root = argparse.ArgumentParser(prog="sesslint")
    subparsers = root.add_subparsers()
    sub = outcome.configure(subparsers)

    subcommand_help = None
    for action in root._actions:
        if isinstance(action, argparse._SubParsersAction):
            for choice_action in action._choices_actions:
                if getattr(choice_action, "dest", None) == outcome.NAME:
                    subcommand_help = choice_action.help
                    break
    if subcommand_help is None:
        raise SystemExit("failed to introspect subcommand help from configure()")

    for field in (subcommand_help or "", sub.description or ""):
        if "\u2014" in field or "\u2013" in field:
            raise SystemExit("help/description must not contain U+2014 or U+2013")

    local: list[dict[str, Any]] = []
    report_output: list[dict[str, Any]] = []
    for action in sub._actions:
        if action.dest == "help":
            continue
        if action.dest == "output":
            report_output.append(encode_report_output(action))
            continue
        local.append(encode_outcome_argument(action))

    dest_to_index = {row["dest"]: index for index, row in enumerate(local)}
    for key in ("output_format", "json"):
        if key not in dest_to_index:
            raise SystemExit(f"missing {key} in local arguments")
    exclusive_group = [dest_to_index["output_format"], dest_to_index["json"]]

    return {
        "name": outcome.NAME,
        "help": subcommand_help or "",
        "description": sub.description or "",
        "arguments": local,
        "exclusive_group": exclusive_group,
        "report_output": report_output,
    }


def vector_specs() -> list[dict[str, Any]]:
    return [
        {"id": "configure_subcommand_declarations", "construct": {"type": "configure"}},
    ]


def build_expected(outcome: types.ModuleType, row: dict[str, Any]) -> dict[str, Any]:
    construct = row["construct"]
    kind = construct["type"]
    if kind == "configure":
        return configure_expected(outcome)
    if kind in {"run", "instant"}:
        raise SystemExit(
            f"{kind} vectors omitted for {row['id']} (outcome runtime import seams)"
        )
    raise SystemExit(f"unknown construct for {row['id']}")


def assert_payload_clean(payload: bytes) -> None:
    if _BANNED_PAT.search(payload):
        raise SystemExit("vectors.json contains banned marker")
    if b"\r" in payload:
        raise SystemExit("vectors.json must be LF-only")


def main() -> int:
    outcome = load_outcome_module()
    out_dir = FsPath(__file__).resolve().parent
    rs_path = repo_root() / "rust" / "crates" / "cli" / "src" / "outcome.rs"
    rs_digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if rs_digest != OUTCOME_RS_SHA256:
        raise SystemExit(
            f"outcome.rs sha256 mismatch: expected {OUTCOME_RS_SHA256}, got {rs_digest}"
        )

    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        expected = build_expected(outcome, row)
        vectors.append(
            {
                "id": row["id"],
                "construct": row["construct"],
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "outcome_py_sha256": OUTCOME_PY_SHA256,
        "outcome_rs_sha256": OUTCOME_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    payload_bytes = payload.encode("utf-8")
    assert_payload_clean(payload_bytes)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_bytes(payload_bytes)
    digest = hashlib.sha256(payload_bytes).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.cli.outcome configure declarations from pinned "
            "src/sesslint/cli/outcome.py (isolated exec stubs). Run and _instant "
            "vectors omitted where outcome runtime exports are unavailable."
        ),
        "generator": "rust/parity/vectors/cli.outcome/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    coverage = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": 0,
        "not_applicable_count": 0,
        "rows": [],
    }
    (out_dir / "coverage.json").write_text(
        json.dumps(coverage, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
