#!/usr/bin/env python3
"""Generate sesslint.cli._context parity vectors from the pinned worktree module (stdlib only)."""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import sys
from argparse import Namespace
from pathlib import Path
from typing import Any

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
CONTEXT_SHA256 = "333e2b5cc857a22387ed5f67e22806491ebdfdabaef970f006d97aff32253667"

SYNTHETIC_ERR = "synthetic-err"
SYNTHETIC_WARN = "synthetic-warn"
SYNTHETIC_INFO = "synthetic-info"
SYNTHETIC_DEBUG = "synthetic-debug"
SYNTHETIC_BAD_FORMAT = "synthetic-bad-format"
SYNTHETIC_SELECT = "synthetic-select"


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def load_context_module():
    root = repo_root()
    module_path = root / "src" / "sesslint" / "cli" / "_context.py"
    digest = hashlib.sha256(module_path.read_bytes()).hexdigest()
    if digest != CONTEXT_SHA256:
        raise SystemExit(
            f"_context.py sha256 mismatch: expected {CONTEXT_SHA256}, got {digest}"
        )
    src = root / "src"
    if str(src) not in sys.path:
        sys.path.insert(0, str(src))
    import sesslint.cli._context as context  # noqa: WPS433

    return context


def encode_default(value: object) -> dict[str, Any] | None:
    if value is None:
        return {"kind": "none"}
    if isinstance(value, bool):
        return {"kind": "bool", "value": value}
    if isinstance(value, int):
        return {"kind": "int", "value": value}
    if isinstance(value, str):
        return {"kind": "str", "value": value}
    raise TypeError(f"unsupported default {value!r}")


def encode_setting(setting: Any) -> dict[str, Any]:
    value = setting.value
    if value is None:
        encoded: object = None
    elif isinstance(value, bool):
        encoded = value
    elif isinstance(value, int):
        encoded = value
    else:
        encoded = str(value)
    return {"value": encoded, "source": setting.source}


def subparser_with_format_choices(choices: tuple[str, ...]) -> argparse.ArgumentParser:
    sub = argparse.ArgumentParser()
    sub.add_argument(
        "-f",
        "--format",
        dest="output_format",
        choices=list(choices),
    )
    return sub


def subparser_json_only() -> argparse.ArgumentParser:
    sub = argparse.ArgumentParser()
    sub.add_argument("--json", action="store_true")
    return sub


def subparser_no_format() -> argparse.ArgumentParser:
    sub = argparse.ArgumentParser()
    sub.add_argument(
        "--policy",
        dest="policy",
        choices=["conservative"],
    )
    return sub


def args_from_mapping(values: dict[str, Any]) -> Namespace:
    return Namespace(**values)


def build_expected(context: Any, spec: dict[str, Any]) -> dict[str, Any]:
    kind = spec["type"]
    if kind == "resolve_output_format":
        args = args_from_mapping(spec.get("args", {}))
        env = spec.get("env", {})
        sub_spec = spec.get("subparser")
        sub = None
        if sub_spec == "format_human_json_ndjson":
            sub = subparser_with_format_choices(("human", "json", "ndjson"))
        elif sub_spec == "format_human_json":
            sub = subparser_with_format_choices(("human", "json"))
        elif sub_spec == "json_only":
            sub = subparser_json_only()
        elif sub_spec == "no_format":
            sub = subparser_no_format()
        elif sub_spec is None:
            sub = None
        else:
            raise ValueError(f"unknown subparser spec: {sub_spec}")
        try:
            setting = context._resolve_output_format(args, env, None, sub)
        except Exception as err:  # noqa: BLE001 — parity harness
            from sesslint.cli._errors import CliError  # noqa: WPS433

            if not isinstance(err, CliError):
                raise
            return {
                "result": "error",
                "exit_code": err.exit_code,
                "message": err.message,
            }
        return {"result": "ok", "setting": encode_setting(setting)}

    if kind == "cli_supplied":
        args = args_from_mapping(spec["args"])
        name = spec["name"]
        supplied = context._cli_supplied(args, name)
        if supplied is None:
            return {"supplied": False, "value": None}
        return {"supplied": True, "value": supplied}

    if kind == "cli_context_channel":
        quiet = bool(spec["quiet"])
        verbose = bool(spec["verbose"])
        channel = spec["channel"]
        message = spec["message"]
        buf = io.StringIO()
        cli_ctx = context.CliContext(
            quiet=quiet,
            verbose=verbose,
            config_path=None,
            settings={},
            stderr=buf,
        )
        if channel == "error":
            cli_ctx.error(message)
        elif channel == "warn":
            cli_ctx.warn(message)
        elif channel == "info":
            cli_ctx.info(message)
        elif channel == "debug":
            cli_ctx.debug(message)
        else:
            raise ValueError(f"unknown channel: {channel}")
        return {"stderr": buf.getvalue()}

    if kind == "setting_specs":
        rows: list[dict[str, Any]] = []
        for name, env_var, cfg_key, default in context.SETTING_SPECS:
            rows.append(
                {
                    "name": name,
                    "env_var": env_var,
                    "config_key": cfg_key,
                    "default": encode_default(default),
                }
            )
        return {"rows": rows}

    if kind == "scoped_commands":
        out: dict[str, list[str]] = {}
        for key, commands in context._SCOPED_TO_COMMANDS.items():
            out[key] = sorted(commands)
        return {"commands": out}

    if kind == "format_choices":
        sub_spec = spec.get("subparser")
        sub = None
        if sub_spec == "format_human_json":
            sub = subparser_with_format_choices(("human", "json"))
        elif sub_spec == "json_only":
            sub = subparser_json_only()
        elif sub_spec == "no_format":
            sub = subparser_no_format()
        elif sub_spec is None:
            sub = None
        else:
            raise ValueError(f"unknown subparser spec: {sub_spec}")
        choices = context._format_choices(sub)
        if choices is None:
            return {"choices": None}
        return {"choices": list(choices)}

    if kind == "progress_callback":
        quiet = bool(spec["quiet"])
        verbose = bool(spec["verbose"])
        isatty = bool(spec["isatty"])
        args = args_from_mapping(spec.get("args", {}))
        buf = io.StringIO()
        buf.isatty = lambda: isatty  # type: ignore[attr-defined]
        cli_ctx = context.CliContext(
            quiet=quiet,
            verbose=verbose,
            config_path=None,
            settings={},
            stderr=buf,
        )
        cb = cli_ctx.progress_callback(args)
        if cb is None:
            return {"kind": "none"}
        if cb.__class__.__name__ == "TtyProgress":
            return {"kind": "tty"}
        return {"kind": "ndjson"}

    raise ValueError(f"unknown construct type: {kind}")


