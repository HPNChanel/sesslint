def build_expected_for_row(context: Any, row: dict[str, Any]) -> dict[str, Any]:
    construct = dict(row["construct"])
    if construct.get("type") == "cli_context_channel" and construct.get("channel") == "warn_then_info":
        quiet = bool(construct["quiet"])
        verbose = bool(construct["verbose"])
        buf = io.StringIO()
        cli_ctx = context.CliContext(
            quiet=quiet,
            verbose=verbose,
            config_path=None,
            settings={},
            stderr=buf,
        )
        cli_ctx.warn(SYNTHETIC_WARN)
        cli_ctx.info(SYNTHETIC_INFO)
        return {"stderr": buf.getvalue()}
    return build_expected(context, construct)


def main() -> int:
    context = load_context_module()
    out_dir = Path(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        expected = build_expected_for_row(context, row)
        vectors.append(
            {
                "id": row["id"],
                "construct": row["construct"],
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": "sesslint.cli._context",
        "python_commit": PYTHON_COMMIT,
        "context_py_sha256": CONTEXT_SHA256,
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    manifest = {
        "schema": SCHEMA,
        "module": "sesslint.cli._context",
        "python_commit": PYTHON_COMMIT,
        "context_py_sha256": CONTEXT_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/cli._context/generate",
        "known_gaps": [
            "build_context calls sesslint.config.load_config; Rust returns ContextError::Unsupported"
        ],
    }
    (out_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    provenance = {
        "contains_real_data": False,
        "description": "Synthetic cli._context setting resolution, stderr channels, and parser metadata parity.",
        "generator": "rust/parity/vectors/cli._context/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
