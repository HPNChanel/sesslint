                "version_norm": "1",
                "supported": True,
                "field": "version",
            },
            {
                "action": "observe_version",
                "version_norm": "2",
                "supported": True,
                "field": "version",
            },
            {"action": "observe_signature", "raw_type": {"kind": "str", "text": "summary"}},
            {
                "action": "observe_version",
                "version_norm": "9.9",
                "supported": False,
                "field": "version",
            },
        ],
    )

    add_tracker(
        specs,
        "signature_foreign_turn_context",
        "claude-code-jsonl",
        [
            {"action": "observe_signature", "raw_type": {"kind": "str", "text": "turn_context"}},
            {"action": "observe_signature", "raw_type": {"kind": "str", "text": "summary"}},
