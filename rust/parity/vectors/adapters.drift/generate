#!/usr/bin/env python3
"""Generate sesslint.adapters.drift parity vectors (stdlib only; pinned git blobs)."""

from __future__ import annotations

import hashlib
import json
import re
import subprocess
import sys
import types
from pathlib import Path
from typing import Any, Final

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
DRIFT_PY_SHA256 = (
    "6f21b713e6c30d0729c08be3452480075350b6be698a43cf5835d8b6c61c2290"
)
DRIFT_RS_SHA256 = (
    "e456ecbac7b4f0ab647621a4f4ecf0cff05f7599700eb8710310c7e285b2e9f4"
)
MODULE = "sesslint.adapters.drift"

PIN_MODULES: Final[tuple[tuple[str, str], ...]] = (
    ("sesslint.errors", "src/sesslint/errors.py"),
    ("sesslint._version", "src/sesslint/_version.py"),
    ("sesslint.context", "src/sesslint/context.py"),
    ("sesslint.codes", "src/sesslint/codes.py"),
    ("sesslint.secret_families", "src/sesslint/secret_families.py"),
    ("sesslint.finding", "src/sesslint/finding.py"),
    ("sesslint.adapters.safe_value", "src/sesslint/adapters/safe_value.py"),
    ("sesslint.adapters.drift", "src/sesslint/adapters/drift.py"),
)

KNOWN_PARITY_GAPS: Final[tuple[str, ...]] = (
    "GAP-drift-finding-fingerprint: into_findings on a non-empty transition "
    "buffer calls make_finding, which needs sesslint.determinism.canonical_json_bytes. "
    "Rust stops at the missing fingerprint codec. Vectors compare tracker state and "
    "empty or suppressed flush only, not Python Finding objects.",
)

SYN_PATH = "syn-drift-parity-path"

_BANNED_LIVE_TEST = re.compile(
    rb"(?:^|[^A-Za-z])(sk|rk)_(?:live|test)_[A-Za-z0-9]{16}"
)
_BANNED_SUPABASE_PAT = re.compile(rb"sbp_[0-9a-f]{40}")


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
    )


def git_show_text(rev_path: str) -> str:
    return git_show_bytes(rev_path).decode("utf-8")


def verify_drift_py_pin() -> None:
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/adapters/drift.py")
    digest = hashlib.sha256(blob).hexdigest()
    if digest != DRIFT_PY_SHA256:
        raise SystemExit(
            f"drift.py pin sha256 mismatch: expected {DRIFT_PY_SHA256}, got {digest}"
        )


def verify_drift_rs_sha256() -> None:
    rs_path = repo_root() / "rust" / "crates" / "adapters" / "src" / "drift.rs"
    digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if digest != DRIFT_RS_SHA256:
        raise SystemExit(
            "adapters/src/drift.rs sha256 mismatch: "
            f"expected {DRIFT_RS_SHA256}, got {digest}"
        )


def load_pinned_drift() -> Any:
    verify_drift_py_pin()
    verify_drift_rs_sha256()
    for pkg in ("sesslint", "sesslint.adapters"):
        mod = types.ModuleType(pkg)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[pkg] = mod
    for mod_name, rel_path in PIN_MODULES:
        source = git_show_text(f"{PYTHON_COMMIT}:{rel_path}")
        compiled = compile(source, f"<pinned {rel_path}>", "exec")
        mod = types.ModuleType(mod_name)
        mod.__file__ = f"<pinned {rel_path}>"
        sys.modules[mod_name] = mod
        exec(compiled, mod.__dict__)  # noqa: S102
        parent_name, _, child = mod_name.rpartition(".")
        if parent_name:
            parent = sys.modules[parent_name]
            setattr(parent, child, mod)
    return sys.modules["sesslint.adapters.drift"]


def transition_row(transition: Any) -> dict[str, Any]:
    row: dict[str, Any] = {
        "kind": transition.kind,
        "previous": transition.previous,
        "observed": transition.observed,
        "field": transition.field,
        "observed_format": transition.observed_format,
        "line": transition.line,
        "record_id": transition.record_id,
        "record_ordinal": transition.record_ordinal,
        "byte_offset": transition.byte_offset,
        "byte_end": transition.byte_end,
    }
    return row


def tracker_state(tracker: Any) -> dict[str, Any]:
    return {
        "version_baseline": tracker._version_baseline,
        "sl301_seen": tracker._sl301_seen,
        "transition_count": len(tracker._transitions),
        "seen_count": len(tracker._seen),
        "transitions": [transition_row(t) for t in tracker._transitions],
    }


def flush_mode(tracker: Any, path: str) -> dict[str, Any]:
    if tracker._sl301_seen or not tracker._transitions:
        findings = tracker.into_findings(path_str=path)
        if findings:
            raise SystemExit("unexpected Python findings on empty or suppressed flush")
        return {"mode": "empty_ok", "path": path}
    return {"mode": "gap_fingerprint", "path": path}


def materialize_raw_type(spec: dict[str, Any] | None) -> Any:
    if spec is None:
        return None
    kind = spec["kind"]
    if kind == "str":
        return spec["text"]
    if kind == "int":
        return int(spec["value"])
    if kind == "float":
        return float(spec["value"])
    if kind == "bool":
        return bool(spec["value"])
    if kind == "none":
        return None
    if kind == "list":
        return []
    if kind == "dict":
        return {}
    if kind == "bytes":
        return b""
    raise SystemExit(f"unknown raw_type kind {kind!r}")


def run_steps(tracker: Any, steps: list[dict[str, Any]]) -> None:
    for step in steps:
        action = step["action"]
        if action == "observe_version":
            tracker.observe_version(
                step["version_norm"],
                supported=bool(step["supported"]),
                field=step["field"],
                line=step.get("line"),
                record_id=step.get("record_id"),
                record_ordinal=step.get("record_ordinal"),
                byte_offset=step.get("byte_offset"),
                byte_end=step.get("byte_end"),
            )
        elif action == "observe_signature":
            raw = materialize_raw_type(step.get("raw_type"))
            tracker.observe_signature(
                raw,
                line=step.get("line"),
                record_id=step.get("record_id"),
                record_ordinal=step.get("record_ordinal"),
                byte_offset=step.get("byte_offset"),
                byte_end=step.get("byte_end"),
            )
        elif action == "note_unsupported_version":
            tracker.note_unsupported_version()
        else:
            raise SystemExit(f"unknown step action {action!r}")


def add_tracker(
    specs: list[dict[str, Any]],
    vector_id: str,
    format_label: str,
    steps: list[dict[str, Any]],
    *,
    flush_path: str | None = SYN_PATH,
) -> None:
    drift = specs_module
    tracker = drift.DriftTracker(format_label)
    run_steps(tracker, steps)
    expected: dict[str, Any] = {"state": tracker_state(tracker)}
    if flush_path is not None:
        expected["flush"] = flush_mode(tracker, flush_path)
    specs.append(
        {
            "id": vector_id,
            "construct": {
                "type": "tracker_run",
                "format_label": format_label,
                "steps": steps,
            },
            "expected": expected,
        }
    )


def scan_committed_text(text: str) -> None:
    raw = text.encode("utf-8")
    if _BANNED_LIVE_TEST.search(raw):
        raise SystemExit("committed output matches banned live/test secret shape")
    if _BANNED_SUPABASE_PAT.search(raw):
        raise SystemExit("committed output contains a contiguous supabase token shape")


def vector_specs(drift: Any) -> list[dict[str, Any]]:
    global specs_module
    specs_module = drift
    specs: list[dict[str, Any]] = []

    foreign_items = [
        {"type_name": name, "format_label": label}
        for name, label in drift.FOREIGN_SIGNATURE_TYPES.items()
    ]

    specs.append(
        {
            "id": "module_exports",
            "construct": {"type": "module_exports"},
            "expected": {
                "python_all": list(drift.__all__),
                "max_drift_transitions": drift.MAX_DRIFT_TRANSITIONS,
                "foreign_signature_types": foreign_items,
