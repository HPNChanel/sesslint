            {
                "action": "observe_signature",
                "raw_type": {"kind": "str", "text": "turn_context"},
                "line": 3,
                "record_id": "syn-rec-03",
                "record_ordinal": 3,
                "byte_offset": 10,
                "byte_end": 20,
            },
            {
                "action": "observe_signature",
                "raw_type": {"kind": "str", "text": "turn_context"},
                "line": 9,
                "record_id": "syn-rec-09",
                "record_ordinal": 9,
