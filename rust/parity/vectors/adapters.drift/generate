                "action": "observe_version",
                "version_norm": "9.9",
                "supported": False,
                "field": "version",
            },
        ],
    )

    add_tracker(
        specs,
        "unsupported_before_baseline_suppresses",
        "canonical",
        [
            {
                "action": "observe_version",
                "version_norm": "9.9",
                "supported": False,
                "field": "version",
            },
            {
                "action": "observe_version",
                "version_norm": "1",
                "supported": True,
                "field": "version",
            },
        ],
    )

    add_tracker(
        specs,
        "note_unsupported_clears_flush",
        "claude-code-jsonl",
        [
            {"action": "observe_signature", "raw_type": {"kind": "str", "text": "turn_context"}},
            {"action": "note_unsupported_version"},
            {
                "action": "observe_signature",
