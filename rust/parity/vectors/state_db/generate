_BANNED_SUPABASE_PAT = re.compile(rb"sbp_[0-9a-f]{40}")


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def verify_pin_hashes() -> None:
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/state_db.py")
    digest = hashlib.sha256(blob).hexdigest()
    if digest != STATE_DB_PY_SHA256:
        raise SystemExit(
            f"state_db.py pin sha256 mismatch: expected {STATE_DB_PY_SHA256}, got {digest}"
        )
    rs_path = repo_root() / "rust" / "crates" / "scan" / "src" / "state_db.rs"
    rs_digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if rs_digest != STATE_DB_RS_SHA256:
        raise SystemExit(
            "state_db.rs sha256 mismatch: "
            f"expected {STATE_DB_RS_SHA256}, got {rs_digest}"
        )


def scan_committed_text(text: str) -> None:
    raw = text.encode("utf-8")
    if _BANNED_SUPABASE_PAT.search(raw):
        raise SystemExit("committed output contains a contiguous supabase token shape")


def install_packages() -> None:
    pkg = types.ModuleType("sesslint")
    pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint"] = pkg

    report = types.ModuleType("sesslint.report")

    def short_hash(identifier: str, length: int = 8) -> str:
        return hashlib.sha256(identifier.encode("utf-8")).hexdigest()[:length]

    report.short_hash = short_hash
    sys.modules["sesslint.report"] = report
    pkg.report = report


def load_state_db() -> Any:
    verify_pin_hashes()
    install_packages()
    source = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/state_db.py").decode("utf-8")
    code = compile(source, f"<{PYTHON_COMMIT}:src/sesslint/state_db.py>", "exec")
    mod = types.ModuleType(MODULE)
    mod.__file__ = f"<{PYTHON_COMMIT}:src/sesslint/state_db.py>"
    sys.modules[MODULE] = mod
    exec(code, mod.__dict__)  # noqa: S102
    sys.modules["sesslint"].state_db = mod
    return mod


def snapshot_payload(snap: Any) -> dict[str, Any]:
    return {
        "parse_ok": snap.parse_ok,
        "schema_note": snap.schema_note,
        "thread_ids": sorted(snap.thread_ids),
        "rollout_uuids": sorted(snap.rollout_uuids),
        "thread_rows": snap.thread_rows,
        "spawn_edge_orphans": snap.spawn_edge_orphans,
        "migration_skips": snap.migration_skips,
        "migration_skip_reason_hashes": list(snap.migration_skip_reason_hashes),
        "thread_rollout_pairs": [
            [a, b] for a, b in sorted(snap.thread_rollout_pairs)
        ],
        "membership_complete": snap.membership_complete,
    }


def mk_db(path: Path, threads: list[tuple[str, str | None]]) -> None:
    con = sqlite3.connect(path)
    try:
        con.execute(
            "CREATE TABLE threads (id TEXT PRIMARY KEY, rollout_path TEXT, "
            "thread_source TEXT, archived INTEGER, title TEXT)"
        )
        con.execute(
            "CREATE TABLE thread_spawn_edges ("
            "parent_thread_id TEXT, child_thread_id TEXT, status TEXT)"
        )
        con.execute(
            "CREATE TABLE rollout_migration_skipped_rollouts "
            "(rollout_path TEXT, skip_reason TEXT)"
        )
        for tid, rp in threads:
            con.execute(
                "INSERT INTO threads (id, rollout_path, thread_source, archived, title) "
                "VALUES (?,?,?,?,?)",
                (tid, rp, "user", 0, "synthetic-title-never-read"),
            )
    finally:
        con.close()


