#!/usr/bin/env python3
"""Generate sesslint.context parity vectors from the pinned worktree module (stdlib only)."""

from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path
from typing import Any

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
CONTEXT_SHA256 = "c2a1ad5574aea073dd45b55653c647c67855e9fdaf89fd4fdefde0f6f80a866f"

MARKER_METADATA: dict[str, int] = {"k": 1}


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def load_context_module():
    root = repo_root()
    module_path = root / "src" / "sesslint" / "context.py"
    digest = hashlib.sha256(module_path.read_bytes()).hexdigest()
    if digest != CONTEXT_SHA256:
        raise SystemExit(
            f"context.py sha256 mismatch: expected {CONTEXT_SHA256}, got {digest}"
        )
    src = root / "src"
    if str(src) not in sys.path:
        sys.path.insert(0, str(src))
    from sesslint.context import CheckContext  # noqa: WPS433

    return CheckContext


def sorted_dict_str_values(d: dict[str, str]) -> dict[str, str]:
    return dict(sorted(d.items()))


def fields_snapshot(ctx: Any) -> dict[str, Any]:
    meta = ctx.source_metadata
    if meta is None:
        meta_out: Any = None
    else:
        meta_out = dict(sorted(meta.items()))
    return {
        "adapter_id": ctx.adapter_id,
        "adapter_version": ctx.adapter_version,
        "profile_id": ctx.profile_id,
        "profile_version": ctx.profile_version,
        "timestamp_skew_ms": ctx.timestamp_skew_ms,
        "source_metadata": meta_out,
        "compaction_checkpoint_capable": ctx.compaction_checkpoint_capable,
    }


def build_new(CheckContext: Any, spec: dict[str, Any]) -> Any:
    kwargs: dict[str, Any] = {
        "adapter_id": spec.get("adapter_id", "unknown"),
        "adapter_version": spec.get("adapter_version", "unknown"),
        "profile_id": spec.get("profile_id", "unknown"),
        "profile_version": spec.get("profile_version", "unknown"),
        "timestamp_skew_ms": spec.get("timestamp_skew_ms", 2000),
    }
    if "source_metadata" in spec:
        kwargs["source_metadata"] = spec["source_metadata"]
    return CheckContext(**kwargs)


def build_create(CheckContext: Any, spec: dict[str, Any]) -> Any:
    kwargs: dict[str, Any] = {}
    for key in (
        "adapter_id",
        "adapter_version",
        "profile_id",
        "profile_version",
        "source_metadata",
    ):
        if key in spec:
            kwargs[key] = spec[key]
    return CheckContext.create(**kwargs)


def apply_with_overrides(CheckContext: Any, base: Any, spec: dict[str, Any]) -> Any:
    kwargs: dict[str, Any] = {}
    for key in ("adapter_id", "adapter_version", "profile_id", "profile_version"):
        if key in spec:
            kwargs[key] = spec[key]
    mode = spec.get("source_metadata_override", "unset")
    if mode == "unset":
        pass
    elif mode == "none":
        kwargs["source_metadata"] = None
    elif mode == "non_mapping":
        kwargs["source_metadata"] = 42
    else:
        raise ValueError(f"unknown source_metadata_override: {mode}")
    return base.with_overrides(**kwargs)


def build_expected(CheckContext: Any, construct: dict[str, Any]) -> dict[str, Any]:
    kind = construct["type"]
    if kind == "default":
        ctx = CheckContext()
        return {"fields": fields_snapshot(ctx)}
    if kind == "new":
        ctx = build_new(CheckContext, construct)
        out: dict[str, Any] = {"fields": fields_snapshot(ctx)}
        if construct.get("assert_non_empty"):
            out["assert_non_empty_coords"] = True
        return out
    if kind == "create":
        ctx = build_create(CheckContext, construct)
        return {"fields": fields_snapshot(ctx)}
    if kind == "to_dict":
        ctx = build_new(CheckContext, construct["base"])
        to_dict = sorted_dict_str_values(ctx.to_dict())
        return {
            "to_dict": to_dict,
            "json": json.dumps(to_dict, sort_keys=True),
            "to_dict_key_count": len(to_dict),
        }
    if kind == "compaction_matrix":
        rows: list[dict[str, Any]] = []
        for row in construct["adapters"]:
            ctx = build_new(
                CheckContext,
                {
                    "adapter_id": row["adapter_id"],
                    "adapter_version": "1.0.0",
                },
            )
            rows.append(
                {
                    "adapter_id": row["adapter_id"],
                    "compaction_checkpoint_capable": ctx.compaction_checkpoint_capable,
                }
            )
        default_ctx = CheckContext()
        rows.append(
            {
                "adapter_id": "default",
                "compaction_checkpoint_capable": default_ctx.compaction_checkpoint_capable,
            }
        )
        return {"compaction": rows}
    if kind == "with_overrides":
        base = build_new(CheckContext, construct["base"])
        ctx = apply_with_overrides(CheckContext, base, construct.get("overrides", {}))
        return {"fields": fields_snapshot(ctx)}
    raise ValueError(f"unknown construct type: {kind}")


