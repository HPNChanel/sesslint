def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_blob(rev_path: str) -> str:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
        text=True,
    )


def verify_hygiene_py_blob() -> None:
    pin = git_show_blob(f"{HYGIENE_PY_PIN}:src/sesslint/checks/hygiene.py")
    head = git_show_blob("HEAD:src/sesslint/checks/hygiene.py")
    if pin != head:
        raise SystemExit(
            "src/sesslint/checks/hygiene.py differs from pin blob; "
            "regenerate or align the worktree."
        )


def verify_hygiene_rs_sha256() -> None:
    rs_path = repo_root() / "rust" / "crates" / "checks" / "src" / "hygiene.rs"
    digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if digest != HYGIENE_RS_SHA256:
        raise SystemExit(
            "checks/src/hygiene.rs sha256 mismatch: "
            f"expected {HYGIENE_RS_SHA256}, got {digest}"
        )


def load_hygiene_module() -> types.ModuleType:
    verify_hygiene_py_blob()
    verify_hygiene_rs_sha256()
    src = repo_root() / "src"
    insert = str(src)
    if insert not in sys.path:
        sys.path.insert(0, insert)

    source = git_show_blob(f"{HYGIENE_PY_PIN}:src/sesslint/checks/hygiene.py")
    with tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        suffix="_pinned_hygiene.py",
        delete=False,
    ) as handle:
        handle.write(source)
        tmp_path = handle.name
    try:
        spec = importlib.util.spec_from_file_location("_sesslint_checks_hygiene_parity", tmp_path)
        if spec is None or spec.loader is None:
            raise SystemExit("failed to create import spec for pinned hygiene.py")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = mod
        spec.loader.exec_module(mod)
        return mod
    finally:
        Path(tmp_path).unlink(missing_ok=True)


def bytes_hex(data: bytes) -> dict[str, Any]:
    return {"kind": "bytes_hex", "hex": data.hex()}


def decode_bytes_hex(obj: dict[str, Any]) -> bytes:
    if obj.get("kind") != "bytes_hex":
        raise SystemExit("expected bytes_hex")
    hx = str(obj.get("hex", ""))
    if len(hx) % 2:
        raise SystemExit("odd hex")
    return bytes.fromhex(hx) if hx else b""


def assemble_recipe(recipe: dict[str, Any]) -> bytes:
    out = bytearray()
    if "lead" in recipe:
        out.extend(decode_bytes_hex(recipe["lead"]))
    pad = recipe.get("padding_length")
    if pad is not None:
        fill = int(recipe["fill_byte"])
        out.extend(bytes([fill]) * int(pad))
    if "gate_literal_hex" in recipe:
        out.extend(bytes.fromhex(str(recipe["gate_literal_hex"])))
    if recipe.get("body_length") is not None:
        fill = int(recipe["fill_byte"])
        out.extend(bytes([fill]) * int(recipe["body_length"]))
    if "tail" in recipe:
        out.extend(decode_bytes_hex(recipe["tail"]))
    return bytes(out)


def scan_committed_text(text: str) -> None:
    if _BANNED_LIVE_TEST.search(text.encode("utf-8")):
        raise SystemExit("committed output matches banned live/test secret shape")


def tracker_feed(
    tracker: Any,
    raw: bytes,
    line: int | None,
    ordinal: int | None,
    byte_offset: int | None,
    byte_end: int | None,
) -> None:
    tracker.feed(
        raw,
        line_number=line,
        byte_offset=byte_offset,
        byte_end=byte_end,
        record_ordinal=ordinal,
    )


def evidence_rows_from_tracker(mod: Any, tracker: Any) -> list[dict[str, Any]]:
    tracker._flush_pending()
    if not tracker._hits:
        return []
    ordered = sorted(
        tracker._hits.items(),
        key=lambda kv: (
            kv[0][1] if kv[0][1] is not None else -1,
            kv[0][0] if kv[0][0] is not None else -1,
            kv[0][4],
        ),
    )
    suppressed = max(0, len(ordered) - mod.MAX_SECRET_FINDINGS_PER_FILE)
    emitted = ordered[: mod.MAX_SECRET_FINDINGS_PER_FILE]
    rows: list[dict[str, Any]] = []
    for idx, ((ordinal, line, byte_off, byte_end, family), agg) in enumerate(emitted):
        digests = sorted(agg.digests)[: mod.MAX_DIGESTS_PER_FINDING]
        truncated = len(agg.digests) > mod.MAX_DIGESTS_PER_FINDING or (
            suppressed and idx == len(emitted) - 1
        )
        overflow = suppressed if (suppressed and idx == len(emitted) - 1) else None
        rows.append(
            {
                "family": family,
                "occurrence_count": agg.count,
                "match_sha256": digests,
                "match_len": agg.max_len,
                "line": line,
                "ordinal": ordinal,
                "byte_offset": byte_off,
                "byte_end": byte_end,
                "truncated": bool(truncated),
                "overflow": overflow,
            }
        )
    return rows


def openai_recipe(fill: int, body: int) -> dict[str, Any]:
    return {
        "lead": bytes_hex(b""),
        "gate_literal_hex": "736b2d",
        "body_length": body,
        "fill_byte": fill,
        "tail": bytes_hex(b""),
    }


def bearer_recipe() -> dict[str, Any]:
    return {
        "lead": bytes_hex(b"Bearer "),
        "body_length": 16,
        "fill_byte": ord("d"),
        "tail": bytes_hex(b""),
    }


def telegram_recipe() -> dict[str, Any]:
    return {
        "lead": bytes_hex(b"12345678:"),
        "body_length": 35,
        "fill_byte": ord("a"),
        "tail": bytes_hex(b""),
    }


def pem_recipe() -> dict[str, Any]:
    return {
        "lead": bytes_hex(b"-----BEGIN PRIVATE KEY-----"),
        "tail": bytes_hex(b""),
    }


def assignment_tail(value_hex: str) -> dict[str, Any]:
    return {
        "lead": bytes_hex(b"token: "),
        "tail": bytes_hex(bytes.fromhex(value_hex)),
    }


