    tracker_feed(tr, colon_tail, 1, None, None, None)
    if evidence_rows_from_tracker(mod, tr):
        raise SystemExit("colon tail without telegram body should be silent")
    if tr.into_findings(path_str="synth.jsonl"):
        raise SystemExit("colon tail into_findings should be empty")
    out.append(
        {
            "id": "tracker_colon_tail_no_telegram_body",
            "construct": {
                "type": "hygiene_tracker",
                "feeds": [
                    {
                        "raw": bytes_hex(colon_tail),
                        "line": 1,
                        "ordinal": None,
                        "byte_offset": None,
                        "byte_end": None,
                    }
                ],
            },
            "expected": {"rows_len": 0, "into_findings_len": 0},
        }
    )

    return out


def main() -> int:
    mod = load_hygiene_module()
    out_dir = Path(__file__).resolve().parent
    vectors = vectors_from_module(mod)

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "checks_hygiene_rs_sha256": HYGIENE_RS_SHA256,
        "python_all": list(mod.__all__),
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(payload)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "checks_hygiene_rs_sha256": HYGIENE_RS_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/checks.hygiene/generate",
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    manifest_text = json.dumps(manifest, indent=2) + "\n"
    scan_committed_text(manifest_text)
    (out_dir / "manifest.json").write_text(manifest_text, encoding="utf-8", newline="\n")
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.checks.hygiene parity (stdlib-only vectors; "
            "no session payload text)."
        ),
        "generator": "rust/parity/vectors/checks.hygiene/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    prov_text = json.dumps(provenance, indent=2) + "\n"
    scan_committed_text(prov_text)
    (out_dir / "PROVENANCE.json").write_text(prov_text, encoding="utf-8", newline="\n")
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
