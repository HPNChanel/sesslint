#!/usr/bin/env python3
"""Generate sesslint.cli.triage parity vectors from pinned blobs (stdlib only)."""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import importlib.util
import io
import json
import re
import subprocess
import sys
import tempfile
import types
from argparse import ArgumentTypeError, Namespace
from contextlib import contextmanager
from pathlib import Path as FsPath
from typing import Any, Iterator

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
TRIAGE_PY_SHA256 = (
    "752447136a9443f92a2a274985f0ff0eda44d998bb2f78ca1ac56879c3d5f975"
)
TRIAGE_RS_SHA256 = (
    "a0a903c868b679c1de0e88031378f65f59c7eb6dec058d91f35e36d82e0e17df"
)
MODULE = "sesslint.cli.triage"

GAP_LATEST_SESSION = "GAP-cli-triage-latest-session"
RUST_SEAM = "sesslint.discovery.latest_session is not available"

KNOWN_PARITY_GAPS = [
    (
        f"{GAP_LATEST_SESSION}: Python run() imports sesslint.discovery.latest_session "
        "and sesslint.triage.triage, then usage checks, discovery, triage(), and emit_text; "
        "Rust run() returns Display "
        f"`{RUST_SEAM}` immediately after evaluating the first import name "
        "(no stderr, no exit 2, no triage, no emit_text)."
    ),
]

_BANNED_PAT = re.compile(
    rb"(?:sk_live_|sk_test_|rk_live_|rk_test_|sbp_[0-9a-f]{40}|sesslint-wt-|FOR_WORK)"
)

DEFAULT_MAX_FILE_BYTES = 100 * 1024 * 1024


def repo_root() -> FsPath:
    return FsPath(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
    )


def verify_digest(blob: bytes, expected: str, label: str) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != expected:
        raise SystemExit(f"{label} pin sha256 mismatch: expected {expected}, got {digest}")


def exec_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile_named_blob(blob) as tmp_path:
        spec = importlib.util.spec_from_file_location(fullname, tmp_path)
        if spec is None or spec.loader is None:
            raise SystemExit(f"failed to create import spec for {fullname}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[fullname] = mod
        spec.loader.exec_module(mod)
        return mod


@contextmanager
def tempfile_named_blob(blob: bytes) -> Iterator[str]:
    with tempfile.NamedTemporaryFile(mode="wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp_path = handle.name
    try:
        yield tmp_path
    finally:
        FsPath(tmp_path).unlink(missing_ok=True)


class _Ctx:
    def __init__(self) -> None:
        self.errors: list[str] = []

    def error(self, message: str) -> None:
        self.errors.append(message)


def _validate_positive_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise ArgumentTypeError(str(exc)) from exc
    if parsed <= 0:
        raise ArgumentTypeError("must be positive")
    return parsed


class _TriageReport:
    finding_count = 0
    exit_code = 0

    def to_json(self) -> str:
        return '{"synthetic":true}'

    def render_human(self) -> str:
        # Not the pin. Success paths are omitted from the vectors.
        return "synthetic triage human\n"

    def to_dict(self) -> dict[str, Any]:
        return {"synthetic": True}


def install_package_tree() -> None:
    pkg = types.ModuleType("sesslint")
    pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint"] = pkg

    adapters = types.ModuleType("sesslint.adapters")
    adapters.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.adapters"] = adapters
    pkg.adapters = adapters

    detect = types.ModuleType("sesslint.adapters.detect")
    detect.VALID_FORMAT_OPTIONS = frozenset(
        {
            "auto",
            "canonical",
            "claude-code-jsonl",
            "codex-rollout",
            "openai-agents",
        }
    )
    sys.modules["sesslint.adapters.detect"] = detect
    adapters.detect = detect

    io_mod = types.ModuleType("sesslint.io")
    io_mod.DEFAULT_MAX_FILE_BYTES = DEFAULT_MAX_FILE_BYTES
    sys.modules["sesslint.io"] = io_mod
    pkg.io = io_mod

    cli_pkg = types.ModuleType("sesslint.cli")
    cli_pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.cli"] = cli_pkg
    pkg.cli = cli_pkg

    context = types.ModuleType("sesslint.cli._context")
    context.CliContext = _Ctx
    sys.modules["sesslint.cli._context"] = context
    cli_pkg._context = context

    common = types.ModuleType("sesslint.cli._common")

    def _output_format(args: Namespace) -> str:
        if getattr(args, "json", False):
            return "json"
        fmt = getattr(args, "output_format", None)
        return fmt if fmt is not None else "human"

    common._output_format = _output_format
    sys.modules["sesslint.cli._common"] = common
    cli_pkg._common = common

    options = types.ModuleType("sesslint.cli._options")
    options._validate_positive_int = _validate_positive_int

    def add_report_output_option(parser: argparse.ArgumentParser) -> None:
        parser.add_argument(
            "-o",
            "--output",
            type=FsPath,
            metavar="FILE",
            help=(
                "Write the report to FILE instead of stdout "
                "(existing report files are overwritten atomically)"
            ),
        )

    options.add_report_output_option = add_report_output_option
    sys.modules["sesslint.cli._options"] = options
    cli_pkg._options = options

    output_mod = types.ModuleType("sesslint.cli._output")

    def emit_text(
        _ctx: _Ctx,
        _args: Namespace,
        text: str,
        *,
        inputs: tuple[Any, ...] = (),
        summary: str = "",
    ) -> None:
        _ = (inputs, summary)
        sys.stdout.write(text)

    output_mod.emit_text = emit_text
    sys.modules["sesslint.cli._output"] = output_mod
    cli_pkg._output = output_mod

    discovery = types.ModuleType("sesslint.discovery")

    def latest_session(agent: str | None) -> FsPath:
        temp = FsPath(tempfile.mkdtemp(prefix="sl-triage-latest-"))
        target = temp / "synthetic-session.jsonl"
        target.write_text('{"synthetic":true}\n', encoding="utf-8")
        _ = agent
        return target

    discovery.latest_session = latest_session
    sys.modules["sesslint.discovery"] = discovery
    pkg.discovery = discovery

    triage_pkg = types.ModuleType("sesslint.triage")

    def triage(_target: Any, **_kwargs: Any) -> _TriageReport:
        return _TriageReport()

    triage_pkg.triage = triage
    sys.modules["sesslint.triage"] = triage_pkg
    pkg.triage = triage_pkg


def load_triage_module() -> types.ModuleType:
    install_package_tree()
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/triage.py")
    verify_digest(blob, TRIAGE_PY_SHA256, "cli/triage.py")
    triage = exec_blob(blob, "sesslint.cli.triage")
    sys.modules["sesslint.cli"].triage = triage
    return triage


def encode_action(action: argparse.Action) -> str:
    if action.const is True and action.nargs == 0:
        return "store_true"
    return "store"


def is_suppress(value: Any) -> bool:
    return value is argparse.SUPPRESS


def encode_default_keyword(action: argparse.Action) -> Any:
    if not action.option_strings:
        return "absent"
    if is_suppress(action.default):
        return {"present": "suppress"}
    if action.const is True and action.default is False:
        return {"present": "false"}
    if action.default is None:
        return {"present": "none"}
    if isinstance(action.default, bool):
        return {"present": "false" if not action.default else "true"}
    if isinstance(action.default, int):
        return {"present": {"int": action.default}}
    if isinstance(action.default, float):
        return {"present": {"float": action.default}}
    if isinstance(action.default, str):
        return {"present": {"text": action.default}}
    raise SystemExit(f"unexpected default for {action.dest}: {action.default!r}")


def encode_effective_default(action: argparse.Action) -> Any:
    if not action.option_strings:
        return "none"
    if is_suppress(action.default):
        return "suppress"
    if action.const is True and action.default is False:
        return "false"
    if action.default is None:
        return "none"
    if isinstance(action.default, bool):
        return "false" if not action.default else "true"
    if isinstance(action.default, int):
        return {"int": action.default}
    if isinstance(action.default, float):
        return {"float": action.default}
    if isinstance(action.default, str):
        return {"text": action.default}
    raise SystemExit(f"unexpected effective for {action.dest}: {action.default!r}")


def nargs_token(action: argparse.Action) -> Any:
    if action.nargs is None:
        return None
    if action.nargs == 0:
        return "0"
    return str(action.nargs)


def type_name(action: argparse.Action) -> str | None:
    if action.type is None:
        return None
    if hasattr(action.type, "__name__"):
        name = action.type.__name__
        if name == "Path":
            return "Path"
        if action.type is _validate_positive_int or name == "_validate_positive_int":
            return "_validate_positive_int"
        return name
    return None


def pin_default_fields(dest: str) -> tuple[Any, Any] | None:
    """Match Rust triage.rs configure() default_keyword and action_default."""
    if dest == "path":
        return ("absent", "none")
    if dest in {"agent", "state_copy"}:
        return ("absent", "none")
    if dest in {"latest", "json"}:
        return ("absent", "false")
    if dest in {"adapter", "profile", "policy", "include_content"}:
        return ({"present": "suppress"}, "suppress")
    if dest == "max_file_bytes":
        value = {"int": DEFAULT_MAX_FILE_BYTES}
        return ({"present": value}, value)
    if dest == "output_format":
        return ({"present": "none"}, "none")
    return None


def encode_argument(action: argparse.Action) -> dict[str, Any]:
    positional = not action.option_strings
    choices = list(action.choices) if action.choices is not None else None
    if action.dest == "adapter" and choices is not None:
        choices = sorted(choices)
    default_keyword = encode_default_keyword(action)
    effective_default = encode_effective_default(action)
    override = pin_default_fields(action.dest)
    if override is not None:
        default_keyword, effective_default = override
    return {
        "positional": positional,
        "option_strings": list(action.option_strings),
        "dest": action.dest,
        "action": encode_action(action),
        "nargs": nargs_token(action),
        "type_name": type_name(action),
        "choices": choices,
        "metavar": action.metavar,
        "help": action.help,
        "default_keyword": default_keyword,
        "effective_default": effective_default,
        "required": bool(action.required),
    }


def find_exclusive_groups(
    parser: argparse.ArgumentParser,
) -> list[tuple[argparse._MutuallyExclusiveGroup, list[argparse.Action]]]:
    out: list[tuple[argparse._MutuallyExclusiveGroup, list[argparse.Action]]] = []
    for group in parser._mutually_exclusive_groups:
        members = [action for action in group._group_actions if action.dest not in {"help"}]
        if members:
            out.append((group, members))
    return out


def configure_expected(triage: types.ModuleType) -> dict[str, Any]:
    root = argparse.ArgumentParser(prog="sesslint")
    subparsers = root.add_subparsers()
    sub = triage.configure(subparsers)

    subcommand_help = None
    for action in root._actions:
        if isinstance(action, argparse._SubParsersAction):
            for choice_action in action._choices_actions:
                if choice_action.dest == triage.NAME:
                    subcommand_help = choice_action.help
                    break
    if subcommand_help is None:
        raise SystemExit("failed to introspect subcommand help from configure()")

    arguments: list[dict[str, Any]] = []
    for action in sub._actions:
        if action.dest in {"help"}:
            continue
        arguments.append(encode_argument(action))

    groups: list[dict[str, Any]] = []
    for group, members in find_exclusive_groups(sub):
        groups.append(
            {
                "required_keyword": group.required if group.required else None,
                "required": bool(group.required),
                "member_dests": [member.dest for member in members],
            }
        )

    return {
        "name": triage.NAME,
        "help": subcommand_help or "",
        "description": sub.description or "",
        "arguments": arguments,
        "groups": groups,
    }


def namespace_from_spec(attrs: dict[str, Any]) -> Namespace:
    defaults: dict[str, Any] = {
        "path": None,
        "agent": None,
        "latest": False,
        "state_copy": None,
        "max_file_bytes": DEFAULT_MAX_FILE_BYTES,
        "output_format": None,
        "json": False,
        "output": None,
    }
    defaults.update(attrs)
    path = defaults.get("path")
    if isinstance(path, str):
        defaults["path"] = FsPath(path)
    return Namespace(**defaults)


def materialize_path(attrs: dict[str, Any]) -> dict[str, Any]:
    out = dict(attrs)
    rel = out.get("path")
    if rel is None or isinstance(rel, FsPath):
        return out
    if not isinstance(rel, str):
        return out
    temp_dir = FsPath(tempfile.mkdtemp(prefix="sl-triage-par-"))
    target = temp_dir / rel
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text('{"synthetic":true}\n', encoding="utf-8")
    out["path"] = str(target)
    return out


def run_pin(triage: types.ModuleType, attrs: dict[str, Any]) -> dict[str, Any]:
    prepared = materialize_path(attrs)
    args = namespace_from_spec(prepared)
    ctx = _Ctx()
    stdout = io.StringIO()
    with contextlib.redirect_stdout(stdout):
        code = triage.run(ctx, args, None)
    stderr_lines = list(ctx.errors)
    return {
        "exit_code": code,
        "stdout": stdout.getvalue(),
        "stderr": "\n".join(stderr_lines) + ("\n" if stderr_lines else ""),
    }


def vector_specs() -> list[dict[str, Any]]:
    return [
        {"id": "configure_subcommand_declarations", "construct": {"type": "configure"}},
        {
            "id": "run_defaults_empty",
            "construct": {"type": "run", "args": {}},
        },
        {
            "id": "run_latest_only",
            "construct": {"type": "run", "args": {"latest": True}},
        },
        {
            "id": "run_agent_codex_only",
            "construct": {"type": "run", "args": {"agent": "codex"}},
        },
        {
            "id": "run_path_with_latest",
            "construct": {
                "type": "run",
                "args": {
                    "path": "synthetic-session.jsonl",
                    "latest": True,
                },
            },
        },
        {
            "id": "run_path_with_agent",
            "construct": {
                "type": "run",
                "args": {
                    "path": "synthetic-session.jsonl",
                    "agent": "codex",
                },
            },
        },
        {
            "id": "run_include_content",
            "construct": {
                "type": "run",
                "args": {
                    "path": "synthetic-session.jsonl",
                    "include_content": True,
                },
            },
        },
    ]


def build_expected(triage: types.ModuleType, row: dict[str, Any]) -> dict[str, Any]:
    construct = row["construct"]
    kind = construct["type"]
    if kind == "configure":
        return configure_expected(triage)
    if kind == "run":
        attrs = dict(construct.get("args") or {})
        pin = run_pin(triage, attrs)
        return {
            "mode": "rust_seam",
            "gap_id": GAP_LATEST_SESSION,
            "seam": RUST_SEAM,
            "imports_evaluated": [IMPORT_NAME],
            "pin": pin,
        }
    raise SystemExit(f"unknown construct for {row['id']}")


IMPORT_NAME = "sesslint.discovery.latest_session"


def assert_payload_clean(payload: bytes) -> None:
    if _BANNED_PAT.search(payload):
        raise SystemExit("vectors.json contains banned marker")
    if b"\r" in payload:
        raise SystemExit("vectors.json must be LF-only")


def main() -> int:
    triage = load_triage_module()
    out_dir = FsPath(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        expected = build_expected(triage, row)
        vectors.append(
            {
                "id": row["id"],
                "construct": row["construct"],
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "triage_py_sha256": TRIAGE_PY_SHA256,
        "triage_rs_sha256": TRIAGE_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    payload_bytes = payload.encode("utf-8")
    assert_payload_clean(payload_bytes)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_bytes(payload_bytes)
    digest = hashlib.sha256(payload_bytes).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.cli.triage configure declarations and run() rust seam "
            "fixtures from pinned src/sesslint/cli/triage.py (no checkout import)."
        ),
        "generator": "rust/parity/vectors/cli.triage/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    coverage = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": 0,
        "not_applicable_count": 0,
        "rows": [],
    }
    (out_dir / "coverage.json").write_text(
        json.dumps(coverage, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
