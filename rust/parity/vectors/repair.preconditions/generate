def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def fullname_for(path: str) -> str:
    rel = path.removeprefix("src/").removesuffix(".py").replace("/", ".")
    return rel


def ensure_pkg(name: str) -> None:
    if name not in sys.modules:
        mod = types.ModuleType(name)
        mod.__path__ = []
        sys.modules[name] = mod


def exec_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile.NamedTemporaryFile("wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp = handle.name
    spec = importlib.util.spec_from_file_location(fullname, tmp)
    if spec is None or spec.loader is None:
        raise SystemExit(f"failed to create import spec for {fullname}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[fullname] = mod
    try:
        spec.loader.exec_module(mod)
    finally:
        Path(tmp).unlink(missing_ok=True)
    parent = fullname.rsplit(".", 1)[0] if "." in fullname else ""
    if parent:
        parent_mod = sys.modules.setdefault(parent, types.ModuleType(parent))
        setattr(parent_mod, fullname.split(".")[-1], mod)
    return mod


def verify_preconditions_rs() -> None:
    rs_path = repo_root() / "rust" / "crates" / "repair" / "src" / "preconditions.rs"
    digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if digest != PRECONDITIONS_RS_SHA256:
        raise SystemExit(
            f"preconditions.rs sha256 mismatch: expected {PRECONDITIONS_RS_SHA256}, got {digest}"
        )


def load_preconditions_module() -> Any:
    verify_preconditions_rs()
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/preconditions.py")
    digest = hashlib.sha256(blob).hexdigest()
    if digest != PRECONDITIONS_PY_SHA256:
        raise SystemExit(
            f"pinned preconditions.py sha256 mismatch: expected {PRECONDITIONS_PY_SHA256}, got {digest}"
        )
    for rel in PIN_CLOSURE:
        if rel == "repair/preconditions.py":
            continue
        path = f"src/sesslint/{rel}"
        fullname = fullname_for(path)
        parts = fullname.split(".")
        for i in range(1, len(parts)):
            ensure_pkg(".".join(parts[:i]))
        exec_blob(git_show_bytes(f"{PYTHON_COMMIT}:{path}"), fullname)
    ensure_pkg("sesslint.repair")
    return exec_blob(blob, "sesslint.repair.preconditions")


def tagged(value: Any) -> dict[str, Any]:
    if value is None:
        return {"t": "null"}
    if isinstance(value, bool):
        return {"t": "bool", "v": value}
    if isinstance(value, int) and not isinstance(value, bool):
        return {"t": "int", "v": value}
    if isinstance(value, str):
        return {"t": "str", "v": value}
    if isinstance(value, dict):
        entries = [[k, tagged(v)] for k, v in value.items()]
        return {"t": "map", "entries": entries}
    if isinstance(value, (list, tuple)):
        return {"t": "list", "items": [tagged(v) for v in value]}
    raise TypeError(f"unencodable {type(value)}")


def event_mapping(entries: dict[str, Any]) -> dict[str, Any]:
    return {"entries": [[k, tagged(v)] for k, v in entries.items()]}


def evidence_from_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    return {"pairs": [[k, tagged(v)] for k, v in pairs]}


def ctx_spec(
    *,
    findings: list[dict[str, Any]] | None = None,
    events: list[dict[str, Any]] | None = None,
    profile: str = "neutral",
    source_hash: str = "",
    finding_index: int | None = None,
    policy: str = "conservative",
    acknowledge: bool = False,
) -> dict[str, Any]:
    return {
        "findings": findings or [],
        "events": events or [],
        "profile": profile,
        "source_hash": source_hash,
        "finding_index": finding_index,
        "policy": policy,
        "acknowledge_side_effects": acknowledge,
    }


def finding_spec(
    code: str,
    *,
    severity: str = "ERROR",
    repairability: str = "DETERMINISTIC",
    record_id: str | None = None,
    evidence: dict[str, Any] | None = None,
) -> dict[str, Any]:
    row: dict[str, Any] = {
        "code": code,
        "severity": severity,
        "repairability": repairability,
        "message": "synthetic precondition marker",
        "source": {"path": "<canonical>", "line": None, "record_id": record_id},
        "related_ids": [],
        "fingerprint": SYNTHETIC_FP,
        "schema_version": "1.0",
        "message_template": None,
    }
    if evidence is not None:
        row["evidence"] = evidence
    else:
        row["evidence"] = None
    return row


def build_py_context(pc: Any, spec: dict[str, Any]) -> Any:
    from sesslint.codes import Repairability, Severity  # noqa: WPS433
    from sesslint.finding import Finding, SourceRef  # noqa: WPS433

    findings: list[Any] = []
    for raw in spec.get("findings", []):
        src = raw["source"]
        line = src.get("line")
        source = SourceRef(src["path"], line, src.get("record_id"))
        evidence = None
        if raw.get("evidence") is not None:
            ev = raw["evidence"]
            if "pairs" in ev:
                evidence = {k: _decode_tagged(v) for k, v in ev["pairs"]}
            else:
                evidence = _decode_tagged(ev)
        findings.append(
            Finding(
                code=raw["code"],
                severity=Severity[raw["severity"]],
                repairability=Repairability[raw["repairability"]],
                message=raw["message"],
                source=source,
                related_ids=tuple(raw.get("related_ids", [])),
                fingerprint=raw["fingerprint"],
                evidence=evidence,
            )
        )
    events = [_decode_event(e) for e in spec.get("events", [])]
    finding = None
    idx = spec.get("finding_index")
    if idx is not None:
        finding = findings[idx]
    return pc.PreconditionContext(
        findings=findings,
        events=events,
        profile=spec.get("profile", "neutral"),
        source_hash=spec.get("source_hash", ""),
        finding=finding,
        policy=spec.get("policy", "conservative"),
        acknowledge_side_effects=spec.get("acknowledge_side_effects", False),
    )


def _decode_tagged(node: Any) -> Any:
    if not isinstance(node, dict) or "t" not in node:
        return node
    kind = node["t"]
    if kind == "null":
        return None
    if kind == "bool":
        return node["v"]
    if kind == "int":
        return node["v"]
    if kind == "str":
        return node["v"]
    if kind == "map":
        out: dict[str, Any] = {}
        for key, val in node["entries"]:
            out[key] = _decode_tagged(val)
        return out
    if kind == "list":
        return [_decode_tagged(item) for item in node["items"]]
    raise ValueError(f"bad tagged node {node!r}")


def _decode_event(spec: dict[str, Any]) -> dict[str, Any]:
    out: dict[str, Any] = {}
    for key, val in spec.get("entries", []):
        tagged = val if isinstance(val, dict) and "t" in val else tagged(val)
        out[key] = _decode_tagged(tagged)
    return out


def run_expected(pc: Any, construct: dict[str, Any]) -> dict[str, Any]:
    kind = construct["type"]
    if kind == "module_all":
        return {"mode": "names", "names": list(pc.__all__)}
    if kind == "precondition_func_names":
        return {"mode": "names", "names": list(pc.PRECONDITION_FUNCS.keys())}
    if kind == "register_precondition":
        name = construct["name"]
        try:
            pc.register_precondition(name, lambda _ctx: True)
        except ValueError as exc:
            return {"mode": "value_error", "message": str(exc)}
        return {"mode": "ok"}
    if kind == "check_preconditions":
        ctx = build_py_context(pc, construct["context"])
        names = construct["names"]
        try:
            ok, failed = pc.check_preconditions(names, ctx)
        except ValueError as exc:
            return {"mode": "value_error", "message": str(exc)}
        return {"mode": "check", "ok": ok, "failed": failed}
    if kind == "_find_component_indices":
        events = [_decode_event(e) for e in construct["events"]]
        try:
            got = pc._find_component_indices(events, construct["seed"])
        except (TypeError, ValueError) as exc:
            return {"mode": "value_error", "message": str(exc)}
        return {"mode": "indices", "sorted": sorted(got)}
    if kind == "_find_torn_compaction_dropped_indices":
        events = [_decode_event(e) for e in construct["events"]]
        got = pc._find_torn_compaction_dropped_indices(events, construct["boundary_index"])
        return {"mode": "indices", "sorted": sorted(got)}
    fn_name = construct["predicate"]
    fn = getattr(pc, fn_name)
    ctx = build_py_context(pc, construct["context"])
    gap = construct.get("gap")
    try:
        got = fn(ctx)
    except Exception as exc:  # noqa: BLE001
        return {"mode": "python_error", "error_type": type(exc).__name__, "message": str(exc)}
    if gap:
        return {"mode": "gap", "gap_id": gap, "python_bool": bool(got)}
    return {"mode": "bool", "value": bool(got)}


