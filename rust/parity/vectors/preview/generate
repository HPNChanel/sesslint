            recipe="brand-new-recipe",
            event_id=SYNTHETIC_EVENT,
            kind=SYNTHETIC_KIND,
            source_line=4,
            seq=7,
        )
        return {
            "sparse_keys": list(sparse.to_dict().keys()),
            "full_keys": list(full.to_dict().keys()),
        }
    if kind == "PreviewBlocked_to_dict":
        blocked = preview.PreviewBlocked(
            code="SL203",
            reason=SYNTHETIC_REASON,
            finding_fp=SYNTHETIC_FP,
        )
        return {"keys": list(blocked.to_dict().keys())}
    if kind == "PreviewDoc_counts":
        doc = preview.PreviewDoc(
            source=SYNTHETIC_SOURCE,
            steps=(
                preview.PreviewDelta(
                    action="normalize",
                    reason_code="SL000",
                    recipe="seq-renumber",
                    seq=0,
                ),
                preview.PreviewDelta(
                    action="drop",
                    reason_code="SL000",
                    recipe="orphan-result-drop",
                    seq=1,
                ),
            ),
            blocked=(),
            plan_fingerprint=SYNTHETIC_PLAN_FP,
            policy=SYNTHETIC_POLICY,
        )
        return {"count_keys": list(doc.to_dict()["counts"].keys())}
    if kind == "PreviewDoc_to_json":
        doc = preview.PreviewDoc(
            source=SYNTHETIC_SOURCE,
            steps=(
                preview.PreviewDelta(
                    action="drop",
                    reason_code="SL000",
                    recipe="brand-new-recipe",
                    event_id=SYNTHETIC_EVENT,
                    kind=SYNTHETIC_KIND,
                    source_line=3,
                    seq=1,
                ),
            ),
            blocked=(
                preview.PreviewBlocked(
                    code="SL203",
                    reason="caf\u00e9",
                    finding_fp=SYNTHETIC_FP,
                ),
            ),
            plan_fingerprint=SYNTHETIC_PLAN_FP,
            policy=SYNTHETIC_POLICY,
        )
        return {"json": doc.to_json(), "refused": doc.refused}
    if kind == "PreviewDoc_render_human":
        empty = preview.PreviewDoc(
            source=SYNTHETIC_SOURCE,
            steps=(),
            blocked=(),
            plan_fingerprint=SYNTHETIC_PLAN_FP,
            policy=SYNTHETIC_POLICY,
        )
        sparse = preview.PreviewDoc(
            source=SYNTHETIC_SOURCE,
            steps=(
                preview.PreviewDelta(
                    action="drop",
