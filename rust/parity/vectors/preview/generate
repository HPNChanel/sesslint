def build_deltas_input(preview: Any, construct: dict[str, Any]) -> tuple[Any, list[Any], list[Any]]:
    steps = [
        plan_step(
            preview,
            row["recipe"],
            row["target_finding_fp"],
            row.get("target_index"),
            row["seq"],
        )
        for row in construct["steps"]
    ]
    findings = [
        make_finding(
            row["fingerprint"],
            row["code"],
            line=row.get("line"),
            record_id=row.get("record_id"),
        )
        for row in construct.get("findings", [])
    ]
    events = [
        make_event(row.get("id"), row.get("kind")) for row in construct.get("events", [])
    ]
    return make_plan(steps), findings, events


def build_expected(preview: Any, spec: dict[str, Any]) -> dict[str, Any]:
    construct = spec["construct"]
    kind = construct["type"]
    if kind == "PREVIEW_VERSION":
        return {"value": preview.PREVIEW_VERSION}
    if kind == "RECIPE_ACTIONS":
        return {"names": list(preview.RECIPE_ACTIONS.keys())}
    if kind == "bounded_id":
        return {
            "results": [preview._bounded_id(value) for value in construct["values"]]
        }
    if kind == "deltas_for_plan":
        plan, findings, events = build_deltas_input(preview, construct)
        deltas = preview._deltas_for_plan(plan, findings, events)
        expected = spec["expected"]
        if "sort_keys" in expected:
            keys = [
                (row.action, row.seq, row.source_line or 0) for row in deltas
            ]
            want = [tuple(item) for item in expected["sort_keys"]]
            if keys != want:
                raise SystemExit(f"{spec['id']}: sort key mismatch {keys!r} != {want!r}")
            return {"sort_keys": expected["sort_keys"]}
        rows = []
        for index, delta in enumerate(deltas):
            row = delta_row(delta)
            patch = expected["deltas"][index]
            for key, value in patch.items():
                if row.get(key) != value:
                    raise SystemExit(
                        f"{spec['id']}: delta[{index}].{key} "
                        f"got {row.get(key)!r} want {value!r}"
                    )
            rows.append(row)
        return {"deltas": rows}
    if kind == "PreviewDelta_to_dict":
        sparse = preview.PreviewDelta(
            action="drop",
            reason_code="SL000",
            recipe="brand-new-recipe",
            seq=7,
        )
