def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def load_preview_module():
    root = repo_root()
    module_path = root / "src" / "sesslint" / "preview.py"
    digest = hashlib.sha256(module_path.read_bytes()).hexdigest()
    if digest != PREVIEW_SHA256:
        raise SystemExit(
            f"preview.py sha256 mismatch: expected {PREVIEW_SHA256}, got {digest}"
        )
    src = root / "src"
    if str(src) not in sys.path:
        sys.path.insert(0, str(src))
    import sesslint.preview as preview  # noqa: WPS433

    return preview


def delta_row(delta: Any) -> dict[str, Any]:
    row = delta.to_dict()
    row["seq"] = delta.seq
    return row


def make_source(line: Any = None, record_id: Any = None) -> SimpleNamespace | None:
    if line is None and record_id is None:
        return None
    return SimpleNamespace(line=line, record_id=record_id)


def make_finding(
    fingerprint: str,
    code: str,
    *,
    line: Any = None,
    record_id: Any = None,
) -> SimpleNamespace:
    return SimpleNamespace(
        fingerprint=fingerprint,
        code=code,
        source=make_source(line, record_id),
    )


def make_event(event_id: Any = None, kind: Any = None) -> SimpleNamespace:
    return SimpleNamespace(id=event_id, kind=kind)


def make_plan(steps: list[Any]) -> SimpleNamespace:
    return SimpleNamespace(steps=tuple(steps))


def plan_step(
    preview: Any,
    recipe: str,
    target_finding_fp: str,
    target_index: int | None,
    seq: int,
) -> Any:
    from sesslint.repair.planner import PlanStep  # noqa: WPS433

    return PlanStep(
        seq=seq,
        recipe=recipe,
        target_finding_fp=target_finding_fp,
        target_index=target_index,
    )


