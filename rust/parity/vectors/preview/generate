            },
        )
        doc = preview.PreviewDoc(
            source=SYNTHETIC_SOURCE,
            steps=preview._deltas_for_plan(plan, findings, events),
            blocked=(),
            plan_fingerprint=SYNTHETIC_PLAN_FP,
            policy=SYNTHETIC_POLICY,
        )
        payload_json = doc.to_json()
        return {
            "json": payload_json,
            "contains_payload": "payload" in payload_json,
            "contains_content": "content" in payload_json,
        }
    raise ValueError(f"unknown construct type: {kind}")


def main() -> int:
    preview = load_preview_module()
    out_dir = Path(__file__).resolve().parent
    specs = vector_specs(preview)
    vectors: list[dict[str, Any]] = []
    for row in specs:
        expected = build_expected(preview, row)
        vectors.append(
            {
                "id": row["id"],
                "construct": row["construct"],
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": "sesslint.preview",
        "python_commit": PYTHON_COMMIT,
        "preview_py_sha256": PREVIEW_SHA256,
        "known_parity_gaps": KNOWN_PARITY_GAPS,
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    manifest = {
        "schema": SCHEMA,
        "module": "sesslint.preview",
        "python_commit": PYTHON_COMMIT,
        "preview_py_sha256": PREVIEW_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/preview/generate",
        "known_parity_gaps": KNOWN_PARITY_GAPS,
    }
    (out_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.preview parity (bounded ids, plan deltas, "
            "PreviewDoc JSON and human render only)."
        ),
        "generator": "rust/parity/vectors/preview/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": KNOWN_PARITY_GAPS,
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
