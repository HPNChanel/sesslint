#!/usr/bin/env python3
"""Generate sesslint.adapters.load parity vectors (stdlib only; pinned git blobs)."""

from __future__ import annotations

import ast
import hashlib
import json
import re
import subprocess
import sys
import tempfile
import types
from pathlib import Path
from typing import Any, Final

