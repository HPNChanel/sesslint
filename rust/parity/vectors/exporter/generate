def list_tests_in_file(rel: str) -> list[str]:
    source = subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:{rel}"],
        cwd=repo_root(),
        text=True,
        encoding="utf-8",
    )
    names: list[str] = []
    for line in source.splitlines():
        if line.startswith("def test_"):
            names.append(line.split("(")[0].replace("def ", ""))
    return names


def write_coverage(out_dir: Path, vector_ids: frozenset[str]) -> tuple[int, int]:
    rows: list[dict[str, object]] = []
    covered = 0
    not_applicable = 0
    for name in list_tests_in_file(COVERAGE_TEST_FILE):
        qual = f"{COVERAGE_TEST_FILE}::{name}"
        needed = COVERED_BY_VECTORS.get(qual)
        row: dict[str, object] = {"test": qual}
        if needed is not None and all(item in vector_ids for item in needed):
            status = "covered"
            covered += 1
            row["vector_ids"] = list(needed)
        else:
            status = "not_applicable"
            not_applicable += 1
        row["status"] = status
        rows.append(row)
    payload = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": covered,
        "not_applicable_count": not_applicable,
        "rows": rows,
    }
    text = json.dumps(payload, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(text)
    (out_dir / "coverage.json").write_text(text, encoding="utf-8", newline="\n")
    return covered, not_applicable


def ensure_symlink_fixture(out_dir: Path) -> None:
    fixtures = out_dir / "fixtures"
    source = fixtures / "synthetic_source.jsonl"
    link = fixtures / "via_link.jsonl"
    if link.exists() or link.is_symlink():
        link.unlink(missing_ok=True)
    link.symlink_to("synthetic_source.jsonl", target_is_directory=False)


def main() -> int:
    exporter = load_exporter_module()
    out_dir = Path(__file__).resolve().parent
    ensure_fixtures(out_dir)
    ensure_symlink_fixture(out_dir)
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        construct = dict(row["construct"])
        expected = build_expected(exporter, out_dir, construct)
        vectors.append({"id": row["id"], "construct": construct, "expected": expected})
    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "exporter_py_sha256": EXPORTER_PY_SHA256,
        "exporter_rs_sha256": EXPORTER_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(payload)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.exporter parity: module exports, ExportRefused, "
            "ExportSummary.to_dict key order, source path preflight, and the "
            "is_live_store_path seam."
        ),
        "generator": "rust/parity/vectors/exporter/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    prov_text = json.dumps(provenance, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(prov_text)
    (out_dir / "PROVENANCE.json").write_text(prov_text, encoding="utf-8", newline="\n")
    covered, not_applicable = write_coverage(out_dir, frozenset(v["id"] for v in vectors))
    print(f"vectors.json sha256={digest}")
    print(f"vector_count={len(vectors)}")
    print(f"covered={covered} not_applicable={not_applicable}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
