      "construct": {
        "type": "module_all"
      },
      "expected": {
        "mode": "names",
        "names": [
          "REGISTRY",
          "Recipe",
          "clear_registry",
          "get_recipe",
          "list_recipes",
          "recipes_for",
          "register_recipe"
        ]
      }
