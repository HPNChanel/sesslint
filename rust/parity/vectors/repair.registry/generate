def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def fullname_for(path: str) -> str:
    rel = path.removeprefix("src/").removesuffix(".py").replace("/", ".")
    return rel


def ensure_pkg(name: str) -> None:
    if name not in sys.modules:
        mod = types.ModuleType(name)
        mod.__path__ = []
        sys.modules[name] = mod


def exec_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile.NamedTemporaryFile("wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp = handle.name
    spec = importlib.util.spec_from_file_location(fullname, tmp)
    if spec is None or spec.loader is None:
        raise SystemExit(f"failed to create import spec for {fullname}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[fullname] = mod
    try:
        spec.loader.exec_module(mod)
    finally:
        Path(tmp).unlink(missing_ok=True)
    parent = fullname.rsplit(".", 1)[0] if "." in fullname else ""
    if parent:
        parent_mod = sys.modules.setdefault(parent, types.ModuleType(parent))
        setattr(parent_mod, fullname.split(".")[-1], mod)
    return mod


def verify_registry_rs() -> None:
    rs_path = repo_root() / "rust" / "crates" / "repair" / "src" / "registry.rs"
    digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if digest != REGISTRY_RS_SHA256:
        raise SystemExit(
            f"registry.rs sha256 mismatch: expected {REGISTRY_RS_SHA256}, got {digest}"
        )


def verify_preconditions_rs() -> None:
    rs_path = repo_root() / "rust" / "crates" / "repair" / "src" / "preconditions.rs"
    digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if digest != PRECONDITIONS_RS_SHA256:
        raise SystemExit(
            f"preconditions.rs sha256 mismatch: expected {PRECONDITIONS_RS_SHA256}, got {digest}"
        )


def load_registry_module() -> Any:
    verify_registry_rs()
    verify_preconditions_rs()
    for rel in PIN_CLOSURE:
        if rel == "repair/registry.py":
            continue
        path = f"src/sesslint/{rel}"
        if rel == "repair/preconditions.py":
            blob = git_show_bytes(f"{PYTHON_COMMIT}:{path}")
            digest = hashlib.sha256(blob).hexdigest()
            if digest != PRECONDITIONS_PY_SHA256:
                raise SystemExit(
                    f"pinned preconditions.py sha256 mismatch: "
                    f"expected {PRECONDITIONS_PY_SHA256}, got {digest}"
                )
        else:
            blob = git_show_bytes(f"{PYTHON_COMMIT}:{path}")
        fullname = fullname_for(path)
        parts = fullname.split(".")
        for i in range(1, len(parts)):
            ensure_pkg(".".join(parts[:i]))
        exec_blob(blob, fullname)
    registry_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/registry.py")
    digest = hashlib.sha256(registry_blob).hexdigest()
    if digest != REGISTRY_PY_SHA256:
        raise SystemExit(
            f"pinned registry.py sha256 mismatch: expected {REGISTRY_PY_SHA256}, got {digest}"
        )
    ensure_pkg("sesslint.repair")
    return exec_blob(registry_blob, "sesslint.repair.registry")


def callable_field(value: Any) -> dict[str, bool]:
    return {"present": value is not None}


def recipe_snapshot(recipe: Any) -> dict[str, Any]:
    return {
        "mode": "recipe",
        "name": recipe.name,
        "handles": list(recipe.handles),
        "preconditions": list(recipe.preconditions),
        "lossy": recipe.lossy,
        "salvage_only": recipe.salvage_only,
        "min_policy": recipe.min_policy,
        "version": recipe.version,
        "excludes_execution_dependence": recipe.excludes_execution_dependence,
        "apply": callable_field(recipe.apply),
        "affected_region": callable_field(recipe.affected_region),
    }


def build_recipe(reg: Any, spec: dict[str, Any]) -> Any:
    kwargs: dict[str, Any] = {
        "name": spec["name"],
        "handles": tuple(spec.get("handles", ())),
        "preconditions": tuple(spec.get("preconditions", ())),
        "lossy": spec.get("lossy", False),
        "salvage_only": spec.get("salvage_only", False),
    }
    if "min_policy" in spec:
        kwargs["min_policy"] = spec["min_policy"]
    if "version" in spec:
        kwargs["version"] = spec["version"]
    if "excludes_execution_dependence" in spec:
        kwargs["excludes_execution_dependence"] = spec["excludes_execution_dependence"]
    if spec.get("with_callables"):
        kwargs["apply"] = lambda _ctx: True  # noqa: ARG005
        kwargs["affected_region"] = lambda _ctx: None  # noqa: ARG005
    return reg.Recipe(**kwargs)


def run_expected(reg: Any, construct: dict[str, Any]) -> dict[str, Any]:
    kind = construct["type"]
    if kind == "module_all":
        return {"mode": "names", "names": list(reg.__all__)}
    reg.clear_registry()
    if kind == "recipe_try_new":
        spec = construct["recipe"]
        try:
            recipe = build_recipe(reg, spec)
        except ValueError as exc:
            return {"mode": "value_error", "message": str(exc)}
        return recipe_snapshot(recipe)
    if kind == "register_recipe":
        spec = construct["recipe"]
        try:
            recipe = build_recipe(reg, spec)
        except ValueError as exc:
            return {"mode": "value_error", "message": str(exc), "stage": "construct"}
        try:
            reg.register_recipe(recipe)
        except ValueError as exc:
            return {"mode": "value_error", "message": str(exc), "stage": "register"}
        return {"mode": "ok"}
    if kind == "duplicate_name":
        first = build_recipe(reg, construct["initial"])
        reg.register_recipe(first)
        second = build_recipe(reg, construct["attempt"])
        try:
            reg.register_recipe(second)
        except ValueError as exc:
            return {
                "mode": "value_error",
                "message": str(exc),
                "list_names": [r.name for r in reg.list_recipes()],
                "first_handles": list(reg.list_recipes()[0].handles),
            }
        raise SystemExit("duplicate_name vector expected ValueError")
    if kind == "unknown_precondition":
        recipe = build_recipe(reg, construct["recipe"])
        try:
            reg.register_recipe(recipe)
        except ValueError as exc:
            return {
                "mode": "value_error",
                "message": str(exc),
                "preconditions": list(recipe.preconditions),
                "list_len": len(reg.list_recipes()),
            }
        raise SystemExit("unknown_precondition vector expected ValueError")
    if kind == "registration_lookup":
        recipe = build_recipe(reg, construct["recipe"])
        reg.register_recipe(recipe)
        missing = construct.get("missing_name", "non-existent")
        code = construct["code"]
        return {
            "mode": "lookup",
            "get": recipe_snapshot(reg.get_recipe(recipe.name)),
            "get_missing": reg.get_recipe(missing),
            "recipes_for": [recipe_snapshot(r) for r in reg.recipes_for(code)],
            "recipes_for_other": [
                recipe_snapshot(r) for r in reg.recipes_for(construct["other_code"])
            ],
            "list_names": [r.name for r in reg.list_recipes()],
        }
    if kind == "empty_preconditions_register":
        recipe = build_recipe(reg, construct["recipe"])
        reg.register_recipe(recipe)
        return {
            "mode": "ok",
            "list_names": [r.name for r in reg.list_recipes()],
            "recipe": recipe_snapshot(recipe),
        }
    if kind == "clear_registry":
        recipe = build_recipe(reg, construct["recipe"])
        reg.register_recipe(recipe)
        before = len(reg.list_recipes())
        reg.clear_registry()
        after = len(reg.list_recipes())
        reg.register_recipe(recipe)
        return {
            "mode": "cleared",
            "before": before,
            "after": after,
            "restored_names": [r.name for r in reg.list_recipes()],
        }
    if kind == "insertion_order":
        first = build_recipe(reg, construct["first"])
        second = build_recipe(reg, construct["second"])
        reg.register_recipe(first)
        reg.register_recipe(second)
        shared = construct["shared_code"]
        return {
            "mode": "order",
            "list_names": [r.name for r in reg.list_recipes()],
            "recipes_for_shared": [r.name for r in reg.recipes_for(shared)],
        }
    raise SystemExit(f"unknown construct type {kind}")


