def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_rev_parse(rev_path: str) -> str:
    return (
        subprocess.check_output(
            ["git", "rev-parse", f"{rev_path}"],
            cwd=repo_root(),
            text=True,
        )
        .strip()
    )


def verify_graph_py_blob() -> None:
    pin = git_rev_parse(f"{GRAPH_PY_PIN}:src/sesslint/checks/graph.py")
    head = git_rev_parse("HEAD:src/sesslint/checks/graph.py")
    if pin != head:
        raise SystemExit(
            "src/sesslint/checks/graph.py differs from pin blob; "
            f"pin={pin} HEAD={head}"
        )


def verify_graph_rs_sha256() -> None:
    graph_rs = repo_root() / "rust" / "crates" / "checks" / "src" / "graph.rs"
    digest = hashlib.sha256(graph_rs.read_bytes()).hexdigest()
    if digest != GRAPH_RS_SHA256:
        raise SystemExit(
            f"checks/src/graph.rs sha256 mismatch: expected {GRAPH_RS_SHA256}, got {digest}"
        )


def load_graph_module() -> types.ModuleType:
    verify_graph_py_blob()
    verify_graph_rs_sha256()
    src = repo_root() / "src"
    insert = str(src)
    if insert not in sys.path:
        sys.path.insert(0, insert)
    graph_path = src / "sesslint" / "checks" / "graph.py"
    # Load under a private name so `sesslint.checks` is not imported mid-exec
    # (that would recurse into a half-initialized `sesslint.checks.graph`).
    spec = importlib.util.spec_from_file_location(
        "_sesslint_checks_graph_parity", graph_path
    )
    if spec is None or spec.loader is None:
        raise SystemExit("failed to create import spec for graph.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def tagged(value: Any) -> dict[str, Any]:
    if value is None:
        return {"t": "null"}
    if isinstance(value, bool):
        return {"t": "bool", "v": value}
    if isinstance(value, int):
        return {"t": "int", "v": value}
    if isinstance(value, str):
        return {"t": "str", "v": value}
    if isinstance(value, dict):
        entries: list[list[Any]] = []
        for key, val in value.items():
            entries.append([key, tagged(val)])
        return {"t": "map", "entries": entries}
    raise TypeError(f"unencodable {type(value)}")


def encode_event(ev: dict[str, Any]) -> dict[str, Any]:
    return {"entries": [[k, tagged(v)] for k, v in ev.items()]}


def encode_graph_scalar(value: Any) -> dict[str, Any]:
    if isinstance(value, str):
        return {"kind": "str", "v": value}
    if isinstance(value, bool):
        return {"kind": "bool", "v": value}
    if isinstance(value, int):
        return {"kind": "int", "v": value}
    raise TypeError(f"bad graph scalar {type(value)}")


def encode_construct(raw: dict[str, Any]) -> dict[str, Any]:
    kind = raw["type"]
    if kind == "module_dunder_all":
        return dict(raw)
    if kind == "module_constants":
        return dict(raw)
    if kind == "compute_graph_fingerprint":
        return {
            "type": "compute_graph_fingerprint",
            "code": raw["code"],
            "ids": [encode_graph_scalar(x) for x in raw["ids"]],
        }
    if kind == "is_qualifying_parent_candidate":
        return {
            "type": "is_qualifying_parent_candidate",
            "candidate": encode_event(raw["candidate"]),
            "child": encode_event(raw["child"]),
            "events": [encode_event(e) for e in raw["events"]],
            "missing_parent_id": raw["missing_parent_id"],
        }
    if kind == "find_qualifying_parent_candidates":
        return {
            "type": "find_qualifying_parent_candidates",
            "events": [encode_event(e) for e in raw["events"]],
            "child": encode_event(raw["child"]),
            "target_idx": raw["target_idx"],
            "missing_parent_id": raw["missing_parent_id"],
        }
    if kind == "same_compaction_segment":
        return {
            "type": "same_compaction_segment",
            "events": [encode_event(e) for e in raw["events"]],
            "endpoint_a": raw["endpoint_a"],
            "endpoint_b": raw["endpoint_b"],
        }
    if kind in (
        "check_missing_parent",
        "check_cycles",
        "check_components",
        "check_heads",
        "check_graph",
    ):
        return {
            "type": kind,
            "events": [encode_event(e) for e in raw["events"]],
            "source_path": raw.get("source_path", "<canonical>"),
        }
    raise ValueError(f"unknown construct {kind}")


