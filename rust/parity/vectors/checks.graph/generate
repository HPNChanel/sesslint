def encode_expected_case(spec: dict[str, Any]) -> dict[str, Any]:
    cid = spec["id"]
    raw_exp = spec["expected"]
    if cid == "find_qualifying_parent_candidates_no_earlier_match":
        return raw_exp
    if cid == "find_qualifying_parent_candidates_one_earlier_exact":
        return raw_exp
    if cid == "find_qualifying_parent_candidates_two_earlier_exact":
        return raw_exp
    return dict(raw_exp)


def main() -> int:
    graph = load_graph_module()
    out_dir = Path(__file__).resolve().parent

    raw_vectors = vectors_from_graph(graph)
    vectors: list[dict[str, Any]] = []
    for spec in raw_vectors:
        vectors.append(
            {
                "id": spec["id"],
                "construct": encode_construct(spec["construct"]),
                "expected": encode_expected_case(spec),
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "checks_graph_rs_sha256": GRAPH_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "checks_graph_rs_sha256": GRAPH_RS_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/checks.graph/generate",
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.checks.graph parity (stdlib-only vectors; no session "
            "payload text)."
        ),
        "generator": "rust/parity/vectors/checks.graph/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
