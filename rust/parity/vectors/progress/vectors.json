      "id": "progress_event_full",
      "construct": {
        "type": "ProgressEvent",
        "phase": "scan",
        "completed": 3,
        "total": 7,
        "item": "a.jsonl"
      },
      "expected": {
        "to_dict": {
          "completed": 3,
          "item": "a.jsonl",
          "phase": "scan",
          "total": 7
        },
        "json": "{\"completed\": 3, \"item\": \"a.jsonl\", \"phase\": \"scan\", \"total\": 7}"
      }
    },
