def build_expected(progress: Any, spec: dict[str, Any]) -> dict[str, Any]:
    kind = spec["type"]
    if kind == "ndjson_emit":
        stderr = run_ndjson(progress, spec["events"])
        return {"stderr": stderr}
    if kind == "tty_emit":
        stderr = run_tty(
            progress,
            spec["steps"],
            finish=bool(spec.get("finish")),
            clock_times=list(spec["clock_times"]),
        )
        return {"stderr": stderr}
    raise ValueError(f"unknown construct type: {kind}")


def write_outputs(out_dir: Path, vectors: list[dict[str, Any]]) -> str:
    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "progress_py_sha256": PROGRESS_PY_SHA256,
        "cli_progress_py_sha256": PROGRESS_PY_SHA256_CLI,
        "progress_rs_sha256": PROGRESS_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "progress_py_sha256": PROGRESS_PY_SHA256,
        "cli_progress_py_sha256": PROGRESS_PY_SHA256_CLI,
        "progress_rs_sha256": PROGRESS_RS_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/cli._progress/generate",
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic NDJSON and TTY stderr bytes from pinned cli._progress with "
            "injected monotonic clock for TtyProgress (default ctor documented gap)."
        ),
        "generator": "rust/parity/vectors/cli._progress/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    return digest


def main() -> int:
    progress = load_cli_progress_module()
    out_dir = Path(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        construct = {k: v for k, v in row["construct"].items()}
        expected = build_expected(progress, construct)
        vectors.append(
            {
                "id": row["id"],
                "construct": construct,
                "expected": expected,
            }
        )
    digest = write_outputs(out_dir, vectors)
    print(f"wrote {len(vectors)} vectors to {out_dir / 'vectors.json'}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
