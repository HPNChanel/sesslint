MODULE = "sesslint.cli._progress"

SYNTHETIC_PHASE = "scan"
SYNTHETIC_ITEM = "synthetic-item.jsonl"
SYNTHETIC_PHASE_LOAD = "check:load"

KNOWN_PARITY_GAPS = [
    (
        "GAP-cli-progress-tty-default-clock: Python TtyProgress() binds time.monotonic "
        "at construction; Rust MonotonicClock injects a floor so the first incomplete "
        "event always renders without wall-clock delay (not byte-compared here)."
    ),
]


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
    )


def verify_progress_dependency() -> None:
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/progress.py")
    digest = hashlib.sha256(blob).hexdigest()
    if digest != PROGRESS_PY_SHA256:
        raise SystemExit(
            f"progress.py pin sha256 mismatch: expected {PROGRESS_PY_SHA256}, got {digest}"
        )


def pinned_cli_progress_source() -> bytes:
    return git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_progress.py")


def verify_cli_progress_digest(blob: bytes) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != PROGRESS_PY_SHA256_CLI:
        raise SystemExit(
            f"cli/_progress.py pin sha256 mismatch: expected "
            f"{PROGRESS_PY_SHA256_CLI}, got {digest}"
        )


def load_cli_progress_module() -> Any:
    verify_progress_dependency()
    blob = pinned_cli_progress_source()
    verify_cli_progress_digest(blob)
    root = repo_root()
    module_path = root / "src" / "sesslint" / "cli" / "_progress.py"
    if module_path.read_bytes() != blob:
        raise SystemExit("worktree cli/_progress.py does not match pinned blob")
    src = root / "src"
    insert = str(src)
    if insert not in sys.path:
        sys.path.insert(0, insert)
    import importlib

    return importlib.import_module("sesslint.cli._progress")


def build_event(progress: Any, spec: dict[str, Any]) -> Any:
    total = spec.get("total")
    item = spec.get("item")
    return progress.ProgressEvent(
        phase=spec["phase"],
        completed=spec["completed"],
        total=total if "total" in spec else None,
        item=item if "item" in spec else None,
    )


def run_ndjson(progress: Any, events: list[dict[str, Any]]) -> str:
    buf = io.StringIO()
    cb = progress.ndjson_progress_cb(buf)
    for event_spec in events:
        cb(build_event(progress, event_spec))
    return buf.getvalue()


def run_tty(
    progress: Any,
    steps: list[dict[str, Any]],
    *,
    finish: bool,
    clock_times: list[float],
) -> str:
    if len(clock_times) < 1:
        raise ValueError("clock_times required")
    call_idx = [0]

    def fake_monotonic() -> float:
        idx = min(call_idx[0], len(clock_times) - 1)
        call_idx[0] += 1
        return clock_times[idx]

    buf = io.StringIO()
    with patch.object(time, "monotonic", side_effect=fake_monotonic):
        tty = progress.TtyProgress(buf)
        for step in steps:
            tty(build_event(progress, step["event"]))
        if finish:
            tty.finish()
    return buf.getvalue()


