  "known_parity_gaps": [
    "GAP-planner-schema-path: get_plan_schema_path and load_plan_schema import sesslint._resources.schema_path. Rust displays sesslint._resources.schema_path is not available and does not read schemas/sesslint.plan.v1.json.",
    "GAP-planner-register-all: plan after policy, source_hash, and profile checks imports sesslint.repair.recipes_conservative.register_all. Rust displays sesslint.repair.recipes_conservative.register_all is not available and does not return a RepairPlan on the pin success path."
  ],
  "vectors": [
    {
      "id": "module_all_export_order",
      "construct": {
        "type": "module_all"
      },
      "expected": {
        "names": [
          "ALLOWED_LOSS_CLASSES",
          "EMPTY_EVENTS_HASH",
          "MAX_STEPS",
          "PLAN_VERSION",
          "Blocked",
          "Loss",
          "PlanStep",
          "RepairPlan",
          "compute_events_source_hash",
          "get_plan_schema_path",
          "load_plan_schema",
          "plan"
        ]
      }
    },
