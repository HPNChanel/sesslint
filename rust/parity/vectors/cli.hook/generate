def build_expected(hook: types.ModuleType, row: dict[str, Any]) -> dict[str, Any]:
    construct = row["construct"]
    kind = construct["type"]
    if kind == "configure":
        return configure_expected(hook)
    if kind == "run":
        attrs = dict(construct.get("args") or {})
        stdin = bytes.fromhex(construct.get("stdin_hex") or "")
        pin = run_pin(hook, attrs, stdin)
        gap_id = GAP_INIT_HOOKS_DOC if attrs.get("init") else GAP_RUN_HOOK
        return {
            "result": "gap",
            "gap_id": gap_id,
            "computed_output_format": pin.pop("computed_output_format"),
            "pin": pin,
        }
    raise SystemExit(f"unknown construct for {row['id']}")


def assert_payload_clean(payload: bytes) -> None:
    if _BANNED_PAT.search(payload):
        raise SystemExit("vectors.json contains banned marker")
    if b"\r" in payload:
        raise SystemExit("vectors.json must be LF-only")


def main() -> int:
    hook = load_hook_module()
    out_dir = Path(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        expected = build_expected(hook, row)
        vectors.append(
            {
                "id": row["id"],
                "construct": row["construct"],
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "hook_py_sha256": HOOK_PY_SHA256,
        "hook_rs_sha256": HOOK_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    payload_bytes = payload.encode("utf-8")
    assert_payload_clean(payload_bytes)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_bytes(payload_bytes)
    digest = hashlib.sha256(payload_bytes).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.cli.hook configure declarations and run() gap "
            "fixtures from pinned src/sesslint/cli/hook.py (no checkout import)."
        ),
        "generator": "rust/parity/vectors/cli.hook/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
