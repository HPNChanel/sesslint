#!/usr/bin/env python3
"""Generate sesslint.discovery parity vectors from the pinned worktree module (stdlib only)."""

from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path
from typing import Any

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
DISCOVERY_SHA256 = "1ddc7064f153315b414537c9880fd4567c047950a78c7c6bed507ffd88e53e5a"
NOT_UNDER_ROOT_DISPLAY = (
    "path is not in the subpath of root OR one path is relative and the other is absolute."
)


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def load_discovery_module():
    root = repo_root()
    module_path = root / "src" / "sesslint" / "discovery.py"
    digest = hashlib.sha256(module_path.read_bytes()).hexdigest()
    if digest != DISCOVERY_SHA256:
        raise SystemExit(
            f"discovery.py sha256 mismatch: expected {DISCOVERY_SHA256}, got {digest}"
        )
    src = root / "src"
    if str(src) not in sys.path:
        sys.path.insert(0, str(src))
    import sesslint.discovery as discovery  # noqa: WPS433

    return discovery


