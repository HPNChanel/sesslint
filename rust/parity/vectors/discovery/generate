def build_expected(discovery: Any, spec: dict[str, Any]) -> dict[str, Any]:
    construct = spec["construct"]
    if construct["type"] != "candidate_in_layout":
        raise ValueError(f"unknown construct type: {construct['type']}")
    path = Path(construct["path"])
    root = Path(construct["root"])
    agent = construct["agent"]
    subagents = construct["subagents"]
    try:
        result = discovery.candidate_in_layout(
            path, root, agent, subagents=subagents
        )
    except ValueError as exc:
        message = str(exc)
        if message == "agent must be claude or codex":
            return {
                "raises": "ValueError",
                "discovery_error": "InvalidAgent",
                "message": message,
            }
        if "is not in the subpath of" in message or message == NOT_UNDER_ROOT_DISPLAY:
            return {
                "raises": "ValueError",
                "discovery_error": "NotUnderRoot",
                "display": NOT_UNDER_ROOT_DISPLAY,
            }
        raise RuntimeError(f"unexpected ValueError for {spec['id']}: {message!r}")
    return {"result": result}


def main() -> int:
    discovery = load_discovery_module()
    out_dir = Path(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        expected = build_expected(discovery, row)
        vectors.append(
            {
                "id": row["id"],
                "construct": row["construct"],
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": "sesslint.discovery",
        "python_commit": PYTHON_COMMIT,
        "discovery_py_sha256": DISCOVERY_SHA256,
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    manifest = {
        "schema": SCHEMA,
        "module": "sesslint.discovery",
        "python_commit": PYTHON_COMMIT,
        "discovery_py_sha256": DISCOVERY_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/discovery/generate",
    }
    (out_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    provenance = {
        "contains_real_data": False,
        "description": "Synthetic relative paths for sesslint.discovery candidate_in_layout parity.",
        "generator": "rust/parity/vectors/discovery/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
