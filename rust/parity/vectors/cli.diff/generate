#!/usr/bin/env python3
"""Generate sesslint.cli.diff parity vectors from pinned blobs (stdlib only)."""

from __future__ import annotations

import argparse
import ast
import contextlib
import hashlib
import importlib.util
import io
import json
import re
import subprocess
import sys
import tempfile
import types
from argparse import Namespace
from contextlib import contextmanager
from pathlib import Path as FsPath
from typing import Any, Iterator

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
DIFF_PY_SHA256 = (
    "877c6b44e9a4cf32316263445cf7b494c05053adde288df62f0eae72ac514a0d"
)
DIFF_RS_SHA256 = (
    "8128910e1196f6fa59eb1d88968fee14e98994884a86ce0e8ad4f7dcca928cb3"
)
MODULE = "sesslint.cli.diff"

GAP_DIFF_SESSIONS = "GAP-cli-diff-diff-sessions"
RUST_SEAM = "sesslint.diff.diff_sessions is not available"
IMPORT_NAME = "sesslint.diff.diff_sessions"

KNOWN_PARITY_GAPS = [
    (
        f"{GAP_DIFF_SESSIONS}: Python run() starts with "
        "`from sesslint.diff import DiffInputError, diff_sessions` before path checks; "
        "Rust run() returns Display "
        f"`{RUST_SEAM}` at that import (no getattr, no path stat, no emit_text, no exit 0/1)."
    ),
]

_BANNED_PAT = re.compile(
    rb"(?:sk_live_|sk_test_|rk_live_|rk_test_|sbp_[0-9a-f]{40}|sesslint-wt-|FOR_WORK)"
)


def repo_root() -> FsPath:
    return FsPath(__file__).resolve().parents[4]


def git_show(rel: str) -> str:
    return subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:src/sesslint/{rel}"],
        cwd=repo_root(),
        text=True,
    )


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def verify_digest(blob: bytes, expected: str, label: str) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != expected:
        raise SystemExit(f"{label} pin sha256 mismatch: expected {expected}, got {digest}")


def mod_to_paths(mod: str) -> list[str]:
    tail = mod[len("sesslint.") :].replace(".", "/")
    return [f"{tail}.py", f"{tail}/__init__.py"]


def add_sesslint_module(found: set[str], name: str) -> None:
    if name == "sesslint" or not name.startswith("sesslint."):
        return
    found.add(name)


def discover_imports(source: str) -> set[str]:
    found: set[str] = set()
    tree = ast.parse(source)
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                add_sesslint_module(found, alias.name)
        elif isinstance(node, ast.ImportFrom) and node.module:
            add_sesslint_module(found, node.module)
    return found


def closure(root_mod: str) -> list[str]:
    queue = [root_mod]
    seen: set[str] = set()
    order: list[str] = []
    while queue:
        mod = queue.pop(0)
        if mod in seen:
            continue
        seen.add(mod)
        source = None
        for candidate in mod_to_paths(mod):
            try:
                source = git_show(candidate)
                break
            except subprocess.CalledProcessError:
                continue
        if source is None:
            continue
        order.append(mod)
        for imp in discover_imports(source):
            if imp not in seen:
                queue.append(imp)
    return order


def ensure_packages() -> None:
    for pkg in (
        "sesslint",
        "sesslint.adapters",
        "sesslint.checks",
        "sesslint.io",
        "sesslint.scan",
        "sesslint.repair",
        "sesslint.profiles",
        "sesslint.determinism",
    ):
        mod = types.ModuleType(pkg)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[pkg] = mod


def load_module(mod: str, *, temp_main: bool = False) -> None:
    source = None
    rel = None
    for candidate in mod_to_paths(mod):
        try:
            source = git_show(candidate)
            rel = candidate
            break
        except subprocess.CalledProcessError:
            continue
    if source is None or rel is None:
        raise ModuleNotFoundError(mod)
    if temp_main and mod == "sesslint.adapters.detect":
        with tempfile.NamedTemporaryFile(
            "w", suffix=".py", delete=False, encoding="utf-8"
        ) as handle:
            handle.write(source)
            path = handle.name
        code = compile(source, path, "exec")
    else:
        code = compile(source, f"<{PYTHON_COMMIT}:{rel}>", "exec")
    module = types.ModuleType(mod)
    module.__file__ = f"<{PYTHON_COMMIT}:{rel}>"
    sys.modules[mod] = module
    try:
        exec(code, module.__dict__)  # noqa: S102
    except Exception:
        del sys.modules[mod]
        raise
    parent, _, child = mod.rpartition(".")
    if parent in sys.modules:
        setattr(sys.modules[parent], child, module)


def load_pinned_detect() -> types.ModuleType:
    ensure_packages()
    mods = [
        m for m in closure("sesslint.adapters.detect") if m != "sesslint.adapters.detect"
    ]
    pending = list(mods)
    for _ in range(200):
        if not pending:
            break
        nxt: list[str] = []
        progress = False
        for mod in pending:
            try:
                load_module(mod, temp_main=False)
                progress = True
            except (ModuleNotFoundError, ImportError, SyntaxError, Exception):
                nxt.append(mod)
        pending = nxt
        if pending and not progress:
            raise SystemExit(f"stuck loading detect closure: {pending[:12]}")
    load_module("sesslint.adapters.detect", temp_main=True)
    return sys.modules["sesslint.adapters.detect"]


def exec_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile_named_blob(blob) as tmp_path:
        spec = importlib.util.spec_from_file_location(fullname, tmp_path)
        if spec is None or spec.loader is None:
            raise SystemExit(f"failed to create import spec for {fullname}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[fullname] = mod
        spec.loader.exec_module(mod)
        return mod


@contextmanager
def tempfile_named_blob(blob: bytes) -> Iterator[str]:
    with tempfile.NamedTemporaryFile(mode="wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp_path = handle.name
    try:
        yield tmp_path
    finally:
        FsPath(tmp_path).unlink(missing_ok=True)


class _Ctx:
    def __init__(self) -> None:
        self.errors: list[str] = []

    def error(self, message: str) -> None:
        self.errors.append(message)


def install_package_tree() -> None:
    pkg = types.ModuleType("sesslint")
    pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint"] = pkg

    adapters = types.ModuleType("sesslint.adapters")
    adapters.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.adapters"] = adapters
    pkg.adapters = adapters

    detect = load_pinned_detect()
    sys.modules["sesslint.adapters.detect"] = detect
    adapters.detect = detect

    cli_pkg = types.ModuleType("sesslint.cli")
    cli_pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.cli"] = cli_pkg
    pkg.cli = cli_pkg

    context = types.ModuleType("sesslint.cli._context")
    context.CliContext = _Ctx
    sys.modules["sesslint.cli._context"] = context
    cli_pkg._context = context

    common = types.ModuleType("sesslint.cli._common")

    def _output_format(args: Namespace) -> str:
        if getattr(args, "json", False):
            return "json"
        fmt = getattr(args, "output_format", None)
        return fmt if fmt is not None else "human"

    common._output_format = _output_format
    sys.modules["sesslint.cli._common"] = common
    cli_pkg._common = common

    errors = types.ModuleType("sesslint.cli._errors")

    class CliError(Exception):
        pass

    errors.CliError = CliError
    sys.modules["sesslint.cli._errors"] = errors
    cli_pkg._errors = errors

    output_mod = types.ModuleType("sesslint.cli._output")

    def emit_text(
        _ctx: _Ctx,
        _args: Namespace,
        text: str,
        *,
        inputs: tuple[Any, ...] = (),
        summary: str = "",
    ) -> None:
        _ = (inputs, summary)
        sys.stdout.write(text)

    output_mod.emit_text = emit_text
    sys.modules["sesslint.cli._output"] = output_mod
    cli_pkg._output = output_mod

    options_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_options.py")
    options = exec_blob(options_blob, "sesslint.cli._options")
    sys.modules["sesslint.cli._options"] = options
    cli_pkg._options = options


def load_diff_module() -> types.ModuleType:
    install_package_tree()
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/diff.py")
    verify_digest(blob, DIFF_PY_SHA256, "cli/diff.py")
    diff = exec_blob(blob, "sesslint.cli.diff")
    sys.modules["sesslint.cli"].diff = diff
    return diff


def encode_action(action: argparse.Action) -> str:
    if action.const is True and action.nargs == 0:
        return "store_true"
    return "store"


def is_suppress(value: Any) -> bool:
    return value is argparse.SUPPRESS


def encode_default_keyword(action: argparse.Action) -> Any:
    if not action.option_strings:
        return "absent"
    if is_suppress(action.default):
        return {"present": "suppress"}
    if action.const is True and action.default is False:
        return {"present": "false"}
    if action.default is None:
        return {"present": "none"}
    if isinstance(action.default, bool):
        return {"present": "false" if not action.default else "true"}
    if isinstance(action.default, str):
        return {"present": {"text": action.default}}
    raise SystemExit(f"unexpected default for {action.dest}: {action.default!r}")


def encode_effective_default(action: argparse.Action) -> Any:
    if not action.option_strings:
        return "none"
    if is_suppress(action.default):
        return "suppress"
    if action.const is True and action.default is False:
        return "false"
    if action.default is None:
        return "none"
    if isinstance(action.default, bool):
        return "false" if not action.default else "true"
    if isinstance(action.default, str):
        return {"text": action.default}
    raise SystemExit(f"unexpected effective for {action.dest}: {action.default!r}")


def nargs_token(action: argparse.Action) -> Any:
    if action.nargs is None:
        return None
    if action.nargs == 0:
        return "0"
    return str(action.nargs)


def type_name(action: argparse.Action) -> str | None:
    if action.type is None:
        return None
    if hasattr(action.type, "__name__"):
        name = action.type.__name__
        if name == "Path":
            return "Path"
        return name
    return None


def encode_argument(action: argparse.Action) -> dict[str, Any]:
    positional = not action.option_strings
    choices = list(action.choices) if action.choices is not None else None
    if action.dest in {"adapter", "adapter_a", "adapter_b"} and choices is not None:
        choices = sorted(choices)
    required = bool(action.required)
    if action.dest in {"a", "b"}:
        required = True
    return {
        "positional": positional,
        "option_strings": list(action.option_strings),
        "dest": action.dest,
        "action": encode_action(action),
        "nargs": nargs_token(action),
        "type_name": type_name(action),
        "choices": choices,
        "metavar": action.metavar,
        "help": action.help,
        "default_keyword": encode_default_keyword(action),
        "effective_default": encode_effective_default(action),
        "required": required,
    }


def find_exclusive_groups(
    parser: argparse.ArgumentParser,
) -> list[tuple[argparse._MutuallyExclusiveGroup, list[argparse.Action]]]:
    out: list[tuple[argparse._MutuallyExclusiveGroup, list[argparse.Action]]] = []
    for group in parser._mutually_exclusive_groups:
        members = [action for action in group._group_actions if action.dest not in {"help"}]
        if members:
            out.append((group, members))
    return out


def configure_expected(diff: types.ModuleType) -> dict[str, Any]:
    root = argparse.ArgumentParser(prog="sesslint")
    subparsers = root.add_subparsers()
    sub = diff.configure(subparsers)

    subcommand_help = None
    for action in root._actions:
        if isinstance(action, argparse._SubParsersAction):
            for choice_action in action._choices_actions:
                if choice_action.dest == diff.NAME:
                    subcommand_help = choice_action.help
                    break
    if subcommand_help is None:
        raise SystemExit("failed to introspect subcommand help from configure()")

    arguments: list[dict[str, Any]] = []
    for action in sub._actions:
        if action.dest in {"help"}:
            continue
        arguments.append(encode_argument(action))

    groups: list[dict[str, Any]] = []
    for group, members in find_exclusive_groups(sub):
        groups.append(
            {
                "required_keyword": group.required if group.required else None,
                "required": bool(group.required),
                "member_dests": [member.dest for member in members],
            }
        )

    return {
        "name": diff.NAME,
        "help": subcommand_help or "",
        "description": sub.description or "",
        "arguments": arguments,
        "groups": groups,
    }


def namespace_from_spec(attrs: dict[str, Any]) -> Namespace:
    defaults: dict[str, Any] = {
        "a": FsPath("synthetic-a.jsonl"),
        "b": FsPath("synthetic-b.jsonl"),
        "adapter": "auto",
        "adapter_a": None,
        "adapter_b": None,
        "output_format": None,
        "json": False,
        "output": None,
    }
    defaults.update(attrs)
    for key in ("a", "b", "output"):
        value = defaults.get(key)
        if isinstance(value, str):
            defaults[key] = FsPath(value)
    return Namespace(**defaults)


def run_pin(diff: types.ModuleType, attrs: dict[str, Any]) -> dict[str, Any]:
    args = namespace_from_spec(attrs)
    ctx = _Ctx()
    stdout = io.StringIO()
    stderr_lines: list[str] = []
    try:
        with contextlib.redirect_stdout(stdout):
            code = diff.run(ctx, args, None)
    except ModuleNotFoundError as err:
        return {
            "exit_code": None,
            "raised": type(err).__name__,
            "stdout": stdout.getvalue(),
            "stderr": str(err),
        }
    for err in ctx.errors:
        stderr_lines.append(err)
    return {
        "exit_code": code,
        "stdout": stdout.getvalue(),
        "stderr": "\n".join(stderr_lines) + ("\n" if stderr_lines else ""),
    }


def vector_specs() -> list[dict[str, Any]]:
    # run() imports sesslint.diff before any path check. An isolated exec raises
    # ModuleNotFoundError; that is not the pin result. Success rows are omitted.
    return [
        {"id": "configure_subcommand_declarations", "construct": {"type": "configure"}},
    ]


def build_expected(diff: types.ModuleType, row: dict[str, Any]) -> dict[str, Any]:
    construct = row["construct"]
    kind = construct["type"]
    if kind == "configure":
        return configure_expected(diff)
    if kind == "run":
        attrs = dict(construct.get("args") or {})
        pin = run_pin(diff, attrs)
        return {
            "mode": "rust_seam",
            "gap_id": GAP_DIFF_SESSIONS,
            "seam": RUST_SEAM,
            "imports_evaluated": [IMPORT_NAME],
            "pin": pin,
        }
    raise SystemExit(f"unknown construct for {row['id']}")


def assert_payload_clean(payload: bytes) -> None:
    if _BANNED_PAT.search(payload):
        raise SystemExit("vectors.json contains banned marker")
    if b"\r" in payload:
        raise SystemExit("vectors.json must be LF-only")


def main() -> int:
    diff = load_diff_module()
    out_dir = FsPath(__file__).resolve().parent
    rs_path = repo_root() / "rust" / "crates" / "cli" / "src" / "diff.rs"
    rs_digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if rs_digest != DIFF_RS_SHA256:
        raise SystemExit(f"diff.rs sha256 mismatch: expected {DIFF_RS_SHA256}, got {rs_digest}")

    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        expected = build_expected(diff, row)
        vectors.append(
            {
                "id": row["id"],
                "construct": row["construct"],
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "diff_py_sha256": DIFF_PY_SHA256,
        "diff_rs_sha256": DIFF_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    payload_bytes = payload.encode("utf-8")
    assert_payload_clean(payload_bytes)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_bytes(payload_bytes)
    digest = hashlib.sha256(payload_bytes).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.cli.diff configure declarations and run() rust seam "
            "fixtures from pinned src/sesslint/cli/diff.py (no checkout import)."
        ),
        "generator": "rust/parity/vectors/cli.diff/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    coverage = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": 0,
        "not_applicable_count": 0,
        "rows": [],
    }
    (out_dir / "coverage.json").write_text(
        json.dumps(coverage, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
