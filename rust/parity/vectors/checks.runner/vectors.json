    "sesslint.profiles.profile.get_profile",
    "sesslint.report.Coverage",
    "sesslint.report.CoverageSkip"
  ],
  "known_parity_gaps": [
    "GAP-runner-coverage: return_coverage true builds sesslint.report.Coverage in Python after detectors. Rust returns the coverage seam and does not construct Coverage on the successful path.",
    "GAP-runner-profile-name: profile supplied as a str resolves through get_profile and sesslint.profiles.builtin in Python. Rust stops at the builtin seam for ProfileArg::Name.",
    "GAP-runner-detector-profile-deps: non-empty streams call tool_pairing and other detectors that import sesslint.profiles in Python. Rust returns sesslint.profiles is not available instead of running the detector chain.",
    "GAP-runner-executor-alias: repair.executor re-exports run_all_checks; parity vectors exercise sesslint.checks.runner.run_all_checks only.",
    "GAP-runner-verify-delegate: verify._run_detector_checks delegates to the runner with adapter=canonical; that entry point is not this module's vector surface."
  ],
  "vectors": [
    {
      "id": "module_all_export",
      "construct": {
        "type": "module_all"
      },
      "expected": {
        "names": [
          "run_all_checks"
        ]
      }
    },
    {
      "id": "import_paths_pin_order",
      "construct": {
        "type": "import_paths"
      },
      "expected": {
        "paths": [
          "sesslint.canonical.SessionEvent",
          "sesslint.checks.accounting.check_accounting",
          "sesslint.checks.checkpoint.check_checkpoint",
          "sesslint.checks.compaction_snapshot.check_compaction_snapshot",
          "sesslint.checks.context_pressure.check_context_pressure",
          "sesslint.checks.durable_prefix.check_durable_prefix",
          "sesslint.checks.foreign_shape.check_foreign_shape",
          "sesslint.checks.graph.check_graph",
          "sesslint.checks.identity.check_identities",
          "sesslint.checks.ordering.check_ordering",
          "sesslint.checks.size.SIZE_MIN_RECORDS",
          "sesslint.checks.size.check_size_anomaly",
          "sesslint.checks.tool_pairing_1.check_tool_pairing_1",
          "sesslint.checks.tool_pairing_2.check_tool_pairing_2",
          "sesslint.checks.writers.check_writers",
          "sesslint.context.CheckContext",
          "sesslint.finding.Finding",
          "sesslint.profiles.builtin.NEUTRAL_PROFILE",
          "sesslint.profiles.profile.Profile",
          "sesslint.profiles.profile.get_profile",
          "sesslint.report.Coverage",
          "sesslint.report.CoverageSkip"
        ]
      }
    },
    {
      "id": "empty_neutral_no_findings",
      "construct": {
        "type": "run_all_checks",
        "events": []
      },
      "expected": {
        "outcome": "ok",
        "findings_count": 0
      }
    },
    {
      "id": "return_coverage_empty_stop",
      "construct": {
        "type": "run_all_checks",
        "events": [],
        "return_coverage": true
      },
      "expected": {
        "pin": {
          "outcome": "ok",
          "findings_count": 0,
          "coverage_keys": [
            "adapter",
            "performed",
            "profile",
            "skipped"
          ]
        },
        "rust_assertion": {
          "mode": "coverage_unavailable",
          "message": "sesslint.report.Coverage is not available"
        }
      }
    },
