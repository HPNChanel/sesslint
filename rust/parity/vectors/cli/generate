        }
    )
    specs.append(
        {
            "id": "version_label",
            "construct": {"type": "version_label"},
            "expected": {"text": version_action.version},
        }
    )
    specs.append(
        {
            "id": "parser_shell_metadata",
            "construct": {"type": "parser_shell_metadata"},
            "expected": {
                "prog": parser.prog,
