def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def verify_digest(blob: bytes, expected: str, label: str) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != expected:
        raise SystemExit(f"{label} pin sha256 mismatch: expected {expected}, got {digest}")


def verify_lib_rs() -> None:
    lib_rs = repo_root() / "rust" / "crates" / "cli" / "src" / "lib.rs"
    digest = hashlib.sha256(lib_rs.read_bytes()).hexdigest()
    if digest != CLI_LIB_RS_SHA256:
        raise SystemExit(
            f"lib.rs sha256 mismatch: expected {CLI_LIB_RS_SHA256}, got {digest}"
        )


def load_pinned_cli() -> Any:
    verify_lib_rs()
    init_blob = git_show_bytes(f"{PYTHON_COMMIT}:{CLI_INIT_PATH}")
    verify_digest(init_blob, CLI_INIT_PY_SHA256, "cli/__init__.py")
    archive = subprocess.check_output(
        ["git", "archive", "--format=zip", PYTHON_COMMIT, "src/sesslint"],
        cwd=repo_root(),
    )
    temp_dir = tempfile.mkdtemp(prefix="sesslint-cli-init-par-")
    with zipfile.ZipFile(io.BytesIO(archive)) as zf:
        zf.extractall(temp_dir)
    root = Path(temp_dir) / "src"
    if str(root) not in sys.path:
        sys.path.insert(0, str(root))
    return importlib.import_module("sesslint.cli")


def capture_main(cli: Any, argv: list[str]) -> dict[str, Any]:
    import sys as pysys

    out = io.StringIO()
    err = io.StringIO()
    prev_out, prev_err = pysys.stdout, pysys.stderr
    pysys.stdout, pysys.stderr = out, err
    code: int | str
    try:
        code = cli.main(argv)
    except SystemExit as exc:
        if isinstance(exc.code, int):
            code = exc.code
        elif exc.code is None:
            code = 0
        else:
            code = 1
    finally:
        pysys.stdout, pysys.stderr = prev_out, prev_err
    return {
        "exit_code": code,
        "stdout": out.getvalue(),
        "stderr": err.getvalue(),
    }


def verbose_settings_stderr(cli: Any) -> str:
    from sesslint.cli._context import CliContext, Setting

    buf = io.StringIO()

    class Share:
        def write(self, text: str) -> int:
            buf.write(text)
            return len(text)

        def flush(self) -> None:
            return None

    ctx = CliContext(
        quiet=False,
        verbose=True,
        config_path=None,
        settings={
            "zeta": Setting(value="json", source="cli"),
            "alpha": Setting(value="neutral", source="default"),
            "policy": Setting(value=None, source="config:synthetic"),
            "flag": Setting(value=True, source="cli"),
            "max_files": Setting(value=3, source="env:SESSLINT_X"),
            "config": Setting(value="synthetic-config.toml", source="cli"),
        },
        stderr=Share(),
    )
    cli._verbose_settings(ctx)
    return buf.getvalue()


