def load_python_all(cli: Any) -> list[str]:
    return list(cli.__all__)


def imports_cli_module(rel: str) -> bool:
    path = repo_root() / rel
    if not path.is_file():
        return False
    source = path.read_text(encoding="utf-8")
    return bool(
        re.search(
            r"(?:from\s+sesslint\.cli\s+import|import\s+sesslint\.cli\b)",
            source,
        )
    )


def collect_pytest_nodes(rel: str) -> list[str]:
    env = dict(os.environ)
    env["COLUMNS"] = "240"
    proc = subprocess.run(
        ["uv", "run", "pytest", rel, "--collect-only", "--no-header"],
        cwd=repo_root(),
        capture_output=True,
        text=True,
        check=False,
        env=env,
    )
    if proc.returncode != 0:
        raise SystemExit(
            f"pytest --collect-only failed for {rel}: {proc.stderr or proc.stdout}"
        )
    text = re.sub(r"\n[ \t]+", "", proc.stdout)
    pattern = re.compile(
        rf"{re.escape(rel)}::test_[a-z0-9_]+(?:\[[^\]]*\])?"
    )
    return pattern.findall(text)


def write_coverage(
    out_dir: Path, vector_ids: frozenset[str], py_all: list[str]
) -> tuple[int, int]:
    rows: list[dict[str, object]] = []
    covered = 0
    not_applicable = 0
    rows.append(
        {
            "test": "src/sesslint/cli/__init__.py::__all__",
            "status": "not_applicable",
            "python_all_len": len(py_all),
        }
    )
    not_applicable += 1
    rows.append(
        {
            "test": "src/sesslint/cli/__init__.py::load_session_file",
            "status": "not_applicable",
            "reason": "Rust does not alias api.validate_session",
        }
    )
    not_applicable += 1
    for rel in COVERAGE_TEST_FILES:
        if not (repo_root() / rel).is_file():
            continue
        if not imports_cli_module(rel):
            continue
        for qual in collect_pytest_nodes(rel):
            needed = COVERED_BY_VECTORS.get(qual)
            row: dict[str, object] = {"test": qual}
            if needed is not None and all(item in vector_ids for item in needed):
                row["status"] = "covered"
                row["vector_ids"] = list(needed)
                covered += 1
            else:
                row["status"] = "not_applicable"
                reason = NOT_THE_TEST.get(qual)
                if reason is not None:
                    row["reason"] = reason
                not_applicable += 1
            rows.append(row)
    payload = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": covered,
        "not_applicable_count": not_applicable,
        "rows": rows,
    }
    (out_dir / "coverage.json").write_text(
        json.dumps(payload, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    return covered, not_applicable


def assert_payload_clean(payload: bytes) -> None:
    if _BANNED_PAT.search(payload):
        raise SystemExit("committed output contains banned marker")
    if b"\r" in payload:
        raise SystemExit("vectors.json must be LF-only")


def main() -> int:
    cli = load_pinned_cli()
    py_all = load_python_all(cli)
    out_dir = Path(__file__).resolve().parent
    vectors = vector_specs(cli)
    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "cli_init_py_sha256": CLI_INIT_PY_SHA256,
        "cli_lib_rs_sha256": CLI_LIB_RS_SHA256,
        "python_all": py_all,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    payload_bytes = payload.encode("utf-8")
    assert_payload_clean(payload_bytes)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_bytes(payload_bytes)
    digest = hashlib.sha256(payload_bytes).hexdigest()

    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "cli_init_py_sha256": CLI_INIT_PY_SHA256,
        "cli_lib_rs_sha256": CLI_LIB_RS_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/cli/generate",
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )

    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.cli entrypoint parity from pinned __init__.py: "
            "constants, removal hints, verbose settings, and removed-command main "
            "paths only; no session payload text."
        ),
        "generator": "rust/parity/vectors/cli/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )

    covered, not_applicable = write_coverage(
        out_dir, frozenset(v["id"] for v in vectors), py_all
    )
    print(f"vector_count={len(vectors)}")
    print(f"vectors_sha256={digest}")
    print(f"covered={covered} not_applicable={not_applicable}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
