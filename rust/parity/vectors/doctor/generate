def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
    )


def pinned_doctor_source() -> bytes:
    return git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/doctor.py")


def verify_pin_digest(blob: bytes) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != DOCTOR_PY_SHA256:
        raise SystemExit(
            f"doctor.py pin sha256 mismatch: expected {DOCTOR_PY_SHA256}, got {digest}"
        )


def verify_doctor_rs_sha256() -> None:
    rs_path = repo_root() / "rust" / "crates" / "evidence" / "src" / "doctor.rs"
    digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if digest != DOCTOR_RS_SHA256:
        raise SystemExit(
            f"doctor.rs sha256 mismatch: expected {DOCTOR_RS_SHA256}, got {digest}"
        )


def load_doctor_module() -> types.ModuleType:
    blob = pinned_doctor_source()
    verify_pin_digest(blob)
    verify_doctor_rs_sha256()
    root = repo_root()
    module_path = root / "src" / "sesslint" / "doctor.py"
    if module_path.read_bytes() == blob:
        src = root / "src"
        insert = str(src)
        if insert not in sys.path:
            sys.path.insert(0, insert)
        import importlib

        return importlib.import_module("sesslint.doctor")

    import tempfile

    with tempfile.NamedTemporaryFile(
        mode="wb",
        suffix="_pinned_doctor.py",
        delete=False,
    ) as handle:
        handle.write(blob)
        tmp_path = handle.name
    try:
        mod_name = "_sesslint_doctor_parity"
        spec = importlib.util.spec_from_file_location(mod_name, tmp_path)
        if spec is None or spec.loader is None:
            raise SystemExit("failed to create import spec for pinned doctor.py")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[mod_name] = mod
        spec.loader.exec_module(mod)
        return mod
    finally:
        Path(tmp_path).unlink(missing_ok=True)


def rel_posix(base: Path, path: Path) -> str:
    return path.relative_to(base).as_posix()


def touch(path: Path, *, stamp: float | None = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("", encoding="utf-8", newline="\n")
    when = 1_700_000_000.0 if stamp is None else stamp
    os.utime(path, (when, when))


def ensure_count_fixtures(out_dir: Path) -> Path:
    fixtures = out_dir / "fixtures" / "count_walk"
    for name in [
        "b.json",
        "a.txt",
        "sesslint.toml",
        ".sesslint.toml",
        "c.jsonl",
        "A.JSON",
        "keep.JSONL",
    ]:
        touch(fixtures / name)
    touch(fixtures / "m" / "d.json")
    touch(fixtures / ".git" / "hidden.json")
    touch(fixtures / ".hg" / "hidden.json")
    touch(fixtures / ".svn" / "hidden.json")
    touch(fixtures / "z" / "inner" / "e.json")
    return fixtures


