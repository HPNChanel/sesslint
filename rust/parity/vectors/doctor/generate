        reader_limits={"z": 1, "a": None},
        config_path=None,
        roots=(),
    )
    mixed = doctor.DoctorReport(
        tool_version="t",
        adapters=(row("n", ["a", 2, None, True, False]),),
        reader_limits={"m": 0},
        config_path=None,
