        missing_name.render_human()
        raise SystemExit("render_key_error_name: expected KeyError")
    except KeyError as exc:
        name_err = repr(exc.args[0])

    vectors.extend(
        [
            {
                "id": "render_key_error_versions",
                "construct": {"type": "DoctorReport_render_key_error", "variant": "versions"},
                "expected": {"error": vers_err},
            },
            {
                "id": "render_key_error_name",
                "construct": {"type": "DoctorReport_render_key_error", "variant": "name"},
                "expected": {"error": name_err},
            },
        ]
    )
    return vectors


def count_vectors(out_dir: Path, doctor: Any) -> list[dict[str, Any]]:
    walk = ensure_count_fixtures(out_dir)
    rel_walk = rel_posix(out_dir, walk)
    counted = doctor._count_files(walk)
    candidates = [rel_posix(walk, path) for path in counted[2]]

    import tempfile

    with tempfile.TemporaryDirectory(prefix="sesslint-doctor-cap-") as tmp:
        cap_root = Path(tmp)
        for index in range(doctor.MAX_FILE_COUNT + 1):
            touch(cap_root / f"n{index:05d}.txt")
        cap = doctor._count_files(cap_root)

    missing = walk.parent / "fixtures" / "count_missing" / "no-such"
    miss = doctor._count_files(missing)

    single = out_dir / "fixtures" / "count_file_root.txt"
    touch(single)
    rel_single = rel_posix(out_dir, single)
    file_root = doctor._count_files(single)

    return [
        {
            "id": "count_files_walk_sorted",
            "construct": {
                "type": "count_files",
                "development_path": rel_walk,
            },
            "expected": {
                "count": counted[0],
                "capped": counted[1],
                "candidates": candidates,
            },
        },
        {
            "id": "count_files_missing_dir",
            "construct": {
                "type": "count_files",
                "development_path": rel_posix(out_dir, missing),
            },
            "expected": {
                "count": miss[0],
                "capped": miss[1],
                "candidates": [],
            },
        },
        {
            "id": "count_files_file_root",
            "construct": {
                "type": "count_files",
                "development_path": rel_single,
            },
            "expected": {
                "count": file_root[0],
                "capped": file_root[1],
                "candidates": [],
            },
        },
        {
            "id": "count_files_cap",
            "construct": {"type": "count_files_cap", "extra_files": doctor.MAX_FILE_COUNT + 1},
            "expected": {
                "count": cap[0],
                "capped": cap[1],
                "candidates": [],
            },
        },
    ]


def make_check_report(
    *,
    limitation: str = "",
    severities: dict[str, int] | None = None,
    codes: list[str] | None = None,
) -> Any:
    sev = severities or {}
    findings = []
    for code in codes or []:
        findings.append(SimpleNamespace(code=code))
    counts = SimpleNamespace(by_severity=sev)
    return SimpleNamespace(limitation=limitation, counts=counts, findings=findings)


def run_quick_with_reports(
    doctor: Any, views: list[Any | None], out_dir: Path
) -> tuple[int, dict[str, int], tuple]:
    quick = out_dir / "fixtures" / "quick" / "synthetic"
    quick.mkdir(parents=True, exist_ok=True)
    files = []
    for index, _view in enumerate(views):
        path = quick / f"quick-{index:02d}.json"
        touch(path, stamp=1_700_000_000.0 - index)
        files.append(path)

    def fake_check(path: Path) -> Any:
        index = int(path.stem.split("-")[-1], 10)
        view = views[index]
        if view is None:
            raise RuntimeError("synthetic unreadable")
        return view

    with patch("sesslint.api.check_file", side_effect=fake_check):
        return doctor._quick_verdicts(tuple(files))


def quick_vectors(doctor: Any, out_dir: Path) -> list[dict[str, Any]]:
    empty = doctor._quick_verdicts(())
    sub = out_dir / "fixtures" / "quick" / "sub"
    sub.mkdir(parents=True, exist_ok=True)
    missing = out_dir / "fixtures" / "quick" / "nope.json"
    ignored = doctor._quick_verdicts((sub, missing))

    ruled_views: list[Any | None] = [
        make_check_report(
            limitation="Unsupported: synthetic",
            severities={"fatal": 4, "error": 1},
            codes=["SYN-Z"],
        ),
        None,
        make_check_report(
            limitation="Skipped: synthetic",
            severities={"warning": 9},
            codes=[],
        ),
        make_check_report(
            severities={"error": 1, "warning": 3},
            codes=["SYN-B", "SYN-A"],
        ),
        make_check_report(
            limitation="warning-not-a-prefix",
            severities={"warning": 1, "fatal": 0},
            codes=["SYN-A"],
        ),
    ]
    ruled = run_quick_with_reports(doctor, ruled_views, out_dir)

    crowded_views: list[Any] = [
        make_check_report(codes=["SYN-B"]),
        make_check_report(codes=["SYN-B"]),
        make_check_report(codes=["SYN-B"]),
        make_check_report(codes=["SYN-A"]),
        make_check_report(codes=["SYN-A"]),
    ]
    crowded = run_quick_with_reports(doctor, crowded_views, out_dir)

    def verdict_list(verdicts: dict[str, int], *, sorted_keys: bool) -> list[list[Any]]:
        if sorted_keys:
            keys = sorted(verdicts)
        else:
            keys = list(verdicts)
        return [[key, verdicts[key]] for key in keys]

    def top_list(top: tuple[tuple[str, int], ...]) -> list[list[Any]]:
        return [[code, count] for code, count in top]

    def outcome_spec(view: Any | None) -> dict[str, Any]:
        if view is None:
            return {"kind": "unreadable"}
        return {
            "kind": "report",
            "limitation": view.limitation,
            "by_severity": list(view.counts.by_severity.items()),
            "finding_codes": [f.code for f in view.findings],
        }

    return [
        {
            "id": "quick_verdicts_empty",
            "construct": {"type": "quick_verdicts", "paths": []},
            "expected": {
                "checked": empty[0],
                "verdicts": verdict_list(empty[1], sorted_keys=True),
                "top_codes": top_list(empty[2]),
            },
        },
        {
            "id": "quick_verdicts_ignores_non_files",
            "construct": {
                "type": "quick_verdicts",
                "paths": [
                    rel_posix(out_dir, sub),
                    rel_posix(out_dir, missing),
                ],
            },
            "expected": {
                "checked": ignored[0],
                "verdicts": verdict_list(ignored[1], sorted_keys=True),
                "top_codes": top_list(ignored[2]),
            },
        },
        {
            "id": "verdict_rules_order",
            "construct": {
                "type": "verdicts_from_outcomes",
                "outcomes": [outcome_spec(v) for v in ruled_views],
            },
            "expected": {
                "checked": ruled[0],
                "verdicts": verdict_list(ruled[1], sorted_keys=False),
                "top_codes": top_list(ruled[2]),
            },
        },
        {
            "id": "verdict_top_codes_cap",
            "construct": {
                "type": "verdicts_from_outcomes",
                "outcomes": [outcome_spec(v) for v in crowded_views],
            },
            "expected": {
                "checked": crowded[0],
                "top_codes": top_list(crowded[2]),
            },
        },
    ]


def build_vectors(doctor: Any, out_dir: Path) -> list[dict[str, Any]]:
    vectors: list[dict[str, Any]] = []
    vectors.extend(iso_utc_vectors(doctor))
    vectors.extend(index_vectors(doctor))
    vectors.extend(report_vectors(doctor))
    vectors.extend(count_vectors(out_dir, doctor))
    vectors.extend(quick_vectors(doctor, out_dir))
    return vectors


def write_outputs(out_dir: Path, vectors: list[dict[str, Any]]) -> str:
    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "doctor_py_sha256": DOCTOR_PY_SHA256,
        "doctor_rs_sha256": DOCTOR_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "doctor_py_sha256": DOCTOR_PY_SHA256,
        "doctor_rs_sha256": DOCTOR_RS_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/doctor/generate",
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.doctor parity (iso_utc, count walk, quick "
            "verdict classification with mocked check_file, report JSON "
            "and human render)."
        ),
        "generator": "rust/parity/vectors/doctor/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    return digest


def main() -> int:
    out_dir = Path(__file__).resolve().parent
    doctor = load_doctor_module()
    vectors = build_vectors(doctor, out_dir)
    digest = write_outputs(out_dir, vectors)
    print(f"wrote {len(vectors)} vectors to {out_dir / 'vectors.json'}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
