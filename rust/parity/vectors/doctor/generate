def index_vectors(doctor: Any) -> list[dict[str, Any]]:
    absent = doctor.IndexDiag(
        sessions_on_disk=2,
        index_entries=None,
        state="absent",
    )
    zero = doctor.IndexDiag(sessions_on_disk=0, index_entries=0, state="not-a-closed-state")
    return [
        {
            "id": "index_diag_to_dict_absent",
            "construct": {"type": "IndexDiag_to_dict", "variant": "absent"},
            "expected": {"to_dict": absent.to_dict()},
        },
        {
            "id": "index_diag_to_dict_zero",
            "construct": {"type": "IndexDiag_to_dict", "variant": "zero"},
            "expected": {"to_dict": zero.to_dict()},
        },
    ]


def row(name: str, versions: Any, **extra: Any) -> dict[str, object]:
    out: dict[str, object] = {"name": name, "versions_supported": versions}
    out.update(extra)
    return out


def primary_report(doctor: Any) -> Any:
    return doctor.DoctorReport(
        tool_version="0.5.0",
        adapters=(
            row(
                "synthetic",
                ["v1", "v2"],
                default_profile="neutral",
                description="synthetic adapter row",
            ),
            row("wide-name-exceeds-twenty-four", []),
        ),
        reader_limits={
            "max_line_bytes": 8,
            "max_depth": 3,
            "max_file_bytes": 100,
            "max_records": None,
        },
        config_path=None,
        roots=(),
    )


