  "known_parity_gaps": [
    "GAP-doctor-index-health: index_health stops at sesslint.indexes.discover_index_files.",
    "GAP-doctor-doctor-report: doctor_report stops at sesslint.adapters.supported_adapters.",
    "GAP-doctor-schema-path: get_doctor_schema_path stops at sesslint._resources.schema_path.",
    "GAP-doctor-load-schema: load_doctor_schema stops at sesslint._resources.schema_path.",
    "GAP-doctor-minimize-path: RootDiag and DoctorReport to_dict, to_json, and render_human call sesslint.report.minimize_path unless paths are already shown via the parity shim.",
    "GAP-doctor-check-file: quick_verdicts stops at sesslint.api.check_file when at least one regular file is selected."
  ],
