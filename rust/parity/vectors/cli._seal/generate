            "construct": {
                "type": "check_seal_verdict",
                "limitation": "Unsupported: synthetic-adapter",
                "by_code": {"SL301": 1},
                "by_severity": {"error": 3, "fatal": 1},
            },
        },
        {
            "id": "skipped_prefix_wins_over_sl301_and_errors",
            "construct": {
                "type": "check_seal_verdict",
                "limitation": "Skipped: synthetic-skip",
                "by_code": {"SL301": 1},
                "by_severity": {"error": 2},
            },
        },
        {
            "id": "limitation_without_colon_unsupported_not_prefix",
            "construct": {
                "type": "check_seal_verdict",
                "limitation": "Unsupported",
                "by_code": {},
                "by_severity": {},
            },
        },
        {
            "id": "limitation_without_colon_skipped_not_prefix",
            "construct": {
                "type": "check_seal_verdict",
                "limitation": "Skipped",
                "by_code": {},
                "by_severity": {},
            },
        },
        {
            "id": "sl301_nonzero_is_unsupported",
            "construct": {
                "type": "check_seal_verdict",
                "limitation": "",
                "by_code": {"SL301": 1},
                "by_severity": {"error": 9},
            },
        },
        {
            "id": "sl301_zero_does_not_force_unsupported",
            "construct": {
                "type": "check_seal_verdict",
                "limitation": "",
                "by_code": {"SL301": 0},
                "by_severity": {"error": 1},
            },
        },
        {
            "id": "sl301_missing_does_not_force_unsupported",
            "construct": {
                "type": "check_seal_verdict",
