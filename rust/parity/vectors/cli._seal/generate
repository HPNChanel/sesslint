#!/usr/bin/env python3
"""Generate sesslint.cli._seal parity vectors from the pinned worktree module (stdlib only)."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
import tempfile
from pathlib import Path
from types import SimpleNamespace
from typing import Any

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
SEAL_SHA256 = "bf42016fea0eece1a96633ce6877a785d03da0f62a870fd87a88a06637eefc1c"
SYNTHETIC_LEDGER_BEFORE = b"synthetic-ledger-before\n"

KNOWN_GAPS = [
    "sesslint.seal and sesslint.report.minimize_path are not ported; Rust maybe_append_seal returns SealError::Unsupported when --seal is present (no successful append vector).",
    "Python getattr(args, 'seal', None) treats seal=False as present; Rust cli_supplied treats ArgValue::Bool(false) as absent (no seal=False vector).",
]


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def load_seal_module():
    root = repo_root()
    module_path = root / "src" / "sesslint" / "cli" / "_seal.py"
    digest = hashlib.sha256(module_path.read_bytes()).hexdigest()
    if digest != SEAL_SHA256:
        raise SystemExit(
            f"_seal.py sha256 mismatch: expected {SEAL_SHA256}, got {digest}"
        )
    src = root / "src"
    if str(src) not in sys.path:
        sys.path.insert(0, str(src))
    from sesslint.cli._context import CliContext  # noqa: WPS433
    from sesslint.cli._seal import _check_seal_verdict, _maybe_append_seal  # noqa: WPS433

    return _check_seal_verdict, _maybe_append_seal, CliContext


class SyntheticReport:
    """Minimal report view for _check_seal_verdict (synthetic counts only)."""

    def __init__(
        self,
        limitation: str,
        by_code: dict[str, int] | None = None,
        by_severity: dict[str, int] | None = None,
    ) -> None:
        self.limitation = limitation
        self.counts = SimpleNamespace(
            by_code=dict(by_code or {}),
            by_severity=dict(by_severity or {}),
        )


def vector_specs() -> list[dict[str, Any]]:
    return [
