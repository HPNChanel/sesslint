        },
    ]


def build_expected(
    check_seal_verdict: Any,
    maybe_append_seal: Any,
    CliContext: type,
    spec: dict[str, Any],
) -> dict[str, Any]:
    kind = spec["type"]
    if kind == "check_seal_verdict":
        report = SyntheticReport(
            limitation=str(spec.get("limitation", "")),
            by_code=dict(spec.get("by_code") or {}),
            by_severity=dict(spec.get("by_severity") or {}),
        )
        return {"verdict": check_seal_verdict(report)}
    if kind == "maybe_append_seal_absent":
        with tempfile.TemporaryDirectory(prefix="synthetic-cli-seal-par-") as tmp:
            ledger = Path(tmp) / "synthetic-ledger.jsonl"
            ledger.write_bytes(SYNTHETIC_LEDGER_BEFORE)
            ctx = CliContext(quiet=True, verbose=False, config_path=None, settings={})
            args = argparse.Namespace(seal=None)
            before = ledger.read_bytes()
            result = maybe_append_seal(
                ctx,
                args,
                tool="synthetic-check",
                artifact_bytes=b"synthetic-artifact-bytes",
                artifact_path=None,
                verdict="healthy",
                codes={"SL001": 0},
                report_bytes=b"synthetic-report-bytes",
            )
            after = ledger.read_bytes()
            if result is not None:
                raise SystemExit("maybe_append_seal_absent: expected None result")
            if before != after or after != SYNTHETIC_LEDGER_BEFORE:
                raise SystemExit("maybe_append_seal_absent: ledger bytes changed")
        return {"result": "none", "ledger_unchanged": True}
    raise ValueError(f"unknown construct type: {kind}")


def main() -> int:
    check_seal_verdict, maybe_append_seal, CliContext = load_seal_module()
    out_dir = Path(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        expected = build_expected(
            check_seal_verdict,
            maybe_append_seal,
            CliContext,
            row["construct"],
        )
        vectors.append(
            {
                "id": row["id"],
                "construct": row["construct"],
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": "sesslint.cli._seal",
        "python_commit": PYTHON_COMMIT,
        "seal_py_sha256": SEAL_SHA256,
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    manifest = {
        "schema": SCHEMA,
        "module": "sesslint.cli._seal",
        "python_commit": PYTHON_COMMIT,
        "seal_py_sha256": SEAL_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/cli._seal/generate",
        "known_gaps": KNOWN_GAPS,
    }
    (out_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    provenance = {
        "contains_real_data": False,
        "description": "Synthetic cli._seal check_seal_verdict and absent --seal maybe_append_seal parity (counts only).",
        "generator": "rust/parity/vectors/cli._seal/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
