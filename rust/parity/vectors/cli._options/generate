def build_expected(mod: Any, row: dict[str, Any]) -> dict[str, Any]:
    construct = row["construct"]
    kind = construct["type"]
    gap_id = construct.get("gap_id")

    if kind == "validate_positive_int":
        expected = run_positive_int(mod, str(construct["input"]))
        if gap_id:
            if expected.get("result") != "ok":
                raise SystemExit(f"{row['id']}: pin must succeed for gap vector")
            return {
                "result": "gap",
                "gap_id": gap_id,
                "pin": expected,
            }
        return expected
    if kind == "validate_unit_interval_float":
        return run_unit_interval(mod, str(construct["input"]))
    if kind == "add_adapter_option":
        return run_adapter_option(mod)
    raise SystemExit(f"unknown construct type {kind}")


def assert_no_banned_patterns(payload: bytes) -> None:
    if _BANNED_SUPABASE_PAT.search(payload):
        raise SystemExit("vectors payload matches banned sbp_ pattern")
    forbidden = (
        b"sesslint-wt-",
        b"FOR_WORK",
        b"WORK_PROJECT",
        b"sk_live_",
        b"sk_test_",
        b"rk_live_",
        b"rk_test_",
    )
    lowered = payload.lower()
    for needle in forbidden:
        if needle.lower() in lowered:
            raise SystemExit(f"vectors payload contains forbidden substring {needle!r}")


def main() -> int:
    mod = exec_options_module()
    out_dir = Path(__file__).resolve().parent
    specs = vector_specs()
    vectors: list[dict[str, Any]] = []
    for row in specs:
        construct = dict(row["construct"])
        expected = build_expected(mod, row)
        vectors.append(
            {
                "id": row["id"],
                "construct": construct,
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "options_py_sha256": OPTIONS_PY_SHA256,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    encoded = payload.encode("utf-8")
    assert_no_banned_patterns(encoded)
    if b"\r" in encoded:
        raise SystemExit("vectors payload must be LF-only")

    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(encoded).hexdigest()

    coverage = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": 0,
        "not_applicable_count": 0,
        "rows": [],
    }
    (out_dir / "coverage.json").write_text(
        json.dumps(coverage, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )

    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.cli._options validator and adapter declaration parity "
            "from pinned _options.py."
        ),
        "generator": "rust/parity/vectors/cli._options/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
