#!/usr/bin/env python3
"""Generate sesslint.cli._options parity vectors from the pinned _options.py blob (stdlib only)."""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import re
import subprocess
import sys
import tempfile
import types
from pathlib import Path
from typing import Any

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
OPTIONS_PY_SHA256 = (
    "4ca584f58db908f9aef026adb87cf51bee6960884699c79fbcd5a9dc29e2f0ea"
)
MODULE = "sesslint.cli._options"

KNOWN_PARITY_GAPS = [
    (
        "GAP-options-positive-int-i64: _validate_positive_int accepts positive "
        "integers beyond i64::MAX in Python; Rust refuses with "
        "int value does not fit i64 (PositiveIntError::Magnitude), not pin int semantics."
    ),
]

_BANNED_SUPABASE_PAT = re.compile(rb"sbp_[0-9a-f]{40}")


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
    )


def verify_digest(blob: bytes, expected: str, label: str) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != expected:
        raise SystemExit(f"{label} pin sha256 mismatch: expected {expected}, got {digest}")


def install_adapter_detect_stub() -> None:
    pkg = types.ModuleType("sesslint")
    pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint"] = pkg

    adapters = types.ModuleType("sesslint.adapters")
    adapters.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.adapters"] = adapters
    pkg.adapters = adapters

    detect = types.ModuleType("sesslint.adapters.detect")
    detect.VALID_FORMAT_OPTIONS = frozenset(
        {
            "auto",
            "canonical",
            "claude-code-jsonl",
            "codex-rollout",
            "openai-agents",
        }
    )
    sys.modules["sesslint.adapters.detect"] = detect
    adapters.detect = detect

    cli_pkg = types.ModuleType("sesslint.cli")
    cli_pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.cli"] = cli_pkg
    pkg.cli = cli_pkg


def exec_options_module() -> types.ModuleType:
    install_adapter_detect_stub()
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_options.py")
    verify_digest(blob, OPTIONS_PY_SHA256, "_options.py")
    with tempfile.NamedTemporaryFile(mode="wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp_path = handle.name
    try:
        spec = importlib.util.spec_from_file_location(MODULE, tmp_path)
        if spec is None or spec.loader is None:
            raise SystemExit(f"failed to create import spec for {MODULE}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[MODULE] = mod
        spec.loader.exec_module(mod)
        return mod
    finally:
        Path(tmp_path).unlink(missing_ok=True)


def run_positive_int(mod: Any, text: str) -> dict[str, Any]:
    try:
        value = mod._validate_positive_int(text)
    except argparse.ArgumentTypeError as err:
        return {"result": "error", "message": str(err)}
    if isinstance(value, int):
        return {"result": "ok", "value_kind": "int", "value": value}
    raise SystemExit(f"unexpected positive_int return type {type(value)}")


def run_unit_interval(mod: Any, text: str) -> dict[str, Any]:
    try:
        value = mod._validate_unit_interval_float(text)
    except argparse.ArgumentTypeError as err:
        return {"result": "error", "message": str(err)}
    if isinstance(value, float):
        return {"result": "ok", "value_kind": "float", "value": format(value, "g")}
    raise SystemExit(f"unexpected unit_interval return type {type(value)}")


def run_adapter_option(mod: Any) -> dict[str, Any]:
    parser = argparse.ArgumentParser()
    mod.add_adapter_option(parser)
    action = next(a for a in parser._actions if "--adapter" in a.option_strings)
    choices = list(action.choices)
    if action.default is not argparse.SUPPRESS:
        raise SystemExit("adapter default must be argparse.SUPPRESS")
    expected_choices = [
        "auto",
        "canonical",
        "claude-code-jsonl",
        "codex-rollout",
        "openai-agents",
    ]
    if choices != expected_choices:
        raise SystemExit(f"unexpected adapter choices: {choices}")
    return {
        "result": "ok",
        "choices": choices,
        "default": "argparse.SUPPRESS",
        "default_distinct_from_none": True,
        "default_distinct_from_false": True,
    }


