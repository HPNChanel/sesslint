{
  "schema": "sesslint.parity-module-vectors/v1",
  "module": "sesslint.seal",
  "python_commit": "e91d50b2ecea57ef4dd900e3b0b87b14946e847e",
  "seal_py_sha256": "37bc7254f2195338db891f8a0fe8a60f1dd0003a76ed4375769d76ef9b2bdf28",
  "canonical_codec_py_sha256": "20f5ba80c0a6ad0be4e096707ffdaac51be88323560321eccbbfdce231b79eee",
  "seal_rs_sha256": "d8c3987425e6d579f7cc2f42b2bd9e12e84bb23eb2077ded908db769261d7c5a",
  "known_parity_gaps": [
    "GAP-seal-ledger-lock: append_seal and _ledger_lock use msvcrt.locking or fcntl.flock; Rust ledger_lock closes the sidecar and returns LockingUnavailable before append (not byte-compared here).",
    "GAP-seal-resources: get_seal_schema_path and load_seal_schema import sesslint._resources.schema_path; Rust returns ResourcesUnavailable (not byte-compared here).",
    "GAP-seal-verify-wide-json-integer: verify_lines on entries with integers outside the Rust codec range returns a canonical error in Rust; Python may still report chain divergence (not byte-compared here)."
  ],
  "vectors": [
    {
      "id": "module_all_export_order",
      "construct": {
        "type": "module_all"
      },
      "expected": {
        "names": [
          "DIVERGENCE_KINDS",
          "GENESIS",
          "SEAL_SCHEMA_ID",
          "SEAL_TOOLS",
          "SealError",
          "append_seal",
          "build_entry",
          "get_seal_schema_path",
          "load_seal_schema",
          "sha256_bytes",
          "sha256_file",
          "verify_ledger",
          "verify_lines"
        ]
      }
    },
