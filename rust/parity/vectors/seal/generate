def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
    )


def verify_digest(blob: bytes, expected: str, label: str) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != expected:
        raise SystemExit(f"{label} pin sha256 mismatch: expected {expected}, got {digest}")


def exec_module_from_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile.NamedTemporaryFile(mode="wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp_path = handle.name
    try:
        spec = importlib.util.spec_from_file_location(fullname, tmp_path)
        if spec is None or spec.loader is None:
            raise SystemExit(f"failed to create import spec for {fullname}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[fullname] = mod
        spec.loader.exec_module(mod)
        return mod
    finally:
        Path(tmp_path).unlink(missing_ok=True)


def install_package_tree() -> None:
    pkg = types.ModuleType("sesslint")
    pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint"] = pkg

    errors_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/errors.py")
    errors = exec_module_from_blob(errors_blob, "sesslint.errors")
    pkg.errors = errors

    canonical = types.ModuleType("sesslint.canonical")

    class SessionEvent:  # noqa: D101
        pass

    canonical.SessionEvent = SessionEvent
    sys.modules["sesslint.canonical"] = canonical
    pkg.canonical = canonical

    codec_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/_canonical_codec.py")
    verify_digest(codec_blob, CANONICAL_CODEC_PY_SHA256, "_canonical_codec.py")
    codec = exec_module_from_blob(codec_blob, "sesslint._canonical_codec")
    pkg._canonical_codec = codec


def load_seal_module() -> types.ModuleType:
    install_package_tree()
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/seal.py")
    verify_digest(blob, SEAL_PY_SHA256, "seal.py")
    seal = exec_module_from_blob(blob, "sesslint.seal")
    sys.modules["sesslint"].seal = seal
    return seal


def hex_digest(byte_val: int) -> str:
    return f"{byte_val:02x}" * 32


def canonical_line(seal: Any, entry: dict[str, Any]) -> str:
    from sesslint._canonical_codec import canonical_json_bytes  # noqa: WPS433

    line = canonical_json_bytes(entry, newline=True)
    return line.decode("utf-8")


def linked_entry(
    seal: Any,
    seq: int,
    prev: str,
    byte_val: int,
) -> dict[str, Any]:
    file_sha = hex_digest(byte_val)
    return seal.build_entry(
        seq=seq,
        prev_sha256=prev,
        file_sha256=file_sha,
        path=None,
        tool="check",
        verdict="healthy",
        codes={},
        report_sha256=REPORT_HEX,
        now=FIXED_NOW,
    )


def entry_fields(entry: dict[str, Any]) -> dict[str, Any]:
    row: dict[str, Any] = {
        "schema": entry["schema"],
        "seq": entry["seq"],
        "prev_sha256": entry["prev_sha256"],
        "file_sha256": entry["file_sha256"],
        "tool": entry["tool"],
        "verdict": entry["verdict"],
        "codes": entry["codes"],
        "report_sha256": entry["report_sha256"],
        "sealed_at": entry["sealed_at"],
        "entry_sha256": entry["entry_sha256"],
    }
    if "path" in entry:
        row["path"] = entry["path"]
    if "genesis_of" in entry:
        row["genesis_of"] = entry["genesis_of"]
    return row


def divergence_expected(div: dict[str, Any] | None) -> dict[str, Any]:
    if div is None:
        return {"ok": True, "divergence": None}
    out: dict[str, Any] = {
        "ok": False,
        "divergence": {
            "kind": div["kind"],
            "line": div["line"],
            "detail": div["detail"],
        },
    }
    if "seq" in div:
        out["divergence"]["seq"] = div["seq"]
    return out


def ensure_fixtures(out_dir: Path, seal: Any) -> None:
    fixtures = out_dir / "fixtures"
    fixtures.mkdir(parents=True, exist_ok=True)
    bin_path = fixtures / "synthetic_bytes.bin"
    bin_path.write_bytes(b"abc")
    first = linked_entry(seal, 1, seal.GENESIS, 0)
    second = linked_entry(seal, 2, first["entry_sha256"], 1)
    third = linked_entry(seal, 3, second["entry_sha256"], 2)
    intact = fixtures / "synthetic_intact.jsonl"
    lines = [canonical_line(seal, first), canonical_line(seal, second), canonical_line(seal, third)]
    intact.write_text("".join(lines), encoding="utf-8", newline="\n")
    edited = lines[1].replace("healthy", "invalid")
    divergent = fixtures / "synthetic_divergent.jsonl"
    divergent.write_text(lines[0] + edited + lines[2], encoding="utf-8", newline="\n")


