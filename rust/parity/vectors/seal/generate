def materialize_hex(spec: dict[str, Any] | str | None) -> str | None:
    if spec is None:
        return None
    if isinstance(spec, str):
        return spec
    prefix = str(spec["prefix"])
    count = int(spec["count"])
    return prefix * count


def materialize_codes(rows: list[list[Any]]) -> dict[str, int]:
    return {str(code): int(count) for code, count in rows}


def build_expected(seal: Any, construct: dict[str, Any]) -> dict[str, Any]:
    kind = construct["type"]
    if kind == "module_all":
        return {"names": list(seal.__all__)}
    if kind == "module_constants":
        return {
            "SEAL_SCHEMA_ID": seal.SEAL_SCHEMA_ID,
            "GENESIS": seal.GENESIS,
            "SEAL_TOOLS": sorted(seal.SEAL_TOOLS),
            "DIVERGENCE_KINDS": sorted(seal.DIVERGENCE_KINDS),
        }
    if kind == "sha256_bytes":
        data = bytes.fromhex(construct["data_hex"]) if construct.get("data_hex") else b""
        return {"digest": seal.sha256_bytes(data)}
    if kind == "build_entry":
        entry = seal.build_entry(
            seq=int(construct["seq"]),
            prev_sha256=str(construct["prev_sha256"]),
            file_sha256=materialize_hex(construct["file_sha256"]),
            path=construct.get("path"),
            tool=str(construct["tool"]),
            verdict=str(construct["verdict"]),
            codes=materialize_codes(construct.get("codes") or []),
            report_sha256=materialize_hex(construct["report_sha256"]),
            genesis_of=materialize_hex(construct.get("genesis_of")),
            now=FIXED_NOW,
        )
        return {"entry": entry_fields(entry)}
    if kind == "build_entry_error":
        try:
            seal.build_entry(
                seq=int(construct["seq"]),
                prev_sha256=str(construct["prev_sha256"]),
                file_sha256=materialize_hex(construct["file_sha256"]),
                path=None,
                tool=str(construct["tool"]),
                verdict=str(construct["verdict"]),
                codes=materialize_codes(construct.get("codes") or []),
                report_sha256=materialize_hex(construct["report_sha256"]),
                now=FIXED_NOW,
            )
        except seal.SealError as err:
            return {"raises": "SealError", "message": str(err)}
        raise SystemExit(f"{construct}: expected SealError")
    if kind == "verify_lines":
        rows = [(int(row["line"]), str(row["raw"])) for row in construct["lines"]]
        div = seal.verify_lines(rows)
        return divergence_expected(div)
    if kind == "verify_ledger":
        out_dir = repo_root() / "rust/parity/vectors/seal"
        rel = str(construct["ledger_path"])
        prev = os.getcwd()
        try:
            os.chdir(out_dir)
            verified, div = seal.verify_ledger(rel)
        finally:
            os.chdir(prev)
        out = divergence_expected(div)
        out["entries_verified"] = verified
        return out
    if kind == "verify_ledger_error":
        out_dir = repo_root() / "rust/parity/vectors/seal"
        rel = str(construct["ledger_path"])
        prev = os.getcwd()
        try:
            os.chdir(out_dir)
            seal.verify_ledger(rel)
        except seal.SealError as err:
            return {"raises": "SealError", "message": str(err)}
        finally:
            os.chdir(prev)
        raise SystemExit(f"{construct}: expected SealError")
    if kind == "sha256_file":
        out_dir = repo_root() / "rust/parity/vectors/seal"
        rel = str(construct["path"])
        prev = os.getcwd()
        try:
            os.chdir(out_dir)
            digest = seal.sha256_file(rel)
        finally:
            os.chdir(prev)
        return {"digest": digest}
    raise ValueError(f"unknown construct type: {kind}")


def main() -> int:
    seal = load_seal_module()
    out_dir = Path(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs(seal, out_dir):
        construct = dict(row["construct"])
        expected = build_expected(seal, construct)
        vectors.append(
            {
                "id": row["id"],
                "construct": construct,
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "seal_py_sha256": SEAL_PY_SHA256,
        "canonical_codec_py_sha256": CANONICAL_CODEC_PY_SHA256,
        "seal_rs_sha256": SEAL_RS_SHA256,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.seal parity (constants, hashing, build_entry, "
            "verify_lines, verify_ledger, sha256_file; no session payloads)."
        ),
        "generator": "rust/parity/vectors/seal/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
