        actor="user",
        kind="message",
    )
    try:
        mod.apply_side_effect_unknown_truncate([ev], step)
    except PreconditionFailed as exc:
        messages.append(str(exc))
    bad_step = PlanStep(
        seq=0,
        recipe="side-effect-unknown-truncate",
        target_finding_fp="fp",
        target_index=5,
        lossy=True,
    )
    try:
        mod.apply_side_effect_unknown_truncate([ev], bad_step)
    except PreconditionFailed as exc:
        messages.append(str(exc))
    return {"mode": "comparable", "pin": {"messages": messages}}


def run_orphan_resolves(mod: Any) -> dict[str, Any]:
    from sesslint.repair.planner import PlanStep  # noqa: WPS433
    from sesslint.repair.recipes_conservative import PreconditionFailed  # noqa: WPS433

    events = decode_events(orphan_events_spec())
    step_by_corr = PlanStep(
        seq=0,
        recipe="orphan-result-drop",
        target_finding_fp="fp",
        target_index=None,
        params={"correlation_id": "corr-orphan"},
        lossy=True,
    )
    out = mod.apply_orphan_result_drop(events, step_by_corr)
    ids_corr = [e["id"] for e in out]
    step_by_id = PlanStep(
        seq=0,
        recipe="orphan-result-drop",
        target_finding_fp="fp",
        target_index=None,
        params={"result_id": "tr_orph"},
        lossy=True,
    )
    out2 = mod.apply_orphan_result_drop(events, step_by_id)
    ids_id = [e["id"] for e in out2]
    events_amb = events + decode_events(
        [
            session_row(
                id="tr_orph2",
                parent_id="m0",
                seq=4,
                ts="2026-09-05T12:00:04Z",
                actor="tool",
                kind="tool_result",
                correlation_id="corr-orphan",
            )
        ]
    )
    amb_message = ""
    try:
        mod.apply_orphan_result_drop(events_amb, step_by_corr)
    except PreconditionFailed as exc:
        amb_message = str(exc)
    return {
        "mode": "comparable",
        "pin": {"ids_by_corr": ids_corr, "ids_by_id": ids_id, "ambiguous": amb_message},
    }


def run_orphan_refusals(mod: Any) -> dict[str, Any]:
    from sesslint.repair.planner import PlanStep  # noqa: WPS433
    from sesslint.repair.recipes_conservative import PreconditionFailed  # noqa: WPS433

    events = decode_events(orphan_events_spec())

    def mkstep(**kw: Any) -> PlanStep:
        base: dict[str, Any] = {
            "seq": 0,
            "recipe": "orphan-result-drop",
            "target_finding_fp": "fp",
            "target_index": 3,
            "lossy": True,
        }
        base.update(kw)
        return PlanStep(**base)

    messages: list[str] = []
    try:
        mod.apply_orphan_result_drop([], mkstep(target_index=None))
    except PreconditionFailed as exc:
        messages.append(str(exc))
    try:
        mod.apply_orphan_result_drop(events, mkstep(target_index=99))
    except PreconditionFailed as exc:
        messages.append(str(exc))
    try:
        mod.apply_orphan_result_drop(events, mkstep(target_index=0))
    except PreconditionFailed as exc:
        messages.append(str(exc))
    try:
        mod.apply_orphan_result_drop(events, mkstep(target_index=2))
    except PreconditionFailed as exc:
        messages.append(str(exc))
    child_spec = [
        session_row(
            id="ch1",
            parent_id="tr_orph",
            seq=4,
            ts="2026-09-05T12:00:04Z",
            actor="assistant",
            kind="message",
        )
    ]
    try:
        mod.apply_orphan_result_drop(events + decode_events(child_spec), mkstep(target_index=3))
    except PreconditionFailed as exc:
        messages.append(str(exc))
    return {"mode": "comparable", "pin": {"messages": messages}}


def run_affected_region_gap(mod: Any, events: list[dict[str, Any]], step: dict[str, Any]) -> dict[str, Any]:
    evs = decode_events(events)
    st = decode_step(step)
    region = mod.affected_region_orphan_result_drop(st, evs)
    indices = sorted(region.indices) if region.indices is not None else []
    ids = sorted(region.ids) if region.ids is not None else []
    ranges = [list(pair) for pair in region.ranges] if region.ranges else []
    return {
        "mode": "gap",
        "gap_id": GAP_ORPHAN_REGION,
        "region": {
            "unproven": bool(region.unproven),
            "indices": indices,
            "ids": ids,
            "ranges": ranges,
        },
    }


def run_expected(mod: Any, construct: dict[str, Any]) -> dict[str, Any]:
    kind = construct["type"]
    if kind == "module_all":
        return {"mode": "names", "names": list(mod.__all__)}
    if kind == "register_all":
        return run_register_all(mod)
    if kind == "registration_matrix":
        return run_registration(mod)
    if kind == "sl001_excisable_precondition":
        return run_sl001_excisable(mod)
    if kind == "apply_torn_record_excision_validation":
        return run_excision_validation(mod)
    if kind == "amputate_direct_apply_validation":
        return run_amputate_validation(mod)
    if kind == "torn_compaction_direct_apply_validation":
        return run_compaction_validation(mod)
    if kind == "truncate_direct_apply_validation":
        return run_truncate_validation(mod)
    if kind == "orphan_result_drop_resolves_by_params":
        return run_orphan_resolves(mod)
    if kind == "orphan_result_drop_direct_apply_refusals":
        return run_orphan_refusals(mod)
    if kind == "affected_region_orphan_gap":
        return run_affected_region_gap(
            mod, construct["events"], construct["step"],
        )
    raise SystemExit(f"unknown construct {kind!r}")


