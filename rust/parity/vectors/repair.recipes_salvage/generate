def discover_coverage(vector_ids: set[str]) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    test_re = re.compile(r"^def (test_\w+)")
    for rel in TEST_FILES:
        text = git_show_bytes(f"{PYTHON_COMMIT}:{rel}").decode("utf-8")
        for line in text.splitlines():
            match = test_re.match(line)
            if not match:
                continue
            name = match.group(1)
            key = f"{rel}::{name}"
            vid = COVERED.get(name)
            status = "covered" if vid and vid in vector_ids else "not_applicable"
            rows.append(
                {
                    "test": key,
                    "column": "column_0",
                    "status": status,
                    "vector_id": vid if status == "covered" else None,
                    "note": "",
                }
            )
    return rows


def assert_payload_clean(payload: str) -> None:
    if "\r" in payload:
        raise SystemExit("payload contains CR")
    if SEAM_SENTENCE in payload:
        raise SystemExit("payload stores the Rust seam sentence")
    if "FOR_WORK" in payload or "sesslint-wt" in payload:
        raise SystemExit("payload stores a forbidden path token")
    if re.search(r"sbp_[0-9a-f]{40}", payload):
        raise SystemExit("payload stores sbp hash")


def main() -> int:
    mod = load_salvage_module()
    out_dir = Path(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for spec in vector_specs():
        expected = run_expected(mod, spec["construct"])
        vectors.append({"id": spec["id"], "construct": spec["construct"], "expected": expected})
    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "recipes_salvage_py_sha256": RECIPES_SALVAGE_PY_SHA256,
        "recipes_salvage_rs_sha256": RECIPES_SALVAGE_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    assert_payload_clean(payload)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    vids = {v["id"] for v in vectors}
    cov = discover_coverage(vids)
    cov_doc = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": sum(1 for r in cov if r["status"] == "covered"),
        "not_applicable_count": sum(1 for r in cov if r["status"] == "not_applicable"),
        "rows": cov,
    }
    cov_payload = json.dumps(cov_doc, indent=2) + "\n"
    assert_payload_clean(cov_payload)
    (out_dir / "coverage.json").write_text(cov_payload, encoding="utf-8", newline="\n")
    provenance = {
        "contains_real_data": False,
        "description": "Synthetic sesslint.repair.recipes_salvage module parity vectors.",
        "generator": "rust/parity/vectors/repair.recipes_salvage/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    prov_payload = json.dumps(provenance, indent=2) + "\n"
    assert_payload_clean(prov_payload)
    (out_dir / "PROVENANCE.json").write_text(prov_payload, encoding="utf-8", newline="\n")
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "recipes_salvage_rs_sha256": RECIPES_SALVAGE_RS_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/repair.recipes_salvage/generate",
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    man_payload = json.dumps(manifest, indent=2) + "\n"
    assert_payload_clean(man_payload)
    (out_dir / "manifest.json").write_text(man_payload, encoding="utf-8", newline="\n")
    print(f"wrote {len(vectors)} vectors")
    print(f"sha256={digest}")
    print(f"covered={cov_doc['covered_count']} not_applicable={cov_doc['not_applicable_count']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
