def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def fullname_for(path: str) -> str:
    rel = path.removeprefix("src/").removesuffix(".py").replace("/", ".")
    return rel


def ensure_pkg(name: str) -> None:
    if name not in sys.modules:
        mod = types.ModuleType(name)
        mod.__path__ = []
        sys.modules[name] = mod


def exec_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile.NamedTemporaryFile("wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp = handle.name
    spec = importlib.util.spec_from_file_location(fullname, tmp)
    if spec is None or spec.loader is None:
        raise SystemExit(f"failed to create import spec for {fullname}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[fullname] = mod
    try:
        spec.loader.exec_module(mod)
    finally:
        Path(tmp).unlink(missing_ok=True)
    parent = fullname.rsplit(".", 1)[0] if "." in fullname else ""
    if parent:
        parent_mod = sys.modules.setdefault(parent, types.ModuleType(parent))
        setattr(parent_mod, fullname.split(".")[-1], mod)
    return mod


def verify_recipes_salvage_rs() -> None:
    rs_path = repo_root() / "rust" / "crates" / "repair" / "src" / "recipes_salvage.rs"
    digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if digest != RECIPES_SALVAGE_RS_SHA256:
        raise SystemExit(
            f"recipes_salvage.rs sha256 mismatch: expected {RECIPES_SALVAGE_RS_SHA256}, got {digest}"
        )


def load_salvage_module() -> Any:
    verify_recipes_salvage_rs()
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/recipes_salvage.py")
    py_digest = hashlib.sha256(py_blob).hexdigest()
    if py_digest != RECIPES_SALVAGE_PY_SHA256:
        raise SystemExit(
            f"pinned recipes_salvage.py sha256 mismatch: "
            f"expected {RECIPES_SALVAGE_PY_SHA256}, got {py_digest}"
        )
    for rel in PIN_CLOSURE:
        if rel == "repair/recipes_salvage.py":
            continue
        path = f"src/sesslint/{rel}"
        blob = git_show_bytes(f"{PYTHON_COMMIT}:{path}")
        fullname = fullname_for(path)
        parts = fullname.split(".")
        for i in range(1, len(parts)):
            ensure_pkg(".".join(parts[:i]))
        exec_blob(blob, fullname)
    ensure_pkg("sesslint.repair")
    return exec_blob(py_blob, "sesslint.repair.recipes_salvage")


def tagged(value: Any) -> dict[str, Any]:
    if value is None:
        return {"t": "null"}
    if isinstance(value, bool):
        return {"t": "bool", "v": value}
    if isinstance(value, int) and not isinstance(value, bool):
        return {"t": "int", "v": value}
    if isinstance(value, str):
        return {"t": "str", "v": value}
    if isinstance(value, float):
        return {"t": "float", "v": value}
    if isinstance(value, dict):
        entries = [[k, tagged(v)] for k, v in value.items()]
        return {"t": "map", "entries": entries}
    if isinstance(value, (list, tuple)):
        return {"t": "list", "items": [tagged(v) for v in value]}
    raise TypeError(f"unencodable {type(value)!r}")


def session_row(**fields: Any) -> dict[str, Any]:
    return {"t": "session", **fields}


def mapping_row(entries: dict[str, Any]) -> dict[str, Any]:
    return {"t": "mapping", "entries": [[k, tagged(v)] for k, v in entries.items()]}


def step_spec(
    *,
    target_index: Any,
    params: Any,
) -> dict[str, Any]:
    if target_index is None:
        ti: dict[str, Any] = {"t": "null"}
    elif isinstance(target_index, bool):
        ti = {"t": "bool", "v": target_index}
    elif isinstance(target_index, int):
        ti = {"t": "int", "v": target_index}
    else:
        ti = tagged(target_index)
    if params == "not_mapping":
        pm = {"t": "not_mapping"}
    elif isinstance(params, dict):
        pm = {"t": "map", "entries": [[k, tagged(v)] for k, v in params.items()]}
    else:
        pm = {"t": "map", "entries": []}
    return {"target_index": ti, "params": pm}


def decode_events(spec: list[dict[str, Any]]) -> list[Any]:
    from sesslint.canonical import SessionEvent  # noqa: WPS433

    out: list[Any] = []
    for row in spec:
        if row.get("t") == "session":
            payload = row.get("payload")
            out.append(
                SessionEvent(
                    _untag(row["id"]),
                    _untag(row.get("parent_id")),
                    _untag(row["seq"]),
                    _untag(row["ts"]),
                    _untag(row["actor"]),
                    _untag(row["kind"]),
                    payload=payload if isinstance(payload, dict) else _untag(payload) if payload else {},
                )
                if "payload" in row
                else SessionEvent(
                    _untag(row["id"]),
                    _untag(row.get("parent_id")),
                    _untag(row["seq"]),
                    _untag(row["ts"]),
                    _untag(row["actor"]),
                    _untag(row["kind"]),
                    correlation_id=_untag(row["correlation_id"]) if "correlation_id" in row else None,
                )
            )
        else:
            out.append({k: _untag(v) for k, v in row.get("entries", [])})
    return out


def _untag(node: Any) -> Any:
    if not isinstance(node, dict) or "t" not in node:
        return node
    kind = node["t"]
    if kind == "null":
        return None
    if kind == "bool":
        return node["v"]
    if kind == "int":
        return node["v"]
    if kind == "float":
        return node["v"]
    if kind == "str":
        return node["v"]
    if kind == "map":
        return {k: _untag(v) for k, v in node["entries"]}
    if kind == "list":
        return [_untag(v) for v in node["items"]]
    raise ValueError(node)


def decode_step(spec: dict[str, Any]) -> Any:
    from sesslint.repair.planner import PlanStep  # noqa: WPS433

    ti = spec["target_index"]
    if ti.get("t") == "null":
        target = None
    elif ti.get("t") == "int":
        target = ti["v"]
    elif ti.get("t") == "bool":
        target = ti["v"]
    else:
        target = _untag(ti)
    pm = spec["params"]
    if pm.get("t") == "not_mapping":
        params: Any = "not-a-mapping"
    else:
        params = {k: _untag(v) for k, v in pm.get("entries", [])}
    return PlanStep(
        seq=0,
        recipe="synthetic",
        target_finding_fp="fp",
        target_index=target,
        params=params,
        lossy=True,
    )


