def run_registration(mod: Any) -> dict[str, Any]:
    import sesslint.repair.registry as reg  # noqa: WPS433
    from sesslint.codes import SL001, SL005, SL006, SL101, SL102, SL108  # noqa: WPS433

    reg.clear_registry()
    mod.register_all()
    recipes = reg.list_recipes()
    names = sorted(r.name for r in recipes)
    snap: dict[str, Any] = {"recipe_count": len(recipes), "names": names, "recipes": {}}
    for const in (
        "RECIPE_UNRESOLVABLE_BRANCH_AMPUTATE",
        "RECIPE_TORN_COMPACTION_PROJECT",
        "RECIPE_SIDE_EFFECT_UNKNOWN_TRUNCATE",
        "RECIPE_ORPHAN_RESULT_DROP",
        "RECIPE_TORN_RECORD_EXCISION",
    ):
        recipe = getattr(mod, const)
        snap["recipes"][recipe.name] = recipe_snapshot(recipe)
    snap["recipes_for"] = {
        "SL001": [r.name for r in reg.recipes_for(SL001)],
        "SL005": [r.name for r in reg.recipes_for(SL005)],
        "SL006": [r.name for r in reg.recipes_for(SL006)],
        "SL101": [r.name for r in reg.recipes_for(SL101)],
        "SL102": [r.name for r in reg.recipes_for(SL102)],
        "SL108": [r.name for r in reg.recipes_for(SL108)],
    }
    assert len(recipes) == 5
    return {"mode": "comparable", "pin": snap}


