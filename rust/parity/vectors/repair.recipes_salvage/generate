def run_sl001_excisable(mod: Any) -> dict[str, Any]:
    from sesslint.codes import SL001, SL006  # noqa: WPS433
    from sesslint.finding import Repairability, Severity, SourceRef, make_finding  # noqa: WPS433
    from sesslint.repair.preconditions import PreconditionContext  # noqa: WPS433

    def ev(i: int, parent: str | None = None) -> Any:
        from sesslint.canonical import SessionEvent  # noqa: WPS433

        return SessionEvent(
            id=f"msg-{i}",
            parent_id=parent,
            seq=i,
            ts=f"2026-09-05T12:00:0{i}Z",
            actor="user" if i % 2 == 0 else "assistant",
            kind="message",
            payload={"text": f"m{i}"},
        )

    torn_evidence = {"byte_offset": 120, "byte_end": 210, "record_ordinal": 2}

    def sl001_finding(
        *,
        line: int | None = 3,
        record_id: str | None = "msg-torn",
        evidence: dict[str, Any] | None = None,
    ) -> Any:
        return make_finding(
            code=SL001,
            severity=Severity.ERROR,
            repairability=Repairability.MANUAL,
            message_template="Malformed nonterminal record on line {line} for record {record_id}",
            source=SourceRef(path="sess.jsonl", line=line, record_id=record_id),
            evidence=dict(torn_evidence if evidence is None else evidence),
        )

    def ctx(finding: Any, events: list[Any], *, policy: str = "salvage", ack: bool = True) -> Any:
        return PreconditionContext(
            findings=[finding],
            events=events,
            profile="neutral",
            source_hash="0" * 64,
            finding=finding,
            policy=policy,
            acknowledge_side_effects=ack,
        )

    events = [ev(0), ev(2)]
    f = sl001_finding()
    checks: list[bool] = []
    checks.append(mod.sl001_excisable(ctx(f, events)))
    f_size = sl001_finding(evidence={"reason": "size_limit_exceeded", "limit": 10})
    checks.append(mod.sl001_excisable(ctx(f_size, events)))
    checks.append(mod.sl001_excisable(ctx(sl001_finding(line=None), events)))
    for bad_ev in (
        {"byte_end": 10, "record_ordinal": 1},
        {"byte_offset": 5, "record_ordinal": 1},
        {"byte_offset": 0, "byte_end": 9, "record_ordinal": 0},
        {"byte_offset": 9, "byte_end": 9, "record_ordinal": 1},
        {"byte_offset": "x", "byte_end": 9, "record_ordinal": 1},
    ):
        checks.append(mod.sl001_excisable(ctx(sl001_finding(evidence=bad_ev), events)))
    dependent = ev(3, parent="msg-torn")
    checks.append(mod.sl001_excisable(ctx(f, events + [dependent])))
    f_other = make_finding(
        code=SL006,
        severity=Severity.WARNING,
        repairability=Repairability.MANUAL,
        message_template="Disconnected branch at line {line}",
        source=SourceRef(path="sess.jsonl", line=3),
        evidence=dict(torn_evidence),
    )
    checks.append(mod.sl001_excisable(ctx(f_other, events)))
    return {"mode": "comparable", "pin": {"kind": "bool_checks", "values": checks}}


def run_excision_validation(mod: Any) -> dict[str, Any]:
    from sesslint.canonical import SessionEvent  # noqa: WPS433
    from sesslint.repair.planner import PlanStep  # noqa: WPS433
    from sesslint.repair.recipes_conservative import PreconditionFailed  # noqa: WPS433

    def ev(i: int, parent: str | None = None) -> SessionEvent:
        return SessionEvent(
            id=f"msg-{i}",
            parent_id=parent,
            seq=i,
            ts=f"2026-09-05T12:00:0{i}Z",
            actor="user" if i % 2 == 0 else "assistant",
            kind="message",
            payload={"text": f"m{i}"},
        )

    events = [ev(0), ev(2)]
    step = PlanStep(
        seq=0,
        recipe="torn-record-excision",
        target_finding_fp="fp",
        target_index=None,
        params={
            "line": 3,
            "record_ordinal": 2,
            "byte_offset": 120,
            "byte_end": 210,
            "record_id": "msg-torn",
        },
        lossy=True,
        loss={"torn-record": 1},
        min_policy="salvage",
    )
    pin: dict[str, Any] = {}
    out, loss = mod.apply_torn_record_excision_with_loss(events, step)
    pin["success"] = {
        "loss": loss,
        "ids": [e["id"] for e in out],
        "plain_eq": mod.apply_torn_record_excision(events, step) == out,
    }
    refuses: list[str] = []
    try:
        mod.apply_torn_record_excision([], step)
    except PreconditionFailed as exc:
        refuses.append(str(exc))
    for bad in (
        {"record_ordinal": 2, "byte_offset": 1, "byte_end": 5},
        {"line": 0, "record_ordinal": 2, "byte_offset": 1, "byte_end": 5},
        {"line": 3, "record_ordinal": 0, "byte_offset": 1, "byte_end": 5},
        {"line": 3, "record_ordinal": 2, "byte_offset": 5, "byte_end": 5},
        {"line": "3", "record_ordinal": 2, "byte_offset": 1, "byte_end": 5},
    ):
        bad_step = PlanStep(
            seq=0,
            recipe="torn-record-excision",
            target_finding_fp="fp",
            target_index=None,
            params=bad,
            lossy=True,
            loss={"torn-record": 1},
            min_policy="salvage",
        )
        try:
            mod.apply_torn_record_excision(events, bad_step)
            raise SystemExit("expected refusal")
        except PreconditionFailed as exc:
            refuses.append(str(exc))
    dependent = ev(3, parent="msg-torn")
    try:
        mod.apply_torn_record_excision(events + [dependent], step)
        raise SystemExit("expected dependent refusal")
    except PreconditionFailed as exc:
        refuses.append(str(exc))
    pin["refusals"] = refuses
    return {"mode": "comparable", "pin": pin}


