#!/usr/bin/env python3
"""Generate sesslint.reference parity vectors (stdlib only; pinned git blobs)."""

from __future__ import annotations

import ast
import hashlib
import json
import re
import subprocess
import sys
import types
from pathlib import Path
from typing import Any, Final

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
REFERENCE_PY_SHA256 = (
    "b2ade3002b062600b5653e85d707c6b1ea4836ce182066da73dc82f7037ffeb5"
)
REFERENCE_RS_SHA256 = (
    "81a1f10ce7f76b64273facd56c985c6ca281fd6b42ce5da7a6f02c9677dc2d03"
)
MODULE = "sesslint.reference"
HEALTHY_FIXTURE = "fixtures/conformance/canonical/healthy.json"

KNOWN_PARITY_GAPS: Final[tuple[str, ...]] = (
    "GAP-reference-dump-canonical: reference_equivalent and reference_equivalent_if_clean "
    "on non-empty inputs at or below MAX_REFERENCE_EVENTS call "
    "sesslint.adapters.canonical.dump_canonical. Rust returns DumpCanonicalUnavailable "
    "and does not call dump_canonical or load_canonical. The harness asserts that seam "
    "and does not treat pin success as equal to the seam.",
)

_BANNED_LIVE_TEST = re.compile(
    rb"(?:^|[^A-Za-z])(sk|rk)_(?:live|test)_[A-Za-z0-9]{16}"
)
_BANNED_SUPABASE_PAT = re.compile(rb"sbp_[0-9a-f]{40}")

COVERAGE_TEST_FILES: Final[tuple[str, ...]] = ("tests/test_reference.py",)

COVERED_BY_VECTORS: Final[dict[str, tuple[str, ...]]] = {
    "tests/test_reference.py::test_scale_bound_skips_loader": (
        "ref_equiv_over_cap",
        "ref_if_clean_over_cap",
    ),
    "tests/test_reference.py::test_loader_skipped_on_warning_or_error": (
        "ref_if_clean_blocking_warning",
        "ref_if_clean_blocking_error",
    ),
}


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show(rel: str) -> str:
    return subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:src/sesslint/{rel}"],
        cwd=repo_root(),
        text=True,
    )


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def verify_pin_hashes() -> None:
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/reference.py")
    digest = hashlib.sha256(blob).hexdigest()
    if digest != REFERENCE_PY_SHA256:
        raise SystemExit(
            f"reference.py pin sha256 mismatch: expected {REFERENCE_PY_SHA256}, got {digest}"
        )
    rs_path = repo_root() / "rust" / "crates" / "model" / "src" / "reference.rs"
    rs_digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if rs_digest != REFERENCE_RS_SHA256:
        raise SystemExit(
            "reference.rs sha256 mismatch: "
            f"expected {REFERENCE_RS_SHA256}, got {rs_digest}"
        )


def mod_to_paths(mod: str) -> list[str]:
    tail = mod[len("sesslint.") :].replace(".", "/")
    return [f"{tail}.py", f"{tail}/__init__.py"]


def discover_imports(source: str) -> set[str]:
    found: set[str] = set()
    tree = ast.parse(source)
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name.startswith("sesslint."):
                    found.add(alias.name)
        elif isinstance(node, ast.ImportFrom) and node.module:
            if node.module.startswith("sesslint."):
                found.add(node.module)
    return found


def closure(root_mod: str) -> list[str]:
    queue = [root_mod]
    seen: set[str] = set()
    order: list[str] = []
    while queue:
        mod = queue.pop(0)
        if mod in seen:
            continue
        seen.add(mod)
        source = None
        for candidate in mod_to_paths(mod):
            try:
                source = git_show(candidate)
                break
            except subprocess.CalledProcessError:
                continue
        if source is None:
            continue
        order.append(mod)
        for imp in discover_imports(source):
            if imp not in seen:
                queue.append(imp)
    return order


def ensure_packages() -> None:
    for pkg in (
        "sesslint",
        "sesslint.adapters",
        "sesslint.checks",
        "sesslint.io",
        "sesslint.repair",
        "sesslint.scan",
        "sesslint.profiles",
    ):
        mod = types.ModuleType(pkg)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[pkg] = mod


def load_module(mod: str) -> None:
    source = None
    rel = None
    for candidate in mod_to_paths(mod):
        try:
            source = git_show(candidate)
            rel = candidate
            break
        except subprocess.CalledProcessError:
            continue
    if source is None or rel is None:
        raise ModuleNotFoundError(mod)
    code = compile(source, f"<{PYTHON_COMMIT}:{rel}>", "exec")
    module = types.ModuleType(mod)
    module.__file__ = f"<{PYTHON_COMMIT}:{rel}>"
    sys.modules[mod] = module
    try:
        exec(code, module.__dict__)  # noqa: S102
    except Exception:
        del sys.modules[mod]
        raise
    parent, _, child = mod.rpartition(".")
    if parent in sys.modules:
        setattr(sys.modules[parent], child, module)


def load_pinned_reference() -> Any:
    verify_pin_hashes()
    ensure_packages()
    deps = [m for m in closure("sesslint.reference") if m != "sesslint.reference"]
    pending = list(deps)
    for _ in range(48):
        if not pending:
            break
        nxt: list[str] = []
        progress = False
        for mod in pending:
            try:
                load_module(mod)
                progress = True
            except Exception:
                nxt.append(mod)
        pending = nxt
        if pending and not progress:
            raise SystemExit(f"stuck loading: {pending[:8]}")
    load_module("sesslint.reference")
    return sys.modules["sesslint.reference"]


def scan_committed_text(text: str) -> None:
    raw = text.encode("utf-8")
    if _BANNED_LIVE_TEST.search(raw):
        raise SystemExit("committed output matches banned live/test secret shape")
    if _BANNED_SUPABASE_PAT.search(raw):
        raise SystemExit("committed output contains a contiguous supabase token shape")


def matrix_finding(mod: Any, code: str, severity: Any) -> Any:
    from sesslint.codes import Repairability  # noqa: WPS433
    from sesslint.finding import SourceRef  # noqa: WPS433

    return mod_reference_finding_helper(
        code=code,
        severity=severity,
        repairability=Repairability.MANUAL,
        message_template="Matrix probe [detail: X]",
        source=SourceRef(path="probe.json"),
    )


def mod_reference_finding_helper(**kwargs: Any) -> Any:
    from sesslint.finding import make_finding  # noqa: WPS433

    return make_finding(**kwargs)


def events_for_kind(kind: str, ref: Any) -> Any:
    if kind == "none":
        return None
    if kind == "empty":
        return []
    if kind == "over_cap":
        return [{"not": "an event"}] * (ref.MAX_REFERENCE_EVENTS + 1)
    if kind == "foreign":
        return [{"not": "an event"}]
    if kind == "fixture_healthy":
        from sesslint.adapters.canonical import load_canonical  # noqa: WPS433

        path = repo_root() / HEALTHY_FIXTURE
        events, _ = load_canonical(path)
        return events
    raise SystemExit(f"unknown events_kind {kind!r}")


def pin_bool(ref: Any, events: Any) -> bool:
    return bool(ref.reference_equivalent(events))


def pin_bool_if_clean(ref: Any, events: Any, findings: list[Any]) -> bool:
    return bool(ref.reference_equivalent_if_clean(events, findings))


def vector_specs(ref: Any) -> list[dict[str, Any]]:
    from sesslint.codes import SL001, SL003, Severity  # noqa: WPS433

    specs: list[dict[str, Any]] = []

    def add(spec: dict[str, Any]) -> None:
        specs.append(spec)

    add(
        {
            "id": "module_exports",
            "construct": {"type": "module_exports"},
            "expected": {"python_all": list(ref.__all__)},
        }
    )
    add(
        {
            "id": "module_constants",
            "construct": {"type": "module_constants"},
            "expected": {"max_reference_events": ref.MAX_REFERENCE_EVENTS},
        }
    )

    for vid, kind in (
        ("ref_equiv_none", "none"),
        ("ref_equiv_empty", "empty"),
        ("ref_equiv_over_cap", "over_cap"),
    ):
        events = events_for_kind(kind, ref)
        add(
            {
                "id": vid,
                "construct": {
                    "type": "reference_equivalent",
                    "events_kind": kind,
                },
                "expected": {"value": pin_bool(ref, events)},
            }
        )

    foreign = events_for_kind("foreign", ref)
    add(
        {
            "id": "ref_equiv_foreign",
            "construct": {
                "type": "reference_equivalent",
                "events_kind": "foreign",
            },
            "expected": {
                "pin": {"value": pin_bool(ref, foreign)},
                "rust_assertion": {"mode": "gap_dump_canonical"},
            },
        }
    )

    add(
        {
            "id": "ref_if_clean_empty_list",
            "construct": {
                "type": "reference_equivalent_if_clean",
                "events_kind": "empty",
                "findings": [],
            },
            "expected": {"value": False},
        }
    )
    add(
        {
            "id": "ref_if_clean_over_cap",
            "construct": {
                "type": "reference_equivalent_if_clean",
                "events_kind": "over_cap",
                "findings": [],
            },
            "expected": {"value": pin_bool_if_clean(ref, events_for_kind("over_cap", ref), [])},
        }
    )

    healthy = events_for_kind("fixture_healthy", ref)
    for vid, sev, code in (
        ("ref_if_clean_blocking_warning", Severity.WARNING, SL003),
        ("ref_if_clean_blocking_error", Severity.ERROR, SL001),
    ):
        finding = matrix_finding(ref, code, sev)
        add(
            {
                "id": vid,
                "construct": {
                    "type": "reference_equivalent_if_clean",
                    "events_kind": "fixture_healthy",
                    "findings": [
                        {
                            "code": code,
                            "severity": sev.value,
                            "repairability": "manual",
                            "message_template": "Matrix probe [detail: X]",
                            "source_path": "probe.json",
                        }
                    ],
                },
                "expected": {"value": pin_bool_if_clean(ref, healthy, [finding])},
            }
        )

    pin_healthy = pin_bool(ref, healthy)
    add(
        {
            "id": "ref_equiv_healthy_gap",
            "construct": {
                "type": "reference_equivalent",
                "events_kind": "fixture_healthy",
            },
            "expected": {
                "pin": {"value": pin_healthy},
                "rust_assertion": {"mode": "gap_dump_canonical"},
            },
        }
    )
    pin_clean = pin_bool_if_clean(ref, healthy, [])
    add(
        {
            "id": "ref_if_clean_healthy_gap",
            "construct": {
                "type": "reference_equivalent_if_clean",
                "events_kind": "fixture_healthy",
                "findings": [],
            },
            "expected": {
                "pin": {"value": pin_clean},
                "rust_assertion": {"mode": "gap_dump_canonical"},
            },
        }
    )

    return specs


def list_tests_in_file(rel: str) -> list[tuple[str, bool]]:
    source = subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:{rel}"], cwd=repo_root(), text=True
    )
    has_column0 = any(line.startswith("def test_") for line in source.splitlines())
    out: list[tuple[str, bool]] = []
    for line in source.splitlines():
        if has_column0 and line.startswith("def test_"):
            name = line.split("(")[0].replace("def ", "")
            out.append((name, True))
        elif not has_column0 and line.startswith("    def test_"):
            name = line.split("(")[0].replace("def ", "").strip()
            out.append((name, False))
    return out


def write_coverage(out_dir: Path, vector_ids: frozenset[str]) -> tuple[int, int]:
    rows: list[dict[str, object]] = []
    covered = 0
    not_applicable = 0
    for rel in COVERAGE_TEST_FILES:
        try:
            tests = list_tests_in_file(rel)
        except subprocess.CalledProcessError:
            continue
        for name, _ in tests:
            qual = f"{rel}::{name}"
            needed = COVERED_BY_VECTORS.get(qual)
            row: dict[str, object] = {"test": qual}
            if needed is not None and all(item in vector_ids for item in needed):
                status = "covered"
                covered += 1
                row["vector_ids"] = list(needed)
            else:
                status = "not_applicable"
                not_applicable += 1
            row["status"] = status
            rows.append(row)
    payload = {"rows": rows}
    (out_dir / "coverage.json").write_text(
        json.dumps(payload, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    return covered, not_applicable


def main() -> int:
    ref = load_pinned_reference()
    out_dir = Path(__file__).resolve().parent
    vectors = vector_specs(ref)
    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "reference_py_sha256": REFERENCE_PY_SHA256,
        "reference_rs_sha256": REFERENCE_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(payload)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.reference parity (early gates and documented dump seam)."
        ),
        "generator": "rust/parity/vectors/reference/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    write_coverage(out_dir, frozenset(v["id"] for v in vectors))
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
