    {
      "id": "session_stats_files_total",
      "construct": {
        "type": "session_stats_files_total"
      },
      "expected": {
        "files_total": 9
      }
    },
    {
      "id": "session_stats_output_minimize_gap",
      "construct": {
        "type": "session_stats_output_gap"
      },
      "expected": {
        "pin": {
          "to_dict_keys": [
            "schema_version",
            "tool_version",
            "root_path",
            "files",
            "by_adapter",
            "events",
            "tool_calls",
            "compaction_boundaries",
            "checkpoints",
            "file_bytes",
            "events_per_file"
          ],
          "json_prefix": "{\n  \"by_adapter\": {},\n  \"checkpo",
          "human_prefix": "SessLint corpus statistics"
        },
        "rust_assertion": {
          "mode": "minimize_path_unavailable"
        }
      }
    },
    {
      "id": "stats_paths_missing_limits_directory",
      "construct": {
        "type": "stats_paths_missing_limits",
        "paths": [
          "fixtures/synthetic-dir"
        ],
        "recursive": false
      },
      "expected": {
        "pin": {
          "raises": "ValueError",
          "message": "Path fixtures\\synthetic-dir is a directory. Use recursive=True to scan."
        },
        "rust_assertion": {
          "mode": "scan_default_unavailable"
        }
      }
    },
    {
      "id": "stats_paths_missing_path_pin_contract",
      "construct": {
        "type": "stats_paths_error",
        "paths": [
          "fixtures/synthetic-absent.jsonl"
        ],
        "pin_kwargs": {},
        "rust": {
          "mode": "scan_default_unavailable"
        }
      },
      "expected": {
        "pin": {
          "raises": "FileNotFoundError",
          "message": "Path not found: fixtures\\synthetic-absent.jsonl"
        },
        "rust_assertion": {
          "mode": "scan_default_unavailable"
        }
      }
    },
    {
      "id": "stats_paths_missing_path_explicit_limits",
      "construct": {
        "type": "stats_paths_error",
        "paths": [
          "fixtures/synthetic-absent.jsonl"
        ],
        "recursive": false,
        "pin_kwargs": {
          "max_files": 4,
          "max_bytes": 32
        },
        "rust": {
          "mode": "path_not_found",
          "leaf": "synthetic-absent.jsonl"
        }
      },
      "expected": {
        "pin": {
          "raises": "FileNotFoundError",
          "message": "Path not found: fixtures\\synthetic-absent.jsonl"
        },
        "rust_assertion": {
          "mode": "path_not_found",
          "leaf": "synthetic-absent.jsonl"
        }
      }
    },
    {
      "id": "stats_paths_directory_requires_recursive",
      "construct": {
        "type": "stats_paths_error",
        "paths": [
          "fixtures/synthetic-dir"
        ],
        "recursive": false,
        "pin_kwargs": {
          "max_files": 4,
          "max_bytes": 32
        },
        "rust": {
          "mode": "directory_requires_recursive",
          "leaf": "synthetic-dir"
        }
      },
      "expected": {
        "pin": {
          "raises": "ValueError",
          "message": "Path fixtures\\synthetic-dir is a directory. Use recursive=True to scan."
        },
        "rust_assertion": {
          "mode": "directory_requires_recursive",
          "leaf": "synthetic-dir"
        }
      }
    },
    {
      "id": "stats_paths_load_events_gap",
      "construct": {
        "type": "stats_paths_error",
        "paths": [
          "fixtures/synthetic-session.jsonl"
        ],
        "recursive": false,
        "pin_kwargs": {
          "max_files": 4,
          "max_bytes": 32,
          "format": "claude-code-jsonl"
        },
        "rust": {
          "mode": "load_events_unavailable"
        }
      },
      "expected": {
        "pin": {
          "files_processed": 0,
          "files_undetected": 1,
          "files_unreadable": 0,
          "events_total": 0,
          "files_total": 1
        },
        "rust_assertion": {
          "mode": "load_events_unavailable"
        }
      }
    },
    {
      "id": "get_stats_schema_path_gap",
      "construct": {
        "type": "get_stats_schema_path"
      },
      "expected": {
        "pin": {
          "raises": "ModuleNotFoundError",
          "message": "No module named 'sesslint._resources'"
        },
        "rust_assertion": {
          "mode": "schema_path_unavailable"
        }
      }
    },
    {
      "id": "load_stats_schema_gap",
      "construct": {
