          "by_actor": {
            "assistant": 1,
            "system": 1,
            "user": 1
          },
          "by_tool_hash": {
            "9b9a8d05a7ec353b": 1
          },
          "tool_calls_total": 1,
          "compaction_boundaries": 1,
          "checkpoints": 1
        }
      }
    },
    {
      "id": "iter_files_excluded_and_order",
      "construct": {
        "type": "iter_files",
        "roots": [
          "fixtures/walk_tree"
        ],
        "max_files": 100
