{
  "schema": "sesslint.parity-module-vectors/v1",
  "module": "sesslint.stats",
  "python_commit": "e91d50b2ecea57ef4dd900e3b0b87b14946e847e",
  "stats_py_sha256": "81ae129ee7be03ff2264fccdd23925edb233c6d73b89eb07a4fced4ed56b577c",
  "stats_rs_sha256": "aa959eba6e754bf574eb37737c0e6c41e6e6f8c3d3c2f51f85644a9398d4d846",
  "known_parity_gaps": [
    "GAP-stats-minimize-path: SessionStats.to_dict, SessionStats.render_human, and SessionStats.to_json import sesslint.report.minimize_path in Python; Rust returns sesslint.report.minimize_path is not available and does not emit output.",
    "GAP-stats-scan-defaults: stats_paths with either max_files or max_bytes omitted imports sesslint.scan DEFAULT_MAX_FILES and DEFAULT_MAX_BYTES in Python; Rust stops with sesslint.scan.DEFAULT_MAX_FILES is not available before root checks.",
    "GAP-stats-load-events: After candidate paths are built, stats_paths imports sesslint.adapters.load.load_events_for_format in Python; Rust stops with sesslint.adapters.load.load_events_for_format is not available.",
    "GAP-stats-schema-path: get_stats_schema_path and load_stats_schema import sesslint._resources.schema_path in Python; Rust stops with sesslint._resources.schema_path is not available."
  ],
  "vectors": [
    {
      "id": "module_constants",
      "construct": {
        "type": "module_constants"
      },
      "expected": {
        "STATS_SCHEMA_VERSION": "sesslint.stats/v1",
        "MAX_TOOL_ROWS": 100,
        "python_all": [
          "MAX_TOOL_ROWS",
          "STATS_SCHEMA_VERSION",
          "SessionStats",
          "get_stats_schema_path",
          "load_stats_schema",
          "stats_paths"
        ]
      }
    },
    {
      "id": "percentile_empty",
      "construct": {
        "type": "percentile",
        "sorted_vals": [],
        "q_text": "0.5"
      },
      "expected": {
        "value": 0
      }
    },
    {
      "id": "percentile_ranked",
      "construct": {
        "type": "percentile",
        "sorted_vals": [
          10,
          20,
          30,
          40,
          50
        ],
        "q_text": "0.5"
      },
      "expected": {
        "value": 30
      }
    },
    {
      "id": "dist_sorted_copy",
      "construct": {
        "type": "dist",
        "values": [
          4,
          1,
          3,
          2
        ]
      },
      "expected": {
        "max": 4,
        "p50": 3,
        "p95": 4,
        "total": 10
      }
    },
    {
      "id": "tool_hash_read",
      "construct": {
        "type": "tool_hash",
        "name": "Read"
      },
      "expected": {
        "hash": "9b9a8d05a7ec353b"
      }
    },
    {
