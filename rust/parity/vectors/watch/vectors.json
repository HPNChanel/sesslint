{
  "schema": "sesslint.parity-module-vectors/v1",
  "module": "sesslint.watch",
  "python_commit": "e91d50b2ecea57ef4dd900e3b0b87b14946e847e",
  "watch_py_sha256": "8329fffaf88e78b3d2881fef699fbc6a66b636180ee68034a6d8dc5de1113bb7",
  "watch_rs_sha256": "a9d4fd57c621b28951aa55765c39e1bc90c48efa6f3fa4903c9f7f290c3de55d",
  "known_parity_gaps": [
    "GAP-watch-check-file: omitted check_fn imports sesslint.api.check_file in Python; Rust returns CheckFileUnavailable before walking (not byte-compared here).",
    "GAP-watch-minimize-path: format_transition and WatchTransition.to_dict import sesslint.report.minimize_path in Python; Rust returns MinimizePathUnavailable at that import (not byte-compared here)."
  ],
  "vectors": [
    {
      "id": "module_constants",
      "construct": {
        "type": "module_constants"
      },
      "expected": {
        "watch_event_schema": "sesslint.watch-event/v1",
        "default_interval": 2.0,
        "min_interval": 0.05,
        "max_tracked_files": 4096,
        "excluded_dirs": [
          ".git",
          ".hg",
          ".svn"
        ],
        "excluded_names": [
          ".sesslint.toml",
          "sesslint.toml"
        ],
        "all_exports": [
          "DEFAULT_INTERVAL",
          "MAX_TRACKED_FILES",
          "MIN_INTERVAL",
          "WATCH_EVENT_SCHEMA",
          "CheckFn",
          "WatchTransition",
          "format_transition",
          "watch"
        ]
      }
    },
    {
      "id": "interval_below_min",
      "construct": {
        "type": "interval_error",
        "interval": 0.04
      },
      "expected": {
        "raises": "ValueError",
        "message": "interval must be >= 0.05s, got 0.04"
      }
    },
    {
      "id": "snapshot_missing",
      "construct": {
        "type": "snapshot_file",
        "path": "fixtures/synthetic_missing.jsonl"
      },
      "expected": {
        "snapshot": null
      }
    },
    {
      "id": "snapshot_single",
      "construct": {
        "type": "snapshot_file",
        "path": "fixtures/synthetic_single.jsonl"
      },
      "expected": {
