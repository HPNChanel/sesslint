def build_expected(render: types.ModuleType, row: dict[str, Any]) -> dict[str, Any]:
    construct = row["construct"]
    kind = construct["type"]
    if kind == "format_scan_report_human":
        return build_expected_scan(render, construct)
    if kind == "emit_check_report":
        return build_expected_emit(render, construct)
    raise ValueError(f"unknown construct type {kind}")


def fix_divergence_entries_files(files: list[dict[str, Any]]) -> None:
    for file_row in files:
        for finding in file_row.get("findings", []):
            evidence = finding.get("evidence")
            if not isinstance(evidence, dict):
                continue
            entries = evidence.pop("divergence_entries", None)
            if entries is None:
                continue
            # Python dict literal with duplicate keys keeps the last value.
            finding["evidence"] = {"divergence": entries[-1]}


def scan_finding_evidence_fixup(spec: dict[str, Any]) -> None:
    if spec.get("type") != "format_scan_report_human":
        return
    report = spec.get("scan_report", {})
    fix_divergence_entries_files(report.get("files", []))


def assert_synthetic(payload: str) -> None:
    if _BANNED_SUPABASE_PAT.search(payload.encode("utf-8")):
        raise SystemExit("vectors contain forbidden sbp_ digest pattern")
    if "\r" in payload:
        raise SystemExit("vectors must be LF-only")


def main() -> int:
    render = load_render_module()
    out_dir = Path(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        construct = dict(row["construct"])
        scan_finding_evidence_fixup(construct)
        expected = build_expected(render, {"construct": construct})
        vectors.append(
            {
                "id": row["id"],
                "construct": construct,
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "render_py_sha256": RENDER_PY_SHA256,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    assert_synthetic(payload)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": "Synthetic cli._render scan human output and skip-undetected parity.",
        "generator": "rust/parity/vectors/cli._render/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
    }
    prov_payload = json.dumps(provenance, indent=2) + "\n"
    assert_synthetic(prov_payload)
    (out_dir / "PROVENANCE.json").write_text(
        prov_payload,
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
