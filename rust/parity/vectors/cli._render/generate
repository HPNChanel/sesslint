def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
    )


def verify_digest(blob: bytes, expected: str, label: str) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != expected:
        raise SystemExit(f"{label} pin sha256 mismatch: expected {expected}, got {digest}")


def exec_module_from_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile.NamedTemporaryFile(mode="wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp_path = handle.name
    try:
        spec = importlib.util.spec_from_file_location(fullname, tmp_path)
        if spec is None or spec.loader is None:
            raise SystemExit(f"failed to create import spec for {fullname}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[fullname] = mod
        spec.loader.exec_module(mod)
        return mod
    finally:
        Path(tmp_path).unlink(missing_ok=True)


def install_package_tree() -> None:
    pkg = types.ModuleType("sesslint")
    pkg.__version__ = "0.5.0"
    pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint"] = pkg

    cli_pkg = types.ModuleType("sesslint.cli")
    cli_pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.cli"] = cli_pkg
    pkg.cli = cli_pkg

    errors_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_errors.py")
    verify_digest(errors_blob, ERRORS_PY_SHA256, "_errors.py")
    errors = exec_module_from_blob(errors_blob, "sesslint.cli._errors")
    cli_pkg._errors = errors
    cli_pkg.CliError = errors.CliError

    progress = types.ModuleType("sesslint.progress")

    class ProgressCallback:  # noqa: D101
        pass

    progress.ProgressCallback = ProgressCallback
    sys.modules["sesslint.progress"] = progress
    pkg.progress = progress

    context_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_context.py")
    verify_digest(context_blob, CONTEXT_PY_SHA256, "_context.py")
    context = exec_module_from_blob(context_blob, "sesslint.cli._context")
    cli_pkg._context = context
    cli_pkg.CliContext = context.CliContext

    api = types.ModuleType("sesslint.api")

    def build_internal_error_envelope(
        err: BaseException,
        error_id: str | None = None,
    ) -> dict[str, str]:
        eid = error_id if error_id is not None else "ERR-00000000"
        return {
            "code": "INTERNAL_ERROR",
            "error_id": eid,
            "message": str(err),
            "verdict": "error",
        }

    api.build_internal_error_envelope = build_internal_error_envelope
    sys.modules["sesslint.api"] = api
    pkg.api = api

    finding = types.ModuleType("sesslint.finding")

    class Finding:  # noqa: D101
        pass

    finding.Finding = Finding
    sys.modules["sesslint.finding"] = finding
    pkg.finding = finding

    io_mod = types.ModuleType("sesslint.io")
    io_mod.DEFAULT_MAX_FILE_BYTES = 100 * 1024 * 1024
    sys.modules["sesslint.io"] = io_mod
    pkg.io = io_mod

    common_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_common.py")
    verify_digest(common_blob, COMMON_PY_SHA256, "_common.py")
    common = exec_module_from_blob(common_blob, "sesslint.cli._common")
    cli_pkg._common = common

    output_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_output.py")
    verify_digest(output_blob, OUTPUT_PY_SHA256, "_output.py")
    output = exec_module_from_blob(output_blob, "sesslint.cli._output")
    cli_pkg._output = output


def load_render_module() -> types.ModuleType:
    install_package_tree()
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_render.py")
    verify_digest(blob, RENDER_PY_SHA256, "_render.py")
    render = exec_module_from_blob(blob, "sesslint.cli._render")
    sys.modules["sesslint.cli"]._render = render
    return render


class ScanTotals:
    def __init__(self, **fields: int) -> None:
        for key, value in fields.items():
            setattr(self, key, value)


class ScanFinding:
    def __init__(self, code: str, evidence: Any) -> None:
        self.code = code
        self.evidence = evidence


class ScanFile:
    def __init__(self, spec: dict[str, Any]) -> None:
        self.verdict = spec["verdict"]
        self.path = spec["path"]
        self.error_count = spec.get("error_count", 0)
        self.warning_count = spec.get("warning_count", 0)
        self.skipped_reason = spec.get("skipped_reason")
        self.cache_hit = bool(spec.get("cache_hit", False))
        self.findings = [build_scan_finding(row) for row in spec.get("findings", [])]


class ScanSummary:
    def __init__(self, spec: dict[str, Any]) -> None:
        self.by_code = [CodeRollup(row) for row in spec.get("by_code", [])]
        self.worst_files = [WorstFile(row) for row in spec.get("worst_files", [])]


class CodeRollup:
    def __init__(self, spec: dict[str, Any]) -> None:
        self.code = spec["code"]
        self.severity = spec["severity"]
        self.count = spec["count"]
        self.files = spec["files"]


class WorstFile:
    def __init__(self, spec: dict[str, Any]) -> None:
        self.path = spec["path"]
        self.error_count = spec["error_count"]
        self.warning_count = spec["warning_count"]


class ScanReport:
    def __init__(self, spec: dict[str, Any]) -> None:
        self.root_path = spec["root_path"]
        self.totals = ScanTotals(**spec["totals"])
        self.files = [ScanFile(row) for row in spec.get("files", [])]
        self._skipped_reason_totals = dict(spec.get("skipped_reason_totals", {}))
        summary = spec.get("summary")
        self.summary = ScanSummary(summary) if summary is not None else None

    def skipped_reason_totals(self) -> dict[str, int]:
        return self._skipped_reason_totals


def build_scan_finding(spec: dict[str, Any]) -> ScanFinding:
    evidence = spec.get("evidence")
    if evidence is None:
        evidence = {}
    elif evidence == "falsy":
        evidence = {}
    elif isinstance(evidence, dict):
        pass
    else:
        raise ValueError(f"unsupported scan evidence: {evidence!r}")
    return ScanFinding(spec["code"], evidence)


def build_scan_report(spec: dict[str, Any]) -> ScanReport:
    return ScanReport(spec)


class SeverityCounts:
    def __init__(self, spec: dict[str, Any]) -> None:
        self.total = spec.get("total", 0)
        self.by_severity = dict(spec.get("by_severity", {}))


class CheckFinding:
    def __init__(self, spec: dict[str, Any]) -> None:
        self.code = spec["code"]
        self.message = spec["message"]
        evidence = spec.get("evidence", "not_dict")
        if evidence == "not_dict":
            self.evidence = 0
        elif isinstance(evidence, dict):
            self.evidence = decode_evidence(evidence)
        else:
            raise ValueError(f"unsupported check evidence: {evidence!r}")


def decode_evidence(value: dict[str, Any]) -> Any:
    out: dict[str, Any] = {}
    for key, item in value.items():
        out[key] = decode_evidence_value(item)
    return out


def decode_evidence_value(item: Any) -> Any:
    if isinstance(item, dict) and "kind" in item:
        kind = item["kind"]
        if kind == "str":
            return item["value"]
        if kind == "int":
            return item["value"]
        if kind == "float":
            return item["value"]
        if kind == "bool":
            return item["value"]
        if kind == "dict":
            return {row["key"]: decode_evidence_value(row["value"]) for row in item["entries"]}
        if kind == "not_str":
            return 0
        raise ValueError(f"unknown evidence kind {kind}")
    return item


class CheckCoverage:
    def __init__(self, spec: dict[str, Any]) -> None:
        self.adapter = dict(spec.get("adapter", {}))
        self.profile = dict(spec.get("profile", {}))


class CheckReport:
    def __init__(self, spec: dict[str, Any]) -> None:
        self.counts = SeverityCounts(spec.get("counts", {}))
        self.limitation = spec.get("limitation", "")
        self.findings = [CheckFinding(row) for row in spec.get("findings", [])]
        self.coverage = CheckCoverage(spec.get("coverage", {}))
        self.tool_version = spec.get("tool_version", "0.5.0")


def args_from_spec(spec: dict[str, Any]) -> argparse.Namespace:
    defaults = {
        "skip_undetected": False,
        "json": False,
        "output_format": None,
        "fail_on": "error",
        "fail_on_unsupported": False,
        "include_content": False,
        "write_baseline": None,
        "quiet": False,
        "command": "check",
    }
    defaults.update(spec)
    return argparse.Namespace(**defaults)


def build_expected_scan(render: types.ModuleType, spec: dict[str, Any]) -> dict[str, Any]:
    report = build_scan_report(spec["scan_report"])
    color = bool(spec.get("color", False))
    text = render.format_scan_report_human(report, color=color)
    return {"text": text}


def build_expected_emit(render: types.ModuleType, spec: dict[str, Any]) -> dict[str, Any]:
    context = sys.modules["sesslint.cli._context"]
    buf = io.StringIO()
    ctx = context.CliContext(
        quiet=bool(spec.get("quiet", False)),
        verbose=False,
        config_path=None,
        settings={},
        stderr=buf,
    )
    report = CheckReport(spec["report"])
    args = args_from_spec(spec.get("args", {}))
    display_path = spec["display_path"]
    try:
        code = render._emit_check_report(
            ctx,
            report,
            args,
            display_path=display_path,
            format_opt=spec.get("format_opt", "auto"),
            profile_opt=spec.get("profile_opt", "synthetic"),
            inputs=(),
        )
    except Exception as err:  # noqa: BLE001 — parity harness
        return {
            "result": "error",
            "message": str(err),
            "stderr": buf.getvalue(),
        }
    return {
        "result": "ok",
        "exit_code": code,
        "stderr": buf.getvalue(),
    }


