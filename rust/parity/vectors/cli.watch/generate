#!/usr/bin/env python3
"""Generate sesslint.cli.watch parity vectors from pinned blobs (stdlib only)."""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import importlib.util
import io
import json
import re
import subprocess
import sys
import tempfile
import types
from argparse import Namespace
from contextlib import contextmanager
from pathlib import Path as FsPath
from typing import Any, Iterator

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
WATCH_PY_SHA256 = (
    "97226bd8408dc1c47a355e9a87d98b10b10f10bfd5ea8e46419d2f5055e8703f"
)
WATCH_RS_SHA256 = (
    "4a062e8dd089979b7d52c622bbd330d7baa1ace83af65b45f2ae402bc8b9ffa2"
)
MODULE = "sesslint.cli.watch"

GAP_DISCOVER = "GAP-cli-watch-discover-session-roots"
RUST_SEAM = "sesslint.api.discover_session_roots is not available"

KNOWN_PARITY_GAPS = [
    (
        f"{GAP_DISCOVER}: Python run() may reach path checks, discover_session_roots, "
        "or sesslint.watch.watch after imports; Rust run() returns Display "
        f"`{RUST_SEAM}` immediately after `json` import (no path check, print, or exit 0)."
    ),
]

_BANNED_PAT = re.compile(
    rb"(?:sk_live_|sk_test_|rk_live_|rk_test_|sbp_[0-9a-f]{40}|sesslint-wt-|FOR_WORK)"
)


def repo_root() -> FsPath:
    return FsPath(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
    )


def verify_digest(blob: bytes, expected: str, label: str) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != expected:
        raise SystemExit(f"{label} pin sha256 mismatch: expected {expected}, got {digest}")


def exec_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile_named_blob(blob) as tmp_path:
        spec = importlib.util.spec_from_file_location(fullname, tmp_path)
        if spec is None or spec.loader is None:
            raise SystemExit(f"failed to create import spec for {fullname}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[fullname] = mod
        spec.loader.exec_module(mod)
        return mod


@contextmanager
def tempfile_named_blob(blob: bytes) -> Iterator[str]:
    with tempfile.NamedTemporaryFile(mode="wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp_path = handle.name
    try:
        yield tmp_path
    finally:
        FsPath(tmp_path).unlink(missing_ok=True)


class _Ctx:
  def __init__(self) -> None:
      self.errors: list[str] = []

  def error(self, message: str) -> None:
      self.errors.append(message)


class _Root:
    def __init__(self, path: str, exists: bool = True) -> None:
        self.path = path
        self.exists = exists


def install_package_tree() -> None:
    pkg = types.ModuleType("sesslint")
    pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint"] = pkg

    adapters = types.ModuleType("sesslint.adapters")
    adapters.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.adapters"] = adapters
    pkg.adapters = adapters

    detect = types.ModuleType("sesslint.adapters.detect")
    detect.VALID_FORMAT_OPTIONS = frozenset(
        {
            "auto",
            "canonical",
            "claude-code-jsonl",
            "codex-rollout",
            "openai-agents",
        }
    )
    sys.modules["sesslint.adapters.detect"] = detect
    adapters.detect = detect

    cli_pkg = types.ModuleType("sesslint.cli")
    cli_pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.cli"] = cli_pkg
    pkg.cli = cli_pkg

    context = types.ModuleType("sesslint.cli._context")
    context.CliContext = _Ctx
    sys.modules["sesslint.cli._context"] = context
    cli_pkg._context = context

    api = types.ModuleType("sesslint.api")

    def discover_session_roots(agents: list[str] | None) -> list[_Root]:
        def make_root(label: str) -> _Root:
            temp = FsPath(tempfile.mkdtemp(prefix=f"sl-watch-root-{label}-"))
            marker = temp / "synthetic-marker"
            marker.write_text("synthetic\n", encoding="utf-8")
            return _Root(str(temp), exists=True)

        if agents is None:
            return [make_root("claude"), make_root("codex")]
        return [make_root(agent) for agent in agents]

    api.discover_session_roots = discover_session_roots
    sys.modules["sesslint.api"] = api
    pkg.api = api

    progress = types.ModuleType("sesslint.progress")

    class OperationCancelled(Exception):
        pass

    progress.OperationCancelled = OperationCancelled
    sys.modules["sesslint.progress"] = progress
    pkg.progress = progress

    watch_mod = types.ModuleType("sesslint.watch")

    def watch(
        paths: list[Any],
        *,
        interval: float,
        on_transition: Any,
        format: str | None,
    ) -> None:
        _ = (paths, interval, on_transition, format)
        raise OperationCancelled()

    watch_mod.watch = watch
    watch_mod.format_transition = lambda _t: "synthetic-transition\n"
    sys.modules["sesslint.watch"] = watch_mod
    pkg.watch = watch_mod


def load_watch_module() -> types.ModuleType:
    install_package_tree()
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/watch.py")
    verify_digest(blob, WATCH_PY_SHA256, "cli/watch.py")
    watch = exec_blob(blob, "sesslint.cli.watch")
    sys.modules["sesslint.cli"].watch = watch
    return watch


def encode_action(action: argparse.Action) -> str:
    if action.const is True and action.nargs == 0:
        return "store_true"
    return "store"


def encode_default_keyword(action: argparse.Action) -> Any:
    if not action.option_strings:
        return "absent"
    if action.const is True and action.default is False:
        return {"present": "false"}
    if action.default is None:
        return {"present": "none"}
    if isinstance(action.default, bool):
        return {"present": "false" if not action.default else "true"}
    if isinstance(action.default, float):
        return {"present": {"float": action.default}}
    if isinstance(action.default, str):
        return {"present": {"text": action.default}}
    raise SystemExit(f"unexpected default for {action.dest}: {action.default!r}")


def encode_effective_default(action: argparse.Action) -> Any:
    if not action.option_strings:
        return "none"
    if action.const is True and action.default is False:
        return "false"
    if action.default is None:
        return "none"
    if isinstance(action.default, bool):
        return "false" if not action.default else "true"
    if isinstance(action.default, float):
        return {"float": action.default}
    if isinstance(action.default, str):
        return {"text": action.default}
    raise SystemExit(f"unexpected effective for {action.dest}: {action.default!r}")


def nargs_token(action: argparse.Action) -> str | None:
    if action.nargs is None:
        return None
    if action.nargs == argparse.ZERO_OR_MORE:
        return "*"
    if action.nargs == 0:
        return "0"
    return str(action.nargs)


def encode_argument(action: argparse.Action) -> dict[str, Any]:
    positional = not action.option_strings
    choices = list(action.choices) if action.choices is not None else None
    if action.dest == "adapter" and choices is not None:
        choices = sorted(choices)
    type_name = None
    if action.type is not None and hasattr(action.type, "__name__"):
        type_name = action.type.__name__
    return {
        "positional": positional,
        "option_strings": list(action.option_strings),
        "dest": action.dest,
        "action": encode_action(action),
        "nargs": nargs_token(action),
        "type_name": type_name,
        "choices": choices,
        "metavar": action.metavar,
        "help": action.help or "",
        "default_keyword": encode_default_keyword(action),
        "effective_default": encode_effective_default(action),
        "required": bool(action.required),
    }


def configure_expected(watch: types.ModuleType) -> dict[str, Any]:
    root = argparse.ArgumentParser(prog="sesslint")
    subparsers = root.add_subparsers()
    sub = watch.configure(subparsers)

    subcommand_help = None
    for action in root._actions:
        if isinstance(action, argparse._SubParsersAction):
            for choice_action in action._choices_actions:
                if choice_action.dest == watch.NAME:
                    subcommand_help = choice_action.help
                    break
    if subcommand_help is None:
        raise SystemExit("failed to introspect subcommand help from configure()")

    arguments: list[dict[str, Any]] = []
    for action in sub._actions:
        if action.dest in {"help"}:
            continue
        arguments.append(encode_argument(action))

    return {
        "name": watch.NAME,
        "help": subcommand_help or "",
        "description": sub.description or "",
        "arguments": arguments,
    }


def namespace_from_spec(attrs: dict[str, Any]) -> Namespace:
    defaults: dict[str, Any] = {
        "path": [],
        "agent": None,
        "interval": 2.0,
        "adapter": "auto",
        "json": False,
    }
    defaults.update(attrs)
    raw_paths = list(defaults.get("path") or [])
    defaults["path"] = [FsPath(p) for p in raw_paths]
    return Namespace(**defaults)


def materialize_paths(attrs: dict[str, Any]) -> dict[str, Any]:
    out = dict(attrs)
    if out.get("agent") is not None:
        return out
    paths = list(out.get("path") or [])
    if not paths:
        return out
    created: list[str] = []
    temp_dir = FsPath(tempfile.mkdtemp(prefix="sl-watch-par-"))
    try:
        for rel in paths:
            target = temp_dir / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text("synthetic\n", encoding="utf-8")
            created.append(str(target))
        out["path"] = created
        return out
    except Exception:
        for item in created:
            FsPath(item).unlink(missing_ok=True)
        temp_dir.rmdir()
        raise


def run_pin(watch: types.ModuleType, attrs: dict[str, Any]) -> dict[str, Any]:
    prepared = materialize_paths(attrs)
    args = namespace_from_spec(prepared)
    ctx = _Ctx()
    stdout = io.StringIO()
    stderr_lines: list[str] = []
    with contextlib.redirect_stdout(stdout):
        code = watch.run(ctx, args, None)
    for err in ctx.errors:
        stderr_lines.append(err)
    return {
        "exit_code": code,
        "stdout": stdout.getvalue(),
        "stderr": "\n".join(stderr_lines) + ("\n" if stderr_lines else ""),
    }


def vector_specs() -> list[dict[str, Any]]:
    return [
        {
            "id": "configure_subcommand_declarations",
            "construct": {"type": "configure"},
        },
        {
            "id": "run_defaults_empty",
            "construct": {
                "type": "run",
                "args": {},
            },
        },
        {
            "id": "run_synthetic_path_only",
            "construct": {
                "type": "run",
                "args": {
                    "path": ["synthetic-session.jsonl"],
                },
            },
        },
        {
            "id": "run_agent_codex",
            "construct": {
                "type": "run",
                "args": {"agent": "codex"},
            },
        },
        {
            "id": "run_agent_with_conflicting_paths",
            "construct": {
                "type": "run",
                "args": {
                    "agent": "all",
                    "path": ["synthetic-session.jsonl"],
                },
            },
        },
        {
            "id": "run_full_args",
            "construct": {
                "type": "run",
                "args": {
                    "path": ["synthetic-session.jsonl"],
                    "agent": None,
                    "interval": 2.0,
                    "adapter": "canonical",
                    "json": True,
                },
            },
        },
    ]


def build_expected(watch: types.ModuleType, row: dict[str, Any]) -> dict[str, Any]:
    construct = row["construct"]
    kind = construct["type"]
    if kind == "configure":
        return configure_expected(watch)
    if kind == "run":
        attrs = dict(construct.get("args") or {})
        pin = run_pin(watch, attrs)
        return {
            "mode": "rust_seam",
            "gap_id": GAP_DISCOVER,
            "seam": RUST_SEAM,
            "imports_evaluated": ["json", "sesslint.api.discover_session_roots"],
            "pin": pin,
        }
    raise SystemExit(f"unknown construct for {row['id']}")


def assert_payload_clean(payload: bytes) -> None:
    if _BANNED_PAT.search(payload):
        raise SystemExit("vectors.json contains banned marker")
    if b"\r" in payload:
        raise SystemExit("vectors.json must be LF-only")


def main() -> int:
    watch = load_watch_module()
    out_dir = FsPath(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        expected = build_expected(watch, row)
        vectors.append(
            {
                "id": row["id"],
                "construct": row["construct"],
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "watch_py_sha256": WATCH_PY_SHA256,
        "watch_rs_sha256": WATCH_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    payload_bytes = payload.encode("utf-8")
    assert_payload_clean(payload_bytes)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_bytes(payload_bytes)
    digest = hashlib.sha256(payload_bytes).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.cli.watch configure declarations and run() rust seam "
            "fixtures from pinned src/sesslint/cli/watch.py (no checkout import)."
        ),
        "generator": "rust/parity/vectors/cli.watch/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    coverage = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": 0,
        "not_applicable_count": 0,
        "rows": [],
    }
    (out_dir / "coverage.json").write_text(
        json.dumps(coverage, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
