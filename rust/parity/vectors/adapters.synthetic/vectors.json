      "construct": {
        "type": "guard_run",
        "steps": [
          {
            "action": "register_real",
            "event_id": "sesslint:synthetic:adapter:0:12345678"
          },
          {
            "action": "register_real",
            "event_id": "sesslint:synthetic:adapter:1:87654321"
