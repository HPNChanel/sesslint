          },
          {
            "action": "register_real",
            "event_id": "sesslint:synthetic:adapter:0:12345678"
          },
          {
            "action": "register_synthetic",
            "event_id": "sesslint:synthetic:claude_code:0:deadbeef"
          },
          {
            "action": "assert_no_collision"
          }
        ]
      },
      "expected": {
        "result": "ok",
        "value": null
      }
