)
DIFF_RS_SHA256 = (
    "5d8f763884f4d11944bef2c9939ce4a88b453a06659f1b0bc92b2800dbb9fa73"
)
MODULE = "sesslint.diff"
COVERAGE_TEST_FILE = "tests/cli/test_diff.py"

KNOWN_PARITY_GAPS: Final[tuple[str, ...]] = (
    "GAP-diff-minimize-path: SessionDiff.to_dict, to_json, and render_human import "
    "sesslint.report.minimize_path in Python; Rust returns "
    "sesslint.report.minimize_path is not available.",
    "GAP-diff-resolve-format: diff_sessions and _load_side call "
    "sesslint.adapters.detect.resolve_format once both paths are files; Rust returns "
