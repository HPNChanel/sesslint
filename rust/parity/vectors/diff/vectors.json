            "b_index": 3,
            "detail": {
              "kind": "message"
            }
          },
          {
            "category": "kind-changed",
            "event_id": "e1",
            "a_index": 0,
            "b_index": 1
          },
          {
            "category": "content-changed",
            "event_id": "e1",
            "a_index": 0,
            "b_index": 1
          }
        ]
      },
      "expected": {
        "identical": false,
        "counts": {
          "added": 1,
          "removed": 0,
          "kind-changed": 1,
          "parent-relinked": 0,
          "seq-reordered": 0,
          "content-changed": 1
        }
      }
    },
    {
