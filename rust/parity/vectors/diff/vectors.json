{
  "schema": "sesslint.parity-module-vectors/v1",
  "module": "sesslint.diff",
  "python_commit": "e91d50b2ecea57ef4dd900e3b0b87b14946e847e",
  "diff_py_sha256": "2d597dad56536db2bba2372c6e809ef31bb5784c31442e06ba8f7c34851ddbcf",
  "diff_rs_sha256": "5d8f763884f4d11944bef2c9939ce4a88b453a06659f1b0bc92b2800dbb9fa73",
  "known_parity_gaps": [
    "GAP-diff-minimize-path: SessionDiff.to_dict, to_json, and render_human import sesslint.report.minimize_path in Python; Rust returns sesslint.report.minimize_path is not available.",
    "GAP-diff-resolve-format: diff_sessions and _load_side call sesslint.adapters.detect.resolve_format once both paths are files; Rust returns sesslint.adapters.detect.resolve_format is not available and builds no SessionDiff.",
    "GAP-diff-content-hash: diff_events with any event calls SessionEvent.content_identity_hash; Rust returns sesslint.canonical.SessionEvent is not available and discards partial deltas.",
    "GAP-diff-schema-path: get_diff_schema_path and load_diff_schema import sesslint._resources.schema_path; Rust returns sesslint._resources.schema_path is not available.",
    "GAP-diff-cli-integration: CLI main tests and full diff_sessions success paths are not byte-compared here."
  ],
  "vectors": [
    {
      "id": "module_constants",
      "construct": {
        "type": "module_constants"
      },
      "expected": {
        "DIFF_SCHEMA_VERSION": "sesslint.diff/v1",
        "MAX_ROWS": 100,
        "DELTA_CATEGORIES": [
          "added",
          "removed",
          "kind-changed",
          "parent-relinked",
          "seq-reordered",
          "content-changed"
        ],
        "python_all": [
          "DELTA_CATEGORIES",
          "DIFF_SCHEMA_VERSION",
          "MAX_ROWS",
          "Delta",
          "DeltaCategory",
          "DiffInputError",
          "SessionDiff",
          "diff_events",
          "diff_sessions",
          "get_diff_schema_path",
          "load_diff_schema"
        ]
      }
    },
    {
      "id": "delta_to_dict_minimal",
      "construct": {
        "type": "delta_to_dict",
        "category": "seq-reordered"
      },
      "expected": {
        "dict": {
          "category": "seq-reordered"
        }
      }
    },
    {
      "id": "delta_to_dict_populated",
      "construct": {
        "type": "delta_to_dict",
        "category": "kind-changed",
        "event_id": "ev-synth-01",
        "a_index": 0,
        "b_index": 2,
        "detail": {
          "kind_a": "message",
          "kind_b": "checkpoint"
        }
      },
      "expected": {
        "dict": {
          "a_index": 0,
          "b_index": 2,
          "category": "kind-changed",
          "detail": {
            "kind_a": "message",
            "kind_b": "checkpoint"
          },
          "event_id": "ev-synth-01"
        }
      }
    },
    {
      "id": "delta_label_pairs",
      "construct": {
        "type": "delta_label",
        "event_id": "ev-synth-02",
        "a_index": 1,
        "b_index": 3,
        "detail": {
          "z_key": "2",
          "a_key": "1"
        }
      },
      "expected": {
        "label": "a[1] -> b[3] id=ev-synth-02 a_key=1 z_key=2"
      }
    },
    {
      "id": "session_identical_empty",
      "construct": {
        "type": "session_identical_counts",
        "deltas": []
      },
      "expected": {
        "identical": true,
        "counts": {
          "added": 0,
          "removed": 0,
          "kind-changed": 0,
          "parent-relinked": 0,
          "seq-reordered": 0,
          "content-changed": 0
        }
      }
    },
    {
      "id": "session_counts_mixed",
      "construct": {
        "type": "session_identical_counts",
        "a_event_count": 3,
        "b_event_count": 4,
        "deltas": [
          {
            "category": "added",
