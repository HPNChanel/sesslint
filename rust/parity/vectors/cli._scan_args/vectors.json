  "known_parity_gaps": [
    "GAP-scan-args-cpu-count: jobs 'auto' or '0' (after strip and lower) use os.cpu_count() or 1 in Python; Rust uses thread::available_parallelism — job counts are not pinned.",
    "GAP-scan-args-jobs-i64: a positive integer jobs token that does not fit in i64 is refused as jobs value does not fit in i64 in Rust, not Python arbitrary int semantics."
  ],
