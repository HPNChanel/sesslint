KNOWN_PARITY_GAPS = [
    (
        "GAP-scan-args-cpu-count: jobs 'auto' or '0' (after strip and lower) use "
        "os.cpu_count() or 1 in Python; Rust uses thread::available_parallelism "
        "— job counts are not pinned."
    ),
    (
        "GAP-scan-args-jobs-i64: a positive integer jobs token that does not fit "
        "in i64 is refused as jobs value does not fit in i64 in Rust, not Python "
        "arbitrary int semantics."
    ),
]

_BANNED_SUPABASE_PAT = re.compile(rb"sbp_[0-9a-f]{40}")


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
    )


def verify_digest(blob: bytes, expected: str, label: str) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != expected:
        raise SystemExit(f"{label} pin sha256 mismatch: expected {expected}, got {digest}")


def exec_module_from_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile.NamedTemporaryFile(mode="wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp_path = handle.name
    try:
        spec = importlib.util.spec_from_file_location(fullname, tmp_path)
        if spec is None or spec.loader is None:
            raise SystemExit(f"failed to create import spec for {fullname}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[fullname] = mod
        spec.loader.exec_module(mod)
        return mod
    finally:
        Path(tmp_path).unlink(missing_ok=True)


def install_package_tree() -> None:
    pkg = types.ModuleType("sesslint")
    pkg.__version__ = "0.5.0+synthetic-parity"
    pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint"] = pkg

    cli_pkg = types.ModuleType("sesslint.cli")
    cli_pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.cli"] = cli_pkg
    pkg.cli = cli_pkg

    errors_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_errors.py")
    verify_digest(errors_blob, ERRORS_PY_SHA256, "_errors.py")
    errors = exec_module_from_blob(errors_blob, "sesslint.cli._errors")
    cli_pkg._errors = errors

    progress_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/progress.py")
    verify_digest(progress_blob, PROGRESS_PY_SHA256, "progress.py")
    progress = exec_module_from_blob(progress_blob, "sesslint.progress")
    sys.modules["sesslint.progress"] = progress
    pkg.progress = progress

    cli_progress_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_progress.py")
    verify_digest(cli_progress_blob, CLI_PROGRESS_PY_SHA256, "cli/_progress.py")
    cli_progress = exec_module_from_blob(cli_progress_blob, "sesslint.cli._progress")
    cli_pkg._progress = cli_progress

    api = types.ModuleType("sesslint.api")

    def build_internal_error_envelope(
        err: BaseException,
        error_id: str | None = None,
    ) -> dict[str, str]:
        eid = error_id if error_id is not None else "ERR-00000000"
        return {
            "code": "INTERNAL_ERROR",
            "error_id": eid,
            "message": str(err),
            "verdict": "error",
        }

    api.build_internal_error_envelope = build_internal_error_envelope
    sys.modules["sesslint.api"] = api
    pkg.api = api

    finding = types.ModuleType("sesslint.finding")

    class Finding:  # noqa: D101
        pass

    finding.Finding = Finding
    sys.modules["sesslint.finding"] = finding
    pkg.finding = finding

    io_mod = types.ModuleType("sesslint.io")
    io_mod.DEFAULT_MAX_FILE_BYTES = 100 * 1024 * 1024
    sys.modules["sesslint.io"] = io_mod
    pkg.io = io_mod

    common_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_common.py")
    verify_digest(common_blob, COMMON_PY_SHA256, "_common.py")
    common = exec_module_from_blob(common_blob, "sesslint.cli._common")
    cli_pkg._common = common

    context_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_context.py")
    verify_digest(context_blob, CONTEXT_PY_SHA256, "_context.py")
    context = exec_module_from_blob(context_blob, "sesslint.cli._context")
    cli_pkg._context = context


def load_scan_args_module() -> types.ModuleType:
    install_package_tree()
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/cli/_scan_args.py")
    verify_digest(blob, SCAN_ARGS_PY_SHA256, "_scan_args.py")
    scan_args = exec_module_from_blob(blob, "sesslint.cli._scan_args")
    sys.modules["sesslint.cli"]._scan_args = scan_args
    return scan_args


def required_args_dict() -> dict[str, Any]:
    return {
        "max_file_bytes": 100,
        "timestamp_skew_ms": 2000,
        "max_findings_per_code": 20,
    }


def namespace_from_mapping(values: dict[str, Any]) -> Namespace:
    return Namespace(**values)


def ctx_from_spec(spec: dict[str, Any]) -> Any:
    quiet = bool(spec.get("quiet", True))
    verbose = bool(spec.get("verbose", False))
    isatty = bool(spec.get("isatty", False))
    buf = io.StringIO()
    buf.isatty = lambda: isatty  # type: ignore[attr-defined]
    context = sys.modules["sesslint.cli._context"]
    return context.CliContext(
        quiet=quiet,
        verbose=verbose,
        config_path=None,
        settings={},
        stderr=buf,
    )


def encode_scalar(value: object) -> dict[str, Any]:
    if value is None:
        return {"kind": "none"}
    if isinstance(value, bool):
        return {"kind": "bool", "value": value}
    if isinstance(value, int):
        return {"kind": "int", "value": value}
    if isinstance(value, str):
        return {"kind": "str", "value": value}
    raise TypeError(f"unsupported scalar {value!r}")


def encode_progress_cb(cb: Any) -> dict[str, str]:
    if cb is None:
        return {"kind": "none"}
    name = cb.__class__.__name__
    if name == "TtyProgress":
        return {"kind": "tty"}
    return {"kind": "ndjson"}


def encode_kwargs(kwargs: dict[str, Any]) -> dict[str, Any]:
    out: dict[str, Any] = {
        "recursive": kwargs["recursive"],
        "follow_symlinks": encode_scalar(kwargs["follow_symlinks"]),
        "max_files": encode_scalar(kwargs["max_files"]),
        "max_bytes": encode_scalar(kwargs["max_bytes"]),
        "max_file_bytes": encode_scalar(kwargs["max_file_bytes"]),
        "timestamp_skew_ms": encode_scalar(kwargs["timestamp_skew_ms"]),
        "max_findings_per_code": encode_scalar(kwargs["max_findings_per_code"]),
        "newest": encode_scalar(kwargs["newest"]) if kwargs["newest"] is not None else None,
        "since": encode_scalar(kwargs["since"]) if kwargs["since"] is not None else None,
        "format": encode_scalar(kwargs["format"]),
        "profile": encode_scalar(kwargs["profile"]),
        "confidence_min": (
            encode_scalar(kwargs["confidence_min"])
            if kwargs["confidence_min"] is not None
            else None
        ),
        "margin_min": (
            encode_scalar(kwargs["margin_min"])
            if kwargs["margin_min"] is not None
            else None
        ),
        "progress_cb": encode_progress_cb(kwargs["progress_cb"]),
        "skip_undetected": encode_scalar(kwargs["skip_undetected"]),
        "select": kwargs["select"],
        "ignore": kwargs["ignore"],
        "baseline": kwargs["baseline"],
        "exclude": encode_scalar(kwargs["exclude"]) if kwargs["exclude"] is not None else None,
        "ext": encode_scalar(kwargs["ext"]) if kwargs["ext"] is not None else None,
        "incremental": encode_scalar(kwargs["incremental"]),
        "cache_dir": (
            encode_scalar(str(kwargs["cache_dir"]))
            if kwargs["cache_dir"] is not None
            else None
        ),
        "jobs": kwargs["jobs"],
    }
    return out


def build_expected(scan_args: types.ModuleType, row: dict[str, Any]) -> dict[str, Any]:
    construct = row["construct"]
    if construct.get("gap_id"):
        return {"result": "gap", "gap_id": construct["gap_id"]}

    ctx = ctx_from_spec(construct.get("ctx", {}))
    args_values = dict(required_args_dict())
    args_values.update(construct.get("args") or {})
    args = namespace_from_mapping(args_values)
    baseline = construct.get("baseline")
    progress_cb = construct.get("progress_cb_provided")

    try:
        kwargs = scan_args.build_scan_kwargs(ctx, args, baseline=baseline, progress_cb=progress_cb)
    except ValueError as err:
        return {
            "result": "error",
            "exception": "ValueError",
            "message": str(err),
        }

    encoded = encode_kwargs(kwargs)
    if construct.get("omit_jobs_from_kwargs"):
        encoded.pop("jobs", None)
    return {"result": "ok", "kwargs": encoded}


