def assert_no_banned_patterns(payload: bytes) -> None:
    if _BANNED_SUPABASE_PAT.search(payload):
        raise SystemExit("vectors payload matches banned sbp_ pattern")


def main() -> int:
    scan_args = load_scan_args_module()
    out_dir = Path(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        construct = dict(row["construct"])
        expected = build_expected(scan_args, row)
        vectors.append(
            {
                "id": row["id"],
                "construct": construct,
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "scan_args_py_sha256": SCAN_ARGS_PY_SHA256,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    assert_no_banned_patterns(payload.encode("utf-8"))
    if b"\r" in payload.encode("utf-8"):
        raise SystemExit("vectors payload must be LF-only")

    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic argparse fixtures for sesslint.cli._scan_args build_scan_kwargs parity."
        ),
        "generator": "rust/parity/vectors/cli._scan_args/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
