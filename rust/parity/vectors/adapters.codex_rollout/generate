def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show(rel: str) -> str:
    return subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:{rel}"], cwd=repo_root(), text=True
    )


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def verify_pin_hashes() -> None:
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/adapters/codex_rollout.py")
    digest = hashlib.sha256(blob).hexdigest()
    if digest != CODEX_PY_SHA256:
        raise SystemExit(
            f"codex_rollout.py pin sha256 mismatch: expected {CODEX_PY_SHA256}, got {digest}"
        )
    rs_path = repo_root() / "rust" / "crates" / "adapters" / "src" / "codex_rollout.rs"
    rs_digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if rs_digest != CODEX_RS_SHA256:
        raise SystemExit(
            "codex_rollout.rs sha256 mismatch: "
            f"expected {CODEX_RS_SHA256}, got {rs_digest}"
        )


def mod_to_paths(mod: str) -> list[str]:
    tail = mod[len("sesslint.") :].replace(".", "/")
    return [f"src/sesslint/{tail}.py", f"src/sesslint/{tail}/__init__.py"]


def discover_imports(source: str) -> set[str]:
    found: set[str] = set()
    tree = ast.parse(source)
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name.startswith("sesslint."):
                    found.add(alias.name)
        elif isinstance(node, ast.ImportFrom) and node.module:
            if node.module.startswith("sesslint."):
                found.add(node.module)
    return found


def closure(root_mod: str) -> list[str]:
    queue = [root_mod]
    seen: set[str] = set()
    order: list[str] = []
    while queue:
        mod = queue.pop(0)
        if mod in seen:
            continue
        seen.add(mod)
        source = None
        for candidate in mod_to_paths(mod):
            try:
                source = git_show(candidate)
                break
            except subprocess.CalledProcessError:
                continue
        if source is None:
            continue
        order.append(mod)
        for imp in discover_imports(source):
            if imp not in seen:
                queue.append(imp)
    return order


def ensure_packages() -> None:
    for pkg in (
        "sesslint",
        "sesslint.adapters",
        "sesslint.checks",
        "sesslint.io",
        "sesslint.scan",
        "sesslint.repair",
        "sesslint.profiles",
    ):
        mod = types.ModuleType(pkg)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[pkg] = mod


def load_module(mod: str, *, temp_main: bool = False) -> None:
    source = None
    rel = None
    for candidate in mod_to_paths(mod):
        try:
            source = git_show(candidate)
            rel = candidate
            break
        except subprocess.CalledProcessError:
            continue
    if source is None or rel is None:
        raise ModuleNotFoundError(mod)
    if temp_main and mod == "sesslint.adapters.codex_rollout":
        with tempfile.NamedTemporaryFile(
            "w", suffix=".py", delete=False, encoding="utf-8"
        ) as handle:
            handle.write(source)
            path = handle.name
        code = compile(source, path, "exec")
    else:
        code = compile(source, f"<{PYTHON_COMMIT}:{rel}>", "exec")
    module = types.ModuleType(mod)
    module.__file__ = f"<{PYTHON_COMMIT}:{rel}>"
    sys.modules[mod] = module
    try:
        exec(code, module.__dict__)  # noqa: S102
    except Exception:
        del sys.modules[mod]
        raise
    parent, _, child = mod.rpartition(".")
    if parent in sys.modules:
        setattr(sys.modules[parent], child, module)


def load_pinned_codex() -> Any:
    verify_pin_hashes()
    ensure_packages()
    mods = [
        m
        for m in closure("sesslint.adapters.codex_rollout")
        if m != "sesslint.adapters.codex_rollout"
    ]
    pending = list(mods)
    for _ in range(120):
        if not pending:
            break
        nxt: list[str] = []
        progress = False
        for mod in pending:
            try:
                load_module(mod, temp_main=False)
                progress = True
            except (ModuleNotFoundError, ImportError):
                nxt.append(mod)
        pending = nxt
        if pending and not progress:
            raise SystemExit(f"stuck loading: {pending[:8]}")
    load_module("sesslint.adapters.codex_rollout", temp_main=True)
    return sys.modules["sesslint.adapters.codex_rollout"]


def encode_payload(value: Any) -> dict[str, Any]:
    if value is None:
        return {"kind": "null"}
    if isinstance(value, bool):
        return {"kind": "bool", "value": value}
    if isinstance(value, int):
        return {"kind": "int", "value": value}
    if isinstance(value, float):
        return {"kind": "float", "value": value}
    if isinstance(value, str):
        return {"kind": "str", "text": value}
    if isinstance(value, list):
        return {"kind": "list", "items": [encode_payload(v) for v in value]}
    if isinstance(value, dict):
        return {
            "kind": "map",
            "entries": [
                {"key": encode_payload(k), "value": encode_payload(v)}
                for k, v in value.items()
            ],
        }
    raise SystemExit(f"cannot encode payload {type(value)!r}")


def pin_load_summary_bytes(mod: Any, data: bytes) -> dict[str, Any]:
    try:
        events, findings = mod.load_codex_rollout(data)
    except Exception as exc:  # noqa: BLE001
        return {"error_type": type(exc).__name__, "message": str(exc)}
    return {
        "event_count": len(events),
        "finding_count": len(findings),
        "finding_codes": sorted(f.code for f in findings),
    }


def pin_load_summary_path(mod: Any, path: Path) -> dict[str, Any]:
    try:
        events, findings = mod.load_codex_rollout(path)
    except Exception as exc:  # noqa: BLE001
        return {
            "error_type": type(exc).__name__,
            "message": relativize_message(str(exc)),
        }
    return {
        "event_count": len(events),
        "finding_count": len(findings),
        "finding_codes": sorted(f.code for f in findings),
    }


def pin_session_summary_bytes(mod: Any, data: bytes) -> dict[str, Any]:
    try:
        session, findings = mod.load_codex_rollout_session(data)
    except Exception as exc:  # noqa: BLE001
        return {"error_type": type(exc).__name__, "message": str(exc)}
    return {
        "event_count": len(session.events),
        "finding_count": len(findings),
        "finding_codes": sorted(f.code for f in findings),
        "session_id": session.header.session_id,
    }


def relativize_message(message: str) -> str:
    out_dir = Path(__file__).resolve().parent
    prefix = str(out_dir)
    needles: list[str] = []
    for item in (prefix, prefix.replace("\\", "\\\\")):
        for sep in ("\\", "/", "\\\\"):
            needles.append(item + sep)
        needles.append(item)
    needles.sort(key=len, reverse=True)
    text = message
    for needle in needles:
        if needle:
            text = text.replace(needle, "")
    return text.replace("\\\\", "/").replace("\\", "/")


def _env(ordinal: int, type_: str, payload: dict, ts: str | None = None) -> dict:
    return {
        "ordinal": ordinal,
        "payload": payload,
        "timestamp": ts or f"2026-09-17T10:{ordinal:02d}:00Z",
        "type": type_,
    }


def _item(ordinal: int, itype: str, iid: str | None, **kw: object) -> dict:
    payload: dict[str, object] = {"type": itype}
    if iid is not None:
        payload["id"] = iid
    payload.update(kw)
    return _env(ordinal, "response_item", payload)


def _jsonl_bytes(*records: dict) -> bytes:
    return (
        "\n".join(json.dumps(r, sort_keys=True) for r in records) + "\n"
    ).encode()


def response_item_map_rows(mod: Any) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    for key, actor_kind in mod.RESPONSE_ITEM_TYPE_MAP.items():
        actor, kind = actor_kind
        rows.append({"key": key, "actor": actor, "kind": kind})
    return rows


def detect_suite(mod: Any) -> list[tuple[str, bytes, str, float]]:
    marked = b'"session_meta"'
    rollout = _jsonl_bytes(
        _env(0, "session_meta", {"cli_version": "0.42.0"}),
        _item(1, "message", "m1", role="user"),
    )
    weak = b'{"ordinal": 0, "payload": {"a": 1}}\n'
    sqlite = mod.SQLITE_MAGIC + b"\x00" * 32
    prefixed = mod.SQLITE_MAGIC + marked
    rows: list[tuple[str, bytes, str, float]] = [
        ("detect_rollout_filename", rollout, "rollout-2026-09-17T10-00-00-abc.jsonl", 1.0),
        ("detect_session_jsonl", rollout, "session.jsonl", 1.0),
        ("detect_session_txt", rollout, "session.txt", 0.0),
        ("detect_rollout_sqlite_name", rollout, "rollout-abc.sqlite", 0.0),
        ("detect_empty_rollout_jsonl", b"", "rollout-x.jsonl", 0.0),
        ("detect_sqlite_prefix_rollout_jsonl", sqlite, "rollout-x.jsonl", 0.0),
        ("detect_weak_ordinal_payload", weak, "x.jsonl", mod.detect_codex_rollout(weak, "x.jsonl")),
        ("detect_session_meta_jsonl", marked, "rollout-a.jsonl", 1.0),
        ("detect_session_meta_upper_jsonl", marked, "a.JSONL", 0.8),
        ("detect_turn_context_jsonl", b'"turn_context"', "a.jsonl", 0.3),
        ("detect_event_msg_rollout_jsonl", b'"event_msg"', "rollout-a.jsonl", 0.8),
        ("detect_ordinal_only_jsonl", b'"ordinal"', "a.jsonl", 0.0),
        ("detect_sqlite_text_rollout", b"SQLite format 3", "rollout-x.jsonl", 0.3),
        ("detect_notes_bak_jsonl", marked, "notes.jsonl.bak", 0.0),
    ]
    for vid, data, name, score in rows:
        got = mod.detect_codex_rollout(data, name)
        if score != got and vid not in ("detect_weak_ordinal_payload",):
            raise SystemExit(f"{vid}: expected {score}, pin gave {got}")
    return rows


