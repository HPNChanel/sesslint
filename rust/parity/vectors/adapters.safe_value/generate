    for vid, val in non_strings:
        add_disc(vid, val)

    add_disc("allowlist_empty", "")
    add_disc("allowlist_one_char", "a")
    add_disc("allowlist_len_64", "a" * 64)
    add_disc("allowlist_len_65", "a" * 65)
    add_disc("allowlist_hyphen_len_64", "-" * 64)
    add_disc("allowlist_hyphen_len_65", "-" * 65)

    for sample in (
        "message",
