#!/usr/bin/env python3
"""Generate sesslint.adapters.safe_value parity vectors (stdlib only; pinned git blobs)."""

from __future__ import annotations

import hashlib
import json
import re
import subprocess
import sys
import types
from pathlib import Path
from typing import Any, Final

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
SAFE_VALUE_PY_SHA256 = (
    "dd864071a538898e7eed4bf318edbf4a2169373e56557d44ccd7bdcf98d518ee"
)
SAFE_VALUE_RS_SHA256 = (
    "178188f5f9ff93a9fb1a69a16608e78ec9e4875e3c3c661a8ad4071a53a720b3"
)
MODULE = "sesslint.adapters.safe_value"

PIN_MODULES: Final[tuple[tuple[str, str], ...]] = (
    ("sesslint.errors", "src/sesslint/errors.py"),
    ("sesslint._version", "src/sesslint/_version.py"),
    ("sesslint.context", "src/sesslint/context.py"),
    ("sesslint.codes", "src/sesslint/codes.py"),
    ("sesslint.secret_families", "src/sesslint/secret_families.py"),
    ("sesslint.finding", "src/sesslint/finding.py"),
    ("sesslint.adapters.safe_value", "src/sesslint/adapters/safe_value.py"),
)

KNOWN_PARITY_GAPS: Final[tuple[str, ...]] = (
    "str_subclass_type_name: a str subclass keeps its own __name__ in Python "
    "safe_type_value; Rust PyValue::Str always reports as str — no required vector.",
    "lone_surrogate_discriminator: a lone UTF-16 surrogate cannot be stored in Rust "
    "str — no required vector.",
)

_BANNED_LIVE_TEST = re.compile(
    rb"(?:^|[^A-Za-z])(sk|rk)_(?:live|test)_[A-Za-z0-9]{16}"
)
_BANNED_SUPABASE_PAT = re.compile(rb"sbp_[0-9a-f]{40}")


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_blob(rev_path: str) -> str:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
        text=True,
    )


def verify_safe_value_py_pin() -> None:
    blob = git_show_blob(
        f"{PYTHON_COMMIT}:src/sesslint/adapters/safe_value.py"
    )
    digest = hashlib.sha256(blob.encode("utf-8")).hexdigest()
    if digest != SAFE_VALUE_PY_SHA256:
        raise SystemExit(
            f"safe_value.py pin sha256 mismatch: expected {SAFE_VALUE_PY_SHA256}, got {digest}"
        )


def verify_safe_value_rs_sha256() -> None:
    rs_path = repo_root() / "rust" / "crates" / "adapters" / "src" / "safe_value.rs"
    digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if digest != SAFE_VALUE_RS_SHA256:
        raise SystemExit(
            "adapters/src/safe_value.rs sha256 mismatch: "
            f"expected {SAFE_VALUE_RS_SHA256}, got {digest}"
        )


def load_pinned_safe_value() -> Any:
    verify_safe_value_py_pin()
    verify_safe_value_rs_sha256()
    for pkg in ("sesslint", "sesslint.adapters"):
        mod = types.ModuleType(pkg)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[pkg] = mod
    for mod_name, rel_path in PIN_MODULES:
        source = git_show_blob(f"{PYTHON_COMMIT}:{rel_path}")
        compiled = compile(source, f"<pinned {rel_path}>", "exec")
        mod = types.ModuleType(mod_name)
        mod.__file__ = f"<pinned {rel_path}>"
        sys.modules[mod_name] = mod
        exec(compiled, mod.__dict__)  # noqa: S102
        parent_name, _, child = mod_name.rpartition(".")
        if parent_name:
            parent = sys.modules[parent_name]
            setattr(parent, child, mod)
    return sys.modules["sesslint.adapters.safe_value"]


def filled(prefix: str, fill: str, count: int) -> str:
    return prefix + fill * count


def materialize_val(spec: dict[str, Any]) -> Any:
    kind = spec["kind"]
    if kind == "str":
        if "fill" in spec:
            fill = str(spec["fill"])
            count = int(spec["count"])
            return str(spec["prefix"]) + fill * count
        return spec["text"]
    if kind == "bytes_hex":
        hx = str(spec["hex"])
        return bytes.fromhex(hx) if hx else b""
    if kind == "list":
        return [materialize_val(item) for item in spec["items"]]
    if kind == "dict":
        return {
            str(k): materialize_val(v)
            for k, v in spec["entries"].items()
        }
    if kind == "set":
        return {materialize_val(item) for item in spec["items"]}
    if kind == "tuple":
        return tuple(materialize_val(item) for item in spec["items"])
    if kind == "none":
        return None
    if kind == "int":
        return int(spec["value"])
    if kind == "float":
        return float(spec["value"])
    if kind == "bool":
        return bool(spec["value"])
    if kind == "frozenset":
        return frozenset(materialize_val(item) for item in spec["items"])
    raise SystemExit(f"unknown val kind {kind!r}")


def encode_val(value: Any) -> dict[str, Any]:
    if isinstance(value, str):
        split = encode_supabase_pat_parts(value)
        if split is not None:
            return split
        return {"kind": "str", "text": value}
    if isinstance(value, bytes):
        return {"kind": "bytes_hex", "hex": value.hex()}
    if isinstance(value, list):
        return {"kind": "list", "items": [encode_val(v) for v in value]}
    if isinstance(value, dict):
        return {
            "kind": "dict",
            "entries": {k: encode_val(v) for k, v in value.items()},
        }
    if isinstance(value, tuple):
        return {"kind": "tuple", "items": [encode_val(v) for v in value]}
    if isinstance(value, set):
        return {"kind": "set", "items": [encode_val(v) for v in value]}
    if value is None:
        return {"kind": "none"}
    if isinstance(value, bool):
        return {"kind": "bool", "value": value}
    if isinstance(value, int):
        return {"kind": "int", "value": value}
    if isinstance(value, float):
        return {"kind": "float", "value": value}
    if isinstance(value, frozenset):
        return {"kind": "frozenset", "items": [encode_val(v) for v in value]}
    raise SystemExit(f"cannot encode value type {type(value)!r}")


def encode_supabase_pat_parts(value: str) -> dict[str, Any] | None:
    """Keep a 40-hex supabase sample from sitting in one committed string."""
    body = value[4:]
    if (
        value.startswith("sbp_")
        and len(body) == 40
        and body == body[0] * 40
        and all(ch in "0123456789abcdef" for ch in body)
    ):
        return {"kind": "str", "prefix": "sbp_", "fill": body[0], "count": 40}
    return None


def scan_committed_text(text: str) -> None:
    raw = text.encode("utf-8")
    if _BANNED_LIVE_TEST.search(raw):
        raise SystemExit("committed output matches banned live/test secret shape")
    if _BANNED_SUPABASE_PAT.search(raw):
        raise SystemExit("committed output contains a contiguous supabase token shape")


def run_safe_type_value(mod: Any, val: Any) -> dict[str, Any]:
    out = mod.safe_type_value(val)
    return {"value": out}


def run_safe_discriminator(mod: Any, val: Any) -> dict[str, Any]:
    type_value, is_truncated = mod.safe_discriminator(val)
    return {"type_value": type_value, "is_truncated": is_truncated}


def vector_specs(mod: Any) -> list[dict[str, Any]]:
    specs: list[dict[str, Any]] = []

    def add_type(vector_id: str, val: Any) -> None:
        enc = encode_val(val)
        specs.append(
            {
                "id": vector_id,
                "construct": {"type": "safe_type_value", "val": enc},
                "expected": run_safe_type_value(mod, val),
            }
        )

    def add_disc(vector_id: str, val: Any) -> None:
        enc = encode_val(val)
        specs.append(
            {
                "id": vector_id,
                "construct": {"type": "safe_discriminator", "val": enc},
                "expected": run_safe_discriminator(mod, val),
            }
        )

    add_type(
        "module_all_order",
        {"kind": "other", "type_name": "__all__probe"} if False else "__probe__",  # placeholder
    )
    # replace botched entry below
    specs.pop()

    specs.append(
        {
            "id": "module_python_all",
            "construct": {"type": "module_exports"},
            "expected": {"python_all": list(mod.__all__)},
        }
    )

    add_type("safe_type_str", "hello")
    add_type("safe_type_bytes", b"bytes")
    add_type("safe_type_list", [1, 2, 3])
    add_type("safe_type_dict", {"a": 1})
