    add_disc("prefix_slack_token_hyphen_trunc", "slack_token-")
    add_disc("prefix_slack_token_dhyphen_trunc", "slack-token-")
    add_disc("prefix_slack_token_upper_trunc", "SLACK-TOKEN-")
    add_disc("prefix_slack_token_echo", "slack-token")
    add_disc("prefix_slack_token_dot_echo", "slack.token-")

    for prefix, fill, enough, short, tag in (
