    add_disc("shared_family_hf_19_echo", filled("hf_", "a", 19))
    add_disc("shared_family_npm_us_20_echo", filled("npm_", "_", 20))
    add_disc("shared_family_hf_us_20_echo", filled("hf_", "_", 20))

    add_disc("content_free_ghp_hit", filled("ghp-", "a", 16))
    add_disc("content_free_gho_hit", filled("gho-", "a", 16))
    add_disc("content_free_ghp_miss_echo", filled("ghp-", "a", 15))
