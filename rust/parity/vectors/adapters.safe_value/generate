    add_disc("sensitive_ghp_double_us_echo", "foo.ghp__")
    add_disc("sensitive_ghq_echo", "foo.ghq_a")
    add_disc("sensitive_glpat_delim", "foo.glpat-9")
    add_disc("sensitive_glpat_upper", "foo.glpat-Z")
    add_disc("sensitive_glpat_prefix_echo", "foo.glpat-")
    add_disc("sensitive_glpat_us_echo", "foo.glpat-_")
    add_disc("sensitive_akia_delim", filled("x-akia", "a", 16))
    add_disc("sensitive_asia_delim", filled("foo.asia", "0", 16))
    add_disc(
        "sensitive_akia_us_prefix",
        filled("foo_", "A", 0) + filled("AKIA", "A", 16),
    )
    add_disc("sensitive_akia_short_echo", filled("foo.akia", "a", 15) + "_")
    add_disc("sensitive_aiza_us", filled("foo.aiza", "_", 20))
    add_disc("sensitive_aiza_hyphen", filled("foo.aiza", "-", 20))
    add_disc("sensitive_aiza_upper", filled("foo.AIZA", "A", 20))
    add_disc("sensitive_aiza_us_19_echo", filled("foo.aiza", "_", 19))
    add_disc("sensitive_aiza_dot_echo", filled("foo.aiza.", "a", 20))
    add_disc("sensitive_bearer_prefix_echo", "xbearer-")
    add_disc("sensitive_bearer_delim", "foo.bearer-")
    add_disc("sensitive_sk_us_delim", filled("foo_sk-", "a", 20))
    add_disc("sensitive_sk_dash_delim", filled("foo-sk-", "a", 15))
    add_disc("sensitive_sk_xx_echo", filled("xxsk-", "a", 20))

    add_disc("cloud_azure_client_secret_8", filled("azure-client-secret-", "a", 8))
    add_disc("cloud_azure_client_secret_16", filled("azure-client-secret-", "a", 16))
    add_disc("cloud_azure_client_secret_7_echo", filled("azure-client-secret-", "a", 7))
    add_disc("cloud_azure_clientsecret_8", filled("azure-clientsecret-", "a", 8))
    add_disc("cloud_azure_client_secret_us", filled("azure_client_secret_", "a", 8))
    add_disc("cloud_azure_client_us_mixed", filled("azure-client_secret-", "a", 8))
    add_disc("cloud_azure_upper", filled("AZURE-CLIENT-SECRET-", "A", 8))
    add_disc("cloud_gcp_service_account_8", filled("gcp-service-account-", "a", 8))
    add_disc("cloud_gcp_service_account_16", filled("gcp-service-account-", "a", 16))
    add_disc("cloud_gcp_serviceaccount_8", filled("gcp-serviceaccount-", "a", 8))
