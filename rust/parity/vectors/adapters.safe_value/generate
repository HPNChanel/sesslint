    add_disc("sensitive_xoxc_us_echo", "xoxc-_")
    add_disc("sensitive_xox_digit_echo", "xox1-a")
    add_disc("sensitive_ghp_delim", "foo.GHP_a")
    add_disc("sensitive_ghp_mixed", "foo.ghP_Z")
