        "custom<xml>tag",
        "custom;sql-inject",
        "type@domain.com",
        "type#anchor",
        "type$var",
        "type%percent",
        "type!exclamation",
        "type=assignment",
        "type\nnewline",
        "type\ttab",
    ):
        slug = re.sub(r"[^a-z0-9]+", "_", invalid[:20].lower()).strip("_")
        add_disc(f"allowlist_reject_{slug}", invalid)

    cafe = "caf\u00e9"
    add_disc("allowlist_reject_cafe", cafe)
    add_disc("allowlist_reject_emoji_suffix", "ab\U0001f389")
    add_disc("allowlist_reject_accents_64", "\u00e9" * 64)
    add_disc("allowlist_reject_sk_accent", "sk-\u00e9")

    for byte in range(128):
        ch = chr(byte)
