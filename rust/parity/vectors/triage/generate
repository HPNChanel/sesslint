def list_tests_in_file(rel: str) -> list[tuple[str, bool]]:
    source = subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:{rel}"], cwd=repo_root(), text=True
    )
    has_column0 = any(line.startswith("def test_") for line in source.splitlines())
    out: list[tuple[str, bool]] = []
    for line in source.splitlines():
        if has_column0 and line.startswith("def test_"):
            name = line.split("(")[0].replace("def ", "")
            out.append((name, True))
        elif not has_column0 and line.startswith("    def test_"):
            name = line.split("(")[0].replace("def ", "").strip()
            out.append((name, False))
    return out


def write_coverage(out_dir: Path, vector_ids: frozenset[str]) -> tuple[int, int]:
    rows: list[dict[str, object]] = []
    covered = 0
    not_applicable = 0
    for rel in COVERAGE_TEST_FILES:
        tests = list_tests_in_file(rel)
        for name, column0 in tests:
            qual = f"{rel}::{name}"
            needed = COVERED_BY_VECTORS.get(qual)
            row: dict[str, object] = {"test": qual}
            if needed is not None and all(item in vector_ids for item in needed):
                status = "covered"
                covered += 1
                row["vector_ids"] = list(needed)
            else:
                status = "not_applicable"
                not_applicable += 1
            row["status"] = status
            rows.append(row)
    payload = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": covered,
        "not_applicable_count": not_applicable,
        "rows": rows,
    }
    text = json.dumps(payload, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(text)
    (out_dir / "coverage.json").write_text(text, encoding="utf-8", newline="\n")
    return covered, not_applicable


def main() -> int:
    mod = load_triage_module()
    out_dir = Path(__file__).resolve().parent
    fixtures = out_dir / "fixtures"
    paths = ensure_fixtures(fixtures)
    vectors = vector_specs(mod, fixtures, paths)
    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "triage_py_sha256": TRIAGE_PY_SHA256,
        "triage_rs_sha256": TRIAGE_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(payload)
    out_dir.joinpath("vectors.json").write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "triage_py_sha256": TRIAGE_PY_SHA256,
        "triage_rs_sha256": TRIAGE_RS_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/triage/generate",
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    scan_committed_text(json.dumps(manifest) + "\n")
    out_dir.joinpath("manifest.json").write_text(
        json.dumps(manifest, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    provenance = {
        "contains_real_data": False,
        "description": "Synthetic triage helpers and envelope parity from pinned sesslint.triage.",
        "generator": "rust/parity/vectors/triage/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    prov_text = json.dumps(provenance, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(prov_text)
    out_dir.joinpath("PROVENANCE.json").write_text(
        prov_text, encoding="utf-8", newline="\n"
    )
    covered, not_applicable = write_coverage(out_dir, frozenset(v["id"] for v in vectors))
    print(f"vector_count={len(vectors)}")
    print(f"vectors_sha256={digest}")
    print(f"covered={covered} not_applicable={not_applicable}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
