def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(path: str) -> bytes:
    return subprocess.check_output(["git", "show", f"{PYTHON_COMMIT}:{path}"], cwd=repo_root())


def verify_pin_hashes() -> None:
    blob = git_show_bytes("src/sesslint/triage.py")
    digest = hashlib.sha256(blob).hexdigest()
    if digest != TRIAGE_PY_SHA256:
        raise SystemExit(f"triage.py pin sha256 mismatch: expected {TRIAGE_PY_SHA256}, got {digest}")
    rs_path = repo_root() / "rust" / "crates" / "report" / "src" / "triage.rs"
    rs_digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if rs_digest != TRIAGE_RS_SHA256:
        raise SystemExit(f"triage.rs sha256 mismatch: expected {TRIAGE_RS_SHA256}, got {rs_digest}")


def load_state_db() -> Any:
    report = types.ModuleType("sesslint.report")
    report.short_hash = lambda identifier, length=8: hashlib.sha256(
        identifier.encode("utf-8")
    ).hexdigest()[:length]
    sys.modules.setdefault("sesslint.report", report)
    pkg = sys.modules.setdefault("sesslint", types.ModuleType("sesslint"))
    pkg.__path__ = []  # type: ignore[attr-defined]
    pkg.report = report
    state_mod = types.ModuleType("sesslint.state_db")
    sys.modules["sesslint.state_db"] = state_mod
    exec(
        compile(
            git_show_bytes("src/sesslint/state_db.py").decode(),
            f"<{PYTHON_COMMIT}:state_db.py>",
            "exec",
        ),
        state_mod.__dict__,
    )
    pkg.state_db = state_mod
    return state_mod


def load_triage_module() -> Any:
    verify_pin_hashes()
    pkg = types.ModuleType("sesslint")
    pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint"] = pkg
    load_state_db()

    ver = types.ModuleType("sesslint._version")
    ver.CLI_VERSION = "0.5.0"
    sys.modules["sesslint._version"] = ver
    pkg._version = ver

    ass = types.ModuleType("sesslint.assessment")
    ass.SourceAssessment = object
    ass.assess_source = lambda *args, **kwargs: None
    sys.modules["sesslint.assessment"] = ass
    pkg.assessment = ass

    codes = types.ModuleType("sesslint.codes")

    class Severity:
        ERROR = "error"
        FATAL = "fatal"
        WARNING = "warning"

    codes.Severity = Severity
    codes.CODE_REGISTRY = {}
    sys.modules["sesslint.codes"] = codes
    pkg.codes = codes

    io_mod = types.ModuleType("sesslint.io")
    io_mod.DEFAULT_MAX_FILE_BYTES = 100 * 1024 * 1024
    sys.modules["sesslint.io"] = io_mod
    pkg.io = io_mod

    prev = types.ModuleType("sesslint.preview")
    prev._deltas_for_plan = lambda *a, **k: []
    sys.modules["sesslint.preview"] = prev
    pkg.preview = prev

    repair = types.ModuleType("sesslint.repair")
    repair.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint.repair"] = repair
    pkg.repair = repair
    plan = types.ModuleType("sesslint.repair.planner")
    plan.plan = lambda *a, **k: None
    sys.modules["sesslint.repair.planner"] = plan
    ref = types.ModuleType("sesslint.repair.refusals")
    ref.refusal_rationale_for = lambda *a, **k: None
    sys.modules["sesslint.repair.refusals"] = ref
    prof = types.ModuleType("sesslint.profiles")
    prof.get_profile = lambda *a, **k: {}
    sys.modules["sesslint.profiles"] = prof
    pkg.profiles = prof

    tri = types.ModuleType("sesslint.triage")
    sys.modules["sesslint.triage"] = tri
    pkg.triage = tri
    blob = git_show_bytes("src/sesslint/triage.py")
    with tempfile.NamedTemporaryFile("wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp_path = handle.name
    spec = importlib.util.spec_from_file_location("sesslint.triage", tmp_path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules["sesslint.triage"] = mod
    spec.loader.exec_module(mod)
    Path(tmp_path).unlink(missing_ok=True)
    return mod


def write_fixture(path: Path, payload: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(payload)
    os.utime(path, (FIXED_MTIME, FIXED_MTIME))


def ensure_fixtures(fixtures: Path) -> dict[str, Path]:
    out: dict[str, Path] = {}
    for name, payload in {
        "empty.bin": b"",
        "abc.bin": b"abc",
        "wide.bin": bytes([1] + [0] * 65535 + [2]),
    }.items():
        target = fixtures / name
        write_fixture(target, payload)
        out[name] = target
    return out


def rel_fixture(fixtures: Path, path: Path) -> str:
    return path.relative_to(fixtures).as_posix()


def scan_committed_text(text: str) -> None:
    raw = text.encode("utf-8")
    if _BANNED_SUPABASE_PAT.search(raw):
        raise SystemExit("committed output contains sbp_ token shape")
    if b"\r" in raw:
        raise SystemExit("committed output must use LF only")


@dataclass
class MockFinding:
    severity: str
    code: str
    record_id: str | None = None
    line: int | None = None
    has_source: bool = True


def mock_assessment(
    tri: Any, events: list[dict[str, Any]], findings: list[MockFinding]
) -> Any:
    evs = [
        SimpleNamespace(
            id=row["id"],
            parent_id=row.get("parent_id"),
            source_line=row.get("source_line"),
        )
        for row in events
    ]
    rows = []
    for item in findings:
        source = None
        if item.has_source:
            source = SimpleNamespace(record_id=item.record_id, line=item.line)
        rows.append(SimpleNamespace(severity=item.severity, code=item.code, source=source))
    report = SimpleNamespace(findings=rows)
    return SimpleNamespace(events=evs, report=report)


