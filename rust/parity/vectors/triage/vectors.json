{
  "schema": "sesslint.parity-module-vectors/v1",
  "module": "sesslint.triage",
  "python_commit": "e91d50b2ecea57ef4dd900e3b0b87b14946e847e",
  "triage_py_sha256": "a1b695b89ac9fc3142f098d51c9ffba01d2f1a20e9cebe202f6a41e26669029d",
