def stable_error_fragment(message: str) -> str:
    if message.startswith("Baseline file not found:"):
        return "Baseline file not found:"
    markers = (
        "fingerprints[",
        "must declare schema_version",
        "must contain a 'fingerprints' list",
        "--upgrade requires a ",
    )
    for marker in markers:
        if marker in message:
            fragment = message[message.index(marker) :]
            if marker == "--upgrade requires a " and " got " in fragment:
                return fragment[: fragment.index(" got ") + len(" got")]
            return fragment
    return message


def strip_internal(construct: dict[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in construct.items() if not key.startswith("_")}


def assert_payload_safe(payload: bytes) -> None:
    if _BANNED_SUPABASE_PAT.search(payload):
        raise SystemExit("vectors.json contains forbidden sbp_ token pattern")


def main() -> int:
    baseline = load_baseline_tree()
    out_dir = Path(__file__).resolve().parent
    fixture_dir = out_dir / "fixtures" / "synthetic"
    if fixture_dir.exists():
        import shutil

        shutil.rmtree(fixture_dir)
    fixture_dir.mkdir(parents=True, exist_ok=True)

    vectors: list[dict[str, Any]] = []
    for row in vector_specs(fixture_dir):
        construct = dict(row["construct"])
        expected = build_expected(baseline, construct)
        vectors.append(
            {
                "id": row["id"],
                "construct": strip_internal(construct),
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "baseline_py_sha256": BASELINE_PY_SHA256,
        "baseline_rs_sha256": BASELINE_RS_SHA256,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    payload_bytes = payload.encode("utf-8")
    assert_payload_safe(payload_bytes)
    if b"\r" in payload_bytes:
        raise SystemExit("vectors.json payload must use LF only")
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload_bytes).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic path spellings and finding fingerprints for sesslint.baseline "
            "parity (file_role, v2 keys, dump/filter/load/upgrade)."
        ),
        "generator": "rust/parity/vectors/baseline/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
