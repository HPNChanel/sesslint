#!/usr/bin/env python3
"""Generate sesslint.baseline parity vectors from pinned blobs (stdlib only)."""

from __future__ import annotations

import hashlib
import importlib.util
import json
import re
import subprocess
import sys
import tempfile
import types
from pathlib import Path
from typing import Any

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
BASELINE_PY_SHA256 = (
    "7d641bb31d495783f7f14b0d99e8a29ef3c80f85924ed616013ba883892d0851"
)
BASELINE_RS_SHA256 = (
    "d76cf27b430c2cbb9385c29c32412bb781958ea1570b63ea6771bea05f1d3f5c"
)
MODULE = "sesslint.baseline"

KNOWN_PARITY_GAPS = [
    (
        "GAP-baseline-file-role-cwd: file_role absolutizes bare relative spellings "
        "against the process working directory; vectors use rooted or virtual paths only."
    ),
    (
        "GAP-baseline-write-baseline: write_baseline delegates to sesslint.atomic "
        "atomic_write_text; parity does not pin host directory layout or temp rename races."
    ),
    (
        "GAP-baseline-parse-json-messages: Rust load_baseline uses the hand-written "
        "JSON reader in baseline.rs; malformed-document cases that differ from "
        "json.loads error text are covered in unit tests, not vectors."
    ),
]

_BANNED_SUPABASE_PAT = re.compile(rb"sbp_[0-9a-f]{40}")

PINNED_MODULES = (
    ("sesslint.errors", "errors.py"),
    ("sesslint.codes", "codes.py"),
    ("sesslint._canonical_codec", "_canonical_codec.py"),
    ("sesslint.finding", "finding.py"),
    ("sesslint.determinism", "determinism.py"),
    ("sesslint.atomic", "atomic.py"),
    ("sesslint.baseline", "baseline.py"),
)


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
    )


def verify_digest(blob: bytes, expected: str, label: str) -> None:
    digest = hashlib.sha256(blob).hexdigest()
    if digest != expected:
        raise SystemExit(f"{label} pin sha256 mismatch: expected {expected}, got {digest}")


def verify_baseline_rs_sha256() -> None:
    rs_path = repo_root() / "rust" / "crates" / "report" / "src" / "baseline.rs"
    digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if digest != BASELINE_RS_SHA256:
        raise SystemExit(
            "report/src/baseline.rs sha256 mismatch: "
            f"expected {BASELINE_RS_SHA256}, got {digest}"
        )


def exec_module_from_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile.NamedTemporaryFile(mode="wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp_path = handle.name
    try:
        spec = importlib.util.spec_from_file_location(fullname, tmp_path)
        if spec is None or spec.loader is None:
            raise SystemExit(f"failed to create import spec for {fullname}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[fullname] = mod
        spec.loader.exec_module(mod)
        return mod
    finally:
        Path(tmp_path).unlink(missing_ok=True)


def install_package_stubs() -> types.ModuleType:
    pkg = types.ModuleType("sesslint")
    pkg.__path__ = []  # type: ignore[attr-defined]
    sys.modules["sesslint"] = pkg

    context = types.ModuleType("sesslint.context")

    class CheckContext:
        pass

    context.CheckContext = CheckContext
    sys.modules["sesslint.context"] = context
    pkg.context = context

    canonical = types.ModuleType("sesslint.canonical")

    class SessionEvent:
        pass

    canonical.SessionEvent = SessionEvent
    sys.modules["sesslint.canonical"] = canonical
    pkg.canonical = canonical

    accel = types.ModuleType("sesslint._accel")
    accel.ACCEL_ENABLED = False
    sys.modules["sesslint._accel"] = accel
    pkg._accel = accel

    return pkg


def load_baseline_tree() -> types.ModuleType:
    install_package_stubs()
    pkg = sys.modules["sesslint"]
    baseline_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/baseline.py")
    verify_digest(baseline_blob, BASELINE_PY_SHA256, "baseline.py")
    verify_baseline_rs_sha256()
    for fullname, rel in PINNED_MODULES:
        if fullname == "sesslint.baseline":
            mod = exec_module_from_blob(baseline_blob, fullname)
        else:
            blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/{rel}")
            mod = exec_module_from_blob(blob, fullname)
        short = fullname.split(".", 1)[1]
        setattr(pkg, short, mod)
    return sys.modules["sesslint.baseline"]


def build_finding(baseline_mod: types.ModuleType, spec: dict[str, Any]) -> Any:
    from sesslint.codes import Repairability, Severity  # noqa: WPS433
    from sesslint.finding import Finding, SourceRef  # noqa: WPS433

    source = spec["source"]
    line = source.get("line")
    kwargs: dict[str, Any] = {
        "code": spec.get("code", "SL001"),
        "severity": Severity(spec.get("severity", "error")),
        "repairability": Repairability(spec.get("repairability", "manual")),
        "message": spec.get("message", "synthetic marker"),
        "source": SourceRef(
            source["path"],
            line,
            source.get("record_id"),
        ),
        "related_ids": tuple(spec.get("related_ids", ())),
        "fingerprint": spec["fingerprint"],
    }
    if "evidence_pairs" in spec:
        evidence: dict[str, Any] = {}
        for key, value in spec["evidence_pairs"]:
            evidence[key] = value
        kwargs["evidence"] = evidence
    elif "evidence" in spec:
        kwargs["evidence"] = spec["evidence"]
    return Finding(**kwargs)


def build_expected(baseline: types.ModuleType, spec: dict[str, Any]) -> dict[str, Any]:
    kind = spec["type"]
    if kind == "file_role":
        return {"file_role": baseline.file_role(spec["path"])}
    if kind == "compute_v2_key":
        finding = build_finding(baseline, spec["finding"])
        return {"key": baseline.compute_v2_key(finding)}
    if kind == "dump_baseline":
        findings = [build_finding(baseline, row) for row in spec["findings"]]
        created_by = spec.get("created_by", "sesslint")
        return {"document": baseline.dump_baseline(findings, created_by=created_by)}
    if kind == "filter_findings":
        findings = [build_finding(baseline, row) for row in spec["findings"]]
        baseline_set = frozenset(spec["baseline_keys"])
        kept = baseline.filter_findings(findings, baseline_set)
        return {"fingerprints": [f.fingerprint for f in kept]}
    if kind == "load_baseline":
        out_dir = Path(spec["_fixture_dir"])
        rel = spec["basename"]
        path = out_dir / rel
        if spec.get("write_file", True):
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(spec["baseline_text"], encoding="utf-8", newline="\n")
        try:
            keys = baseline.load_baseline(path)
        except baseline.BaselineError as err:
            return {
                "raises": "BaselineError",
                "message_contains": stable_error_fragment(str(err)),
            }
        return {"keys": sorted(keys)}
    if kind == "upgrade_baseline":
        out_dir = Path(spec["_fixture_dir"])
        rel = spec["basename"]
        path = out_dir / rel
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(spec["baseline_text"], encoding="utf-8", newline="\n")
        rows = spec.get("findings")
        findings = None
        if rows is not None:
            findings = [build_finding(baseline, row) for row in rows]
        try:
            doc, verified, unverified = baseline.upgrade_baseline(
                path,
                findings,
                created_by=spec.get("created_by", "sesslint"),
            )
        except baseline.BaselineError as err:
            return {
                "raises": "BaselineError",
                "message_contains": stable_error_fragment(str(err)),
            }
        return {
            "document": doc,
            "verified": verified,
            "unverified": unverified,
        }
    raise ValueError(f"unknown construct type: {kind}")


def _src(path: str, **extra: Any) -> dict[str, Any]:
    row = {"path": path}
    row.update(extra)
    return row


def plain_finding(path: str, fingerprint: str) -> dict[str, Any]:
    return {
        "fingerprint": fingerprint,
        "source": _src(path),
    }


