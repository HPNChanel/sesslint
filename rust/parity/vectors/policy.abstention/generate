SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"

# rust/crates/checks/src/abstention.rs — must match manifest (card invariant).
ABSTENTION_RS_SHA256 = (
    "46b681a6b615bd59d73730b402e73b76fc5b007d41766a3517500ee683c5f824"
)

ABSTENTION_PY_BLOB_SHA1 = "45b240fc059adaa0ee928ac02b4bb2785129c044"

KNOWN_PARITY_GAPS = [
    "a missing or empty content_hash, because Python hashes and Rust returns a typed unavailable error",
    "a bool used as an evidence index or a range endpoint",
    "Python str(float), str(list), and str(dict)",
    "reason order when more than one correlation id is present, because Python iterates a set",
    "the order of the in-region tool walk, because Python iterates a set",
    "an inclusive span wider than 1048576, and a range that ends at i64::MAX",
    "side-effect-None; extract_side_effects already returns the string unknown",
]


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def verify_abstention_py_blob() -> None:
    root = repo_root()
    abstention_py = root / "src" / "sesslint" / "policy" / "abstention.py"
    raw = abstention_py.read_bytes()
    header = b"blob " + str(len(raw)).encode() + b"\0"
    blob = hashlib.sha1(header + raw).hexdigest()
    if blob != ABSTENTION_PY_BLOB_SHA1:
        raise SystemExit(
            f"src/sesslint/policy/abstention.py git blob mismatch: expected {ABSTENTION_PY_BLOB_SHA1}, got {blob}"
        )


def verify_abstention_rs_sha256() -> None:
    root = repo_root()
    rs_path = root / "rust" / "crates" / "checks" / "src" / "abstention.rs"
    digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if digest != ABSTENTION_RS_SHA256:
        raise SystemExit(
            f"abstention.rs sha256 mismatch: expected {ABSTENTION_RS_SHA256}, got {digest}"
        )


def load_abstention_module() -> Any:
    verify_abstention_py_blob()
    verify_abstention_rs_sha256()
    root = repo_root()
    src = root / "src"
    if str(src) not in sys.path:
        sys.path.insert(0, str(src))
    from sesslint.policy import abstention  # noqa: WPS433

    return abstention


def encode_value(value: Any) -> dict[str, Any]:
    if value is None:
        return {"t": "null"}
    if isinstance(value, bool):
        return {"t": "bool", "v": value}
    if isinstance(value, int):
        return {"t": "int", "v": value}
    if isinstance(value, str):
        return {"t": "str", "v": value}
    if isinstance(value, dict):
        return {"t": "map", "entries": encode_mapping(value)}
    raise TypeError(f"unencodable {type(value)}")


def encode_mapping(d: dict[str, Any]) -> list[list[Any]]:
    return [[key, encode_value(val)] for key, val in d.items()]


def decode_field(obj: dict[str, Any]) -> Any:
    t = obj["t"]
    if t == "null":
        return None
    if t == "str":
        return str(obj["v"])
    if t == "bool":
        return bool(obj["v"])
    if t == "int":
        return int(obj["v"])
    if t == "map":
        return decode_mapping(obj["entries"])
    raise ValueError(f"unknown field tag {t}")


def decode_mapping(entries: list[list[Any]]) -> dict[str, Any]:
    out: dict[str, Any] = {}
    for pair in entries:
        key, field = pair[0], pair[1]
        out[str(key)] = decode_field(field)
    return out


def encode_abstention(a: Any) -> dict[str, Any]:
    d = a.to_dict()
    return {
        "abstain": bool(d["abstain"]),
        "reasons": list(d["reasons"]),
    }


def encode_ambiguous(am: Any) -> dict[str, Any]:
    return {
        "indices": sorted(am.indices),
        "ids": sorted(am.ids),
        "reasons": list(am.reasons),
    }


def encode_indices(s: frozenset) -> list[int]:
    return sorted(s)


def finding_sl203() -> Any:
    from sesslint.codes import Repairability, Severity  # noqa: WPS433
    from sesslint.finding import Finding, SourceRef  # noqa: WPS433

    source = SourceRef(path="a.jsonl", line=1, record_id="rec-sl203")
    return Finding(
        code="SL203",
        severity=Severity.ERROR,
        repairability=Repairability.MANUAL,
        message="synthetic marker",
        source=source,
        related_ids=(),
        fingerprint="0123456789abcdef",
        evidence=None,
    )


def finding_sl203_json() -> dict[str, Any]:
    """JSON-serializable finding spec (rebuilt in ``run_vector``)."""
    return {
        "code": "SL203",
        "severity": "ERROR",
        "repairability": "MANUAL",
        "message": "synthetic marker",
        "source": {"path": "a.jsonl", "line": 1, "record_id": "rec-sl203"},
        "related_ids": [],
        "fingerprint": "0123456789abcdef",
        "schema_version": "sesslint.finding/v1",
        "message_template": None,
        "evidence": None,
    }


def decode_finding(data: dict[str, Any]) -> Any:
    from sesslint.codes import Repairability, Severity  # noqa: WPS433
    from sesslint.finding import Finding, SourceRef  # noqa: WPS433

    sev = getattr(Severity, str(data["severity"]))
    rep = getattr(Repairability, str(data["repairability"]))
    src = data["source"]
    line = src.get("line")
    source = SourceRef(
        path=str(src["path"]),
        line=int(line) if line is not None else None,
        record_id=str(src["record_id"]) if src.get("record_id") is not None else None,
    )
    rel = tuple(str(x) for x in data.get("related_ids", []))
    return Finding(
        code=str(data["code"]),
        severity=sev,
        repairability=rep,
        message=str(data["message"]),
        source=source,
        related_ids=rel,
        fingerprint=str(data["fingerprint"]),
        schema_version=str(data.get("schema_version", "sesslint.finding/v1")),
        message_template=data.get("message_template"),
        evidence=data.get("evidence"),
    )


def wrap_event_plain(ev: dict[str, Any]) -> dict[str, Any]:
    """JSON-vector wrapper: plain nested dicts -> tagged entries."""
    return {"entries": encode_mapping(ev)}


def run_vector(mod: Any, construct: dict[str, Any]) -> dict[str, Any]:
    kind = construct["type"]
    if kind == "extract_side_effects":
        m = decode_mapping(construct["mapping"])
        raw_kind = construct.get("raw_kind")
        if raw_kind is None:
            se = mod._extract_side_effects(m)
        else:
            se = mod._extract_side_effects(m, str(raw_kind))
        return {"value": se}
    if kind == "affected_region_all_indices":
        indices = frozenset(int(x) for x in construct.get("indices", []))
        ids = frozenset(str(x) for x in construct.get("ids", []))
        ranges = tuple(tuple(int(x) for x in pair) for pair in construct["ranges"])
        total = construct.get("total_len")
        region = mod.AffectedRegion(indices=indices, ids=ids, ranges=ranges, unproven=False)
        out = region.all_indices(total)
        return {"indices": encode_indices(out)}
    if kind == "should_abstain_from_repair":
        findings_in = construct["findings"]
        findings = [decode_finding(f) for f in findings_in]
        events_in = construct["events"]
        events = [decode_mapping(e["entries"]) for e in events_in]
        policy = str(construct["policy"])
        acknowledge = bool(construct["acknowledge_side_effects"])
        step = construct.get("step")
        excludes = bool(construct["excludes_execution_dependence"])
        recipe_region_fn: Callable[..., Any] | None = None
        if construct.get("has_recipe_region_fn"):
            region_payload = construct["region"]

            def recipe_region_fn(_step: Any, _evs: Any) -> Any:  # noqa: ARG001
                idx = frozenset(int(x) for x in region_payload.get("indices", []))
                ids = frozenset(str(x) for x in region_payload.get("ids", []))
                ranges = tuple(
                    tuple(int(x) for x in pair) for pair in region_payload["ranges"]
                )
                return mod.AffectedRegion(
                    indices=idx,
                    ids=ids,
                    ranges=ranges,
                    unproven=bool(region_payload.get("unproven", False)),
                )

        a = mod.should_abstain_from_repair(
            findings,
            events,
            policy=policy,
            acknowledge_side_effects=acknowledge,
            step=step,
            recipe_region_fn=recipe_region_fn,
            excludes_execution_dependence=excludes,
        )
        return {"abstention": encode_abstention(a)}
    if kind == "must_abstain":
        findings = [decode_finding(f) for f in construct["findings"]]
        events_in = construct["events"]
        events = [decode_mapping(e["entries"]) for e in events_in]
        allow = bool(construct["allow_unknown_side_effects"])
        a = mod.must_abstain(findings, events, allow_unknown_side_effects=allow)
        return {"abstention": encode_abstention(a)}
    if kind == "find_ambiguous_events":
        findings_arg = None
        if construct.get("findings") is not None:
            findings_arg = [decode_finding(f) for f in construct["findings"]]
        events_in = construct["events"]
        events = [decode_mapping(e["entries"]) for e in events_in]
        am = mod.find_ambiguous_events(events, findings=findings_arg)
        return {"ambiguous": encode_ambiguous(am)}
    if kind == "check_step_scope":
        step = construct.get("step", 0)
        events_in = construct["events"]
        events = [decode_mapping(e["entries"]) for e in events_in]
        findings_arg = None
        if construct.get("findings") is not None:
            findings_arg = [decode_finding(f) for f in construct["findings"]]
        excludes = bool(construct["excludes_execution_dependence"])
        region_payload = construct["region"]

        def region_fn(_s: Any, _evs: Any) -> Any:  # noqa: ARG001
            idx = frozenset(int(x) for x in region_payload.get("indices", []))
            ids = frozenset(str(x) for x in region_payload.get("ids", []))
            ranges = tuple(tuple(int(x) for x in pair) for pair in region_payload["ranges"])
            return mod.AffectedRegion(
                indices=idx,
                ids=ids,
                ranges=ranges,
                unproven=bool(region_payload.get("unproven", False)),
            )

        if not construct.get("has_recipe_region_fn"):
            ok, reason = mod.check_step_scope(
                step,
                events,
                recipe_region_fn=None,
                findings=findings_arg,
                excludes_execution_dependence=excludes,
            )
        else:
            ok, reason = mod.check_step_scope(
                step,
                events,
                recipe_region_fn=region_fn,
                findings=findings_arg,
                excludes_execution_dependence=excludes,
            )
        return {"ok": ok, "reason": reason}
    raise ValueError(f"unknown construct type: {kind}")


def wrap_event(entries: dict[str, Any]) -> dict[str, Any]:
    return wrap_event_plain(entries)


def event_mapping_for_pairing(
    kind: str,
    name: str,
    corr: str,
    event_id: str,
    *,
    content_hash: str | None = None,
    side_effects: str | None = None,
) -> dict[str, Any]:
    ev: dict[str, Any] = {
        "kind": kind,
        "id": event_id,
        "correlation_id": corr,
        "payload": {"name": name},
    }
    if side_effects is not None:
        ev["side_effects"] = side_effects
    if content_hash is not None:
        ev["content_hash"] = content_hash
    return ev


