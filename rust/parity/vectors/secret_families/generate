def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_blob(rev_path: str) -> str:
    return subprocess.check_output(
        ["git", "show", rev_path],
        cwd=repo_root(),
        text=True,
    )


def verify_secret_families_py_matches_pin() -> None:
    pin = git_show_blob(f"{SECRET_FAMILIES_PY_PIN}:src/sesslint/secret_families.py")
    head = git_show_blob("HEAD:src/sesslint/secret_families.py")
    if pin != head:
        raise SystemExit(
            "src/sesslint/secret_families.py differs from pin blob; "
            "regenerate or align the worktree."
        )


def verify_secret_families_rs_sha256() -> None:
    rs_path = repo_root() / "rust" / "crates" / "model" / "src" / "secret_families.rs"
    digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if digest != SECRET_FAMILIES_RS_SHA256:
        raise SystemExit(
            "model/src/secret_families.rs sha256 mismatch: "
            f"expected {SECRET_FAMILIES_RS_SHA256}, got {digest}"
        )


def load_pinned_secret_families() -> tuple[
    list[tuple[str, re.Pattern[bytes], int]], dict[str, tuple[bytes, ...]]
]:
    verify_secret_families_py_matches_pin()
    source = git_show_blob(f"{SECRET_FAMILIES_PY_PIN}:src/sesslint/secret_families.py")
    globs: dict[str, Any] = {"__name__": "_parity_secret_families"}
    exec(compile(source, "<pinned secret_families.py>", "exec"), globs, globs)
    raw = globs.get("SECRET_FAMILIES")
    if raw is None:
        raise SystemExit("pinned module has no SECRET_FAMILIES")
    lit = globs.get("FAMILY_LITERALS")
    if lit is None:
        raise SystemExit("pinned module has no FAMILY_LITERALS")
    out: list[tuple[str, re.Pattern[bytes], int]] = []
    for name, pattern, group in raw:
        out.append((name, pattern, group))
    return out, lit


def family_by_name(
    patterns: list[tuple[str, re.Pattern[bytes], int]], name: str
) -> tuple[str, re.Pattern[bytes], int]:
    for item in patterns:
        if item[0] == name:
            return item
    raise SystemExit(f"unknown family {name!r}")


def span_for_search(
    haystack: bytes, pattern: re.Pattern[bytes], group: int
) -> tuple[int, int] | None:
    match = pattern.search(haystack)
    if match is None:
        return None
    return match.span(group)


def decode_bytes_blob(obj: dict[str, Any]) -> bytes:
    if obj.get("kind") != "bytes_hex":
        raise SystemExit("expected bytes_hex blob")
    hx = str(obj["hex"])
    if len(hx) % 2 != 0:
        raise SystemExit("odd hex length")
    return bytes.fromhex(hx) if hx else b""


def literal_bytes(literals: dict[str, tuple[bytes, ...]], family: str, index: int) -> bytes:
    return literals[family][index]


def assemble_concat_part(
    part: dict[str, Any], literals: dict[str, tuple[bytes, ...]]
) -> bytes:
    kind = part["kind"]
    if kind == "bytes_hex":
        return decode_bytes_blob(part)
    if kind == "family_literal_prefix":
        return literal_bytes(literals, part["family"], int(part["literal_index"]))
    raise SystemExit(f"unknown concat part {kind}")


def assemble_prefix_mode(
    recipe: dict[str, Any],
    mode: dict[str, Any],
    literals: dict[str, tuple[bytes, ...]],
) -> bytes:
    kind = mode["kind"]
    if kind == "family_literal":
        return literal_bytes(literals, recipe["family"], int(recipe["literal_index"]))
    if kind == "family_literal_prefix":
        return literal_bytes(literals, mode["family"], int(mode["literal_index"]))
    if kind == "concat":
        return b"".join(assemble_concat_part(p, literals) for p in mode["parts"])
    if kind == "pem_header":
        return b"-----BEGIN " + decode_bytes_blob(mode["middle"]) + literal_bytes(
            literals, "private-key-block", 0
        )
    if kind == "generic":
        if mode["keyword"] != "password":
            raise SystemExit("unknown generic keyword")
        return b"password"
    raise SystemExit(f"unknown prefix_mode {kind}")


def assemble_recipe(
    recipe: dict[str, Any], literals: dict[str, tuple[bytes, ...]]
) -> bytes:
    out = bytearray()
    out.extend(decode_bytes_blob(recipe["lead"]))
    out.extend(assemble_prefix_mode(recipe, recipe["prefix_mode"], literals))
    family = recipe["family"]
    if "segment_lengths" in recipe:
        segs = recipe["segment_lengths"]
        fill = int(recipe["fill_byte"])
        out.extend(bytes([fill]) * int(segs[0]))
        out.append(ord("."))
        out.extend(bytes([fill]) * int(segs[1]))
        out.append(ord("."))
        out.extend(bytes([fill]) * int(segs[2]))
    elif family == "generic-credential-assignment":
        out.extend(decode_bytes_blob(recipe["between"]))
        out.extend(bytes([int(recipe["fill_byte"])]) * int(recipe["body_length"]))
    else:
        bl = recipe.get("body_length")
        if bl is not None:
            n = int(bl)
            out.extend(bytes([int(recipe["fill_byte"])]) * n)
    out.extend(decode_bytes_blob(recipe["tail"]))
    return bytes(out)


