    specs: list[dict[str, Any]] = []

    def add(spec: dict[str, Any]) -> None:
        specs.append(spec)

    add(
        {
            "id": "module_exports",
            "construct": {"type": "module_exports"},
            "expected": {"python_all": list(mod.__all__)},
