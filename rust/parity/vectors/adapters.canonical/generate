                "supported_canonical_versions": sorted(mod.SUPPORTED_CANONICAL_VERSIONS),
                "required_event_keys": list(mod.REQUIRED_EVENT_KEYS),
                "known_top_keys": sorted(mod.KNOWN_TOP_KEYS),
                "known_event_keys": sorted(mod.KNOWN_EVENT_KEYS),
                "critical_keys": sorted(mod.CRITICAL_KEYS),
                "critical_top_keys": sorted(mod.CRITICAL_TOP_KEYS),
                "default_max_file_bytes": sys.modules[
                    "sesslint.io"
                ].DEFAULT_READER_LIMITS.max_file_bytes,
            },
        }
    )

    for vid, raw in (
        ("normalize_trim", "  1.0.0  "),
        ("normalize_v_prefix", "v1.2.3"),
        ("normalize_nbsp_v", " \u00a0V1\u001c "),
        ("normalize_empty", ""),
        ("normalize_v_alone", "v"),
        ("normalize_vx", "VX"),
        ("normalize_version_word", "version"),
    ):
        add(
            {
                "id": vid,
                "construct": {"type": "normalize_version", "text": raw},
                "expected": {"text": mod.normalize_version(raw)},
            }
        )

    detect_cases = [
        ("detect_empty", b"", "session.json", 0.0),
        ("detect_schema_v1", b'{"schema":"sesslint.session/v1","version":1}', "session.json", 1.0),
        (
            "detect_schema_version_key",
            b'{"schema_version": "sesslint.session/v1", "events": []}',
            "session.json",
            1.0,
        ),
        (
            "detect_partial_v2",
            b'{"schema": "sesslint.session/v2", "version": 2}',
            "session.json",
            0.6,
        ),
        (
            "detect_unrelated",
            b'{"items": [{"id": "1", "role": "user"}]}',
            "session.json",
            0.0,
        ),
        ("detect_substring", b"see sesslint.session here", "x", 0.6),
    ]
    for vid, data, name, score in detect_cases:
        add(
            {
                "id": vid,
                "construct": {
                    "type": "detect_canonical",
                    "bytes_hex": data.hex(),
                    "filename": name,
                },
                "expected": {"score": score},
            }
        )

    classify_cases: list[tuple[str, Any, bool]] = [
        ("classify_events_null", {"events": None}, True),
        (
            "classify_events_identity",
            {"events": [], "schema_version": "x", "session_id": "s"},
            True,
        ),
        ("classify_schema_only", {"schema": "s"}, True),
        ("classify_version_only", {"version": 1}, True),
        (
            "classify_schema_blocked",
            {"schema": "s", "schema_version": "v"},
            False,
        ),
        ("classify_empty_map", {}, False),
        ("classify_list", [], True),
        ("classify_string", "nope", True),
    ]
    for vid, doc, want in classify_cases:
        add(
            {
                "id": vid,
                "construct": {"type": "classify_session_doc", "doc": encode_payload(doc)},
                "expected": {"is_session_doc": mod._classify_session_doc(doc)},
            }
        )

    labels = [
        ("label_bytes", {"kind": "bytes_hex", "hex": ""}, "<bytes>"),
        ("label_str_dot", {"kind": "str", "text": "."}, "."),
        ("label_str_slash", {"kind": "str", "text": "synth/leaf"}, "synth/leaf"),
        ("label_str_backslash", {"kind": "str", "text": r"synth\leaf"}, "synth/leaf"),
        ("label_stream_missing", {"kind": "stream_name"}, "<stream>"),
        (
            "label_stream_name",
            {"kind": "stream_name", "text": r"a\.\b"},
            "a/./b",
        ),
    ]
    for vid, src, want in labels:
        path = materialize_source(src)
        add(
            {
                "id": vid,
                "construct": {"type": "canonical_source_label", "source": src},
                "expected": {"label": mod._canonical_source_label(path)},
