    decorative = json.dumps(
        {
            "schema": "sesslint.session/v1",
            "version": 1,
            "source": {"format": "canonical"},
            "events": [
                {
                    "actor": "user",
                    "id": "evt_syn_001",
                    "kind": "message",
                    "parent_id": None,
                    "payload": {"text": "hello"},
                    "seq": 0,
