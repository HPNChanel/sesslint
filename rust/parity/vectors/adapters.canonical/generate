    minimal = git_show_bytes(f"{PYTHON_COMMIT}:fixtures/canonical/minimal.json")
    empty = git_show_bytes(f"{PYTHON_COMMIT}:fixtures/canonical/empty.json")
    bad_schema = json.dumps(
