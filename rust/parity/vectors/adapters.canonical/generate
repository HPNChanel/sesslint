def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show(rel: str) -> str:
    return subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:src/sesslint/{rel}"],
        cwd=repo_root(),
        text=True,
    )


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def verify_pin_hashes() -> None:
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/adapters/canonical.py")
    digest = hashlib.sha256(blob).hexdigest()
    if digest != CANONICAL_PY_SHA256:
        raise SystemExit(
            f"canonical.py pin sha256 mismatch: expected {CANONICAL_PY_SHA256}, got {digest}"
        )
    rs_path = repo_root() / "rust" / "crates" / "adapters" / "src" / "canonical.rs"
    rs_digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if rs_digest != CANONICAL_RS_SHA256:
        raise SystemExit(
            "canonical.rs sha256 mismatch: "
            f"expected {CANONICAL_RS_SHA256}, got {rs_digest}"
        )


def mod_to_paths(mod: str) -> list[str]:
    tail = mod[len("sesslint.") :].replace(".", "/")
    return [f"{tail}.py", f"{tail}/__init__.py"]


def add_sesslint_module(found: set[str], name: str) -> None:
    if name == "sesslint" or not name.startswith("sesslint."):
        return
    found.add(name)


def discover_imports(source: str) -> set[str]:
    found: set[str] = set()
    tree = ast.parse(source)
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                add_sesslint_module(found, alias.name)
        elif isinstance(node, ast.ImportFrom) and node.module:
            add_sesslint_module(found, node.module)
    return found


def closure(root_mod: str) -> list[str]:
    queue = [root_mod]
    seen: set[str] = set()
    order: list[str] = []
    while queue:
        mod = queue.pop(0)
        if mod in seen:
            continue
        seen.add(mod)
        source = None
        for candidate in mod_to_paths(mod):
            try:
                source = git_show(candidate)
                break
            except subprocess.CalledProcessError:
                continue
        if source is None:
            continue
        order.append(mod)
        for imp in discover_imports(source):
            if imp not in seen:
                queue.append(imp)
    return order


def ensure_packages() -> None:
    for pkg in (
        "sesslint",
        "sesslint.adapters",
        "sesslint.checks",
        "sesslint.io",
        "sesslint.repair",
        "sesslint.scan",
    ):
        mod = types.ModuleType(pkg)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[pkg] = mod


def load_module(mod: str) -> None:
    source = None
    rel = None
    for candidate in mod_to_paths(mod):
        try:
            source = git_show(candidate)
            rel = candidate
            break
        except subprocess.CalledProcessError:
            continue
    if source is None or rel is None:
        raise ModuleNotFoundError(mod)
    code = compile(source, f"<{PYTHON_COMMIT}:{rel}>", "exec")
    module = types.ModuleType(mod)
    module.__file__ = f"<{PYTHON_COMMIT}:{rel}>"
    sys.modules[mod] = module
    try:
        exec(code, module.__dict__)  # noqa: S102
    except Exception:
        del sys.modules[mod]
        raise
    parent, _, child = mod.rpartition(".")
    if parent in sys.modules:
        setattr(sys.modules[parent], child, module)


def load_pinned_canonical() -> Any:
    verify_pin_hashes()
    ensure_packages()
    mods = [m for m in closure("sesslint.adapters.canonical") if m != "sesslint.adapters.canonical"]
    pending = list(mods)
    for _ in range(40):
        if not pending:
            break
        nxt: list[str] = []
        progress = False
        for mod in pending:
            try:
                load_module(mod)
                progress = True
            except ModuleNotFoundError:
                nxt.append(mod)
        pending = nxt
        if pending and not progress:
            raise SystemExit(f"stuck loading: {pending[:8]}")
    load_module("sesslint.adapters.canonical")
    return sys.modules["sesslint.adapters.canonical"]


def encode_payload(value: Any) -> dict[str, Any]:
    if value is None:
        return {"kind": "null"}
    if isinstance(value, bool):
        return {"kind": "bool", "value": value}
    if isinstance(value, int):
        return {"kind": "int", "value": value}
    if isinstance(value, float):
        return {"kind": "float", "value": value}
    if isinstance(value, str):
        return {"kind": "str", "text": value}
    if isinstance(value, list):
        return {"kind": "list", "items": [encode_payload(v) for v in value]}
    if isinstance(value, dict):
        return {
            "kind": "map",
            "entries": [
                {"key": encode_payload(k), "value": encode_payload(v)}
                for k, v in value.items()
            ],
        }
    raise SystemExit(f"cannot encode payload {type(value)!r}")


def pin_load_summary(mod: Any, source: dict[str, Any]) -> dict[str, Any]:
    path = materialize_source(source)
    events, findings = mod.load_canonical(path)
    return {
        "event_count": len(events),
        "finding_count": len(findings),
        "finding_codes": sorted(f.code for f in findings),
    }


def pin_body_summary(mod: Any, source: dict[str, Any], limits: Any) -> dict[str, Any]:
    from sesslint.checks.hygiene import SecretScanTracker

    path = materialize_source(source)
    tracker = SecretScanTracker()
    try:
        mod._load_canonical(path, limits=limits, secret_tracker=tracker)
        return {"mode": "ok"}
    except Exception as err:  # noqa: BLE001
        return {"mode": "error", "message": str(err)}


def materialize_source(spec: dict[str, Any]) -> Any:
    kind = spec["kind"]
    if kind == "bytes_hex":
        hx = spec.get("hex", "")
        return bytes.fromhex(hx) if hx else b""
    if kind == "str":
        return spec["text"]
    if kind == "stream_name":
        if "text" not in spec:
            return type("SynStream", (), {})()
        return type("SynStream", (), {"name": spec.get("text")})()
    raise SystemExit(f"unknown source kind {kind!r}")


def scan_committed_text(text: str) -> None:
    raw = text.encode("utf-8")
    if _BANNED_LIVE_TEST.search(raw):
        raise SystemExit("committed output matches banned live/test secret shape")
    if _BANNED_SUPABASE_PAT.search(raw):
        raise SystemExit("committed output contains a contiguous supabase token shape")


