    for vid, src in gap_sources:
        add(
            {
                "id": vid,
                "construct": {"type": "load_canonical", "source": src},
                "expected": {
                    "pin": pin_load_summary(mod, src),
                    "rust_assertion": {"mode": "gap_secret_scan_tracker"},
                },
            }
        )

    for vid, src in (
        ("gap_session_minimal", {"kind": "bytes_hex", "hex": minimal.hex()}),
        ("gap_session_decorative", {"kind": "bytes_hex", "hex": decorative.hex()}),
    ):
        add(
            {
                "id": vid,
                "construct": {"type": "load_canonical_session", "source": src},
                "expected": {
                    "pin": pin_load_summary(mod, src),
                    "rust_assertion": {"mode": "gap_secret_scan_tracker"},
                },
            }
        )

    missing = {"kind": "str", "text": "syn/parity-missing.json"}
    add(
        {
            "id": "body_missing_path",
            "construct": {"type": "load_canonical_body", "source": missing},
            "expected": {"message": pin_body_summary(mod, missing, None)["message"]},
        }
    )

    whitespace = {"kind": "bytes_hex", "hex": "202020"}
    pin_ws = pin_body_summary(mod, {"kind": "bytes_hex", "hex": "202020"}, None)
    add(
        {
            "id": "body_whitespace_only",
            "construct": {"type": "load_canonical_body", "source": whitespace},
            "expected": {
                "pin": pin_ws,
                "rust_assertion": {"mode": "gap_fingerprint_codec"},
            },
        }
    )

    empty_obj = {"kind": "bytes_hex", "hex": "7b7d"}  # {}
    pin_empty = pin_body_summary(mod, empty_obj, None)
    body_mode = (
        {"mode": "gap_decode_json"}
        if pin_empty.get("mode") == "ok"
        else {"mode": "gap_fingerprint_codec"}
    )
    add(
        {
            "id": "body_empty_object",
            "construct": {"type": "load_canonical_body", "source": empty_obj},
            "expected": {"pin": pin_empty, "rust_assertion": body_mode},
        }
    )

    add(
        {
            "id": "body_nul_gate",
            "construct": {"type": "load_canonical_body", "source": {"kind": "bytes_hex", "hex": nul_doc.hex()}},
            "expected": {
                "pin": pin_body_summary(mod, {"kind": "bytes_hex", "hex": nul_doc.hex()}, None),
                "rust_assertion": {"mode": "gap_fingerprint_codec"},
            },
        }
    )

    return specs


def list_tests_in_file(rel: str) -> list[tuple[str, bool]]:
    source = subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:{rel}"], cwd=repo_root(), text=True
    )
    has_column0 = any(line.startswith("def test_") for line in source.splitlines())
    out: list[tuple[str, bool]] = []
    for line in source.splitlines():
        if has_column0 and line.startswith("def test_"):
            name = line.split("(")[0].replace("def ", "")
            out.append((name, True))
        elif not has_column0 and line.startswith("    def test_"):
            name = line.split("(")[0].replace("def ", "").strip()
            out.append((name, False))
    return out


def write_coverage(out_dir: Path, vector_ids: frozenset[str]) -> tuple[int, int]:
    rows: list[dict[str, object]] = []
    covered = 0
    not_applicable = 0
    for rel in COVERAGE_TEST_FILES:
        try:
            tests = list_tests_in_file(rel)
        except subprocess.CalledProcessError:
            continue
        for name, _ in tests:
            qual = f"{rel}::{name}"
            needed = COVERED_BY_VECTORS.get(qual)
            row: dict[str, object] = {"test": qual}
            if needed is not None and all(item in vector_ids for item in needed):
                status = "covered"
                covered += 1
                row["vector_ids"] = list(needed)
            else:
                status = "not_applicable"
                not_applicable += 1
            row["status"] = status
            rows.append(row)
    payload = {"rows": rows}
    (out_dir / "coverage.json").write_text(
        json.dumps(payload, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    return covered, not_applicable


def main() -> int:
    mod = load_pinned_canonical()
    out_dir = Path(__file__).resolve().parent
    vectors = vector_specs(mod)
    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "canonical_py_sha256": CANONICAL_PY_SHA256,
        "canonical_rs_sha256": CANONICAL_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(payload)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.adapters.canonical parity (prefix helpers, "
            "detection, labels, and documented load seams)."
        ),
        "generator": "rust/parity/vectors/adapters.canonical/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    write_coverage(out_dir, frozenset(v["id"] for v in vectors))
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
