        "shape": "json",
        "value": {
          "b": 2,
          "a": 1
        },
        "newline": false
      },
      "expected": {
        "result": "ok",
        "bytes_b64": "eyJhIjoxLCJiIjoyfQ=="
      }
    },
    {
