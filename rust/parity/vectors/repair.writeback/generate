def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show(rel: str) -> str:
    return subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:{rel}"], cwd=repo_root(), text=True
    )


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def mod_to_paths(mod: str) -> list[str]:
    tail = mod[len("sesslint.") :].replace(".", "/")
    return [f"src/sesslint/{tail}.py", f"src/sesslint/{tail}/__init__.py"]


def discover_imports(source: str) -> set[str]:
    found: set[str] = set()
    tree = ast.parse(source)
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name.startswith("sesslint."):
                    found.add(alias.name)
        elif isinstance(node, ast.ImportFrom) and node.module:
            if node.module.startswith("sesslint."):
                found.add(node.module)
    return found


def closure(root_mods: tuple[str, ...]) -> list[str]:
    queue = list(root_mods)
    seen: set[str] = set()
    order: list[str] = []
    while queue:
        mod = queue.pop(0)
        if mod in seen:
            continue
        seen.add(mod)
        source = None
        for candidate in mod_to_paths(mod):
            try:
                source = git_show(candidate)
                break
            except subprocess.CalledProcessError:
                continue
        if source is None:
            continue
        order.append(mod)
        for imp in discover_imports(source):
            if imp not in seen:
                queue.append(imp)
    return order


def ensure_packages() -> None:
    for pkg in (
        "sesslint",
        "sesslint.adapters",
        "sesslint.checks",
        "sesslint.io",
        "sesslint.scan",
        "sesslint.repair",
        "sesslint.profiles",
        "sesslint.policy",
    ):
        mod = types.ModuleType(pkg)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[pkg] = mod


def load_module(mod: str) -> None:
    source = None
    rel = None
    for candidate in mod_to_paths(mod):
        try:
            source = git_show(candidate)
            rel = candidate
            break
        except subprocess.CalledProcessError:
            continue
    if source is None or rel is None:
        raise ModuleNotFoundError(mod)
    code = compile(source, f"<{PYTHON_COMMIT}:{rel}>", "exec")
    module = types.ModuleType(mod)
    module.__file__ = f"<{PYTHON_COMMIT}:{rel}>"
    sys.modules[mod] = module
    try:
        exec(code, module.__dict__)  # noqa: S102
    except Exception:
        del sys.modules[mod]
        raise
    parent, _, child = mod.rpartition(".")
    if parent in sys.modules:
        setattr(sys.modules[parent], child, module)


def verify_writeback_digests() -> None:
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/writeback.py")
    py_digest = hashlib.sha256(py_blob).hexdigest()
    if py_digest != WRITEBACK_PY_SHA256:
        raise SystemExit(
            f"writeback.py pin sha256 mismatch: expected {WRITEBACK_PY_SHA256}, got {py_digest}"
        )
    rs_path = repo_root() / "rust" / "crates" / "repair" / "src" / "writeback.rs"
    rs_digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if rs_digest != WRITEBACK_RS_SHA256:
        raise SystemExit(
            f"writeback.rs sha256 mismatch: expected {WRITEBACK_RS_SHA256}, got {rs_digest}"
        )


def load_modules_with_retries(mods: list[str], *, final: str | None = None) -> None:
    pending = [m for m in mods if m != final]
    for _ in range(96):
        if not pending:
            break
        nxt: list[str] = []
        progress = False
        for mod in pending:
            try:
                load_module(mod)
                progress = True
            except ModuleNotFoundError:
                nxt.append(mod)
        pending = nxt
        if pending and not progress:
            raise SystemExit(f"stuck loading pinned modules: {pending[:12]}")
    if final is not None:
        load_module(final)


def load_pinned_writeback_stack() -> tuple[Any, Any, Any, Any]:
    verify_writeback_digests()
    ensure_packages()
    roots = (
        "sesslint.adapters.claude_code",
        "sesslint.adapters.codex_rollout",
        "sesslint.adapters.openai_agents",
        "sesslint.adapters.canonical",
        "sesslint.adapters.detect",
        "sesslint.repair.writeback",
    )
    ordered = closure(roots)
    claude_mod = "sesslint.adapters.claude_code"
    detect_mod = "sesslint.adapters.detect"
    writeback_mod = "sesslint.repair.writeback"
    defer = {claude_mod, detect_mod, writeback_mod}
    others = [m for m in ordered if m not in defer]
    load_modules_with_retries(others)
    load_module(claude_mod)
    load_modules_with_retries(
        [m for m in ordered if m in defer and m != writeback_mod],
        final=detect_mod,
    )
    load_module(writeback_mod)
    writeback = sys.modules["sesslint.repair.writeback"]
    claude = sys.modules["sesslint.adapters.claude_code"]
    canonical = sys.modules["sesslint.canonical"]
    errors = sys.modules["sesslint.repair.errors"]
    return writeback, claude, canonical, errors


def scan_committed_text(text: str) -> None:
    raw = text.encode("utf-8")
    if _BANNED_LIVE_TEST.search(raw):
        raise SystemExit("committed output matches banned live/test secret shape")
    if _BANNED_SUPABASE_PAT.search(raw):
        raise SystemExit("committed output contains a contiguous supabase token shape")
    for needle in _BANNED_LITERALS:
        if needle in raw:
            raise SystemExit(f"committed output contains banned literal {needle!r}")


def event_dict(event: Any) -> dict[str, Any]:
    line = getattr(event, "source_line", None)
    rh = getattr(event, "source_record_hash", None)
    if not isinstance(rh, str):
        rh = None
    ident_fn = getattr(event, "content_identity_hash", None)
    identity = str(ident_fn()) if callable(ident_fn) else ""
    return {
        "source_line": line,
        "id": str(getattr(event, "id", "")),
        "identity": identity,
        "source_record_hash": rh,
    }


def events_have_nonempty_record_hash(events: list[Any]) -> bool:
    for ev in events:
        rh = getattr(ev, "source_record_hash", None)
        if isinstance(rh, str) and rh:
            return True
    return False


def b64(data: bytes) -> str:
    return base64.standard_b64encode(data).decode("ascii")


def emit_construct(
    writeback: Any,
    errors: Any,
    *,
    source: bytes,
    source_events: list[Any],
    output_events: list[Any],
    emit_format: str,
    drop_lines: list[int] | None = None,
) -> dict[str, Any]:
    drops = frozenset(drop_lines or ())
    try:
        out, summary = writeback.emit_vendor_bytes(
            source,
            source_events,
            output_events,
            emit_format,
            drop_lines=drops,
        )
    except errors.VendorProjectionRefused as exc:
        return {
            "mode": "comparable",
            "reason": exc.reason,
            "message": str(exc),
            "pin": {"mode": "refusal", "reason": exc.reason},
        }
    seam = (
        CANONICAL_SEAM
        if events_have_nonempty_record_hash(source_events)
        else HASHLIB_SEAM
    )
    return {
        "mode": "rust_seam",
        "seam": seam,
        "pin": {
            "mode": "success",
            "emitted_b64": b64(out),
            "retained_lines": summary.retained_lines,
            "dropped_lines": summary.dropped_lines,
            "emitted_sha256": summary.emitted_sha256,
            "emit_format": summary.emit_format,
        },
    }


def basic_fixture(claude: Any) -> tuple[bytes, list[Any]]:
    blob = git_show_bytes(f"{PYTHON_COMMIT}:fixtures/claude_code/basic.jsonl")
    with tempfile.NamedTemporaryFile(suffix=".jsonl", delete=False) as handle:
        handle.write(blob)
        path = Path(handle.name)
    src = path.read_bytes()
    events, _ = claude.load_claude_code(path)
    path.unlink(missing_ok=True)
    return src, list(events)


def mk_event(canonical: Any, eid: str, seq: int, *, source_line: int | None) -> Any:
    return canonical.SessionEvent(
        id=eid,
        parent_id=None,
        seq=seq,
        ts="2026-09-15T00:00:00Z",
        actor="assistant",
        kind="message",
        source_line=source_line,
    )


