def discover_coverage_rows(vector_ids: set[str]) -> list[dict[str, Any]]:
    tests = [
        "tests/repair/test_writeback.py::test_writeback_identity_passthrough",
        "tests/repair/test_writeback.py::test_writeback_drops_line_when_all_events_dropped",
        "tests/repair/test_writeback.py::test_writeback_refuses_synthesized_event_r1",
        "tests/repair/test_writeback.py::test_writeback_refuses_partial_line_r2",
        "tests/repair/test_writeback.py::test_writeback_refuses_rewritten_event_r3",
        "tests/repair/test_writeback.py::test_writeback_refuses_source_drift_r4",
        "tests/repair/test_writeback.py::test_writeback_refuses_reorder_r5",
        "tests/repair/test_writeback.py::test_writeback_refuses_single_doc_json_r6",
        "tests/repair/test_writeback.py::test_single_jsonl_record_and_interior_cr_are_preserved",
        "tests/repair/test_writeback.py::test_writeback_refuses_unsupported_format_r6",
        "tests/repair/test_writeback.py::test_writeback_drop_lines_discards_torn_record",
        "tests/repair/test_writeback.py::test_writeback_keeps_uninterpreted_lines",
        "tests/repair/test_writeback.py::test_api_repair_vendor_torn_writeback",
        "tests/repair/test_writeback.py::test_api_repair_vendor_emit_canonical",
        "tests/repair/test_writeback.py::test_api_verify_vendor_pair",
    ]
    rows: list[dict[str, Any]] = []
    for test in tests:
        vector_id = COVERED_BY_VECTORS.get(test)
        if vector_id and vector_id in vector_ids:
            rows.append(
                {
                    "test": test,
                    "status": "covered",
                    "vector_id": vector_id,
                }
            )
        elif test.endswith("test_writeback_refuses_partial_line_r2") and (
            "refuses_partial_line_r2" not in vector_ids
        ):
            rows.append(
                {
                    "test": test,
                    "status": "not_applicable",
                    "vector_id": None,
                    "note": "adapter produced fewer than two events on the multi-block line at pin",
                }
            )
        elif test.endswith("test_writeback_refuses_source_drift_r4"):
            rows.append(
                {
                    "test": test,
                    "status": "not_applicable",
                    "vector_id": None,
                    "note": "Rust stops at canonical_json_bytes instead of Python record-hash drift R4",
                }
            )
        elif test.endswith("test_writeback_refuses_rewritten_event_r3"):
            rows.append(
                {
                    "test": test,
                    "status": "not_applicable",
                    "vector_id": None,
                    "note": "Rust hits canonical record-hash on an earlier line before line-level R3",
                }
            )
        elif test.endswith(
            (
                "test_writeback_identity_passthrough",
                "test_writeback_drops_line_when_all_events_dropped",
                "test_single_jsonl_record_and_interior_cr_are_preserved",
                "test_writeback_drop_lines_discards_torn_record",
                "test_writeback_keeps_uninterpreted_lines",
            )
        ):
            rows.append(
                {
                    "test": test,
                    "status": "not_applicable",
                    "vector_id": None,
                    "note": "pin asserts emitted bytes or a sha256 summary; Rust stops at canonical_json_bytes or hashlib.sha256",
                }
            )
        elif "api_" in test:
            rows.append(
                {
                    "test": test,
                    "status": "not_applicable",
                    "vector_id": None,
                    "note": "api.repair / api.verify integration outside repair::writeback",
                }
            )
        else:
            rows.append(
                {
                    "test": test,
                    "status": "not_applicable",
                    "vector_id": None,
                    "note": "no matching vector construct",
                }
            )
    return rows


def main() -> int:
    writeback, claude, canonical, errors = load_pinned_writeback_stack()
    vectors = build_vectors(writeback, claude, canonical, errors)
    out_dir = Path(__file__).resolve().parent
    vector_ids = {item["id"] for item in vectors}
    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "writeback_py_sha256": WRITEBACK_PY_SHA256,
        "writeback_rs_sha256": WRITEBACK_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(payload)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()

    coverage_rows = discover_coverage_rows(vector_ids)
    covered = sum(1 for row in coverage_rows if row["status"] == "covered")
    not_applicable = sum(1 for row in coverage_rows if row["status"] == "not_applicable")
    coverage_doc = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": covered,
        "not_applicable_count": not_applicable,
        "rows": coverage_rows,
    }
    (out_dir / "coverage.json").write_text(
        json.dumps(coverage_doc, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )

    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    print(f"coverage covered={covered} not_applicable={not_applicable}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
