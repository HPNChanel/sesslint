def tag(v):
    if v is snap.NON_SCALAR:
        return ["nested"]
    if v is None:
        return ["null"]
    if type(v) is bool:
        return ["bool", v]
    if type(v) is int:
        return ["int", str(v)]
    if type(v) is float:
        return ["float", struct.pack(">d", v).hex()]
    return ["str", v]


def rows(x):
    return dict(records=[{k: tag(v) for k, v in r.items()} for r in x[0]], fields=sorted(x[1]))


archive = subprocess.check_output(["git", "archive", "--format=zip", PIN, "src/sesslint"], cwd=ROOT)
with tempfile.TemporaryDirectory(prefix="sesslint-snapshot-vector-") as temporary:
    root = Path(temporary)
    with zipfile.ZipFile(io.BytesIO(archive)) as z:
        for member in z.infolist():
            if member.is_dir():
                continue
            p = Path(member.filename)
            assert (
                not p.is_absolute() and ".." not in p.parts and p.parts[:2] == ("src", "sesslint")
            )
            target = root / p
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(z.read(member))
    sys.path.insert(0, str(root / "src"))
    snap = importlib.import_module("sesslint.outcome.snapshot")
    results = []
    for case in cases:
        try:
            op = case["op"]
            if op == "instant":
                out = snap.format_instant(snap.parse_instant(case["raw"]))
            elif op == "csv":
                out = rows(snap._from_csv(case["raw"]))
            elif op == "jsonl":
                out = rows(snap._from_jsonl(case["raw"]))
            elif op == "objects":
                out = rows(snap._from_objects(snap.parse_strict_json(case["raw"]), "items"))
            elif op == "load":
                name = case["name"]
                assert Path(name).name == name and name not in (".", "..")
                path = root / name
                path.write_bytes(bytes.fromhex(case["hex"]))
                opts = {
                    k: case[k] for k in ["role", "completeness", "origin", "max_bytes"] if k in case
                }
                opts.setdefault("role", "target")
                if case.get("observed_at") is not None:
                    opts["observed_at"] = snap.parse_instant(case["observed_at"])
                s = snap.load_snapshot(path, **opts)
                out = dict(meta=s.to_dict(), **rows((s.records, s.fields)))
            else:
                raise AssertionError(op)
            results.append(dict(ok=out))
        except (ValueError, RecursionError, OverflowError) as e:
            results.append(dict(error=str(e), kind=type(e).__name__))

