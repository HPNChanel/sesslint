#!/usr/bin/env python3
"""Generate sesslint.cli._json_errors parity vectors from the pinned worktree module (stdlib only)."""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import sys
from argparse import Namespace
from pathlib import Path
from typing import Any

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
JSON_ERRORS_SHA256 = "af5502d6bc92b7d4d7967edee7edb3012afbeebcacde052e7a7576aad55d5e1b"

KNOWN_GAPS = [
    "A lone UTF-16 surrogate cannot be stored in Rust str; no \\ud800 error_document vector.",
    "Rust 1.91 makes std::env::set_var unsafe; parity vectors do not set SESSLINT_FORMAT (env fallback covered by cli unit tests in json_errors.rs).",
]

SYNTHETIC_ASCII = "Command failed"
SYNTHETIC_CAFE = "caf\u00e9"
SYNTHETIC_DEL = "\u007f"


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def load_json_errors_module():
    root = repo_root()
    module_path = root / "src" / "sesslint" / "cli" / "_json_errors.py"
    digest = hashlib.sha256(module_path.read_bytes()).hexdigest()
    if digest != JSON_ERRORS_SHA256:
        raise SystemExit(
            f"_json_errors.py sha256 mismatch: expected {JSON_ERRORS_SHA256}, got {digest}"
        )
    src = root / "src"
    if str(src) not in sys.path:
        sys.path.insert(0, str(src))
    from sesslint.cli._json_errors import (  # noqa: WPS433
        TrackedStream,
        error_document,
        wants_json,
    )

    return TrackedStream, error_document, wants_json


class NonIntegerWriteStream(io.StringIO):
    def write(self, s: str) -> object:
        super().write(s)
        return None  # type: ignore[return-value]


class FailingWriteStream(io.StringIO):
    def write(self, s: str) -> int:
        raise OSError("synthetic-write-fail")


def args_from_spec(spec: dict[str, Any] | None) -> Namespace | None:
    if spec is None:
        return None
    if spec.get("json_surface") is False:
        return Namespace(policy="conservative")
    ns = Namespace()
    if "json" in spec:
        ns.json = spec["json"]
    if "output_format" in spec:
        ns.output_format = spec["output_format"]
    return ns


