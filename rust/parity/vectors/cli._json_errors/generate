def build_expected(
    TrackedStream: type,
    error_document: Any,
    wants_json: Any,
    spec: dict[str, Any],
) -> dict[str, Any]:
    kind = spec["type"]
    if kind == "error_document":
        message = str(spec["message"])
        document = error_document(message)
        payload = document.encode("utf-8")
        return {
            "document": document,
            "bytes_sha256": hashlib.sha256(payload).hexdigest(),
            "bytes_len": len(payload),
        }
    if kind == "wants_json":
        argv = list(spec.get("argv") or [])
        args = args_from_spec(spec.get("args"))
        return {"value": wants_json(argv, args)}
    if kind == "tracked_stream":
        limit = int(spec.get("diagnostic_limit", 0))
        raw_mode = spec.get("raw_mode", "integer")
        if raw_mode == "non_integer":
            raw: io.StringIO | NonIntegerWriteStream | FailingWriteStream = (
                NonIntegerWriteStream()
            )
        elif raw_mode == "fail":
            raw = FailingWriteStream()
        else:
            raw = io.StringIO()
        stream = TrackedStream(raw, diagnostic_limit=limit)
        write_results: list[dict[str, Any]] = []
        for chunk in spec.get("writes") or []:
            text = str(chunk)
            try:
                count = stream.write(text)
                write_results.append({"ok": True, "count": count})
            except OSError as exc:
                write_results.append({"ok": False, "error": type(exc).__name__})
        return {
            "nonempty": stream.nonempty,
            "diagnostic": stream.diagnostic(),
            "write_results": write_results,
        }
    raise ValueError(f"unknown construct type: {kind}")


def main() -> int:
    TrackedStream, error_document, wants_json = load_json_errors_module()
    out_dir = Path(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        expected = build_expected(
            TrackedStream,
            error_document,
            wants_json,
            row["construct"],
        )
        vectors.append(
            {
                "id": row["id"],
                "construct": row["construct"],
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": "sesslint.cli._json_errors",
        "python_commit": PYTHON_COMMIT,
        "json_errors_py_sha256": JSON_ERRORS_SHA256,
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    manifest = {
        "schema": SCHEMA,
        "module": "sesslint.cli._json_errors",
        "python_commit": PYTHON_COMMIT,
        "json_errors_py_sha256": JSON_ERRORS_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/cli._json_errors/generate",
        "known_gaps": KNOWN_GAPS,
    }
    (out_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    provenance = {
        "contains_real_data": False,
        "description": "Synthetic cli._json_errors error_document, wants_json, and TrackedStream parity.",
        "generator": "rust/parity/vectors/cli._json_errors/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": KNOWN_GAPS,
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
