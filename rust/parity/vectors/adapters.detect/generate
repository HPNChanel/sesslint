def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show(rel: str) -> str:
    return subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:src/sesslint/{rel}"],
        cwd=repo_root(),
        text=True,
    )


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def verify_pin_hashes() -> None:
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/adapters/detect.py")
    digest = hashlib.sha256(blob).hexdigest()
    if digest != DETECT_PY_SHA256:
        raise SystemExit(
            f"detect.py pin sha256 mismatch: expected {DETECT_PY_SHA256}, got {digest}"
        )
    rs_path = repo_root() / "rust" / "crates" / "adapters" / "src" / "detect.rs"
    rs_digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if rs_digest != DETECT_RS_SHA256:
        raise SystemExit(
            "detect.rs sha256 mismatch: "
            f"expected {DETECT_RS_SHA256}, got {rs_digest}"
        )


def mod_to_paths(mod: str) -> list[str]:
    tail = mod[len("sesslint.") :].replace(".", "/")
    return [f"{tail}.py", f"{tail}/__init__.py"]


def add_sesslint_module(found: set[str], name: str) -> None:
    if name == "sesslint" or not name.startswith("sesslint."):
        return
    found.add(name)


def discover_imports(source: str) -> set[str]:
    found: set[str] = set()
    tree = ast.parse(source)
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                add_sesslint_module(found, alias.name)
        elif isinstance(node, ast.ImportFrom) and node.module:
            add_sesslint_module(found, node.module)
    return found


def closure(root_mod: str) -> list[str]:
    queue = [root_mod]
    seen: set[str] = set()
    order: list[str] = []
    while queue:
        mod = queue.pop(0)
        if mod in seen:
            continue
        seen.add(mod)
        source = None
        for candidate in mod_to_paths(mod):
            try:
                source = git_show(candidate)
                break
            except subprocess.CalledProcessError:
                continue
        if source is None:
            continue
        order.append(mod)
        for imp in discover_imports(source):
            if imp not in seen:
                queue.append(imp)
    return order


def ensure_packages() -> None:
    for pkg in (
        "sesslint",
        "sesslint.adapters",
        "sesslint.checks",
        "sesslint.io",
        "sesslint.scan",
        "sesslint.repair",
        "sesslint.profiles",
        "sesslint.determinism",
    ):
        mod = types.ModuleType(pkg)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[pkg] = mod


def load_module(mod: str, *, temp_main: bool = False) -> None:
    source = None
    rel = None
    for candidate in mod_to_paths(mod):
        try:
            source = git_show(candidate)
            rel = candidate
            break
        except subprocess.CalledProcessError:
            continue
    if source is None or rel is None:
        raise ModuleNotFoundError(mod)
    if temp_main and mod == "sesslint.adapters.detect":
        with tempfile.NamedTemporaryFile(
            "w", suffix=".py", delete=False, encoding="utf-8"
        ) as handle:
            handle.write(source)
            path = handle.name
        code = compile(source, path, "exec")
    else:
        code = compile(source, f"<{PYTHON_COMMIT}:{rel}>", "exec")
    module = types.ModuleType(mod)
    module.__file__ = f"<{PYTHON_COMMIT}:{rel}>"
    sys.modules[mod] = module
    try:
        exec(code, module.__dict__)  # noqa: S102
    except Exception:
        del sys.modules[mod]
        raise
    parent, _, child = mod.rpartition(".")
    if parent in sys.modules:
        setattr(sys.modules[parent], child, module)


def load_pinned_detect() -> Any:
    verify_pin_hashes()
    ensure_packages()
    mods = [
        m for m in closure("sesslint.adapters.detect") if m != "sesslint.adapters.detect"
    ]
    pending = list(mods)
    for _ in range(200):
        if not pending:
            break
        nxt: list[str] = []
        progress = False
        for mod in pending:
            try:
                load_module(mod, temp_main=False)
                progress = True
            except (ModuleNotFoundError, ImportError, SyntaxError, Exception):
                nxt.append(mod)
        pending = nxt
        if pending and not progress:
            raise SystemExit(f"stuck loading: {pending[:12]}")
    load_module("sesslint.adapters.detect", temp_main=True)
    return sys.modules["sesslint.adapters.detect"]


def encode_payload(value: Any) -> dict[str, Any]:
    if value is None:
        return {"kind": "null"}
    if isinstance(value, bool):
        return {"kind": "bool", "value": value}
    if isinstance(value, int) and not isinstance(value, bool):
        return {"kind": "int", "value": value}
    if isinstance(value, float):
        if math.isnan(value):
            return {"kind": "float", "text": "nan"}
        if math.isinf(value):
            return {
                "kind": "float",
                "text": "inf" if value > 0 else "-inf",
            }
        return {"kind": "float", "value": value}
    if isinstance(value, str):
        return {"kind": "str", "text": value}
    if isinstance(value, list):
        return {"kind": "list", "items": [encode_payload(v) for v in value]}
    if isinstance(value, dict):
        return {
            "kind": "map",
            "entries": [
                {"key": encode_payload(k), "value": encode_payload(v)}
                for k, v in value.items()
            ],
        }
    raise SystemExit(f"cannot encode payload {type(value)!r}")


def encode_confidences(conf: dict[str, float]) -> list[list[Any]]:
    return [[key, value] for key, value in conf.items()]


def encode_detection_result(res: Any) -> dict[str, Any]:
    return {
        "format": res.format,
        "reason": res.reason,
        "confidences": encode_confidences(res.confidences),
    }


def encode_source_block(block: dict[str, Any]) -> dict[str, Any]:
    conf = block.get("confidences", {})
    if isinstance(conf, dict):
        conf_out = [[key, value] for key, value in conf.items()]
    else:
        conf_out = conf
    return {
        "requested": block["requested"],
        "resolved": block.get("resolved"),
        "confidences": conf_out,
        "reason": block["reason"],
    }


def pin_detect_path(mod: Any, path: Path, **kwargs: Any) -> dict[str, Any]:
    try:
        res = mod.detect_format(path, **kwargs)
    except Exception as exc:  # noqa: BLE001
        return {"error_type": type(exc).__name__, "message": str(exc)}
    return {"result": encode_detection_result(res)}


def pin_detect_bytes(mod: Any, data: bytes, filename: str, **kwargs: Any) -> dict[str, Any]:
    try:
        res = mod.detect_format_bytes(data, filename=filename, **kwargs)
    except Exception as exc:  # noqa: BLE001
        return {"error_type": type(exc).__name__, "message": str(exc)}
    return {"result": encode_detection_result(res)}


def pin_validate(mod: Any, confidence_min: Any, margin_min: Any) -> dict[str, Any]:
    try:
        mod.validate_detection_thresholds(confidence_min, margin_min)
    except Exception as exc:  # noqa: BLE001
        return {"error_type": type(exc).__name__, "message": str(exc)}
    return {"ok": True}


def pin_resolve(mod: Any, explicit: Any, path: Path, **kwargs: Any) -> dict[str, Any]:
    try:
        fmt, det, findings = mod.resolve_format(explicit, path, **kwargs)
    except Exception as exc:  # noqa: BLE001
        return {"error_type": type(exc).__name__, "message": str(exc)}
    return {
        "format": fmt,
        "finding_count": len(findings),
        "result": encode_detection_result(det) if det is not None else None,
    }


def relativize_message(message: str) -> str:
    out_dir = Path(__file__).resolve().parent
    prefix = str(out_dir)
    needles: list[str] = []
    for item in (prefix, prefix.replace("\\", "\\\\")):
        for sep in ("\\", "/", "\\\\"):
            needles.append(item + sep)
        needles.append(item)
    needles.sort(key=len, reverse=True)
    text = message
    for needle in needles:
        if needle:
            text = text.replace(needle, "")
    return text.replace("\\\\", "/").replace("\\", "/")


def ensure_fixtures(out_dir: Path, mod: Any) -> None:
    fixtures = out_dir / "fixtures"
    fixtures.mkdir(exist_ok=True)
    pin_names = [
        "ambiguous.json",
        "canonical_sample.json",
        "claude_sample.jsonl",
        "codex_sample.jsonl",
        "empty.jsonl",
        "openai_sample.json",
    ]
    for name in pin_names:
        dest = fixtures / name
        if not dest.exists():
            dest.write_bytes(
                git_show_bytes(f"{commit_path()}:fixtures/detect/{name}")
            )
    (fixtures / SYN_WS.split("/")[-1]).write_text(
        "   \n\t  \r\n   ", encoding="utf-8", newline="\n"
    )
    (fixtures / SYN_BOM_WS.split("/")[-1]).write_bytes(
        b"\xef\xbb\xbf   \r\n\t"
    )
    sqlite_magic = mod.SQLITE_MAGIC if hasattr(mod, "SQLITE_MAGIC") else (
        __import__("sesslint.adapters.openai_agents", fromlist=["SQLITE_MAGIC"]).SQLITE_MAGIC
    )
    (fixtures / SYN_SQLITE.split("/")[-1]).write_bytes(sqlite_magic + b"\x00" * 84)
    (fixtures / SYN_RANDOM.split("/")[-1]).write_text(
        "random unstructured log content line 1\nline 2",
        encoding="utf-8",
        newline="\n",
    )
    canon = (fixtures / "canonical_sample.json").read_bytes()
    (fixtures / SYN_LYING.split("/")[-1]).write_bytes(canon)
    line = (
        '{"type":"user_message","sessionId":"sess-large"}'
        + (" " * 200_000)
        + "\n"
    )
    (fixtures / SYN_GIANT.split("/")[-1]).write_bytes(line.encode("utf-8"))
    sniff = mod.SNIFF_BYTES
    head = b'{"id":"msg_01","type":"user_message"}\n'
    pad = b" " * (sniff - len(head) - 1)
    boundary = head + pad + b"\xe2"
    assert len(boundary) == sniff
    (fixtures / SYN_BOUNDARY.split("/")[-1]).write_bytes(
        boundary + (b"\x80\x99 extra content\n" * 5000)
    )
    snif_missing = fixtures / "syn-missing-file.json"
    if snif_missing.exists():
        snif_missing.unlink()
    directory = fixtures / "syn-dir-not-file"
    directory.mkdir(exist_ok=True)
    (directory / "KEEP").write_text(
        "Synthetic directory fixture. The path itself is the input.\n",
        encoding="utf-8",
        newline="\n",
    )
    dummy = fixtures / "syn-dummy.json"
    dummy.write_text("{}", encoding="utf-8", newline="\n")


