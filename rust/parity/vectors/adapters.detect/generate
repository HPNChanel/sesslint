                writable,
                confidence_min=0.99,
                margin_min=0.99,
            ),
        }
    )

    result = mod.DetectionResult(
        format=mod.FORMAT_CANONICAL,
        confidences={
            mod.FORMAT_CLAUDE_CODE: 0.123456,
            mod.FORMAT_OPENAI_AGENTS: 0.0,
            mod.FORMAT_CANONICAL: 1.0,
        },
        reason=mod.REASON_CLEAR_WINNER,
    )
    add(
        {
            "id": "to_source_block_auto",
            "construct": {
                "type": "to_source_block",
                "result": encode_detection_result(result),
                "requested": "auto",
            },
            "expected": {
                "block": encode_source_block(
                    mod.to_source_block(result, requested="auto")
                )
            },
        }
    )
    add(
        {
            "id": "to_source_block_method",
            "construct": {
                "type": "to_source_block_method",
                "result": encode_detection_result(result),
                "requested": "canonical",
            },
            "expected": {
                "block": encode_source_block(
                    result.to_source_block(requested="canonical")
                )
            },
        }
    )
    add(
        {
            "id": "to_source_block_none",
            "construct": {
                "type": "to_source_block",
                "result": None,
                "requested": "auto",
            },
            "expected": {
                "block": encode_source_block(
                    mod.to_source_block(None, requested="auto")
                )
            },
        }
    )

    gap_cases = [
        (
            "gap_resolve_empty_sl001",
            "fixtures/empty.jsonl",
            None,
            {"reason": mod.REASON_EMPTY},
        ),
        (
            "gap_resolve_ambiguous_sl302",
            "fixtures/ambiguous.json",
            None,
            {"reason": mod.REASON_TIE},
        ),
        (
            "gap_resolve_sqlite_sl001",
            SYN_SQLITE,
            None,
            {"reason": mod.REASON_REFUSED_LIVE_DB},
        ),
        (
            "gap_resolve_low_confidence",
            SYN_RANDOM,
            "auto",
            {"reason": mod.REASON_LOW_CONFIDENCE},
        ),
    ]
    for vid, rel, explicit, want_det in gap_cases:
        path = out_dir / rel if rel.startswith("fixtures/") else fx / rel.split("/")[-1]
        pin = pin_resolve(mod, explicit, path)
        add(
            {
                "id": vid,
                "construct": {
                    "type": "resolve_format",
                    "explicit": explicit,
                    "path_rel": rel,
                },
                "expected": {
                    "pin": pin,
                    "rust_assertion": {"mode": "gap_finding_fingerprint"},
                    **want_det,
                },
            }
        )

    return specs


def imports_module(rel: str) -> bool:
    try:
        source = subprocess.check_output(
            ["git", "show", f"{PYTHON_COMMIT}:{rel}"], cwd=repo_root(), text=True
        )
    except subprocess.CalledProcessError:
        return False
    return "sesslint.adapters.detect" in source


def list_tests_in_file(rel: str) -> list[str]:
    source = subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:{rel}"], cwd=repo_root(), text=True
    )
    has_column0 = any(line.startswith("def test_") for line in source.splitlines())
    out: list[str] = []
    for line in source.splitlines():
        if has_column0 and line.startswith("def test_"):
            out.append(line.split("(")[0].replace("def ", ""))
        elif not has_column0 and line.startswith("    def test_"):
            out.append(line.split("(")[0].replace("def ", "").strip())
    return out


def write_coverage(out_dir: Path, vector_ids: frozenset[str]) -> tuple[int, int]:
    rows: list[dict[str, object]] = []
    covered = 0
    not_applicable = 0
    for rel in COVERAGE_TEST_FILES:
        if not imports_module(rel):
            continue
        tests = list_tests_in_file(rel)
        for name in tests:
            qual = f"{rel}::{name}"
            needed = COVERED_BY_VECTORS.get(qual)
            row: dict[str, object] = {"test": qual}
            if needed is not None and all(item in vector_ids for item in needed):
                row["status"] = "covered"
                row["vector_ids"] = list(needed)
                covered += 1
            else:
                row["status"] = "not_applicable"
                not_applicable += 1
            rows.append(row)
        if rel == "tests/test_docs_consistency.py" and imports_module(rel):
            pass
    (out_dir / "coverage.json").write_text(
        json.dumps({"rows": rows}, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    return covered, not_applicable


def scan_committed_text(text: str) -> None:
    raw = text.encode("utf-8")
    if _BANNED_LIVE_TEST.search(raw):
        raise SystemExit("committed output matches banned live/test secret shape")
    if _BANNED_SUPABASE_PAT.search(raw):
        raise SystemExit("committed output contains a contiguous supabase token shape")
    if "sesslint-wt-" in text or "FOR_WORK" in text:
        raise SystemExit("committed output contains a checkout path")
    if b"\r" in raw:
        raise SystemExit("committed output must be LF only")


def main() -> int:
    mod = load_pinned_detect()
    out_dir = Path(__file__).resolve().parent
    ensure_fixtures(out_dir, mod)
    vectors = vector_specs(mod, out_dir)
    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "detect_py_sha256": DETECT_PY_SHA256,
        "detect_rs_sha256": DETECT_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    payload = payload.replace('"epsilon": 1e-09', '"epsilon": 0.000000001')
    payload = payload.replace('"epsilon": 1e-9', '"epsilon": 0.000000001')
    scan_committed_text(payload)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.adapters.detect parity: constants, sniff "
            "arbitration, thresholds, to_source_block, explicit resolve, "
            "and documented finding fingerprint gaps."
        ),
        "generator": "rust/parity/vectors/adapters.detect/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "detect_py_sha256": DETECT_PY_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/adapters.detect/generate",
    }
    (out_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    covered, not_applicable = write_coverage(out_dir, frozenset(v["id"] for v in vectors))
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    print(f"covered={covered} not_applicable={not_applicable}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
