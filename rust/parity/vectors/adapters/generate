#!/usr/bin/env python3
"""Generate sesslint.adapters package parity vectors (stdlib only; pinned __init__.py)."""

from __future__ import annotations

import ast
import hashlib
import importlib.util
import json
import re
import subprocess
import sys
import tempfile
import types
from pathlib import Path
from typing import Any, Final

SCHEMA = "sesslint.parity-module-vectors/v1"
PYTHON_COMMIT = "e91d50b2ecea57ef4dd900e3b0b87b14946e847e"
ADAPTERS_INIT_PATH = "src/sesslint/adapters/__init__.py"
ADAPTERS_INIT_PY_SHA256 = (
    "78c34a4ebcadb7a743bf48ca1315625e6c56d6524f9b99b83d6f33b299a46c66"
)
ADAPTERS_LIB_RS_SHA256 = (
    "59e542822a7fef006cbf2ee3ed1f08cb0991d2fd515e3174a411adae6bf6de3d"
)
MODULE = "sesslint.adapters"

VERSION_MODULES: Final[tuple[tuple[str, str], ...]] = (
    ("sesslint.adapters.canonical", "SUPPORTED_CANONICAL_VERSIONS"),
    ("sesslint.adapters.claude_code", "SUPPORTED_CLAUDE_VERSIONS"),
