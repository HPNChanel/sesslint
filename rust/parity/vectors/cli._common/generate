@contextlib.contextmanager
def fixed_error_id(hex_id: str):
    original = secrets.token_hex

    def _token_hex(nbytes: int) -> str:
        if nbytes == 4:
            return hex_id
        return original(nbytes)

    secrets.token_hex = _token_hex  # type: ignore[assignment]
    try:
        yield
    finally:
        secrets.token_hex = original  # type: ignore[assignment]


def build_expected(common: types.ModuleType, spec: dict[str, Any]) -> dict[str, Any]:
    kind = spec["type"]
    if kind == "format_display_names":
        items = [
            {"key": key, "display": val}
            for key, val in common.FORMAT_DISPLAY_NAMES.items()
        ]
        return {"entries": items}
    if kind == "handle_internal_error":
        err_spec = spec["err"]
        if err_spec["kind"] == "CliError":
            error = common.CliError(err_spec["exit_code"], err_spec["message"])
        else:
            error = RuntimeError(err_spec["message"])
        args = namespace_from_spec(spec.get("args"))
        hex_id = spec.get("error_id_hex", HEX_ID)
        stdout = io.StringIO()
        stderr = io.StringIO()
        with fixed_error_id(hex_id):
            try:
                with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
                    code = common._handle_internal_error(error, args)
            except common.CliError as raised:
                return {
                    "raises": "CliError",
                    "exit_code": raised.exit_code,
                    "message": raised.message,
                }
        return {
            "exit_code": code,
            "stdout": stdout.getvalue(),
            "stderr": stderr.getvalue(),
            "raises": None,
        }
    if kind == "should_color":
        saved = apply_environ(spec.get("environ") or [])
        try:
            args = namespace_from_spec(spec.get("args"))
            stream = stream_from_spec(spec.get("stream_isatty"))
            value = common.should_color(args, stream)
        finally:
            restore_environ(saved)
        return {"value": value}
    if kind == "rule_codes_arg":
        if steps := spec.get("args_steps"):
            args = argparse.Namespace()
            for step in steps:
                for key, val in step.items():
                    setattr(args, key, val)
        else:
            args = namespace_from_spec(spec.get("args"))
        codes = common._rule_codes_arg(args, spec["name"])
        return {"codes": codes}
    if kind == "output_format":
        args = namespace_from_spec(spec.get("args"))
        return {"format": common._output_format(args)}
    if kind == "load_baseline_arg":
        args = namespace_from_spec(spec.get("args"))
        return {"baseline": common._load_baseline_arg(args)}
    if kind == "write_baseline_arg":
        args = namespace_from_spec(spec.get("args"))

        class _Ctx:
            def info(self, _msg: str) -> None:
                return None

        common._write_baseline_arg(_Ctx(), args, [])
        return {"ok": True}
    if kind == "read_stdin_bytes":
        data = bytes.fromhex(spec["stdin_hex"]) if spec.get("stdin_hex") else b""
        limit = spec.get("max_file_bytes")

        class _Stdin:
            buffer = io.BytesIO(data)

        old = sys.stdin
        try:
            sys.stdin = _Stdin()  # type: ignore[assignment]
            if limit is None:
                out = common._read_stdin_bytes()
            else:
                out = common._read_stdin_bytes(max_file_bytes=limit)
        except ValueError as err:
            return {"raises": "ValueError", "message": str(err)}
        finally:
            sys.stdin = old
        return {"bytes_hex": bytes_hex(out), "raises": None}
    if kind == "default_max_file_bytes":
        from sesslint.io import DEFAULT_MAX_FILE_BYTES

        return {"value": DEFAULT_MAX_FILE_BYTES}
    raise ValueError(f"unknown construct type: {kind}")


def main() -> int:
    common = load_common_module()
    out_dir = Path(__file__).resolve().parent
    vectors: list[dict[str, Any]] = []
    for row in vector_specs():
        construct = dict(row["construct"])
        expected = build_expected(common, construct)
        vectors.append(
            {
                "id": row["id"],
                "construct": construct,
                "expected": expected,
            }
        )

    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "common_py_sha256": COMMON_PY_SHA256,
        "errors_py_sha256": ERRORS_PY_SHA256,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic argparse and stdin fixtures for sesslint.cli._common helper parity."
        ),
        "generator": "rust/parity/vectors/cli._common/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": [text for text in KNOWN_PARITY_GAPS],
    }
    (out_dir / "PROVENANCE.json").write_text(
        json.dumps(provenance, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"wrote {len(vectors)} vectors to {vectors_path}")
    print(f"sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
