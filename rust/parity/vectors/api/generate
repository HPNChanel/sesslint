def imports_sesslint_api(source: str) -> bool:
    tree = ast.parse(source)
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name == "sesslint.api":
                    return True
        elif isinstance(node, ast.ImportFrom) and node.module:
            if node.module == "sesslint.api":
                return True
            if node.module == "sesslint" and any(
                alias.name == "api" for alias in node.names
            ):
                return True
    return False


def list_test_names(rel: str) -> list[str]:
    try:
        source = git_show_bytes(f"{PYTHON_COMMIT}:{rel}").decode("utf-8")
    except subprocess.CalledProcessError:
        work = repo_root() / rel
        source = work.read_text(encoding="utf-8")
    names: list[str] = []
    has_column0 = any(line.startswith("def test_") for line in source.splitlines())
    for line in source.splitlines():
        if has_column0 and line.startswith("def test_"):
            names.append(line.split("(")[0].replace("def ", ""))
        elif not has_column0 and line.startswith("    def test_"):
            names.append(line.split("(")[0].replace("def ", "").strip())
    return names


def discover_api_test_files() -> list[str]:
    listing = subprocess.check_output(
        ["git", "ls-tree", "-r", "--name-only", PYTHON_COMMIT, "tests"],
        cwd=repo_root(),
        text=True,
    )
    rel_paths = [line for line in listing.splitlines() if line.endswith(".py")]
    selected: list[str] = []
    for rel in sorted(rel_paths):
        try:
            source = git_show_bytes(f"{PYTHON_COMMIT}:{rel}").decode("utf-8")
        except subprocess.CalledProcessError:
            continue
        if imports_sesslint_api(source):
            selected.append(rel)
    return selected


def coverage_rows(vector_ids: frozenset[str]) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for rel in discover_api_test_files():
        for name in list_test_names(rel):
            qualified = f"{rel}::{name}"
            needed = COVERED_BY_VECTORS.get(qualified)
            row: dict[str, Any] = {"test": qualified, "status": "not_applicable"}
            if needed is not None and all(item in vector_ids for item in needed):
                row["status"] = "covered"
                row["vector_ids"] = list(needed)
            rows.append(row)
    return rows


def write_outputs(out_dir: Path, vectors: list[dict[str, Any]]) -> str:
    document = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "api_py_sha256": API_PY_SHA256,
        "api_rs_sha256": API_RS_SHA256,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
        "vectors": vectors,
    }
    payload = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(payload)
    vectors_path = out_dir / "vectors.json"
    vectors_path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()

    manifest = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "api_py_sha256": API_PY_SHA256,
        "api_rs_sha256": API_RS_SHA256,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/api/generate",
    }
    manifest_text = json.dumps(manifest, indent=2) + "\n"
    scan_committed_text(manifest_text)
    (out_dir / "manifest.json").write_text(
        manifest_text, encoding="utf-8", newline="\n"
    )

    rows = coverage_rows(frozenset(v["id"] for v in vectors))
    covered = sum(1 for row in rows if row["status"] == "covered")
    not_applicable = sum(1 for row in rows if row["status"] == "not_applicable")
    coverage = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": covered,
        "not_applicable_count": not_applicable,
        "rows": rows,
    }
    coverage_text = json.dumps(coverage, indent=2, ensure_ascii=False) + "\n"
    scan_committed_text(coverage_text)
    (out_dir / "coverage.json").write_text(
        coverage_text, encoding="utf-8", newline="\n"
    )

    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.api parity: module exports, threshold guards, "
            "missing-path errors, repair emit/plan exclusivity, internal-error "
            "envelopes, discover_session_roots with injected home/env, and "
            "validate_session schema failures from pinned Python."
        ),
        "generator": "rust/parity/vectors/api/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": list(KNOWN_PARITY_GAPS),
    }
    prov_text = json.dumps(provenance, indent=2) + "\n"
    scan_committed_text(prov_text)
    (out_dir / "PROVENANCE.json").write_text(
        prov_text, encoding="utf-8", newline="\n"
    )
    return digest


def main() -> int:
    out_dir = Path(__file__).resolve().parent
    symlink_ok = ensure_fixture_homes(out_dir)
    api_mod = load_api_module()
    vectors = build_vectors(api_mod, out_dir, symlink_ok)
    digest = write_outputs(out_dir, vectors)
    rows = coverage_rows(frozenset(v["id"] for v in vectors))
    summary = {
        "vectors": len(vectors),
        "sha256": digest,
        "covered": sum(row["status"] == "covered" for row in rows),
        "not_applicable": sum(row["status"] == "not_applicable" for row in rows),
    }
    print(json.dumps(summary))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
