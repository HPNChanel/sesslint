_BANNED_LIVE_TEST = re.compile(
    rb"(?:^|[^A-Za-z])(sk|rk)_(?:live|test)_[A-Za-z0-9]{16}"
)
_BANNED_SUPABASE_PAT = re.compile(rb"sbp_[0-9a-f]{40}")


def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def verify_pin_hashes() -> None:
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/api.py")
    digest = hashlib.sha256(blob).hexdigest()
    if digest != API_PY_SHA256:
        raise SystemExit(
            f"api.py pin sha256 mismatch: expected {API_PY_SHA256}, got {digest}"
        )
    rs_path = repo_root() / "rust" / "crates" / "cli" / "src" / "api.rs"
    rs_digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if rs_digest != API_RS_SHA256:
        raise SystemExit(
            f"api.rs sha256 mismatch: expected {API_RS_SHA256}, got {rs_digest}"
        )


def scan_committed_text(text: str) -> None:
    raw = text.encode("utf-8")
    if _BANNED_LIVE_TEST.search(raw):
        raise SystemExit("committed output matches banned live/test secret shape")
    if _BANNED_SUPABASE_PAT.search(raw):
        raise SystemExit("committed output contains a contiguous supabase token shape")
    for needle in (
        b"sesslint-wt-",
        b"FOR_WORK",
        b"C:\\",
        b"D:\\",
        b"C:/",
        b"D:/",
    ):
        if needle in raw:
            raise SystemExit(f"committed output contains banned marker {needle!r}")
    if b"\r" in raw:
        raise SystemExit("committed output must be LF only")


def load_api_module() -> Any:
    verify_pin_hashes()
    archive = subprocess.check_output(
        ["git", "archive", "--format=zip", PYTHON_COMMIT, "src/sesslint"],
        cwd=repo_root(),
    )
    tmp = tempfile.mkdtemp(prefix="sesslint-pinned-api-par-")
    zipfile.ZipFile(io.BytesIO(archive)).extractall(tmp)
    sys.path.insert(0, str(Path(tmp) / "src"))
    import importlib

    return importlib.import_module("sesslint.api")


def normalize_message(message: str) -> str:
    return message.replace("\\", "/")


def raises_payload(exc: BaseException) -> dict[str, Any]:
    return {
        "kind": "raises",
        "exc_type": type(exc).__name__,
        "message": normalize_message(str(exc)),
    }


def ok_payload(payload: dict[str, Any]) -> dict[str, Any]:
    return {"kind": "ok", **payload}


def resolve_path(out_dir: Path, rel: str) -> Path:
    text = rel.replace("\\", "/")
    if text.startswith("fixture_homes/"):
        return out_dir / text
    return Path(text)


def minimal_repair_plan(api_mod: Any) -> Any:
    from sesslint.repair.planner import Loss

    return api_mod.RepairPlan(
        source_hash="0" * 64,
        profile="neutral",
        steps=(),
        blocked=(),
        loss_accounting=Loss(preview={}),
        fingerprint="f" * 64,
    )


def resolve_env_path(out_dir: Path, value: str) -> str:
    stripped = value.strip()
    if not stripped or stripped == "\u001c":
        return value
    if stripped.startswith("fixture_homes/"):
        return str(out_dir / stripped)
    candidate = out_dir / "fixture_homes" / stripped
    if candidate.exists():
        return str(candidate)
    return value


def root_item(root: Any, homes_root: Path) -> dict[str, Any]:
    path = root.path
    try:
        path_text = path.relative_to(homes_root).as_posix()
    except ValueError:
        path_text = path.as_posix().replace("\\", "/")
    return {
        "agent": root.agent,
        "path": path_text,
        "exists": bool(root.exists),
        "source": root.source,
    }


def execute_call(api_mod: Any, out_dir: Path, target: str, args: dict[str, Any]) -> dict[str, Any]:
    if target == "check_file":
        path = resolve_path(out_dir, str(args["path"]))
        try:
            api_mod.check_file(
                path,
                confidence_min=args.get("confidence_min"),
                margin_min=args.get("margin_min"),
                max_file_bytes=int(args.get("max_file_bytes", 104_857_600)),
                timestamp_skew_ms=args.get("timestamp_skew_ms"),
                profile=args.get("profile", "neutral"),
            )
        except Exception as exc:
            return raises_payload(exc)
        raise SystemExit(f"{target} expected raise, got success for {args}")

    if target == "check_bytes":
        data = base64.b64decode(str(args["data_b64"]))
        try:
            api_mod.check_bytes(
                data,
                virtual_path=str(args.get("virtual_path", MISSING_FILE)),
                confidence_min=args.get("confidence_min"),
                margin_min=args.get("margin_min"),
                max_input_bytes=args.get("max_input_bytes"),
                max_file_bytes=int(args.get("max_file_bytes", 104_857_600)),
                timestamp_skew_ms=args.get("timestamp_skew_ms"),
            )
        except Exception as exc:
            return raises_payload(exc)
        raise SystemExit(f"{target} expected raise, got success for {args}")

    if target == "check_dir":
        path = resolve_path(out_dir, str(args["path"]))
        try:
            api_mod.check_dir(
                path,
                max_files=int(args["max_files"]),
                max_bytes=int(args["max_bytes"]),
                confidence_min=args.get("confidence_min"),
                margin_min=args.get("margin_min"),
            )
        except Exception as exc:
            return raises_payload(exc)
        raise SystemExit(f"{target} expected raise, got success for {args}")

    if target == "check":
        path = resolve_path(out_dir, str(args["path"]))
        try:
            api_mod.check(
                path,
                max_files=int(args.get("max_files", 10_000)),
                max_bytes=int(args.get("max_bytes", 1_073_741_824)),
                max_file_bytes=int(args.get("max_file_bytes", 104_857_600)),
                confidence_min=args.get("confidence_min"),
                margin_min=args.get("margin_min"),
            )
        except Exception as exc:
            return raises_payload(exc)
        raise SystemExit(f"{target} expected raise, got success for {args}")

    if target == "repair":
        source = resolve_path(out_dir, str(args["source"]))
        plan_path = args.get("plan_path")
        plan_path_resolved = (
            resolve_path(out_dir, str(plan_path)) if plan_path is not None else None
        )
        plan = minimal_repair_plan(api_mod) if args.get("with_plan") else None
        try:
            api_mod.repair(
                source,
                resolve_path(out_dir, str(args["output"]))
                if args.get("output")
                else None,
                policy=args.get("policy", "conservative"),
                format=args.get("format"),
                profile=args.get("profile", "neutral"),
                plan_path=plan_path_resolved,
                plan=plan,
                dry_run=bool(args.get("dry_run", True)),
                emit=str(args.get("emit", "auto")),
            )
        except Exception as exc:
            return raises_payload(exc)
        raise SystemExit(f"{target} expected raise, got success for {args}")

    if target == "plan":
        path = resolve_path(out_dir, str(args["path"]))
        try:
            api_mod.plan(
                path,
                policy=str(args.get("policy", "conservative")),
                format=args.get("format"),
                profile=str(args.get("profile", "neutral")),
                acknowledge_side_effects=bool(args.get("acknowledge_side_effects", False)),
            )
        except Exception as exc:
            return raises_payload(exc)
        raise SystemExit(f"{target} expected raise, got success for {args}")

    if target == "validate_session":
        path = resolve_path(out_dir, str(args["path"]))
        try:
            api_mod.validate_session(path)
        except Exception as exc:
            return raises_payload(exc)
        raise SystemExit(f"{target} expected raise, got success for {args}")

    if target == "build_internal_error_envelope":
        class SyntheticInternal(Exception):
            def __str__(self) -> str:
                return "Something unexpected broke"

        err = SyntheticInternal()
        error_id = args.get("error_id")
        if error_id is None and "omit_error_id" in args:
            try:
                api_mod.build_internal_error_envelope(err, None)
            except Exception as exc:
                return raises_payload(exc)
            raise SystemExit("expected omitted error_id to mint id")
        try:
            envelope = api_mod.build_internal_error_envelope(err, error_id)
        except Exception as exc:
            return raises_payload(exc)
        return ok_payload({"envelope": envelope})

    if target == "discover_session_roots":
        home = out_dir / "fixture_homes" / str(args["home"])
        env_items = args.get("env") or []
        env: dict[str, str] = {}
        for key, value in env_items:
            env[str(key)] = resolve_env_path(out_dir, str(value))
        agents = args.get("agents")
        if agents is not None:
            agents = [str(item) for item in agents]
        try:
            roots = api_mod.discover_session_roots(
                agents,
                env=env,
                home=home,
                include_archived=bool(args.get("include_archived", False)),
            )
        except Exception as exc:
            return raises_payload(exc)
        homes_root = out_dir / "fixture_homes"
        return ok_payload({"roots": [root_item(item, homes_root) for item in roots]})

    raise SystemExit(f"unknown call target: {target}")


def ensure_fixture_homes(out_dir: Path) -> bool:
    """Return False if symlink vectors must be skipped."""
    homes = out_dir / "fixture_homes"
    if homes.exists():
        shutil.rmtree(homes)
    homes.mkdir(parents=True, exist_ok=True)

    existing = homes / "synthetic_existing" / "session.jsonl"
    existing.parent.mkdir(parents=True, exist_ok=True)
    existing.write_text("not-valid-session\n", encoding="utf-8", newline="\n")

    invalid = homes / "invalid-session" / "invalid.jsonl"
    invalid.parent.mkdir(parents=True, exist_ok=True)
    invalid.write_text("not-valid-jsonl\n", encoding="utf-8", newline="\n")

    default_home = homes / "discover-default" / "home"
    (default_home / ".claude" / "projects").mkdir(parents=True)
    (default_home / ".codex" / "sessions").mkdir(parents=True)
    (default_home / ".claude" / "projects" / "child.txt").write_bytes(b"")

    env_home = homes / "discover-env" / "home"
    (env_home / ".claude" / "projects").mkdir(parents=True)
    (env_home / ".codex" / "sessions").mkdir(parents=True)
    ccfg = homes / "discover-env" / "ccfg" / "projects"
    ccfg.mkdir(parents=True)
    cx = homes / "discover-env" / "cx" / "sessions"
    cx.mkdir(parents=True)

    classify_home = homes / "discover-classify" / "home"
    classify_home.mkdir(parents=True)
    (classify_home / ".codex").mkdir(parents=True)
    (classify_home / ".codex" / "sessions").write_bytes(b"")
    real_projects = homes / "discover-classify" / "real-projects"
    real_projects.mkdir(parents=True)
    (classify_home / ".claude").mkdir(parents=True)
    link = classify_home / ".claude" / "projects"
    symlink_ok = True
    try:
        if os.name == "nt":
            os.symlink(real_projects, link, target_is_directory=True)
        else:
            os.symlink(real_projects, link)
    except OSError:
        symlink_ok = False

    archived_home = homes / "discover-archived" / "home"
    (archived_home / ".codex" / "archived_sessions").mkdir(parents=True)
    (archived_home / ".claude" / "projects").mkdir(parents=True)
    (archived_home / ".claude" / "archived_sessions").mkdir(parents=True)

    env_archived = homes / "discover-env-archived" / "home"
    (env_archived / ".codex" / "sessions").mkdir(parents=True)
    cx_arch = homes / "discover-env-archived" / "cx"
    (cx_arch / "archived_sessions").mkdir(parents=True)

    absent_home = homes / "discover-absent" / "home"
    absent_home.mkdir(parents=True)

    return symlink_ok


def add_call(
    vectors: list[dict[str, Any]],
    api_mod: Any,
    out_dir: Path,
    vector_id: str,
    target: str,
    args: dict[str, Any],
) -> None:
    expected = execute_call(api_mod, out_dir, target, args)
    vectors.append(
        {
            "id": vector_id,
            "construct": {"type": "call", "target": target, "args": args},
            "expected": expected,
        }
    )


