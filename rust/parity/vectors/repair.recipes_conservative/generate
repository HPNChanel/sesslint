def run_expected(cons: Any, construct: dict[str, Any]) -> dict[str, Any]:
    import sesslint.repair.registry as reg  # noqa: WPS433
    kind = construct["type"]
    if kind == "module_all":
        return {"mode": "comparable", "pin": {"names": list(cons.__all__)}}
    if kind == "registration_matrix":
        return run_registration(cons, reg)
    if kind == "register_all":
        return run_register_all(cons, reg)
    if kind == "fixture_apply":
        return run_fixture_apply(
            cons,
            construct["fixture"],
            construct["fn"],
            loss=construct.get("loss", False),
        )
    if kind == "fixture_parent_restore":
        return run_fixture_parent(cons, construct["fixture"])
    if kind == "apply":
        spec = dict(construct)
        return run_apply(cons, spec)
    raise SystemExit(f"unknown {kind}")


def discover_coverage(vector_ids: set[str]) -> list[dict[str, Any]]:
    text = git_show_bytes(f"{PYTHON_COMMIT}:{TEST_FILE}").decode("utf-8")
    rows: list[dict[str, Any]] = []
    col0 = re.compile(r"^def (test_\w+)")
    for line in text.splitlines():
        m = col0.match(line)
        if not m:
            continue
        name = m.group(1)
        key = f"{TEST_FILE}::{name}"
        vid = COVERED.get(name)
        status = "covered" if vid and vid in vector_ids else "not_applicable"
        row: dict[str, Any] = {
            "test": key,
            "column": "column_0",
            "status": status,
            "vector_id": vid if status == "covered" else None,
            "note": "",
        }
        rows.append(row)
    return rows


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    cons = load_mod()
    vectors: list[dict[str, Any]] = []
    for spec in vector_specs():
        expected = run_expected(cons, spec["construct"])
        vectors.append({"id": spec["id"], "construct": spec["construct"], "expected": expected})
    doc = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "recipes_conservative_py_sha256": PY_SHA,
        "recipes_conservative_rs_sha256": RS_SHA,
        "known_parity_gaps": [
            f"{GAP}: Python affected_region_* returns sesslint.policy.abstention.AffectedRegion. "
            "Rust returns AffectedRegionUnavailable; parity asserts the seam only.",
        ],
        "vectors": vectors,
    }
    payload = json.dumps(doc, indent=2, ensure_ascii=False) + "\n"
    path = OUT / "vectors.json"
    path.write_text(payload, encoding="utf-8", newline="\n")
    digest = hashlib.sha256(payload.encode()).hexdigest()
    vids = {v["id"] for v in vectors}
    cov = discover_coverage(vids)
    cov_doc = {
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "covered_count": sum(1 for r in cov if r["status"] == "covered"),
        "not_applicable_count": sum(1 for r in cov if r["status"] == "not_applicable"),
        "rows": cov,
    }
    (OUT / "coverage.json").write_text(json.dumps(cov_doc, indent=2) + "\n", encoding="utf-8", newline="\n")
    prov = {
        "contains_real_data": False,
        "description": "Synthetic sesslint.repair.recipes_conservative parity vectors.",
        "generator": "rust/parity/vectors/repair.recipes_conservative/generate",
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
        "known_parity_gaps": doc["known_parity_gaps"],
    }
    (OUT / "PROVENANCE.json").write_text(json.dumps(prov, indent=2) + "\n", encoding="utf-8", newline="\n")
    man = {
        "schema": SCHEMA,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "recipes_conservative_rs_sha256": RS_SHA,
        "vector_count": len(vectors),
        "vectors_sha256": digest,
        "generator": "rust/parity/vectors/repair.recipes_conservative/generate",
        "known_parity_gaps": doc["known_parity_gaps"],
    }
    (OUT / "manifest.json").write_text(json.dumps(man, indent=2) + "\n", encoding="utf-8", newline="\n")
    print(len(vectors), digest)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
