def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=ROOT)


def fullname_for(path: str) -> str:
    return path.removeprefix("src/").removesuffix(".py").replace("/", ".")


def ensure_pkg(name: str) -> None:
    if name not in sys.modules:
        mod = types.ModuleType(name)
        mod.__path__ = []
        sys.modules[name] = mod


def exec_blob(blob: bytes, fullname: str) -> types.ModuleType:
    with tempfile.NamedTemporaryFile("wb", suffix=".py", delete=False) as handle:
        handle.write(blob)
        tmp = handle.name
    spec = importlib.util.spec_from_file_location(fullname, tmp)
    if spec is None or spec.loader is None:
        raise SystemExit(f"spec failed {fullname}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[fullname] = mod
    try:
        spec.loader.exec_module(mod)
    finally:
        Path(tmp).unlink(missing_ok=True)
    parent = fullname.rsplit(".", 1)[0] if "." in fullname else ""
    if parent:
        parent_mod = sys.modules.setdefault(parent, types.ModuleType(parent))
        setattr(parent_mod, fullname.split(".")[-1], mod)
    return mod


def load_mod() -> Any:
    rs = ROOT / "rust/crates/repair/src/recipes_conservative.rs"
    if hashlib.sha256(rs.read_bytes()).hexdigest() != RS_SHA:
        raise SystemExit("rs sha mismatch")
    py_blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/repair/recipes_conservative.py")
    if hashlib.sha256(py_blob).hexdigest() != PY_SHA:
        raise SystemExit("py pin sha mismatch")
    for rel in PIN_CLOSURE:
        if rel == "repair/recipes_conservative.py":
            continue
        path = f"src/sesslint/{rel}"
        blob = git_show_bytes(f"{PYTHON_COMMIT}:{path}")
        fullname = fullname_for(path)
        parts = fullname.split(".")
        for i in range(1, len(parts)):
            ensure_pkg(".".join(parts[:i]))
        exec_blob(blob, fullname)
    ensure_pkg("sesslint.repair")
    return exec_blob(py_blob, "sesslint.repair.recipes_conservative")


def tagged(value: Any) -> dict[str, Any]:
    if value is None:
        return {"t": "null"}
    if isinstance(value, bool):
        return {"t": "bool", "v": value}
    if isinstance(value, int) and not isinstance(value, bool):
        return {"t": "int", "v": value}
    if isinstance(value, str):
        return {"t": "str", "v": value}
    if isinstance(value, float):
        return {"t": "float", "v": value}
    if isinstance(value, dict):
        return {"t": "map", "entries": [[k, tagged(v)] for k, v in value.items()]}
    if isinstance(value, list):
        return {"t": "list", "items": [tagged(v) for v in value]}
    return {"t": "other", "v": repr(value)}


def ev_dict(entries: dict[str, Any]) -> dict[str, Any]:
    return {"t": "mapping", "entries": [[k, tagged(v)] for k, v in entries.items()]}


def step_dict(*, recipe: str, target_index: Any, params: Any, seq: int = 0, fp: str = "f0") -> dict[str, Any]:
    if isinstance(target_index, int):
        ti = tagged(target_index)
    elif target_index is None:
        ti = {"t": "null"}
    else:
        ti = tagged(target_index)
    if params == "not_mapping":
        pm = {"t": "not_mapping"}
    elif isinstance(params, dict):
        pm = {"t": "map", "entries": [[k, tagged(v)] for k, v in params.items()]}
    else:
        pm = {"t": "map", "entries": []}
    return {
        "seq": seq,
        "recipe": recipe,
        "target_finding_fp": fp,
        "target_index": ti,
        "params": pm,
    }


def load_fixture(rel: str) -> Any:
    raw = git_show_bytes(f"{PYTHON_COMMIT}:{rel}")
    return json.loads(raw.decode("utf-8"))


def events_from_json(events: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [dict(e) for e in events]


def plan_step_from(spec: dict[str, Any]) -> Any:
    from sesslint.repair.planner import PlanStep  # noqa: WPS433

    ti = spec["target_index"]
    if ti.get("t") == "int":
        target = ti["v"]
    elif ti.get("t") == "null":
        target = None
    elif ti.get("t") == "bool":
        target = ti["v"]
    else:
        target = None
    params: Any = {}
    pm = spec["params"]
    if pm.get("t") == "map":
        params = {k: _decode(v) for k, v in pm["entries"]}
    elif pm.get("t") == "not_mapping":
        params = "not-a-mapping"
    return PlanStep(
        seq=spec.get("seq", 0),
        recipe=spec["recipe"],
        target_finding_fp=spec.get("target_finding_fp", "f0"),
        target_index=target,
        params=params,
    )


def _decode(node: Any) -> Any:
    if not isinstance(node, dict) or "t" not in node:
        return node
    k = node["t"]
    if k == "null":
        return None
    if k == "bool":
        return node["v"]
    if k == "int":
        return node["v"]
    if k == "str":
        return node["v"]
    if k == "map":
        return {a: _decode(b) for a, b in node["entries"]}
    return node.get("v")


def snap_events(events: list[dict[str, Any]]) -> dict[str, Any]:
    return {
        "ids": [e.get("id") for e in events],
        "len": len(events),
        "parents": {e.get("id"): e.get("parent_id") for e in events if e.get("id")},
    }


def run_apply(cons: Any, spec: dict[str, Any]) -> dict[str, Any]:
    fn = getattr(cons, spec["fn"])
    events = events_from_json(spec["events"])
    step = plan_step_from(spec["step"])
    try:
        out = fn(events, step)
        pin: dict[str, Any] = {"mode": "ok", **snap_events(out)}
        if "extra" in spec:
            for key, expr in spec["extra"].items():
                if key == "loss_count":
                    pin[key] = len(events) - len(out)
                elif key == "child_parent":
                    cid, pid = expr
                    child = next(e for e in out if e.get("id") == cid)
                    pin["child_parent"] = {"id": cid, "parent_id": child.get("parent_id")}
                elif key == "ids_exact":
                    pin["ids"] = [e["id"] for e in out]
        return {"mode": "comparable", "pin": pin}
    except cons.PreconditionFailed as exc:
        return {
            "mode": "comparable",
            "pin": {
                "mode": "precondition",
                "error_type": "PreconditionFailed",
                "message": str(exc),
            },
        }


def run_registration(cons: Any, reg: Any) -> dict[str, Any]:
    from sesslint.codes import SL003, SL004, SL005, SL101, SL104, SL108, SL203  # noqa: WPS433

    reg.clear_registry()
    cons.register_all()
    recipes = reg.list_recipes()
    names = [r.name for r in recipes]
    snap: dict[str, Any] = {"recipe_count": len(recipes), "names": names, "recipes": {}}
    for name in (
        "terminal-suffix-discard",
        "identical-duplicate-collapse",
        "proven-unique-parent-restore",
        "compaction-projection-reunion",
        "duplicate-projection-removal",
        "identical-duplicate-drop",
        "seq-renumber",
    ):
        r = reg.get_recipe(name)
        assert r is not None
        snap["recipes"][name] = {
            "handles": list(r.handles),
            "preconditions": list(r.preconditions),
            "lossy": r.lossy,
            "salvage_only": r.salvage_only,
        }
    suffix_r = reg.get_recipe("terminal-suffix-discard")
    collapse_r = reg.get_recipe("identical-duplicate-collapse")
    restore_r = reg.get_recipe("proven-unique-parent-restore")
    reunion_r = reg.get_recipe("compaction-projection-reunion")
    removal_r = reg.get_recipe("duplicate-projection-removal")
    drop_r = reg.get_recipe("identical-duplicate-drop")
    renum_r = reg.get_recipe("seq-renumber")
    snap["recipes_for"] = {
        "SL003": [r.name for r in reg.recipes_for(SL003)],
        "SL004": [r.name for r in reg.recipes_for(SL004)],
        "SL005": [r.name for r in reg.recipes_for(SL005)],
        "SL104": [r.name for r in reg.recipes_for(SL104)],
        "SL108": [r.name for r in reg.recipes_for(SL108)],
        "SL203": [r.name for r in reg.recipes_for(SL203)],
        "SL101": [r.name for r in reg.recipes_for(SL101)],
    }
    assert len(recipes) == 7
    assert suffix_r and collapse_r and restore_r and reunion_r and removal_r and drop_r and renum_r
    return {"mode": "comparable", "pin": snap}


def run_register_all(cons: Any, reg: Any) -> dict[str, Any]:
    reg.clear_registry()
    cons.register_all()
    cons.register_all()
    return {
        "mode": "comparable",
        "pin": {"recipe_count": len(reg.list_recipes())},
    }


def run_fixture_parent(cons: Any, rel: str) -> dict[str, Any]:
    data = load_fixture(rel)
    pin: dict[str, Any] = {}
    happy = data["happy_path"]
    step_h = plan_step_from(step_dict(**_step_from_fixture(happy["step"])))
    out_h = cons.apply_proven_unique_parent_restore(happy["input_events"], step_h)
    pin["happy"] = snap_events(out_h)
    ambig = data["refusal_ambiguous"]
    step_a = plan_step_from(step_dict(**_step_from_fixture(ambig["step"])))
    try:
        cons.apply_proven_unique_parent_restore(ambig["input_events"], step_a)
        raise SystemExit("expected ambiguous refusal")
    except cons.PreconditionFailed as exc:
        pin["ambiguous"] = {"message": str(exc)}
    return {"mode": "comparable", "pin": pin}


def _step_from_fixture(step: dict[str, Any]) -> dict[str, Any]:
    return {
        "recipe": step["recipe"],
        "target_index": step["target_index"],
        "params": step.get("params", {}),
        "seq": step.get("seq", 0),
        "fp": step.get("target_finding_fp", "f0"),
    }


def run_fixture_apply(cons: Any, rel: str, fn_name: str, *, loss: bool = False) -> dict[str, Any]:
    data = load_fixture(rel)
    step = plan_step_from(step_dict(**_step_from_fixture(data["step"])))
    fn = getattr(cons, fn_name)
    out = fn(data["input_events"], step)
    pin = snap_events(out)
    if loss:
        pin["loss_count"] = len(data["input_events"]) - len(out)
    return {"mode": "comparable", "pin": pin}


