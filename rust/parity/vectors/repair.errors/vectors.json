  "schema": "sesslint.parity-module-vectors/v1",
  "module": "sesslint.repair.errors",
  "python_commit": "e91d50b2ecea57ef4dd900e3b0b87b14946e847e",
  "errors_rs_sha256": "79a30b309327cda120e14365d85339bbb6df21e851bb297f13037681a152ce16",
  "known_parity_gaps": [
    "Scaffold repair::error::RepairError (Unsupported) is not part of this hierarchy; parity vectors use repair::errors types only.",
    "Python isinstance(exc, SesslintError) on the repair hierarchy; Rust uses an explicit is_sesslint_error probe tied to model::errors::SesslintError — parity is on the boolean, not on converting into SesslintError::Generic.",
    "VendorProjectionRefused: Python always sets instance code VENDOR_PROJECTION_REFUSED via __init__; there is no code= override vector — parity not required on a non-existent path."
  ],
  "vectors": [
    {
      "id": "module_all_export_order",
      "construct": {
        "type": "module_all"
      },
