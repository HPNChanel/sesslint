def tag(x):
    if x is None:
        return ["null"]
    if type(x) is bool:
        return ["bool", x]
    if type(x) is int:
        return ["int", str(x)]
    if type(x) is float:
        return ["float", struct.pack(">d", x).hex()]
    if type(x) is str:
        return ["str", x]
    if type(x) is list:
        return ["array", [tag(v) for v in x]]
    return ["object", {k: tag(v) for k, v in x.items()}]


def pred(p):
    if p is None:
        return None
    return dict(field=p.field, op=p.op, value=tag(p.value), values=[tag(v) for v in p.values])


def cond(c):
    names = [
        "id",
        "type",
        "advisory",
        "disabled",
        "description",
        "field",
        "source_field",
        "kind",
        "allow_null",
        "allow_empty",
        "basis",
    ]
    out = {k: getattr(c, k) for k in names}
    out.update(
        values=[tag(v) for v in c.values],
        normalize=list(c.normalize),
        minimum=struct.pack(">d", c.minimum).hex() if c.minimum is not None else None,
        maximum=struct.pack(">d", c.maximum).hex() if c.maximum is not None else None,
        when=[pred(p) for p in c.when],
        conditions=[cond(v) for v in c.conditions],
    )
    return out


def contract(c):
    return dict(
        name=c.name,
        version=c.version,
        description=c.description,
        source_key=list(c.source_key),
        target_key=list(c.target_key),
        eligibility=[pred(p) for p in c.eligibility],
        due=dict(source_time_field=c.due.source_time_field, within_seconds=c.due.within_seconds)
        if c.due
        else None,
        conditions=[cond(v) for v in c.conditions],
        sha256=c.sha256,
        warnings=list(c.warnings()),
        fields=sorted(c.relevant_source_fields()),
        iter=[v.id for v in c.iter_conditions()],
    )


