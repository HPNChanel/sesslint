            if op == "file":
                path = source / f"synthetic-{case['id']}.json"
                spec = case["file"]
                if not spec.get("missing"):
                    data = b" " * spec["spaces"] if "spaces" in spec else bytes.fromhex(spec["hex"])
                    path.write_bytes(data)
                result = {"output": contract(c.load_contract(path))}
            else:
                try:
                    raw = c.parse_strict_json(case["raw"])
                except json.JSONDecodeError:
                    result = {"error": "syntax"}
                except ValueError as e:
                    result = {"error": str(e)}
                else:
                    if op == "contract":
                        result = {"output": contract(c.contract_from_dict(raw))}
                    else:
                        if op == "key":
                            out = list(c._key_fields(raw, "w", p))
                        elif op == "condition":
                            v = c._condition(
                                raw, "w", p, nested=case["nested"], has_due=case["has_due"]
                            )
                            out = cond(v) if v is not None and not p.items else None
                        elif op == "parse":
                            out = tag(raw)
                        elif op == "field":
                            out = c._field(raw, "field", "w", p)
                        elif op == "text":
                            out = c._text(raw, "text", "w", p)
                        elif op == "normalize":
                            out = list(c._normalize(raw, "w", p))
                        elif op == "unknown":
                            out = c._unknown_keys(raw, frozenset({"known"}), "w", p)
                        elif op == "values":
                            out = [tag(v) for v in c._values(raw, "w", p)]
                        elif op == "predicate":
                            out = pred(c._predicate(raw, "w", p))
                        elif op == "predicates":
                            out = [pred(v) for v in c._predicates(raw, "w", p)]
                        elif op == "bound":
                            v = c._bound(raw, "min", "w", p)
                            out = struct.pack(">d", v).hex() if v is not None else None
                        else:
                            raise AssertionError(op)
                        result = {"output": out, "problems": p.items}
        except c.ContractError as e:
            result = {"error": "ContractError", "problems": list(e.problems)}
        except OSError:
            result = {"error": "OSError"}
        except Exception as e:
            result = {"error": type(e).__name__}
        if "assert_contains" in case:
            assert any(case["assert_contains"] in p for p in result["problems"])
        results.append(result)

