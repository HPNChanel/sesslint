def file_case(data=None, *, spaces=None, missing=False):
    spec = (
        {"missing": True}
        if missing
        else {"spaces": spaces}
        if spaces is not None
        else {"hex": data.hex()}
    )
    cases.append(dict(id=len(cases), op="file", file=spec))
    return len(cases) - 1


