{
  "schema": "sesslint.parity-module-vectors/v1",
  "module": "sesslint.bundle",
  "python_commit": "e91d50b2ecea57ef4dd900e3b0b87b14946e847e",
  "bundle_py_sha256": "3c5f7df93eaa410d6ccfc83c17b49ac1f85e45e2007fc9076635bec40965b133",
  "bundle_rs_sha256": "30a0ecf9c7c6ffc6ca001d1a31cfa158fc514adcfab891ff0617303148529564",
  "known_parity_gaps": [
    "GAP-bundle-build: build_bundle runs validate_detection_thresholds then path, hash, check_file, and render_json in Python; Rust returns sesslint.adapters.detect.validate_detection_thresholds is not available and builds no Bundle.",
    "GAP-bundle-schema-path: get_bundle_schema_path and load_bundle_schema import sesslint._resources.schema_path in Python; Rust returns sesslint._resources.schema_path is not available.",
    "GAP-bundle-version-info: _build_created_by calls sesslint._version.get_version_info in Python; Rust returns sesslint._version.get_version_info is not available.",
    "GAP-bundle-short-hash: _sanitize_evidence imports sesslint.report.short_hash in Python; Rust returns sesslint.report.short_hash is not available.",
    "GAP-bundle-safe-discriminator: _extract_kinds_fallback calls safe_discriminator on string kinds in Python; Rust returns sesslint.adapters.safe_value.safe_discriminator is not available.",
    "GAP-bundle-integration: CLI, api.build_bundle, and schema validation tests do not map to isolated bundle.rs helpers byte-for-byte here."
  ],
  "vectors": [
    {
      "id": "module_constants",
      "construct": {
        "type": "module_constants"
      },
      "expected": {
        "BUNDLE_SCHEMA_VERSION": "sesslint.bundle/v1",
        "FIXTURE_TEMPLATE_sha256": "10d54eb7416be822c1b29e46bcb039c7e685d636a62c07e97a6361cc53cec2d7",
        "DEFAULT_JSON_INDENT": 2,
        "MAX_PROBE_LINES": 1000,
        "RECORD_CHUNK_BYTES": 65536,
        "MAX_READLINE_BYTES": 1000000,
        "python_exports": [
          "BUNDLE_SCHEMA_VERSION",
          "Bundle",
          "FIXTURE_TEMPLATE",
          "build_bundle",
          "get_bundle_schema_path",
          "load_bundle_schema"
        ]
      }
    },
    {
      "id": "sanitize_simple_path",
      "construct": {
        "type": "sanitize_remediation",
        "remediation": "run 'sesslint repair path/to/file'",
        "basename": "file.jsonl"
      },
      "expected": {
        "text": "run 'sesslint repair file.jsonl'"
      }
    },
    {
      "id": "sanitize_two_clauses",
      "construct": {
        "type": "sanitize_remediation",
        "remediation": "please run 'sesslint repair a.json ; run 'sesslint repair b.json",
        "basename": "base.name"
      },
      "expected": {
        "text": "please run 'sesslint repair base.name ; run 'sesslint repair base.name"
      }
    },
    {
      "id": "sanitize_quote_in_basename",
      "construct": {
        "type": "sanitize_remediation",
        "remediation": "run 'sesslint repair old",
        "basename": "base'.name"
      },
      "expected": {
        "text": "run 'sesslint repair base'.name"
      }
    },
    {
      "id": "sanitize_only_first_token",
      "construct": {
        "type": "sanitize_remediation",
        "remediation": "run 'sesslint repair foo bar",
        "basename": "B"
      },
      "expected": {
        "text": "run 'sesslint repair B bar"
      }
    },
    {
      "id": "sanitize_no_whitespace_after_prefix",
