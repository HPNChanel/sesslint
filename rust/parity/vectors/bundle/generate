    "3c5f7df93eaa410d6ccfc83c17b49ac1f85e45e2007fc9076635bec40965b133"
)
BUNDLE_RS_SHA256 = (
    "30a0ecf9c7c6ffc6ca001d1a31cfa158fc514adcfab891ff0617303148529564"
)
MODULE = "sesslint.bundle"
RECORD_CHUNK_BYTES = 65536
FIXTURE_TEMPLATE_SHA256 = (
    "10d54eb7416be822c1b29e46bcb039c7e685d636a62c07e97a6361cc53cec2d7"
)

COVERAGE_TEST_FILES: Final[tuple[str, ...]] = (
    "tests/test_bundle.py",
    "tests/test_plan_bundle_schemas.py",
    "tests/test_wave1_correctness.py",
)

KNOWN_PARITY_GAPS: Final[tuple[str, ...]] = (
    "GAP-bundle-build: build_bundle runs validate_detection_thresholds then path, hash, "
    "check_file, and render_json in Python; Rust returns "
    "sesslint.adapters.detect.validate_detection_thresholds is not available and builds no Bundle.",
    "GAP-bundle-schema-path: get_bundle_schema_path and load_bundle_schema import "
    "sesslint._resources.schema_path in Python; Rust returns "
    "sesslint._resources.schema_path is not available.",
    "GAP-bundle-version-info: _build_created_by calls sesslint._version.get_version_info in "
    "Python; Rust returns sesslint._version.get_version_info is not available.",
    "GAP-bundle-short-hash: _sanitize_evidence imports sesslint.report.short_hash in Python; "
    "Rust returns sesslint.report.short_hash is not available.",
    "GAP-bundle-safe-discriminator: _extract_kinds_fallback calls safe_discriminator on string "
    "kinds in Python; Rust returns sesslint.adapters.safe_value.safe_discriminator is not available.",
    "GAP-bundle-integration: CLI, api.build_bundle, and schema validation tests do not map to "
    "isolated bundle.rs helpers byte-for-byte here.",
