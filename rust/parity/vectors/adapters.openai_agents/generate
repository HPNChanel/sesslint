def repo_root() -> Path:
    return Path(__file__).resolve().parents[4]


def git_show(rel: str) -> str:
    return subprocess.check_output(
        ["git", "show", f"{PYTHON_COMMIT}:{rel}"], cwd=repo_root(), text=True
    )


def git_show_bytes(rev_path: str) -> bytes:
    return subprocess.check_output(["git", "show", rev_path], cwd=repo_root())


def verify_pin_hashes() -> None:
    blob = git_show_bytes(f"{PYTHON_COMMIT}:src/sesslint/adapters/openai_agents.py")
    digest = hashlib.sha256(blob).hexdigest()
    if digest != OPENAI_PY_SHA256:
        raise SystemExit(
            f"openai_agents.py pin sha256 mismatch: expected {OPENAI_PY_SHA256}, got {digest}"
        )
    rs_path = repo_root() / "rust" / "crates" / "adapters" / "src" / "openai_agents.rs"
    rs_digest = hashlib.sha256(rs_path.read_bytes()).hexdigest()
    if rs_digest != OPENAI_RS_SHA256:
        raise SystemExit(
            "openai_agents.rs sha256 mismatch: "
            f"expected {OPENAI_RS_SHA256}, got {rs_digest}"
        )


def mod_to_paths(mod: str) -> list[str]:
    tail = mod[len("sesslint.") :].replace(".", "/")
    return [f"src/sesslint/{tail}.py", f"src/sesslint/{tail}/__init__.py"]


def discover_imports(source: str) -> set[str]:
    found: set[str] = set()
    tree = ast.parse(source)
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name.startswith("sesslint."):
                    found.add(alias.name)
        elif isinstance(node, ast.ImportFrom) and node.module:
            if node.module.startswith("sesslint."):
                found.add(node.module)
    return found


def closure(root_mod: str) -> list[str]:
    queue = [root_mod]
    seen: set[str] = set()
    order: list[str] = []
    while queue:
        mod = queue.pop(0)
        if mod in seen:
            continue
        seen.add(mod)
        source = None
        for candidate in mod_to_paths(mod):
            try:
                source = git_show(candidate)
                break
            except subprocess.CalledProcessError:
                continue
        if source is None:
            continue
        order.append(mod)
        for imp in discover_imports(source):
            if imp not in seen:
                queue.append(imp)
    return order


def ensure_packages() -> None:
    for pkg in (
        "sesslint",
        "sesslint.adapters",
        "sesslint.checks",
        "sesslint.io",
        "sesslint.scan",
        "sesslint.repair",
        "sesslint.profiles",
    ):
        mod = types.ModuleType(pkg)
        mod.__path__ = []  # type: ignore[attr-defined]
        sys.modules[pkg] = mod


def load_module(mod: str, *, temp_main: bool = False) -> None:
    source = None
    rel = None
    for candidate in mod_to_paths(mod):
        try:
            source = git_show(candidate)
            rel = candidate
            break
        except subprocess.CalledProcessError:
            continue
    if source is None or rel is None:
        raise ModuleNotFoundError(mod)
    if temp_main and mod == "sesslint.adapters.openai_agents":
        with tempfile.NamedTemporaryFile(
            "w", suffix=".py", delete=False, encoding="utf-8"
        ) as handle:
            handle.write(source)
            path = handle.name
        code = compile(source, path, "exec")
    else:
        code = compile(source, f"<{PYTHON_COMMIT}:{rel}>", "exec")
    module = types.ModuleType(mod)
    module.__file__ = f"<{PYTHON_COMMIT}:{rel}>"
    sys.modules[mod] = module
    try:
        exec(code, module.__dict__)  # noqa: S102
    except Exception:
        del sys.modules[mod]
        raise
    parent, _, child = mod.rpartition(".")
    if parent in sys.modules:
        setattr(sys.modules[parent], child, module)


def load_pinned_openai() -> Any:
    verify_pin_hashes()
    ensure_packages()
    mods = [m for m in closure("sesslint.adapters.openai_agents") if m != "sesslint.adapters.openai_agents"]
    pending = list(mods)
    for _ in range(80):
        if not pending:
            break
        nxt: list[str] = []
        progress = False
        for mod in pending:
            try:
                load_module(mod, temp_main=False)
                progress = True
            except ModuleNotFoundError:
                nxt.append(mod)
        pending = nxt
        if pending and not progress:
            raise SystemExit(f"stuck loading: {pending[:8]}")
    load_module("sesslint.adapters.openai_agents", temp_main=True)
    return sys.modules["sesslint.adapters.openai_agents"]


def encode_payload(value: Any) -> dict[str, Any]:
    if value is None:
        return {"kind": "null"}
    if isinstance(value, bool):
        return {"kind": "bool", "value": value}
    if isinstance(value, int):
        return {"kind": "int", "value": value}
    if isinstance(value, float):
        return {"kind": "float", "value": value}
    if isinstance(value, str):
        return {"kind": "str", "text": value}
    if isinstance(value, list):
        return {"kind": "list", "items": [encode_payload(v) for v in value]}
    if isinstance(value, dict):
        return {
            "kind": "map",
            "entries": [
                {"key": encode_payload(k), "value": encode_payload(v)}
                for k, v in value.items()
            ],
        }
    raise SystemExit(f"cannot encode payload {type(value)!r}")


def pin_load_summary(mod: Any, data: bytes) -> dict[str, Any]:
    events, findings = mod.load_openai_agents(data)
    return {
        "event_count": len(events),
        "finding_count": len(findings),
        "finding_codes": sorted(f.code for f in findings),
    }


def scan_committed_text(text: str) -> None:
    raw = text.encode("utf-8")
    if _BANNED_LIVE_TEST.search(raw):
        raise SystemExit("committed output matches banned live/test secret shape")
    if _BANNED_SUPABASE_PAT.search(raw):
        raise SystemExit("committed output contains a contiguous supabase token shape")


