#!/usr/bin/env python3
"""Synthetic input-schema oracle from pinned schema; no envelope producer exists.

Run with repository dev Python. The snapshot consumer is hashed for provenance;
it is not the schema oracle and report metadata is not an envelope output.
"""

from __future__ import annotations

import ast
import hashlib
import json
import subprocess
from importlib.metadata import version
from pathlib import Path

from jsonschema import Draft202012Validator

PIN = "02694d537104659df66cdd084354739f3cccc440"
ROOT = Path(__file__).resolve().parents[4]
OUT = Path(__file__).resolve().parent
SOURCES = (
    "schemas/sesslint.snapshot.v1.json",
    "src/sesslint/outcome/snapshot.py",
    "tests/outcome/test_outcome_snapshot.py",
    "fixtures/outcome/orders/target_complete.json",
    "fixtures/outcome/orders/PROVENANCE.json",
)


def encode(value):
    return (json.dumps(value, ensure_ascii=True, indent=2, sort_keys=True) + "\n").encode()


def main():
    sources = {
        path: subprocess.check_output(["git", "show", f"{PIN}:{path}"], cwd=ROOT)
        for path in SOURCES
    }
    schema = json.loads(sources[SOURCES[0]])
    Draft202012Validator.check_schema(schema)
    oracle = Draft202012Validator(schema)
    base = {"schema_version": "sesslint.snapshot/v1"}
    rows = []

    def add(label, value):
        text = json.dumps(value, ensure_ascii=True, allow_nan=False)
        rows.append({"id": label, "input": text, "valid": oracle.is_valid(value)})

    for i, value in enumerate([None, True, False, 0, "", [], {}, base]):
        add(f"root-{i}", value)
    choices = [
        None,
        True,
        False,
        0,
        1,
        1.5,
        "",
        "unknown",
        "complete",
        "partial",
        "unavailable",
        "target_system",
        "workflow_log",
        "user_file",
        "manual",
        "sesslint.snapshot/v1",
        [],
        {},
        [{}],
        [None],
        [1],
        [True],
        [[]],
        ["x"],
        [{"nested": [None, {"x": [1, True, "synthetic"]}]}],
        "Z",
        "z",
        "garbageZ",
        "2026-11-09T01:02:03+07:00",
        "2026-11-09T01:02:03",
        "\u0000Z",
        "\nZ",
        "Z\n",
        "Z\r\n",
        "Z\n\n",
        "+99:99",
        "-9999",
        "+0:00",
        "+000",
        "+00000",
        "+0000\n",
        "Z\u2028",
        "Z\r",
        "Z\u0085",
        "Z\u000b",
        "\ud83d\ude00Z".encode("utf-16", "surrogatepass").decode("utf-16"),
        "+١٢:٣٤",
        "\n+00:00\n",
        "zsuffix",
    ]
    for key in schema["properties"]:
        for i, value in enumerate(choices):
            add(f"{key}-matrix-{i}", {**base, key: value})
    for key in ["unknown", "Schema_version", "schema", "records\n", "\u0000", "role", "name"]:
        add("unknown-" + str(len(rows)), {**base, key: None})
    for completeness in [None, "complete", "partial", "unknown", "unavailable"]:
        for records in [[], [{}], [{"n": 10**100, "zero": -0.0, "tiny": 5e-324}]]:
            add(
                f"combination-{len(rows)}",
                {**base, "completeness": completeness, "records": records},
            )
    add(
        "full",
        {
            **base,
            "observed_at": "2026-11-09T00:00:00Z",
            "completeness": "complete",
            "origin": "target_system",
            "demo": True,
            "records": [{"x": None}],
        },
    )
    add("nullable", {**base, "observed_at": None, "completeness": None, "origin": None})
    assert json.loads(sources[SOURCES[4]])["contains_real_data"] is False
    add("pinned-synthetic-envelope", json.loads(sources[SOURCES[3]]))
    overflow = '{"schema_version":"sesslint.snapshot/v1","records":[{"x":1e400}]}'
    rows.append(
        {
            "id": "exponent-overflow",
            "input": overflow,
            "valid": oracle.is_valid(json.loads(overflow)),
        }
    )
    boundaries = []
    for count in [999999, 1000000, 1000001]:
        boundaries.append(
            {"count": count, "valid": oracle.is_valid({**base, "records": [{}] * count})}
        )
    assert len({r["id"] for r in rows}) == len(rows)
    data = encode(
        {
            "schema": "sesslint.parity-schema-vectors/v1",
            "count": len(rows),
            "vectors": rows,
            "boundaries": boundaries,
        }
    )
    tests = [
        n.name
        for n in ast.parse(sources[SOURCES[2]].decode()).body
        if isinstance(n, ast.FunctionDef) and n.name.startswith("test_")
    ]
    outputs = {
        "schema.json": sources[SOURCES[0]],
        "vectors.json": data,
        "PROVENANCE.json": encode(
            {
                "contains_real_data": False,
                "source": "Generated synthetic envelope schema boundaries; no session data.",
            }
        ),
        "coverage.json": encode(
            {
                "python_commit": PIN,
                "covered_count": 0,
                "not_applicable_count": len(tests),
                "rows": [
                    {
                        "test": SOURCES[2] + "::" + name,
                        "status": "not_applicable",
                        "note": (
                            "Independent schema validation does not execute entire "
                            "snapshot loader test; "
                            "loader parity is covered in snapshot-PAR."
                        ),
                    }
                    for name in tests
                ],
            }
        ),
        "manifest.json": encode(
            {
                "python_commit": PIN,
                "source_sha256": {p: hashlib.sha256(b).hexdigest() for p, b in sources.items()},
                "vectors_sha256": hashlib.sha256(data).hexdigest(),
                "vector_count": len(rows),
                "boundary_count": len(boundaries),
                "valid_count": sum(r["valid"] for r in rows),
                "invalid_count": sum(not r["valid"] for r in rows),
                "oracle": "Draft202012Validator",
                "jsonschema_version": version("jsonschema"),
                "scope": (
                    "Optional input envelope schema; pinned snapshot.py has no envelope producer."
                ),
                "byte_exact_scope": (
                    "Embedded pinned schema blob only; no envelope serialization/CLI output claim."
                ),
                "domain": (
                    "Strict JSON parser: binary64 floats including exponent overflow as in Python, "
                    "exact integers up to 4300 digits, Unicode scalar strings, depth128; "
                    "duplicate keys and NaN/Infinity literals refused. Schema accepts arbitrary "
                    "nested record data. Typed from_json callers supply JSON-domain values."
                ),
            }
        ),
    }
    for name, payload in outputs.items():
        (OUT / name).write_bytes(payload)
    print(
        f"snapshot schema: {len(rows)} vectors + {len(boundaries)} maxItems boundaries; "
        f"{hashlib.sha256(data).hexdigest()}"
    )


if __name__ == "__main__":
    main()
