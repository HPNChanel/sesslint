def emitter_document(finding: Any) -> dict[str, Any]:
    source = finding.SourceRef(path="a.jsonl", line=1, record_id="r1")
    item = finding.Finding(
        code="SL001",
        severity=finding.Severity.ERROR,
        repairability=finding.Repairability.MANUAL,
        message="m",
        source=source,
        related_ids=(),
        fingerprint="0123456789abcdef",
    )
    document = item.to_dict()
    if not isinstance(document, dict):
        raise SystemExit("to_dict did not return an object")
    return document


def facts_from(schema: dict[str, Any], finding: Any, emitted: dict[str, Any]) -> dict[str, Any]:
    properties = schema["properties"]
    source = properties["source"]
    codes = set(finding.ALL_CODES)
    schema_codes = set(properties["code"]["enum"])
    severities = {item.value for item in finding.Severity}
    schema_severities = set(properties["severity"]["enum"])
    repairabilities = {item.value for item in finding.Repairability}
    schema_repairabilities = set(properties["repairability"]["enum"])
    if codes != schema_codes or severities != schema_severities or repairabilities != schema_repairabilities:
        raise SystemExit("emitter enums disagree with the pinned schema")
    if finding.SCHEMA_VERSION != properties["schema_version"]["const"]:
        raise SystemExit("emitter schema_version disagrees with the pinned const")
    if properties["fingerprint"]["pattern"] != FINGERPRINT_PATTERN:
        raise SystemExit("pinned fingerprint pattern changed")
    return {
        "additional_properties": schema["additionalProperties"],
        "code_enum": properties["code"]["enum"],
        "emitter_codes": sorted(codes),
        "emitter_repairabilities": [item.value for item in finding.Repairability],
        "emitter_schema_version": finding.SCHEMA_VERSION,
        "emitter_severities": [item.value for item in finding.Severity],
        "fingerprint_pattern": properties["fingerprint"]["pattern"],
        "id": schema["$id"],
        "line_minimum": source["properties"]["line"]["minimum"],
        "message_max_length": properties["message"]["maxLength"],
        "path_min_length": source["properties"]["path"]["minLength"],
        "property_names": list(properties.keys()),
        "related_ids_unique_items": properties["related_ids"]["uniqueItems"],
        "repairability_enum": properties["repairability"]["enum"],
        "required": schema["required"],
        "schema_version_const": properties["schema_version"]["const"],
        "severity_enum": properties["severity"]["enum"],
        "source_additional_properties": source["additionalProperties"],
        "source_property_names": list(source["properties"].keys()),
        "source_required": source["required"],
        "emitter_keys": sorted(emitted.keys()),
    }


def coverage_doc() -> dict[str, Any]:
    rows = [
        {
            "note": NOTES[test_id],
            "status": "not_applicable",
            "test": test_id,
            "vector_id": None,
        }
        for test_id in SCHEMA_TESTS
    ]
    return {
        "covered_count": 0,
        "module": "sesslint.finding",
        "not_applicable_count": len(rows),
        "python_commit": PYTHON_COMMIT,
        "rows": rows,
        "schema_file": "schemas/sesslint.finding.v1.json",
    }


def main() -> None:
    assert_pattern_engine()
    assert_test_list()
    schema_bytes = git_show_bytes(SCHEMA_GIT)
    finding_bytes = git_show_bytes(FINDING_GIT)
    if b"\r" in schema_bytes or b"\r" in finding_bytes:
        raise SystemExit("pin blob contains CR")
    embedded = embedded_schema()
    if embedded.encode("utf-8") != schema_bytes:
        raise SystemExit("embedded schema bytes differ from the pin")
    schema = json.loads(schema_bytes.decode("utf-8"))
    if not isinstance(schema, dict):
        raise SystemExit("pinned schema is not an object")
    finding = load_emitter()
    emitted = emitter_document(finding)
    if expect(schema, emitted) != {"ok": True}:
        raise SystemExit("emitter to_dict is not valid for the pinned schema")
    vectors = build_vectors(schema, emitted)
    document = {
        "facts": facts_from(schema, finding, emitted),
        "python_commit": PYTHON_COMMIT,
        "schema": "sesslint.parity-schema-vectors/v1",
        "vectors": vectors,
    }
    vectors_text = dumps(document)
    vectors_sha = hashlib.sha256(vectors_text.encode("utf-8")).hexdigest()
    manifest = {
        "finding_py_sha256": hashlib.sha256(finding_bytes).hexdigest(),
        "generator": GENERATOR,
        "python_commit": PYTHON_COMMIT,
        "schema": "sesslint.parity-schema-vectors/v1",
        "schema_file": "schemas/sesslint.finding.v1.json",
        "schema_sha256": hashlib.sha256(schema_bytes).hexdigest(),
        "vector_count": len(vectors),
        "vectors_sha256": vectors_sha,
    }
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.finding.v1 schema parity. Constraints and expected "
            "rejections come from the pinned schema. One object comes from Finding.to_dict "
            "on the pinned emitter. No session text is stored."
        ),
        "generator": GENERATOR,
        "known_parity_gaps": [
            "Schema path resolution and the missing-file loader are not this validator.",
            "make_finding round-trip and canonical fingerprint bytes are not produced.",
            "The codes enum lockstep sweep is not one accepted or rejected value.",
        ],
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
    }
    write_text(OUT / "vectors.json", vectors_text)
    write_text(OUT / "coverage.json", dumps(coverage_doc()))
    write_text(OUT / "manifest.json", dumps(manifest))
    write_text(OUT / "PROVENANCE.json", dumps(provenance))
    print(f"vector_count={len(vectors)}")
    print(f"vectors_sha256={vectors_sha}")


if __name__ == "__main__":
    main()
