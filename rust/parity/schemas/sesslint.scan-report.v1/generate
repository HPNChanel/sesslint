    add("finding_sl001", with_finding(finding_row()))
    add("code_sl402", with_finding(finding_row(code="SL402")))
    add("fingerprint_upper", with_finding(finding_row(fingerprint="F")))
    add("severity_unconstrained", with_finding(finding_row(severity="nope")))
    add("repairability_unconstrained", with_finding(finding_row(repairability="nope")))
    add("evidence_null", with_finding(finding_row(evidence=None)))
    null_span = {"byte": None, "line": None, "path": "a.jsonl"}
    add("span_nulls", with_finding(finding_row(span=null_span)))
    negative_span = {"byte": -1, "line": -1, "path": "a.jsonl"}
    add("span_negative", with_finding(finding_row(span=negative_span)))
    noted = finding_row()
    noted["note"] = "n"
    add("finding_note_allowed", with_finding(noted))
    span_note = finding_row()
    span_note["span"] = {"byte": 0, "line": 1, "note": "n", "path": "a.jsonl"}
    add("span_note_allowed", with_finding(span_note))
    for name in finding_schema["required"]:
        row = finding_row()
        row.pop(name)
        add(f"missing_finding_{name}", with_finding(row))
    add("code_enum", with_finding(finding_row(code="SL999")))
    add("code_type", with_finding(finding_row(code=1)))
    add("fingerprint_min_length", with_finding(finding_row(fingerprint="")))
    add("fingerprint_type", with_finding(finding_row(fingerprint=1)))
    add("remediation_type", with_finding(finding_row(remediation=1)))
    add("repairability_type", with_finding(finding_row(repairability=1)))
    add("severity_type", with_finding(finding_row(severity=1)))
    add("span_type", with_finding(finding_row(span=[])))
    add("span_missing_path", with_finding(finding_row(span={"line": 1})))
    add("span_path_min_length", with_finding(finding_row(span={"path": ""})))
    add("span_path_type", with_finding(finding_row(span={"path": 1})))
    add("span_line_type", with_finding(finding_row(span={"line": "1", "path": "a.jsonl"})))
    add("span_byte_type", with_finding(finding_row(span={"byte": True, "path": "a.jsonl"})))
    add("evidence_type_string", with_finding(finding_row(evidence="x")))
    add("evidence_type_array", with_finding(finding_row(evidence=[])))
    add("finding_group_one", with_group(group_row()))
    empty_samples = group_row(sample_fingerprints=[])
    add("empty_sample_fingerprints", with_group(empty_samples))
    for name in group_schema["required"]:
        row = group_row()
        row.pop(name)
        add(f"missing_group_{name}", with_group(row))
    extra_group = group_row()
    extra_group["extra"] = 1
    add("group_additional_property", with_group(extra_group))
    add("group_count_minimum", with_group(group_row(count=0)))
    add("group_count_bool", with_group(group_row(count=True)))
    add("group_code_type", with_group(group_row(code=1)))
    add("group_kind_type", with_group(group_row(kind=1)))
    groups_type = file_row()
    groups_type["finding_groups"] = {}
    add("finding_groups_type", with_file(groups_type))
    group_item = file_row()
    group_item["finding_groups"] = ["g"]
    add("group_item_type", with_file(group_item))
    samples_type = group_row(sample_fingerprints={})
    add("sample_fingerprints_type", with_group(samples_type))
    sample_item = group_row(sample_fingerprints=[1])
    add("sample_fingerprint_type", with_group(sample_item))
    padded = json.dumps(minimal(), ensure_ascii=True, sort_keys=True, separators=(", ", ": "))
    add("raw_padded", raw="\n" + padded + "\n")
    add("raw_healthy_one_point_zero", raw=raw_replace(minimal(), '"healthy": 0', '"healthy": 1.0'))
    add("raw_healthy_exponent", raw=raw_replace(minimal(), '"healthy": 0', '"healthy": 1e1'))
    add("raw_healthy_scaled", raw=raw_replace(minimal(), '"healthy": 0', '"healthy": 10e-1'))
    add("raw_healthy_negative_zero", raw=raw_replace(minimal(), '"healthy": 0', '"healthy": -0'))
    add("raw_healthy_fraction", raw=raw_replace(minimal(), '"healthy": 0', '"healthy": 1.5'))
    add(
        "raw_skipped_reason_one_point_zero",
        raw=raw_replace(reasons, '"size-cap": 1', '"size-cap": 1.0'),
    )
    add(
        "raw_skipped_reason_fraction",
        raw=raw_replace(reasons, '"size-cap": 1', '"size-cap": 1.5'),
    )
    rich = with_finding(finding_row())
    add("raw_line_one_point_zero", raw=raw_replace(rich, '"line": 1', '"line": 1.0'))
    add("raw_line_fraction", raw=raw_replace(rich, '"line": 1', '"line": 1.5'))
    ids = [item["id"] for item in vectors]
    if len(ids) != len(set(ids)):
        raise SystemExit("duplicate vector id")
    return vectors


def with_file_value(value: object) -> dict[str, Any]:
    document = minimal()
    document["files"] = [value]
    return document


def minimal_files(rows: list[dict[str, Any]]) -> dict[str, Any]:
    document = minimal()
    document["files"] = rows
    return document


def require_expected(
    vectors: list[dict[str, Any]],
    vector_id: str,
    expected: dict[str, Any],
) -> None:
    found = next(item for item in vectors if item["id"] == vector_id)
    if found["expected"] != expected:
        raise SystemExit(f"{vector_id} oracle drifted: {found['expected']}")


def assert_oracle(schema: dict[str, Any], vectors: list[dict[str, Any]]) -> None:
    if check({"pattern": "^a$"}, "a", "") != ("unsupported", "", "pattern"):
        raise SystemExit("pattern did not fail closed")
    if check({"uniqueItems": True}, ["a", "a"], "") != ("unsupported", "", "uniqueItems"):
        raise SystemExit("uniqueItems did not fail closed")
    if check({"format": "date"}, "m", "") != ("unsupported", "", "format"):
        raise SystemExit("format did not fail closed")
    if expect(schema, minimal()) != {"ok": True}:
        raise SystemExit("minimal object rejected")
    require_expected(
        vectors,
        "empty_object",
        {"detail": "files", "keyword": "required", "ok": False, "path": ""},
    )
    require_expected(
        vectors,
        "healthy_minimum",
        {"detail": "", "keyword": "minimum", "ok": False, "path": "/totals/healthy"},
    )
    require_expected(
        vectors,
        "totals_additional_property",
        {"detail": "extra", "keyword": "additionalProperties", "ok": False, "path": "/totals"},
    )
    require_expected(
        vectors,
        "skipped_reasons_slash_key",
        {"detail": "", "keyword": "minimum", "ok": False, "path": "/totals/skipped_reasons/a~1b"},
    )
    require_expected(
        vectors,
        "skipped_reasons_tilde_key",
        {"detail": "", "keyword": "type", "ok": False, "path": "/totals/skipped_reasons/a~0b"},
    )
    require_expected(
        vectors,
        "file_index_one_missing_path",
        {"detail": "path", "keyword": "required", "ok": False, "path": "/files/1"},
    )
    require_expected(vectors, "root_summary_allowed", {"ok": True})
    require_expected(vectors, "span_negative", {"ok": True})
    require_expected(vectors, "severity_unconstrained", {"ok": True})
    require_expected(vectors, "fingerprint_upper", {"ok": True})
    require_expected(vectors, "totals_sum_not_a_schema_rule", {"ok": True})
    require_expected(
        vectors,
        "code_enum",
        {"detail": "", "keyword": "enum", "ok": False, "path": "/files/0/findings/0/code"},
    )
    require_expected(
        vectors,
        "verdict_type",
        {"detail": "", "keyword": "type", "ok": False, "path": "/files/0/verdict"},
    )
    require_expected(
        vectors,
        "raw_healthy_fraction",
        {"detail": "", "keyword": "type", "ok": False, "path": "/totals/healthy"},
    )
    require_expected(vectors, "raw_healthy_one_point_zero", {"ok": True})
    require_expected(vectors, "raw_healthy_negative_zero", {"ok": True})
    require_expected(
        vectors,
        "group_additional_property",
        {
            "detail": "extra",
            "keyword": "additionalProperties",
            "ok": False,
            "path": "/files/0/finding_groups/0",
        },
    )


def facts_from(schema: dict[str, Any]) -> dict[str, Any]:
    props = schema["properties"]
    totals = props["totals"]
    file_item = props["files"]["items"]
    finding = file_item["properties"]["findings"]["items"]
    span = finding["properties"]["span"]
    group = file_item["properties"]["finding_groups"]["items"]
    reasons = totals["properties"]["skipped_reasons"]
    found: set[str] = set()
    collect_keywords(schema, found)
    if found != STATED:
        raise SystemExit(f"pinned keyword set drifted: {sorted(found)}")
    return {
        "code_enum": finding["properties"]["code"]["enum"],
        "counter_minimum": totals["properties"]["healthy"]["minimum"],
        "dialect": schema["$schema"],
        "evidence_type": finding["properties"]["evidence"]["type"],
        "file_property_names": list(file_item["properties"]),
        "file_required": file_item["required"],
        "finding_property_names": list(finding["properties"]),
        "finding_required": finding["required"],
        "fingerprint_min_length": finding["properties"]["fingerprint"]["minLength"],
        "group_additional_properties": group["additionalProperties"],
        "group_count_minimum": group["properties"]["count"]["minimum"],
        "group_property_names": list(group["properties"]),
        "group_required": group["required"],
        "id": schema["$id"],
        "keywords": sorted(found),
        "line_type": span["properties"]["line"]["type"],
        "path_min_length": file_item["properties"]["path"]["minLength"],
        "property_names": list(props),
        "required": schema["required"],
        "root_additional_properties": schema.get("additionalProperties"),
        "schema_version_const": props["schema_version"]["const"],
        "skipped_reason_min_length": file_item["properties"]["skipped_reason"]["minLength"],
        "skipped_reasons_minimum": reasons["additionalProperties"]["minimum"],
        "skipped_reasons_value_type": reasons["additionalProperties"]["type"],
        "span_property_names": list(span["properties"]),
        "span_required": span["required"],
        "totals_additional_properties": totals["additionalProperties"],
        "totals_property_names": list(totals["properties"]),
        "totals_required": totals["required"],
        "verdict_enum": file_item["properties"]["verdict"]["enum"],
    }


def coverage_doc() -> dict[str, Any]:
    rows = [
        {
            "note": NOTES[test_id],
            "status": "not_applicable",
            "test": test_id,
            "vector_id": None,
        }
        for test_id in SCHEMA_TESTS
    ]
    return {
        "covered_count": 0,
        "module": "sesslint.scan",
        "not_applicable_count": len(rows),
        "python_commit": PYTHON_COMMIT,
        "rows": rows,
        "schema_file": "schemas/sesslint.scan-report.v1.json",
    }


def main() -> None:
    assert_test_list()
    schema_bytes = git_show_bytes(SCHEMA_GIT)
    test_bytes = git_show_bytes(TEST_GIT)
    if b"\r" in schema_bytes or b"\r" in test_bytes:
        raise SystemExit("pin blob contains CR")
    embedded = embedded_schema()
    if embedded.encode("utf-8") != schema_bytes:
        raise SystemExit("embedded schema bytes differ from the pin")
    schema = json.loads(schema_bytes.decode("utf-8"))
    if not isinstance(schema, dict):
        raise SystemExit("pinned schema is not an object")
    vectors = build_vectors(schema)
    assert_oracle(schema, vectors)
    document = {
        "facts": facts_from(schema),
        "python_commit": PYTHON_COMMIT,
        "schema": "sesslint.parity-schema-vectors/v1",
        "vectors": vectors,
    }
    vectors_text = dumps(document)
    vectors_sha = hashlib.sha256(vectors_text.encode("utf-8")).hexdigest()
    manifest = {
        "generator": GENERATOR,
        "python_commit": PYTHON_COMMIT,
        "schema": "sesslint.parity-schema-vectors/v1",
        "schema_file": "schemas/sesslint.scan-report.v1.json",
        "schema_sha256": hashlib.sha256(schema_bytes).hexdigest(),
        "test_py_sha256": hashlib.sha256(test_bytes).hexdigest(),
        "vector_count": len(vectors),
        "vectors_sha256": vectors_sha,
    }
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.scan-report.v1 schema parity. Constraints and expected "
            "rejections come from the pinned schema. Documents are hand-built. "
            "ScanReport.to_dict is not executed. No session text is stored."
        ),
        "generator": GENERATOR,
        "known_parity_gaps": [
            "Schema loading and the ALL_CODES enum lockstep are not this validator.",
            "Bucket sums, sorted reason keys, and reason sums are outside the pinned schema.",
            "JSON round trip and skipped_reason_totals are emitter behavior.",
            "Emitter omission of empty skipped_reasons is not one accepted object.",
            "Duplicate JSON object keys are refused. Python json.loads keeps the last key.",
            "A JSON number is an integer only when it is a proven i128.",
        ],
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
    }
    write_text(OUT / "vectors.json", vectors_text)
    write_text(OUT / "coverage.json", dumps(coverage_doc()))
    write_text(OUT / "manifest.json", dumps(manifest))
    write_text(OUT / "PROVENANCE.json", dumps(provenance))
    payload = vectors_text.encode("utf-8")
    print(f"vector_count={len(vectors)}")
    print("covered_count=0")
    print(f"not_applicable_count={len(SCHEMA_TESTS)}")
    print(f"vectors_sha256={vectors_sha}")
    print(f"bytes={len(payload)}")
    print(f"lf={payload.count(10)}")
    print(f"cr={payload.count(13)}")


if __name__ == "__main__":
    main()
