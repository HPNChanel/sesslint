def raw_replace(document: dict[str, Any], old: str, new: str) -> str:
    text = json.dumps(document, ensure_ascii=True, sort_keys=True, separators=(", ", ": "))
    if text.count(old) != 1:
        raise SystemExit(f"token not unique: {old}")
    return text.replace(old, new, 1)


def build_vectors(schema: dict[str, Any]) -> list[dict[str, Any]]:
    vectors: list[dict[str, Any]] = []

    def add(vector_id: str, instance: object = None, raw: str | None = None) -> None:
        if raw is None:
            encoded = json.dumps(instance, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
            loaded = json.loads(encoded)
            vectors.append(
                {"expected": expect(schema, loaded), "id": vector_id, "instance": loaded}
            )
            return
        loaded = json.loads(raw)
        vectors.append({"expected": expect(schema, loaded), "id": vector_id, "raw": raw})

    props = schema["properties"]
    totals_schema = props["totals"]
    file_schema = props["files"]["items"]
    finding_schema = file_schema["properties"]["findings"]["items"]
    group_schema = file_schema["properties"]["finding_groups"]["items"]
    verdicts = file_schema["properties"]["verdict"]["enum"]

    add("minimal_object", minimal())
    add("empty_object", {})
    add("root_array", [])
    add("root_string", "x")
    add("root_null", None)
    add("root_number", 1)
    add("root_bool", True)
    for name in schema["required"]:
        document = minimal()
        document.pop(name)
        add(f"missing_{name}", document)
    const_bad = minimal()
    const_bad["schema_version"] = "nope"
    add("schema_version_const", const_bad)
    root_type = minimal()
    root_type["root_path"] = 1
    add("root_path_type", root_type)
    empty_root = minimal()
    empty_root["root_path"] = ""
    add("empty_root_path", empty_root)
    summary = minimal()
    summary["summary"] = {}
    add("root_summary_allowed", summary)
    uneven = minimal()
    uneven["totals"]["healthy"] = 2
    add("totals_sum_not_a_schema_rule", uneven)
    totals_type = minimal()
    totals_type["totals"] = []
    add("totals_type", totals_type)
    for name in totals_schema["required"]:
        document = minimal()
        document["totals"].pop(name)
        add(f"missing_totals_{name}", document)
    extra = minimal()
    extra["totals"]["extra"] = 1
    add("totals_additional_property", extra)
    healthy_min = minimal()
    healthy_min["totals"]["healthy"] = -1
    add("healthy_minimum", healthy_min)
    total_min = minimal()
    total_min["totals"]["total"] = -1
    add("total_minimum", total_min)
    healthy_str = minimal()
    healthy_str["totals"]["healthy"] = "0"
    add("healthy_type_string", healthy_str)
    healthy_bool = minimal()
    healthy_bool["totals"]["healthy"] = True
    add("healthy_type_bool", healthy_bool)
    reasons = minimal()
    reasons["totals"]["skipped_reasons"] = {"size-cap": 1}
    add("skipped_reasons_one", reasons)
    reasons_empty = minimal()
    reasons_empty["totals"]["skipped_reasons"] = {}
    add("skipped_reasons_empty", reasons_empty)
    reasons_two = minimal()
    reasons_two["totals"]["skipped_reasons"] = {"z": 2, "a": 1}
    add("skipped_reasons_two", reasons_two)
    reasons_over = minimal()
    reasons_over["totals"]["skipped_reasons"] = {"a": 3}
    add("skipped_reasons_sum_not_a_schema_rule", reasons_over)
    reasons_type = minimal()
    reasons_type["totals"]["skipped_reasons"] = []
    add("skipped_reasons_type", reasons_type)
    reasons_zero = minimal()
    reasons_zero["totals"]["skipped_reasons"] = {"size-cap": 0}
    add("skipped_reasons_minimum", reasons_zero)
    reasons_neg = minimal()
    reasons_neg["totals"]["skipped_reasons"] = {"size-cap": -1}
    add("skipped_reasons_negative", reasons_neg)
    reasons_str = minimal()
    reasons_str["totals"]["skipped_reasons"] = {"size-cap": "1"}
    add("skipped_reasons_value_type", reasons_str)
    reasons_bool = minimal()
    reasons_bool["totals"]["skipped_reasons"] = {"size-cap": True}
    add("skipped_reasons_value_bool", reasons_bool)
    slash = minimal()
    slash["totals"]["skipped_reasons"] = {"a/b": 0}
    add("skipped_reasons_slash_key", slash)
    tilde = minimal()
    tilde["totals"]["skipped_reasons"] = {"a~b": "x"}
    add("skipped_reasons_tilde_key", tilde)
    files_type = minimal()
    files_type["files"] = {}
    add("files_type", files_type)
    add("file_item_type", with_file_value("a.jsonl"))
    for verdict in verdicts:
        add(f"verdict_{verdict}", with_file(file_row(verdict=verdict)))
    skipped = file_row(verdict="skipped", skipped_reason="size-cap")
    add("skipped_reason_present", with_file(skipped))
    cached = file_row()
    cached["cache"] = "hit"
    add("file_cache_allowed", with_file(cached))
    add("duplicate_paths_allowed", minimal_files([file_row(), file_row()]))
    omitted = file_row()
    add("findings_omitted", with_file(omitted))
    empty_findings = file_row()
    empty_findings["findings"] = []
    add("findings_empty", with_file(empty_findings))
    for name in file_schema["required"]:
