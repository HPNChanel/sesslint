        row.pop(name)
        add(f"missing_file_{name}", with_file(row))
    add("path_min_length", with_file(file_row(path="")))
    add("path_type", with_file(file_row(path=1)))
    add("verdict_enum", with_file(file_row(verdict="nope")))
    add("verdict_type", with_file(file_row(verdict=1)))
