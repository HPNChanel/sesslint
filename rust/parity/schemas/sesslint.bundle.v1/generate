def clone(document: dict[str, Any]) -> dict[str, Any]:
    cloned = json.loads(compact(document))
    if not isinstance(cloned, dict):
        raise SystemExit("clone did not return an object")
    return cloned


def set_in(document: dict[str, Any], path: tuple[Any, ...], value: object) -> dict[str, Any]:
    cursor: Any = document
    for key in path[:-1]:
        cursor = cursor[key]
    cursor[path[-1]] = value
    return document


def del_in(document: dict[str, Any], path: tuple[Any, ...]) -> dict[str, Any]:
    cursor: Any = document
    for key in path[:-1]:
        cursor = cursor[key]
    del cursor[path[-1]]
    return document


def replaced(document: str, old: str, new: str) -> str:
    count = document.count(old)
    if count != 1:
        raise SystemExit(f"needle {old!r} count {count}")
    return document.replace(old, new, 1)


def build_vectors(schema: dict[str, Any]) -> list[dict[str, Any]]:
    vectors: list[dict[str, Any]] = []

    def add(case_id: str, instance: object, keyword: str, path: str = "", detail: str = "") -> None:
        document = compact(instance)
        found = expect(schema, json.loads(document))
        require_found(case_id, found, keyword, path, detail)
        vectors.append(record(case_id, document, found))

    def add_raw(
        case_id: str,
        document: str,
        keyword: str,
        path: str = "",
        detail: str = "",
    ) -> None:
        found = expect(schema, json.loads(document))
        require_found(case_id, found, keyword, path, detail)
        vectors.append(record(case_id, document, found))

    minimal = base_document()
    share = share_document()
    minimal_text = compact(minimal)
    share_text = compact(share)
    span = ("report", "findings", 0, "span")
    add("validate_minimal", minimal, "")
    add("validate_share_advisory", share, "")
    add("validate_resolved_string", set_in(clone(minimal), ("detection", "resolved"), "auto"), "")
    add(
        "validate_confidence_fraction",
        set_in(clone(minimal), ("detection", "confidences", "half"), 0.5),
        "",
    )
    add("validate_span_line_integer", set_in(clone(minimal), (*span, "line"), 2), "")
    add_raw(
        "validate_span_line_one_point_zero",
        replaced(minimal_text, '"line":null', '"line":1.0'),
        "",
    )
    add("validate_span_byte_null", set_in(clone(minimal), (*span, "byte"), None), "")
    optional = clone(minimal)
    finding = optional["report"]["findings"][0]
    del finding["message"]
    del finding["remediation"]
    del finding["evidence"]
    add("validate_optional_finding_fields_absent", optional, "")
    add(
        "validate_versions_nested",
        set_in(clone(minimal), ("created_by", "versions"), {"n": [1, {"z": False}]}),
        "",
    )
    add(
        "validate_families_unsorted",
        set_in(clone(share), ("share_advisory", "families"), ["b", "a"]),
        "",
    )
    add("validate_families_empty", set_in(clone(share), ("share_advisory", "families"), []), "")
    add("validate_size_zero", set_in(clone(minimal), ("source", "size"), 0), "")
    add_raw(
        "validate_size_exponent_integer",
        replaced(minimal_text, '"size":1', '"size":10e-1'),
        "",
    )
    add(
        "validate_record_count_zero",
        set_in(clone(minimal), ("fixture_skeleton", "record_count"), 0),
        "",
    )
    empty_collections = clone(minimal)
    empty_collections["created_by"]["adapters"] = {}
    empty_collections["created_by"]["profiles"] = {}
    empty_collections["detection"]["confidences"] = {}
    empty_collections["fixture_skeleton"]["codes"] = []
    empty_collections["report"]["findings"] = []
    add("validate_empty_collections", empty_collections, "")

    add("validate_empty_object", {}, "required", "", "bundle_version")
    add("validate_root_array", [], "type")
    add("validate_root_string", "x", "type")
    add("validate_root_bool", True, "type")
    add("validate_root_null", None, "type")
    for name in (
        "bundle_version",
        "created_by",
        "detection",
        "fixture_skeleton",
        "report",
        "source",
    ):
        add(
            f"validate_missing_{name}",
            del_in(clone(minimal), (name,)),
            "required",
            "",
            name,
        )
    add(
        "validate_root_additional",
        set_in(clone(minimal), ("extra",), 1),
        "additionalProperties",
        "",
        "extra",
    )
    both = clone(minimal)
    both["a_extra"] = 1
    both["m_extra"] = 2
    add("validate_root_additional_sorted", both, "additionalProperties", "", "a_extra")
    add(
        "validate_bad_const",
        set_in(clone(minimal), ("bundle_version",), "other"),
        "const",
        "/bundle_version",
    )
    add(
        "validate_const_integer",
        set_in(clone(minimal), ("bundle_version",), 1),
        "const",
        "/bundle_version",
    )
    add(
        "validate_tool_const",
        set_in(clone(minimal), ("created_by", "tool"), "other"),
        "const",
        "/created_by/tool",
    )
    add(
        "validate_tool_integer",
        set_in(clone(minimal), ("created_by", "tool"), 1),
        "const",
        "/created_by/tool",
    )
