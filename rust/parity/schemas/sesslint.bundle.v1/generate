class CheckoutImportRefused(Exception):
    """A sesslint import missed the pin and must not reach the checkout."""


class Unproven(Exception):
    """A comparison or keyword cannot be proven."""


class _PinOnly(importlib.abc.MetaPathFinder):
    """Reject any sesslint import. This generator does not exec the bundle blob."""

    def find_spec(
        self,
        fullname: str,
        path: object = None,
        target: object = None,
    ) -> None:
        del path, target
        if fullname == "sesslint" or fullname.startswith("sesslint."):
            raise CheckoutImportRefused(fullname)
        return None


def git_show_bytes(rev_path: str) -> bytes:
    if "02694d5" in rev_path:
        raise SystemExit("refusing 02694d5")
    if not rev_path.startswith(f"{PYTHON_COMMIT}:"):
        raise SystemExit("git show is limited to the pin")
    return subprocess.check_output(["git", "show", rev_path], cwd=ROOT)


def digest(blob: bytes) -> str:
    return hashlib.sha256(blob).hexdigest()


def embedded_schema() -> str:
    text = RS_PATH.read_text(encoding="utf-8")
    marker = 'BUNDLE_SCHEMA_JSON: &str = r#"'
    start = text.find(marker)
    if start < 0:
        raise SystemExit("schema const missing")
    start += len(marker)
    end = text.find('"#;', start)
    if end < 0:
        raise SystemExit("schema const end missing")
    body = text[start:end]
    if body == "___PIN_SCHEMA___":
        raise SystemExit("schema placeholder was not spliced")
    return body


def prove(schema: object) -> None:
    if not isinstance(schema, dict):
        raise SystemExit("schema node is not an object")
    for key, value in schema.items():
        if key in ANNOTATIONS:
            continue
        if key not in KNOWN:
            raise SystemExit(f"unproven keyword {key}")
        if key == "pattern":
            if value != HEX64:
                raise SystemExit("unproven pattern")
        elif key in {"minimum", "minLength", "maxLength"}:
            if isinstance(value, bool) or not isinstance(value, int) or value < 0:
                raise SystemExit(f"unproven {key}")
        elif key == "additionalProperties":
            if isinstance(value, dict):
                prove(value)
            elif value is not True and value is not False:
                raise SystemExit("unproven additionalProperties")
        elif key == "items":
            prove(value)
        elif key == "properties":
            if not isinstance(value, dict):
                raise SystemExit("properties")
            for sub in value.values():
                prove(sub)
        elif key == "required":
            if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
                raise SystemExit("required")
        elif key == "type":
            prove_type(value)
        elif key == "const" and not isinstance(value, str):
            raise SystemExit("unproven const")
        elif key == "enum":
            if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
                raise SystemExit("enum")
        elif key == "uniqueItems" and value is not True and value is not False:
            raise SystemExit("uniqueItems")


def prove_type(value: object) -> None:
    if isinstance(value, str):
        if value not in TYPES:
            raise SystemExit(f"unproven type {value}")
        return
    if isinstance(value, list) and value and all(type_name_ok(item) for item in value):
        return
    raise SystemExit("unproven type")


def type_name_ok(item: object) -> bool:
    return isinstance(item, str) and item in TYPES


def integer_value(value: object) -> int | None:
    if isinstance(value, bool) or not isinstance(value, int | float):
        return None
    if isinstance(value, int):
        if -(2**127) <= value < 2**127:
            return value
        return None
    if not math.isfinite(value) or abs(value) > 2**53 or not value.is_integer():
        return None
    return int(value)


def json_equal(left: object, right: object) -> bool:
    if left is None or right is None:
        return left is None and right is None
    if isinstance(left, bool) or isinstance(right, bool):
        return isinstance(left, bool) and isinstance(right, bool) and left == right
    left_num = isinstance(left, int | float)
    right_num = isinstance(right, int | float)
    if left_num or right_num:
        if not left_num or not right_num:
            return False
        left_int = integer_value(left)
        right_int = integer_value(right)
        if left_int is None or right_int is None:
            raise Unproven()
        return left_int == right_int
    if isinstance(left, str) or isinstance(right, str):
        return isinstance(left, str) and isinstance(right, str) and left == right
    if isinstance(left, list) or isinstance(right, list):
        if not isinstance(left, list) or not isinstance(right, list) or len(left) != len(right):
            return False
        return all(json_equal(item, other) for item, other in zip(left, right, strict=True))
    if isinstance(left, dict) or isinstance(right, dict):
        if not isinstance(left, dict) or not isinstance(right, dict) or set(left) != set(right):
            return False
        return all(json_equal(left[key], right[key]) for key in left)
    raise Unproven()


def type_ok(spec: object, value: object) -> bool:
    if isinstance(spec, list):
        return any(type_ok(item, value) for item in spec)
    if spec == "object":
        return isinstance(value, dict)
    if spec == "array":
        return isinstance(value, list)
    if spec == "string":
        return isinstance(value, str)
    if spec == "boolean":
        return isinstance(value, bool)
    if spec == "null":
        return value is None
    if spec == "integer":
        return integer_value(value) is not None
    if spec == "number":
        return (
            not isinstance(value, bool) and isinstance(value, int | float) and math.isfinite(value)
        )
    raise Unproven()


def pointer(parent: str, key: str) -> str:
    return parent + "/" + key.replace("~", "~0").replace("/", "~1")


def pointer_index(parent: str, index: int) -> str:
    return f"{parent}/{index}"


def check(schema: object, value: object, path: str) -> tuple[str, str, str] | None:
    if not isinstance(schema, dict):
        return ("unsupported", path, "schema")
    for key in schema:
        if key not in ANNOTATIONS and key not in KNOWN:
            return ("unsupported", path, str(key))
    if "type" in schema:
        try:
            matched = type_ok(schema["type"], value)
        except Unproven:
            return ("unsupported", path, "type")
        if not matched:
            return ("type", path, "")
    if "const" in schema:
        try:
            matched = json_equal(value, schema["const"])
        except Unproven:
            return ("unsupported", path, "const")
        if not matched:
            return ("const", path, "")
    if "enum" in schema:
        failure = check_enum(schema["enum"], value, path)
        if failure is not None:
            return failure
    failure = check_string(schema, value, path)
    if failure is not None:
        return failure
    failure = check_minimum(schema, value, path)
    if failure is not None:
        return failure
    failure = check_object(schema, value, path)
    if failure is not None:
        return failure
    return check_array(schema, value, path)


def check_enum(choices: object, value: object, path: str) -> tuple[str, str, str] | None:
    if not isinstance(choices, list):
        return ("unsupported", path, "enum")
    for choice in choices:
        try:
            if json_equal(value, choice):
                return None
        except Unproven:
            return ("unsupported", path, "enum")
    return ("enum", path, "")


def check_string(schema: dict[str, Any], value: object, path: str) -> tuple[str, str, str] | None:
    if not isinstance(value, str):
        return None
    for keyword in ("minLength", "maxLength"):
        if keyword not in schema:
            continue
        limit = schema[keyword]
        if isinstance(limit, bool) or not isinstance(limit, int) or limit < 0:
            return ("unsupported", path, "length")
        if keyword == "minLength" and len(value) < limit:
            return ("minLength", path, "")
        if keyword == "maxLength" and len(value) > limit:
            return ("maxLength", path, "")
    if "pattern" in schema:
        pattern = schema["pattern"]
        if pattern != HEX64:
            return ("unsupported", path, "pattern")
        if len(value) != 64 or any(ch not in "0123456789abcdef" for ch in value):
            return ("pattern", path, "")
    return None


def check_minimum(schema: dict[str, Any], value: object, path: str) -> tuple[str, str, str] | None:
    if "minimum" not in schema:
        return None
    if isinstance(value, bool) or not isinstance(value, int | float):
        return None
    number = integer_value(value)
    if number is None:
        return ("unsupported", path, "minimum")
    limit = schema["minimum"]
    if isinstance(limit, bool) or not isinstance(limit, int):
        return ("unsupported", path, "minimum")
    if number < limit:
        return ("minimum", path, "")
    return None


def check_object(schema: dict[str, Any], value: object, path: str) -> tuple[str, str, str] | None:
    if not isinstance(value, dict):
        return None
    if "required" in schema:
        required = schema["required"]
        if not isinstance(required, list):
            return ("unsupported", path, "required")
        for name in required:
            if not isinstance(name, str):
                return ("unsupported", path, "required")
            if name not in value:
                return ("required", path, name)
    if "additionalProperties" in schema:
        failure = check_additional(schema, value, path)
        if failure is not None:
            return failure
    if "properties" in schema:
        props = schema["properties"]
        if not isinstance(props, dict):
            return ("unsupported", path, "properties")
        for name, sub in props.items():
            if name in value:
                found = check(sub, value[name], pointer(path, str(name)))
                if found is not None:
                    return found
    return None


def check_additional(
    schema: dict[str, Any], value: dict[str, Any], path: str
) -> tuple[str, str, str] | None:
    props = schema.get("properties", {})
    if not isinstance(props, dict):
        return ("unsupported", path, "properties")
    unknown = sorted(key for key in value if key not in props)
    flag = schema["additionalProperties"]
    if flag is False:
        if unknown:
            return ("additionalProperties", path, unknown[0])
        return None
    if flag is True:
        return None
    if isinstance(flag, dict):
        for key in unknown:
            found = check(flag, value[key], pointer(path, key))
            if found is not None:
                return found
        return None
    return ("unsupported", path, "additionalProperties")


def check_array(schema: dict[str, Any], value: object, path: str) -> tuple[str, str, str] | None:
    if not isinstance(value, list):
        return None
    if "items" in schema:
        item_schema = schema["items"]
        if not isinstance(item_schema, dict):
            return ("unsupported", path, "items")
        for index, item in enumerate(value):
            found = check(item_schema, item, pointer_index(path, index))
            if found is not None:
                return found
    unique = schema.get("uniqueItems", False)
    if unique is True:
        for right in range(1, len(value)):
            for left in range(right):
                try:
                    same = json_equal(value[left], value[right])
                except Unproven:
                    return ("unsupported", path, "uniqueItems")
                if same:
                    return ("uniqueItems", path, "")
        return None
    if unique is not False:
        return ("unsupported", path, "uniqueItems")
    return None


def expect(schema: dict[str, Any], value: object) -> dict[str, Any]:
    failure = check(schema, value, "")
    if failure is None:
        return {"detail": "", "keyword": "", "mode": "ok", "path": ""}
    keyword, path, detail = failure
    if keyword == "unsupported":
        raise SystemExit(f"oracle unsupported at {path} ({detail})")
    return {"detail": detail, "keyword": keyword, "mode": "reject", "path": path}


def compact(value: object) -> str:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
    )


def require_found(
    case_id: str,
    found: dict[str, Any],
    keyword: str,
    path: str,
    detail: str,
) -> None:
    if keyword == "":
        if found["mode"] != "ok":
            raise SystemExit(f"{case_id} expected ok, got {found}")
        return
    if (
        found["mode"] != "reject"
        or found["keyword"] != keyword
        or found["path"] != path
        or found["detail"] != detail
    ):
        raise SystemExit(f"{case_id} expected {keyword} {path} {detail}, got {found}")


def record(case_id: str, document: str, found: dict[str, Any]) -> dict[str, Any]:
    return {
        "construct": {
            "document": document,
            "fn": "validate_json",
            "mode": found["mode"],
            "type": "validate",
        },
        "expected": found,
        "id": case_id,
    }


