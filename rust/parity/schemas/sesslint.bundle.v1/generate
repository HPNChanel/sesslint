def call_names(fn: ast.FunctionDef) -> list[str]:
    names: list[str] = []
    for node in ast.walk(fn):
        if not isinstance(node, ast.Call):
            continue
        if isinstance(node.func, ast.Attribute):
            names.append(node.func.attr)
        elif isinstance(node.func, ast.Name):
            names.append(node.func.id)
    return names


def assert_schema_tests(test_text: str) -> None:
    tree = ast.parse(test_text)
    found: list[str] = []
    functions = {
        node.name: node
        for node in tree.body
        if isinstance(node, ast.FunctionDef) and node.name.startswith("test_")
    }
    for node in tree.body:
        if not isinstance(node, ast.FunctionDef) or not node.name.startswith("test_"):
            continue
        names = call_names(node)
        if set(names) & MARKERS:
            found.append(node.name)
            if set(names) == {"validate_json"} or len(set(names)) < 2:
                raise SystemExit(f"{node.name} is not a multi-call schema test: {names}")
    expected = [item.split("::", 1)[1] for item in SCHEMA_TESTS]
    if found != expected:
        raise SystemExit(f"schema test list mismatch: {found}")
    for name in expected:
        if name not in functions:
            raise SystemExit(f"missing pinned test {name}")


def emitter_keys(fn: ast.FunctionDef) -> list[str]:
    found: list[tuple[int, int, str]] = []
    for node in ast.walk(fn):
        if isinstance(node, ast.Dict):
            for key in node.keys:
                if not isinstance(key, ast.Constant) or not isinstance(key.value, str):
                    raise SystemExit("to_dict key is not a string")
                found.append((key.lineno, key.col_offset, key.value))
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if (
                    isinstance(target, ast.Subscript)
                    and isinstance(target.slice, ast.Constant)
                    and isinstance(target.slice.value, str)
                ):
                    found.append((target.slice.lineno, target.slice.col_offset, target.slice.value))
    found.sort()
    return [item[2] for item in found]


def method(bundle_cls: ast.ClassDef, name: str) -> ast.FunctionDef | None:
    return next(
        (
            node
            for node in bundle_cls.body
            if isinstance(node, ast.FunctionDef) and node.name == name
        ),
        None,
    )


def emitter_facts(source: str, schema: dict[str, Any]) -> tuple[str, list[str]]:
    tree = ast.parse(source)
    version = None
    for node in tree.body:
        if (
            isinstance(node, ast.AnnAssign)
            and isinstance(node.target, ast.Name)
            and node.target.id == "BUNDLE_SCHEMA_VERSION"
            and isinstance(node.value, ast.Constant)
            and isinstance(node.value.value, str)
        ):
            version = node.value.value
    if version is None:
        raise SystemExit("BUNDLE_SCHEMA_VERSION missing")
    const = schema["properties"]["bundle_version"]["const"]
    if version != const:
        raise SystemExit("emitter version disagrees with the schema const")
    bundle_cls = next(
        (node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "Bundle"),
        None,
    )
    if bundle_cls is None:
        raise SystemExit("Bundle class missing")
    to_dict = method(bundle_cls, "to_dict")
    to_json = method(bundle_cls, "to_json")
    if to_dict is None or to_json is None:
        raise SystemExit("Bundle emitter methods missing")
    segment = ast.get_source_segment(source, to_json)
    if segment is None or "canonical_json_bytes" in segment:
        raise SystemExit("to_json is not the pinned dumps emitter")
    dumps_ok = "json.dumps" in segment and "sort_keys=True" in segment
    ascii_ok = "ensure_ascii=False" in segment
    if not dumps_ok or not ascii_ok:
        raise SystemExit("to_json kwargs changed")
    keys = emitter_keys(to_dict)
    if keys != EXPECTED_EMITTER_KEYS:
        raise SystemExit(f"emitter keys {keys}")
    if set(keys) != set(schema["properties"]):
        raise SystemExit("emitter keys differ from schema properties")
    return version, keys


def facts_from(schema: dict[str, Any], version: str, keys: list[str]) -> dict[str, Any]:
    props = schema["properties"]
    source = props["source"]["properties"]
    created = props["created_by"]
    detection = props["detection"]
    report = props["report"]
    counts = report["properties"]["counts"]
    finding = report["properties"]["findings"]["items"]
    span = finding["properties"]["span"]
    skeleton = props["fixture_skeleton"]
    share = props["share_advisory"]
    return {
        "adapter_value_type": created["properties"]["adapters"]["additionalProperties"]["type"],
        "additional_properties": schema["additionalProperties"],
        "bundle_version_const": props["bundle_version"]["const"],
        "by_code_minimum": counts["properties"]["by_code"]["additionalProperties"]["minimum"],
        "confidence_type": detection["properties"]["confidences"]["additionalProperties"]["type"],
        "counts_required": counts["required"],
        "created_by_required": created["required"],
        "detection_required": detection["required"],
        "draft": schema["$schema"],
        "emitter_bundle_version": version,
        "emitter_keys": keys,
        "families_unique_items": share["properties"]["families"]["uniqueItems"],
        "finding_count_minimum": share["properties"]["finding_count"]["minimum"],
        "finding_required": finding["required"],
        "id": schema["$id"],
        "kind_count_minimum": skeleton["properties"]["kinds"]["additionalProperties"]["minimum"],
        "properties": list(props),
        "record_count_minimum": skeleton["properties"]["record_count"]["minimum"],
        "report_required": report["required"],
        "required": list(schema["required"]),
        "resolved_type": detection["properties"]["resolved"]["type"],
        "root_type": schema["type"],
        "sha256_pattern": source["sha256"]["pattern"],
        "share_kind_const": share["properties"]["kind"]["const"],
        "share_required": share["required"],
        "size_minimum": source["size"]["minimum"],
        "skeleton_required": skeleton["required"],
        "source_required": props["source"]["required"],
        "span_byte_type": span["properties"]["byte"]["type"],
        "span_line_type": span["properties"]["line"]["type"],
        "span_required": span["required"],
        "tool_const": created["properties"]["tool"]["const"],
        "total_minimum": counts["properties"]["total"]["minimum"],
    }


def dumps(doc: object) -> str:
    text = json.dumps(doc, indent=2, sort_keys=True, ensure_ascii=True) + "\n"
    if "\r" in text or "FOR_WORK" in text or "sesslint-wt-" in text or "02694d5" in text:
        raise SystemExit("refusing banned text in parity output")
    if "sbp_" in text:
        raise SystemExit("refusing sbp_ fragment in parity output")
    return text


def write_text(path: Path, text: str) -> None:
    path.write_bytes(text.encode("utf-8"))


def coverage_doc() -> dict[str, Any]:
    rows = [
        {
            "column": "column_0",
            "note": NOTES[test_id],
            "status": "not_applicable",
            "test": test_id,
            "vector_id": None,
        }
        for test_id in SCHEMA_TESTS
    ]
    if any(row["status"] == "covered" for row in rows):
        raise SystemExit("refusing a covered claim")
    return {
        "covered_count": 0,
        "module": MODULE,
        "not_applicable_count": len(rows),
        "python_commit": PYTHON_COMMIT,
        "rows": rows,
        "schema_file": SCHEMA_BLOB,
    }


def main() -> int:
    sys.dont_write_bytecode = True
    blocked = {str(ROOT), str(ROOT / "src"), "", "."}
    sys.path[:] = [item for item in sys.path if item not in blocked]
    sys.meta_path.insert(0, _PinOnly())
    OUT.mkdir(parents=True, exist_ok=True)
    schema_bytes = git_show_bytes(f"{PYTHON_COMMIT}:{SCHEMA_BLOB}")
    bundle_bytes = git_show_bytes(f"{PYTHON_COMMIT}:{BUNDLE_PY}")
    test_bytes = git_show_bytes(f"{PYTHON_COMMIT}:{TEST_FILE}")
    if b"\r" in schema_bytes or b"\r" in bundle_bytes or b"\r" in test_bytes:
        raise SystemExit("pin blob contains CR")
    embedded = embedded_schema()
    if embedded.encode("utf-8") != schema_bytes:
        raise SystemExit("embedded schema bytes differ from the pin")
    schema = json.loads(schema_bytes.decode("utf-8"))
    if not isinstance(schema, dict):
        raise SystemExit("pinned schema is not an object")
    prove(schema)
    if schema.get("additionalProperties") is not False:
        raise SystemExit("root additionalProperties is not false")
    version, keys = emitter_facts(bundle_bytes.decode("utf-8"), schema)
    assert_schema_tests(test_bytes.decode("utf-8"))
    fact_doc = facts_from(schema, version, keys)
    if set(fact_doc) != {
        "adapter_value_type",
        "additional_properties",
        "bundle_version_const",
        "by_code_minimum",
        "confidence_type",
        "counts_required",
        "created_by_required",
        "detection_required",
        "draft",
        "emitter_bundle_version",
        "emitter_keys",
        "families_unique_items",
        "finding_count_minimum",
        "finding_required",
        "id",
        "kind_count_minimum",
        "properties",
        "record_count_minimum",
        "report_required",
        "required",
        "resolved_type",
        "root_type",
        "sha256_pattern",
        "share_kind_const",
        "share_required",
        "size_minimum",
        "skeleton_required",
        "source_required",
        "span_byte_type",
        "span_line_type",
        "span_required",
        "tool_const",
        "total_minimum",
    }:
        raise SystemExit("fact keys drifted")
    vectors = [
        {
            "construct": {"fn": "schema_document", "mode": "pin", "type": "schema_facts"},
            "expected": fact_doc,
            "id": "schema_facts",
        },
        *build_vectors(schema),
    ]
    doc = {
        "bundle_py_sha256": digest(bundle_bytes),
        "known_parity_gaps": list(GAPS),
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "schema": SCHEMA_ID,
        "schema_file": SCHEMA_BLOB,
        "schema_sha256": digest(schema_bytes),
        "vectors": vectors,
    }
    payload = dumps(doc)
    write_text(OUT / "vectors.json", payload)
    file_digest = digest(payload.encode("utf-8"))
    write_text(OUT / "coverage.json", dumps(coverage_doc()))
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.bundle.v1 schema parity. Constraints and expected "
            "rejections come from the pinned schema. Bundle.to_json bytes are not "
            "stored. The pinned schema tests are not covered."
        ),
        "generator": GENERATOR,
        "known_parity_gaps": list(GAPS),
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
    }
    write_text(OUT / "PROVENANCE.json", dumps(provenance))
    manifest = {
        "bundle_py_sha256": digest(bundle_bytes),
        "generator": GENERATOR,
        "known_parity_gaps": list(GAPS),
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "schema": SCHEMA_ID,
        "schema_file": SCHEMA_BLOB,
        "schema_sha256": digest(schema_bytes),
        "vector_count": len(vectors),
        "vectors_sha256": file_digest,
    }
    write_text(OUT / "manifest.json", dumps(manifest))
    print(f"vector_count={len(vectors)}")
    print(f"vectors_sha256={file_digest}")
    print("covered=0 not_applicable=6")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
