class Unproven(Exception):
    """A comparison or keyword cannot be proven."""


def git_bytes(rev_path: str) -> bytes:
    if not rev_path.startswith(f"{PYTHON_COMMIT}:"):
        raise SystemExit("git show is limited to the pin")
    return subprocess.check_output(["git", "show", rev_path], cwd=ROOT)


def schema_test_names(path: str) -> list[str]:
    source = git_bytes(f"{PYTHON_COMMIT}:{path}").decode("utf-8")
    tree = ast.parse(source)
    return [
        node.name
        for node in tree.body
        if isinstance(node, ast.FunctionDef)
        and node.name.startswith("test_")
        and "schema" in node.name
    ]


def assert_test_list() -> None:
    by_file: dict[str, list[str]] = {}
    for test_id in SCHEMA_TESTS:
        path, name = test_id.split("::", 1)
        by_file.setdefault(path, []).append(name)
    for path, names in by_file.items():
        actual = schema_test_names(path)
        if actual != names:
            raise SystemExit(f"schema test list mismatch for {path}: {actual}")


def integer_value(value: object) -> int | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if isinstance(value, int):
        if -(2**127) < value < 2**127:
            return value
        return None
    if not value.is_integer() or abs(value) > 2**53:
        return None
    return int(value)


def json_equal(left: object, right: object) -> bool:
    if left is None or right is None:
        return left is None and right is None
    if isinstance(left, bool) or isinstance(right, bool):
        return isinstance(left, bool) and isinstance(right, bool) and left == right
    if isinstance(left, str) or isinstance(right, str):
        return isinstance(left, str) and isinstance(right, str) and left == right
    if isinstance(left, list) or isinstance(right, list):
        if not isinstance(left, list) or not isinstance(right, list) or len(left) != len(right):
            return False
        return all(json_equal(item, other) for item, other in zip(left, right))
    if isinstance(left, dict) or isinstance(right, dict):
        if not isinstance(left, dict) or not isinstance(right, dict) or set(left) != set(right):
            return False
        return all(json_equal(left[key], right[key]) for key in left)
    if isinstance(left, (int, float)) and isinstance(right, (int, float)):
        left_int = integer_value(left)
        right_int = integer_value(right)
        if left_int is not None and right_int is not None:
            return left_int == right_int
        if left_int is None and right_int is None:
            if left == right:
                return True
            raise Unproven()
        return False
    raise Unproven()


def equal_result(left: object, right: object) -> bool | None:
    try:
        return json_equal(left, right)
    except Unproven:
        return None


def type_ok(spec: object, value: object) -> bool:
    if isinstance(spec, list):
        if not spec:
            raise Unproven()
        return any(type_ok(item, value) for item in spec)
    if spec == "object":
        return isinstance(value, dict)
    if spec == "array":
        return isinstance(value, list)
    if spec == "string":
        return isinstance(value, str)
    if spec == "boolean":
        return isinstance(value, bool)
    if spec == "null":
        return value is None
    if spec == "integer":
        return integer_value(value) is not None
    if spec == "number":
        return not isinstance(value, bool) and isinstance(value, (int, float))
    raise Unproven()


def pointer(parent: str, key: str) -> str:
    escaped = key.replace("~", "~0").replace("/", "~1")
    return f"{parent}/{escaped}"


def unescape(raw: str) -> str:
    out: list[str] = []
    index = 0
    while index < len(raw):
        if raw[index] != "~":
            out.append(raw[index])
            index += 1
            continue
        if index + 1 >= len(raw) or raw[index + 1] not in "01":
            raise Unproven()
        out.append("~" if raw[index + 1] == "0" else "/")
        index += 2
    return "".join(out)


def resolve(root: object, pointer_text: str) -> object:
    if not pointer_text.startswith("#"):
        raise Unproven()
    rest = pointer_text[1:]
    if rest == "":
        return root
    if not rest.startswith("/"):
        raise Unproven()
    node = root
    for raw in rest[1:].split("/") if rest != "/" else [""]:
        key = unescape(raw)
        if isinstance(node, dict):
            if key not in node:
                raise Unproven()
            node = node[key]
            continue
        if isinstance(node, list):
            if key == "0":
                index = 0
            elif key.isdigit() and not key.startswith("0"):
                index = int(key)
            else:
                raise Unproven()
            if index >= len(node):
                raise Unproven()
            node = node[index]
            continue
        raise Unproven()
    return node


def pattern_match(pattern: str, text: str) -> bool:
    if pattern != EXPERIMENTAL_PATTERN:
        raise Unproven()
    return text.startswith("experimental_")


def check(
    root: object,
    schema: object,
    value: object,
    path: str,
    depth: int,
) -> tuple[str, str, str] | None:
    if depth >= MAX_DEPTH:
        return ("unsupported", path, "depth")
    if not isinstance(schema, dict):
        return ("unsupported", path, "schema")
    for key in schema:
        if key not in ANNOTATIONS and key not in KNOWN:
            return ("unsupported", path, str(key))
    if "format" in schema and not isinstance(schema["format"], str):
        return ("unsupported", path, "format")
    if "$defs" in schema and not isinstance(schema["$defs"], dict):
        return ("unsupported", path, "$defs")
    if "patternProperties" in schema:
        raw_patterns = schema["patternProperties"]
        if not isinstance(raw_patterns, dict):
            return ("unsupported", path, "patternProperties")
        for pattern, sub in raw_patterns.items():
            if pattern != EXPERIMENTAL_PATTERN or not isinstance(sub, dict):
                return ("unsupported", path, "pattern")
    if "properties" in schema and not isinstance(schema["properties"], dict):
        return ("unsupported", path, "properties")
    if "items" in schema and not isinstance(schema["items"], dict):
        return ("unsupported", path, "items")
    if "additionalProperties" in schema and not isinstance(
        schema["additionalProperties"], (bool, dict)
    ):
        return ("unsupported", path, "additionalProperties")
    if "required" in schema and (
        not isinstance(schema["required"], list)
        or any(not isinstance(name, str) for name in schema["required"])
    ):
        return ("unsupported", path, "required")
    if "enum" in schema and (not isinstance(schema["enum"], list) or not schema["enum"]):
        return ("unsupported", path, "enum")
    if "oneOf" in schema and (not isinstance(schema["oneOf"], list) or not schema["oneOf"]):
        return ("unsupported", path, "oneOf")
    if "$ref" in schema:
        reference = schema["$ref"]
        if not isinstance(reference, str):
            return ("unsupported", path, "$ref")
        try:
            target = resolve(root, reference)
        except Unproven:
            return ("unsupported", path, "$ref")
        failure = check(root, target, value, path, depth + 1)
        if failure is not None:
            return failure
    if "type" in schema:
        try:
            matched = type_ok(schema["type"], value)
        except Unproven:
            return ("unsupported", path, "type")
        if not matched:
            return ("type", path, "")
    if "const" in schema:
        compared = equal_result(value, schema["const"])
        if compared is None:
            return ("unsupported", path, "const")
        if not compared:
            return ("const", path, "")
    if "enum" in schema:
        choices = schema["enum"]
        if not isinstance(choices, list) or not choices:
            return ("unsupported", path, "enum")
        matched = False
        for choice in choices:
            compared = equal_result(value, choice)
            if compared is None:
                return ("unsupported", path, "enum")
            if compared:
                matched = True
                break
        if not matched:
            return ("enum", path, "")
    failure = check_string(schema, value, path)
    if failure is not None:
        return failure
    failure = check_minimum(schema, value, path)
    if failure is not None:
        return failure
    failure = check_object(root, schema, value, path, depth)
    if failure is not None:
        return failure
    failure = check_array(root, schema, value, path, depth)
    if failure is not None:
        return failure
    if "oneOf" in schema:
        return check_one_of(root, schema, value, path, depth)
    return None


def check_string(schema: dict[str, Any], value: object, path: str) -> tuple[str, str, str] | None:
    if not isinstance(value, str):
        return None
    if "minLength" in schema:
        limit = length_bound(schema["minLength"])
        if limit is None:
            return ("unsupported", path, "length")
        if len(value) < limit:
            return ("minLength", path, "")
    if "maxLength" in schema:
        limit = length_bound(schema["maxLength"])
        if limit is None:
            return ("unsupported", path, "length")
        if len(value) > limit:
            return ("maxLength", path, "")
    if "pattern" in schema:
        pattern = schema["pattern"]
        if not isinstance(pattern, str):
            return ("unsupported", path, "pattern")
        try:
            matched = pattern_match(pattern, value)
        except Unproven:
            return ("unsupported", path, "pattern")
        if not matched:
            return ("pattern", path, "")
    return None


def length_bound(bound: object) -> int | None:
    if isinstance(bound, bool) or not isinstance(bound, int) or bound < 0:
        return None
    return bound


def check_minimum(schema: dict[str, Any], value: object, path: str) -> tuple[str, str, str] | None:
    if "minimum" not in schema:
        return None
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    number = integer_value(value)
    if number is None:
        return ("unsupported", path, "minimum")
    limit = schema["minimum"]
    if isinstance(limit, bool) or not isinstance(limit, int):
        return ("unsupported", path, "minimum")
    if number < limit:
        return ("minimum", path, "")
    return None


def proven_patterns(schema: dict[str, Any]) -> list[tuple[str, dict[str, Any]]] | tuple[str, str, str]:
    raw = schema.get("patternProperties")
    if raw is None:
        return []
    if not isinstance(raw, dict):
        return ("unsupported", "", "patternProperties")
    proven: list[tuple[str, dict[str, Any]]] = []
    for pattern, sub in raw.items():
        if pattern != EXPERIMENTAL_PATTERN or not isinstance(sub, dict):
            return ("unsupported", "", "pattern")
        proven.append((pattern, sub))
    return proven


def pattern_hit(key: str, patterns: list[tuple[str, dict[str, Any]]]) -> bool | tuple[str, str, str]:
    matched = False
    for pattern, _sub in patterns:
        try:
            hit = pattern_match(pattern, key)
        except Unproven:
            return ("unsupported", "", "pattern")
        matched = matched or hit
    return matched


def check_object(
    root: object,
    schema: dict[str, Any],
    value: object,
    path: str,
    depth: int,
) -> tuple[str, str, str] | None:
    if not isinstance(value, dict):
        return None
    if "required" in schema:
        required = schema["required"]
        if not isinstance(required, list):
            return ("unsupported", path, "required")
        for name in required:
            if not isinstance(name, str):
                return ("unsupported", path, "required")
            if name not in value:
                return ("required", path, name)
    props = schema.get("properties", {})
    patterns = proven_patterns(schema)
    if isinstance(patterns, tuple):
        return (patterns[0], path, patterns[2])
    if "additionalProperties" in schema:
        if "properties" in schema and not isinstance(props, dict):
            return ("unsupported", path, "properties")
        names = props if isinstance(props, dict) else {}
        flag = schema["additionalProperties"]
        if flag is False:
            unknown: list[str] = []
            for key in value:
                if key in names:
                    continue
                hit = pattern_hit(str(key), patterns)
                if isinstance(hit, tuple):
                    return (hit[0], path, hit[2])
                if hit:
                    continue
                unknown.append(str(key))
            unknown.sort()
            if unknown:
                return ("additionalProperties", path, unknown[0])
        elif flag is True:
            pass
        elif isinstance(flag, dict):
            for key in sorted(value):
                if key in names:
                    continue
                hit = pattern_hit(str(key), patterns)
                if isinstance(hit, tuple):
                    return (hit[0], path, hit[2])
                if hit:
                    continue
                failure = check(root, flag, value[key], pointer(path, str(key)), depth + 1)
                if failure is not None:
                    return failure
        else:
            return ("unsupported", path, "additionalProperties")
    if "properties" in schema:
        if not isinstance(props, dict):
            return ("unsupported", path, "properties")
        for name, sub in props.items():
            if name in value:
                failure = check(root, sub, value[name], pointer(path, str(name)), depth + 1)
                if failure is not None:
                    return failure
    for key in sorted(value):
        for pattern, sub in patterns:
            try:
                hit = pattern_match(pattern, str(key))
            except Unproven:
                return ("unsupported", path, "pattern")
            if not hit:
                continue
            failure = check(root, sub, value[key], pointer(path, str(key)), depth + 1)
            if failure is not None:
                return failure
    return None


def check_array(
    root: object,
    schema: dict[str, Any],
    value: object,
    path: str,
    depth: int,
) -> tuple[str, str, str] | None:
    if not isinstance(value, list):
        return None
    if "items" in schema:
        item_schema = schema["items"]
        if not isinstance(item_schema, dict):
            return ("unsupported", path, "items")
        for index, item in enumerate(value):
            failure = check(root, item_schema, item, f"{path}/{index}", depth + 1)
            if failure is not None:
                return failure
    if schema.get("uniqueItems") is True:
        for right in range(1, len(value)):
            for left in range(right):
                compared = equal_result(value[left], value[right])
                if compared is None:
                    return ("unsupported", path, "uniqueItems")
                if compared:
                    return ("uniqueItems", path, "")
    elif "uniqueItems" in schema and schema["uniqueItems"] is not False:
        return ("unsupported", path, "uniqueItems")
    return None


def check_one_of(
    root: object,
    schema: dict[str, Any],
    value: object,
    path: str,
    depth: int,
) -> tuple[str, str, str] | None:
    branches = schema["oneOf"]
    if not isinstance(branches, list) or not branches:
        return ("unsupported", path, "oneOf")
    matched = 0
    unsupported: tuple[str, str, str] | None = None
    for branch in branches:
        failure = check(root, branch, value, path, depth + 1)
        if failure is None:
            matched += 1
        elif failure[0] == "unsupported":
            unsupported = failure
    if matched > 1:
        return ("oneOf", path, "")
    if unsupported is not None:
        return unsupported
    if matched != 1:
        return ("oneOf", path, "")
    return None


def walk_keywords(node: object) -> None:
    if isinstance(node, dict):
        for key in node:
            if key not in ANNOTATIONS and key not in KNOWN:
                raise SystemExit(f"unproven keyword {key}")
        if "patternProperties" in node:
            patterns = node["patternProperties"]
            if not isinstance(patterns, dict) or set(patterns) != {EXPERIMENTAL_PATTERN}:
                raise SystemExit("patternProperties changed")
            for sub in patterns.values():
                if sub != {}:
                    raise SystemExit("pattern schema is not empty")
        if "format" in node and node["format"] != "date-time":
            raise SystemExit("format changed")
        if "$ref" in node and node["$ref"] not in {HEADER_REF, EVENT_REF}:
            raise SystemExit("ref changed")
        for key, value in node.items():
            if key in {"properties", "patternProperties", "$defs"} and isinstance(value, dict):
                for child in value.values():
                    walk_keywords(child)
            elif key in {"items", "additionalProperties"} and isinstance(value, dict):
                walk_keywords(value)
            elif key == "oneOf" and isinstance(value, list):
                for child in value:
                    walk_keywords(child)
    elif isinstance(node, list):
        for child in node:
            walk_keywords(child)


def dumps(value: object) -> str:
    return json.dumps(value, ensure_ascii=True, indent=2, sort_keys=True, allow_nan=False) + "\n"


def assert_clean(text: str) -> None:
    if "\r" in text or "FOR_WORK" in text or "sesslint-wt-" in text or "C:" in text or "/Users/" in text:
        raise SystemExit("refusing banned text in parity output")
    if "sbp_" in text:
        raise SystemExit("refusing sbp hash in parity output")


def write_bytes(path: Path, payload: bytes) -> None:
    text = payload.decode("utf-8")
    assert_clean(text)
    path.write_bytes(payload)


def load_package() -> tuple[Any, Any, Any]:
    os.environ["SESSLINT_DISABLE_ACCEL"] = "1"
    sys.dont_write_bytecode = True
    archive = subprocess.check_output(
        ["git", "archive", "--format=zip", PYTHON_COMMIT, "src/sesslint"],
        cwd=ROOT,
    )
    temporary = tempfile.TemporaryDirectory(prefix="sesslint-session-schema-")
    root = Path(temporary.name)
    with zipfile.ZipFile(io.BytesIO(archive)) as zipped:
        zipped.extractall(root)
    blocked = {str(ROOT), str(ROOT / "src"), "", "."}
    sys.path[:] = [item for item in sys.path if item not in blocked]
    sys.path.insert(0, str(root / "src"))
    canonical = importlib.import_module("sesslint.canonical")
    adapters = importlib.import_module("sesslint.adapters.canonical")
    codec = importlib.import_module("sesslint._canonical_codec")
    codec.set_active_codec(codec.PurePythonCanonicalCodec())
    for module in (canonical, adapters, codec):
        file_path = Path(module.__file__).resolve()
        if not file_path.is_relative_to(root.resolve()):
            raise SystemExit(f"{module.__name__} loaded from outside the pin archive")
    if not isinstance(codec.get_active_codec(), codec.PurePythonCanonicalCodec):
        raise SystemExit("accel codec is active")
    load_package.keep = temporary  # type: ignore[attr-defined]
    return canonical, adapters, codec


def header(
    canonical: Any,
    *,
    session_id: str = "s1",
    created_at: str = TS,
    title: str | None = None,
    metadata: dict[str, Any] | None = None,
    source: dict[str, Any] | str | None = None,
    version: int | None = None,
    extra: dict[str, Any] | None = None,
) -> Any:
    return canonical.SessionHeader(
        schema_version="sesslint.session/v1",
        session_id=session_id,
        created_at=created_at,
        title=title,
        metadata=metadata or {},
        source=source,
        version=version,
        extra_fields=extra or {},
    )


def event(
    canonical: Any,
    *,
    event_id: str = "e1",
    parent_id: str | None = None,
    seq: int = 0,
    ts: str = TS,
    actor: str = "user",
    kind: str = "message",
    payload: dict[str, Any] | None = None,
    extra: dict[str, Any] | None = None,
    **optional: Any,
) -> Any:
    values: dict[str, Any] = {
        "id": event_id,
        "parent_id": parent_id,
        "seq": seq,
        "ts": ts,
        "actor": actor,
        "kind": kind,
        "payload": {"k": "v"} if payload is None else payload,
        "extra_fields": extra or {},
    }
    values.update(optional)
    return canonical.SessionEvent(**values)


def canonical_text(canonical: Any, value: Any) -> str:
    first = canonical.to_canonical_json(value)
    second = canonical.to_canonical_json(value)
    if not isinstance(first, str) or first != second or "\r" in first or first.endswith("\n"):
        raise SystemExit("to_canonical_json is not one stable document")
    json.loads(first)
    return first


def dump_text(adapters: Any, session: Any, source: dict[str, Any] | None = None) -> str:
    first = adapters.dump_canonical(session, source, format="json")
    second = adapters.dump_canonical(session, source, format="json")
    if not isinstance(first, bytes) or first != second or b"\r" in first or not first.endswith(b"\n"):
        raise SystemExit("dump_canonical json is not one stable document")
    text = first.decode("utf-8")
    json.loads(text)
    return text


def base_event_map() -> dict[str, Any]:
    return {
        "actor": "user",
        "id": "e1",
        "kind": "message",
        "parent_id": None,
        "payload": {"k": "v"},
        "seq": 0,
        "ts": TS,
    }


def base_header_map() -> dict[str, Any]:
    return {
        "created_at": TS,
        "schema_version": "sesslint.session/v1",
        "session_id": "s1",
    }


def main() -> None:
    assert_test_list()
    schema_bytes = git_bytes(f"{PYTHON_COMMIT}:schemas/sesslint.session.v1.json")
