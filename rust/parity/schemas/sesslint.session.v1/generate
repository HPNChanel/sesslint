        raise SystemExit("pin schema line endings changed")
    schema = json.loads(schema_bytes.decode("utf-8"))
    if not isinstance(schema, dict):
        raise SystemExit("pinned schema is not an object")
    walk_keywords(schema)
    if schema.get("$id") != "https://sesslint.dev/schemas/sesslint.session/v1":
        raise SystemExit("schema id changed")
    if len(schema.get("oneOf", [])) != 4:
        raise SystemExit("oneOf branch count changed")
    canonical, adapters, _codec = load_package()
    actors = list(schema["$defs"]["event"]["properties"]["actor"]["enum"])
    kinds = list(schema["$defs"]["event"]["properties"]["kind"]["enum"])
    states = [
        item
        for item in schema["$defs"]["event"]["properties"]["execution_state"]["enum"]
        if item is not None
