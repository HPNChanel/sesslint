    add_instance("header_created_at_not_date", {**header_map, "created_at": "not-a-date"})
    add_instance("header_title_number", {**header_map, "title": 1}, HEADER_REF)
    add_instance("header_title_null", {**header_map, "title": None})
    add_instance("header_metadata_array", {**header_map, "metadata": []}, HEADER_REF)
    add_instance("header_source_number", {**header_map, "source": 1}, HEADER_REF)
    add_instance("header_source_null", {**header_map, "source": None})
    add_instance("header_version_string", {**header_map, "version": "1"}, HEADER_REF)
    add_instance("header_version_bool", {**header_map, "version": True}, HEADER_REF)
    add_instance("header_version_null", {**header_map, "version": None})
