    vectors: list[dict[str, Any]] = []

    def add_python(vector_id: str, text: str, *, newline: bool, emitter: str) -> None:
        if newline:
            if not text.endswith("\n") or text[:-1].endswith("\n"):
                raise SystemExit(f"{vector_id} newline")
            body = text[:-1]
        else:
            if text.endswith(("\n", " ", "\t")):
                raise SystemExit(f"{vector_id} trailing whitespace")
            body = text
        parsed = json.loads(body)
        failure = check(schema, schema, parsed, "", 0)
        if failure is not None:
            raise SystemExit(f"{vector_id} emitter rejected {failure}")
        vectors.append(
            {
                "emitter": emitter,
                "expected": {"ok": True},
                "id": vector_id,
                "python_json": text,
                "trailing_newline": newline,
            }
        )

    def add_instance(vector_id: str, instance: object, pointer_text: str = "#") -> None:
        try:
            target = resolve(schema, pointer_text)
        except Unproven as err:
            raise SystemExit(f"{vector_id} pointer") from err
        failure = check(schema, target, instance, "", 0)
        if failure is None:
            expected: dict[str, Any] = {"ok": True}
        else:
            keyword, path, detail = failure
            if keyword == "unsupported":
                raise SystemExit(f"{vector_id} unsupported at {path} ({detail})")
            expected = {"detail": detail, "keyword": keyword, "ok": False, "path": path}
        item: dict[str, Any] = {"expected": expected, "id": vector_id, "instance": instance}
        if pointer_text != "#":
            item["schema_pointer"] = pointer_text
        vectors.append(item)

