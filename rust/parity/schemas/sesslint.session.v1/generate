    ids = [item["id"] for item in vectors]
    if len(ids) != len(set(ids)):
        raise SystemExit("duplicate vector id")
    header_props = schema["$defs"]["header"]["properties"]
    event_props = schema["$defs"]["event"]["properties"]
    flat_props = schema["oneOf"][0]["properties"]
    framed_props = schema["oneOf"][1]["properties"]
    facts = {
        "actor_enum": actors,
        "branch_count": 4,
        "event_emit_order": sorted(event_props),
        "event_required": list(schema["$defs"]["event"]["required"]),
        "execution_state_enum": list(schema["$defs"]["event"]["properties"]["execution_state"]["enum"]),
        "flat_emit_order": sorted(flat_props),
