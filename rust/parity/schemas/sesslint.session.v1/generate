            git_bytes(f"{PYTHON_COMMIT}:src/sesslint/adapters/canonical.py")
        ).hexdigest(),
        "canonical_py_sha256": hashlib.sha256(
            git_bytes(f"{PYTHON_COMMIT}:src/sesslint/canonical.py")
