        ],
        "schema_file": "schemas/sesslint.session.v1.json",
    }
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.session.v1 schema parity. Header, event, and framed "
            "bytes come from to_canonical_json. Flat bytes come from dump_canonical "
            "format json. No session payload from a real transcript is stored."
        ),
        "generator": GENERATOR,
        "known_parity_gaps": [
            "dump_session and dump_canonical format jsonl return a header line plus one line per event. That byte string is not one JSON document, so it is not expected output.",
