def emitter_document(report: Any) -> dict[str, Any]:
    action = report.RepairAction(kind="drop", record_id="r1", detail="d")
    revalidation = report.RevalidationSummary(
        assurance="A1",
        error_count=0,
        warning_count=0,
        profile_id="neutral",
        profile_version="1",
    )
    item = report.RepairManifest(
        schema_version="sesslint.repair-manifest/v1",
        input_fingerprint="in",
        output_fingerprint="out",
        policy="conservative",
        actions=(action,),
        declared_loss=("gap",),
        revalidate_report=None,
        idempotency_key="0" * 64,
        revalidation=revalidation,
        assurance_ceiling="A1",
    )
    document = item.to_dict()
    if not isinstance(document, dict):
        raise SystemExit("to_dict did not return an object")
    return document


def assert_emitter_shape(schema: dict[str, Any], emitted: dict[str, Any]) -> None:
    for name in schema["required"]:
        if name not in emitted:
            raise SystemExit(f"emitter omitted required {name}")
    if emitted["input_fingerprint"] != "in" or emitted["output_fingerprint"] != "out":
        raise SystemExit("emitter document is not the synthetic manifest")
    if emitted["idempotency_key"] != "0" * 64:
        raise SystemExit("emitter document key is not the synthetic key")
    actions = emitted["actions"]
    if not isinstance(actions, list) or len(actions) != 1 or not isinstance(actions[0], dict):
        raise SystemExit("emitter actions shape changed")
    if actions[0].get("kind") != "drop":
        raise SystemExit("emitter action kind changed")
    revalidation = emitted["revalidation"]
    if not isinstance(revalidation, dict) or revalidation.get("error_count") != 0:
        raise SystemExit("emitter revalidation shape changed")
    assert_clean(json.dumps(emitted, ensure_ascii=True, sort_keys=True))


def facts_from(schema: dict[str, Any], report: Any, emitted: dict[str, Any]) -> dict[str, Any]:
    properties = schema["properties"]
    actions = properties["actions"]["items"]
    revalidation = properties["revalidation"]
    policies = set(report.VALID_POLICIES)
    levels = set(report.VALID_ASSURANCE_LEVELS)
    if policies != set(properties["policy"]["enum"]):
        raise SystemExit("emitter policies disagree with the pinned schema")
    if levels != set(properties["assurance_ceiling"]["enum"]):
        raise SystemExit("emitter assurance ceiling disagrees with the pinned schema")
    if levels != set(revalidation["properties"]["assurance"]["enum"]):
        raise SystemExit("emitter revalidation assurance disagrees with the pinned schema")
    if report.MANIFEST_SCHEMA_VERSION != properties["schema_version"]["const"]:
        raise SystemExit("emitter schema_version disagrees with the pinned const")
    if properties["idempotency_key"]["pattern"] != IDEMPOTENCY_PATTERN:
        raise SystemExit("pinned idempotency pattern changed")
    if schema["additionalProperties"] is not False:
        raise SystemExit("root additionalProperties is not false")
    if actions["additionalProperties"] is not False:
        raise SystemExit("action additionalProperties is not false")
    if revalidation["additionalProperties"] is not False:
        raise SystemExit("revalidation additionalProperties is not false")
    recipe_type = plain_value_type(properties["recipe_versions"]["additionalProperties"], "recipe")
    byte_type = plain_value_type(properties["byte_counts"]["additionalProperties"], "byte_counts")
    record_type = plain_value_type(
        properties["record_counts"]["additionalProperties"], "record_counts"
    )
    if recipe_type != "string" or byte_type != "integer" or record_type != "integer":
        raise SystemExit("additionalProperties value types changed")
    return {
        "action_additional_properties": actions["additionalProperties"],
        "action_kind_min_length": actions["properties"]["kind"]["minLength"],
        "action_property_names": list(actions["properties"].keys()),
        "action_required": actions["required"],
        "additional_properties": schema["additionalProperties"],
        "assurance_enum": properties["assurance_ceiling"]["enum"],
        "byte_counts_value_type": byte_type,
        "emitter_assurance_levels": sorted(levels),
        "emitter_keys": sorted(emitted.keys()),
        "emitter_policies": sorted(policies),
        "emitter_schema_version": report.MANIFEST_SCHEMA_VERSION,
        "error_count_minimum": revalidation["properties"]["error_count"]["minimum"],
        "id": schema["$id"],
        "idempotency_pattern": properties["idempotency_key"]["pattern"],
        "input_min_length": properties["input_fingerprint"]["minLength"],
        "output_min_length": properties["output_fingerprint"]["minLength"],
        "policy_enum": properties["policy"]["enum"],
        "profile_id_min_length": revalidation["properties"]["profile_id"]["minLength"],
        "profile_version_min_length": revalidation["properties"]["profile_version"]["minLength"],
        "property_names": list(properties.keys()),
        "recipe_versions_value_type": recipe_type,
        "record_counts_value_type": record_type,
        "required": schema["required"],
        "revalidation_additional_properties": revalidation["additionalProperties"],
        "revalidation_assurance_enum": revalidation["properties"]["assurance"]["enum"],
        "revalidation_property_names": list(revalidation["properties"].keys()),
        "revalidation_required": revalidation["required"],
        "schema_version_const": properties["schema_version"]["const"],
        "warning_count_minimum": revalidation["properties"]["warning_count"]["minimum"],
    }


def coverage_doc() -> dict[str, Any]:
    rows = [
        {
            "note": NOTES[test_id],
            "status": "not_applicable",
            "test": test_id,
            "vector_id": None,
        }
        for test_id in SCHEMA_TESTS
    ]
    return {
        "covered_count": 0,
        "module": "sesslint.report",
        "not_applicable_count": len(rows),
        "python_commit": PYTHON_COMMIT,
        "rows": rows,
        "schema_file": "schemas/sesslint.repair-manifest.v1.json",
    }


def assert_oracle_samples(schema: dict[str, Any]) -> None:
    properties = schema["properties"]
    samples = (
        (properties["recipe_versions"], {"k": 1}, ("type", "/recipe_versions/k", "")),
        (properties["recipe_versions"], {"k": "v"}, None),
        (properties["byte_counts"], {"n": True}, ("type", "/byte_counts/n", "")),
        (properties["byte_counts"], {"n": -1}, None),
        (properties["assurance_ceiling"], "A9", ("enum", "/assurance_ceiling", "")),
        (properties["idempotency_key"], "0" * 64, None),
        (properties["idempotency_key"], "0" * 63, ("pattern", "/idempotency_key", "")),
    )
    for node, value, expected in samples:
        failure = check(node, value, "")
        if node is properties["recipe_versions"]:
            failure = check(node, value, "/recipe_versions")
        elif node is properties["byte_counts"]:
            failure = check(node, value, "/byte_counts")
        elif node is properties["assurance_ceiling"]:
            failure = check(node, value, "/assurance_ceiling")
        elif node is properties["idempotency_key"]:
            failure = check(node, value, "/idempotency_key")
        if failure != expected:
            raise SystemExit(f"oracle sample mismatch: {failure} != {expected}")


def main() -> None:
    assert_pattern_engine()
    assert_test_list()
    schema_bytes = git_show_bytes(SCHEMA_GIT)
    report_bytes = git_show_bytes(REPORT_GIT)
    if b"\r" in schema_bytes or b"\r" in report_bytes:
        raise SystemExit("pin blob contains CR")
    embedded = embedded_schema()
    if embedded.encode("utf-8") != schema_bytes:
        raise SystemExit("embedded schema bytes differ from the pin")
    schema = json.loads(schema_bytes.decode("utf-8"))
    if not isinstance(schema, dict):
        raise SystemExit("pinned schema is not an object")
    assert_oracle_samples(schema)
    report = load_emitter()
    emitted = emitter_document(report)
    assert_emitter_shape(schema, emitted)
    if expect(schema, emitted) != {"ok": True}:
        raise SystemExit("emitter to_dict is not valid for the pinned schema")
    vectors = build_vectors(schema, emitted)
    document = {
        "facts": facts_from(schema, report, emitted),
        "python_commit": PYTHON_COMMIT,
        "schema": "sesslint.parity-schema-vectors/v1",
        "vectors": vectors,
    }
    vectors_text = dumps(document)
    vectors_sha = hashlib.sha256(vectors_text.encode("utf-8")).hexdigest()
    manifest = {
        "generator": GENERATOR,
        "python_commit": PYTHON_COMMIT,
        "report_py_sha256": hashlib.sha256(report_bytes).hexdigest(),
        "schema": "sesslint.parity-schema-vectors/v1",
        "schema_file": "schemas/sesslint.repair-manifest.v1.json",
        "schema_sha256": hashlib.sha256(schema_bytes).hexdigest(),
        "vector_count": len(vectors),
        "vectors_sha256": vectors_sha,
    }
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.repair-manifest.v1 schema parity. Constraints and expected "
            "rejections come from the pinned schema. One object comes from "
            "RepairManifest.to_dict on the pinned emitter. No session text is stored."
        ),
        "generator": GENERATOR,
        "known_parity_gaps": [
            "Schema path resolution and the missing-file loader are not this validator.",
            "Fixture repair execution and the model anti-drift set comparison are not one "
            "accepted or rejected instance.",
            "Content-free checks and computed idempotency bytes are not produced.",
        ],
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
    }
    write_text(OUT / "vectors.json", vectors_text)
    write_text(OUT / "coverage.json", dumps(coverage_doc()))
    write_text(OUT / "manifest.json", dumps(manifest))
    write_text(OUT / "PROVENANCE.json", dumps(provenance))
    print(f"vector_count={len(vectors)}")
    print(f"vectors_sha256={vectors_sha}")


if __name__ == "__main__":
    main()
