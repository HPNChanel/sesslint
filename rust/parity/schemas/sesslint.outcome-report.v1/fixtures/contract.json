{
  "schema_version": "sesslint.outcome-contract/v1",
  "name": "orders-to-shipments",
  "version": "1",
  "description": "Every open synthetic order gets exactly one shipment record within one hour.",
  "key": {"source": "order_id", "target": "order_ref"},
  "eligibility": [{"field": "state", "op": "ne", "value": "cancelled"}],
  "due": {"source_time_field": "placed_at", "within_seconds": 3600},
  "conditions": [
    {"id": "shipment-exists", "type": "exists"},
    {"id": "single-shipment", "type": "count", "min": 1, "max": 1},
    {"id": "status-set", "type": "required", "field": "status"},
    {"id": "status-known", "type": "one_of", "field": "status", "values": ["shipped", "delivered"], "normalize": ["trim", "casefold"]},
    {"id": "sku-matches", "type": "equals", "field": "sku", "source_field": "sku"},
    {"id": "eu-warehouse", "type": "route", "field": "warehouse", "values": ["EU-1"], "when": [{"field": "region", "op": "eq", "value": "EU"}]},
    {"id": "shipped-on-time", "type": "on_time", "basis": "target_time", "field": "shipped_at"},
    {"id": "weight-plausible", "type": "range", "field": "weight_kg", "min": 0, "max": 50, "advisory": true}
  ]
}
