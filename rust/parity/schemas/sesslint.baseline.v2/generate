def coverage_rows() -> list[dict[str, Any]]:
    covered = {
        "test_load_malformed_v2_fails": "load_malformed_v2",
        "test_upgrade_unverified_without_source": "upgrade_unverified_without_source",
        "test_upgrade_deterministic": "upgrade_deterministic",
    }
    rows: list[dict[str, Any]] = []
    order = [
        "test_baseline_v2_round_trip",
        "test_load_v1_still_supported",
        "test_load_missing_fails",
        "test_load_malformed_v1_fails",
        "test_load_malformed_v2_fails",
        "test_load_wrong_schema_fails",
        "test_file_role_normalizes_spelling",
        "test_file_role_bare_name_uses_cwd",
        "test_v2_key_path_spelling_independent",
        "test_v2_key_immediate_parent_rename_differs",
        "test_check_write_v2_then_baseline",
        "test_check_v2_baseline_survives_relative_invoke",
        "test_v1_baseline_still_suppresses_via_v1_leg",
        "test_ambiguous_v2_key_suppresses_nothing",
        "test_upgrade_unverified_without_source",
        "test_upgrade_verified_with_source",
        "test_upgrade_rejects_non_v1",
        "test_upgrade_deterministic",
        "test_check_missing_baseline_fails",
        "test_scan_baseline_suppresses",
        "test_scan_v2_baseline_survives_tree_rename",
        "test_baseline_flags_mutually_exclusive",
    ]
    for name in order:
        vector_id = covered.get(name)
        if vector_id is None and name not in NOTES:
            raise SystemExit(f"missing note {name}")
        rows.append(
            {
                "test": f"{TEST_FILE}::{name}",
                "column": "column_0",
                "status": "covered" if vector_id else "not_applicable",
                "vector_id": vector_id,
                "note": "" if vector_id else NOTES[name],
            }
        )
    covered_count = sum(row["status"] == "covered" for row in rows)
    if covered_count != COVERED_COUNT or len(rows) != PINNED_TEST_COUNT:
        raise SystemExit("coverage counts drifted")
    return rows


def dump(doc: Any) -> str:
    text = json.dumps(doc, indent=2, sort_keys=True) + "\n"
    if "\r" in text or _SBP.search(text):
        raise SystemExit("refusing CR or sbp hash in JSON")
    for banned in _BANNED:
        if banned in text:
            raise SystemExit(f"refusing banned fragment {banned}")
    return text


def write_text(path: Path, text: str) -> None:
    path.write_bytes(text.encode("utf-8"))


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    schema_blob = git_show_bytes(f"{PYTHON_COMMIT}:{SCHEMA_PATH}")
    if b"02694d5" in schema_blob:
        raise SystemExit("refusing 02694d5 in the schema")
    constraints = require_schema(schema_blob)
    test_text = git_show_bytes(f"{PYTHON_COMMIT}:{TEST_FILE}").decode("utf-8")
    prove_tests(test_text)
    emitter_blob = git_show_bytes(f"{PYTHON_COMMIT}:{EMITTER_PATH}")
    baseline = load_emitter()
    vectors = build_vectors(baseline)
    rows = coverage_rows()
    schema_sha = hashlib.sha256(schema_blob).hexdigest()
    emitter_sha = hashlib.sha256(emitter_blob).hexdigest()
    envelope = {
        "baseline_py_sha256": emitter_sha,
        "constraints": constraints,
        "module": MODULE,
        "python_commit": PYTHON_COMMIT,
        "schema": ENVELOPE,
        "schema_id": SCHEMA_ID,
        "schema_sha256": schema_sha,
        "vectors": vectors,
    }
    vectors_text = dump(envelope)
    vectors_sha = hashlib.sha256(vectors_text.encode("utf-8")).hexdigest()
    coverage = {
        "covered_count": COVERED_COUNT,
        "module": MODULE,
        "not_applicable_count": PINNED_TEST_COUNT - COVERED_COUNT,
        "python_commit": PYTHON_COMMIT,
        "rows": rows,
        "schema_id": SCHEMA_ID,
        "test_file": TEST_FILE,
    }
    manifest = {
        "baseline_py_sha256": emitter_sha,
        "covered_count": COVERED_COUNT,
        "generator": GENERATOR,
        "module": MODULE,
        "not_applicable_count": PINNED_TEST_COUNT - COVERED_COUNT,
        "python_commit": PYTHON_COMMIT,
        "schema": ENVELOPE,
        "schema_id": SCHEMA_ID,
        "schema_sha256": schema_sha,
        "vector_count": VECTOR_COUNT,
        "vectors_sha256": vectors_sha,
    }
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.baseline.v2 schema vectors. Emitter documents "
            "come from the pinned blob. Session text is not stored."
        ),
        "generator": GENERATOR,
        "known_parity_gaps": [
            (
                "GAP-baseline-schema-fixture: tests that call main or _findings "
                "on a fixture session are not replayed. Session text is not stored."
            ),
            (
                "GAP-baseline-schema-other-functions: file_role, compute_v2_key, "
                "filter_findings, and v1 load are different functions from the "
                "v2 schema check."
            ),
            (
                "GAP-baseline-schema-partial: a test that mixes write, load, and "
                "upgrade is not covered by one of those calls."
            ),
        ],
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
    }
    write_text(OUT / "vectors.json", vectors_text)
    write_text(OUT / "coverage.json", dump(coverage))
    write_text(OUT / "manifest.json", dump(manifest))
    write_text(OUT / "PROVENANCE.json", dump(provenance))
    reread = (OUT / "vectors.json").read_bytes()
    if hashlib.sha256(reread).hexdigest() != vectors_sha:
        raise SystemExit("vectors sha changed while writing")
    print(f"vectors {VECTOR_COUNT} sha {vectors_sha}")
    print(f"schema_sha {schema_sha}")
    print(f"baseline_py_sha {emitter_sha}")
    print(f"covered {COVERED_COUNT} not_applicable {PINNED_TEST_COUNT - COVERED_COUNT}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
