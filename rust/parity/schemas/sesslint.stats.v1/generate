class CheckoutImportRefused(Exception):
    """A sesslint import missed the pin and must not fall through to the checkout."""


class Unproven(Exception):
    """A comparison cannot be proven."""


class _PinOnly(importlib.abc.MetaPathFinder):
    def find_spec(
        self,
        fullname: str,
        path: object = None,
        target: object = None,
    ) -> None:
        del path, target
        if fullname == "sesslint" or fullname.startswith("sesslint."):
            raise CheckoutImportRefused(fullname)
        return None


class _PinLoader(importlib.abc.Loader):
    def __init__(self, source: str, origin: str) -> None:
        self._source = source
        self._origin = origin

    def create_module(self, spec: object) -> None:
        del spec
        return None

    def exec_module(self, module: types.ModuleType) -> None:
        code = compile(self._source, self._origin, "exec")
        exec(code, module.__dict__)


def install_refusal() -> None:
    sys.dont_write_bytecode = True
    blocked = {str(ROOT), str(ROOT / "src"), "", "."}
    sys.path[:] = [item for item in sys.path if item not in blocked]
    sys.meta_path.insert(0, _PinOnly())


def assert_checkout_import_refused() -> None:
    try:
        importlib.import_module("sesslint.stats")
    except CheckoutImportRefused:
        return
    except ModuleNotFoundError as exc:
        raise SystemExit("isolated ModuleNotFoundError is not a pin result") from exc
    raise SystemExit("sesslint import was not refused")


def exec_pin_blob(source: str) -> None:
    if "02694d5" in source:
        raise SystemExit("refusing 02694d5")
    name = "_pin_sesslint_stats"
    origin = f"{PYTHON_COMMIT}:src/sesslint/stats.py"
    loader = _PinLoader(source, origin)
    spec = importlib.util.spec_from_loader(name, loader)
    if spec is None or spec.loader is None:
        raise SystemExit("pin loader spec is missing")
    module = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(module)
    except CheckoutImportRefused:
        return
    except ModuleNotFoundError as exc:
        raise SystemExit("isolated ModuleNotFoundError is not a pin result") from exc
    raise SystemExit("pin stats module loaded without a sesslint refusal")


def git_show_bytes(rev_path: str) -> bytes:
    if "02694d5" in rev_path:
        raise SystemExit("refusing 02694d5")
    if not rev_path.startswith(f"{PYTHON_COMMIT}:"):
        raise SystemExit("git show is limited to the pin")
    return subprocess.check_output(["git", "show", rev_path], cwd=ROOT)


def embedded_schema() -> str:
    text = RS_PATH.read_text(encoding="utf-8")
    marker = 'STATS_SCHEMA_JSON: &str = r##"'
    start = text.find(marker)
    if start < 0:
        raise SystemExit("schema const missing")
    start += len(marker)
    end = text.find('"##;', start)
    if end < 0:
        raise SystemExit("schema const end missing")
    body = text[start:end]
    if body == "___PIN_SCHEMA___":
        raise SystemExit("schema placeholder was not spliced")
    return body


def schema_test_names(source: str) -> list[str]:
    tree = ast.parse(source)
    names: list[str] = []
    for node in tree.body:
        if isinstance(node, ast.FunctionDef) and _is_schema_test(node.name):
            names.append(node.name)
        if isinstance(node, ast.ClassDef):
            for child in node.body:
                if isinstance(child, ast.FunctionDef) and _is_schema_test(child.name):
                    raise SystemExit(f"class schema test is not flat: {node.name}.{child.name}")
    return names


def _is_schema_test(name: str) -> bool:
    return name.startswith("test_") and "schema" in name


def assert_test_list(source: str) -> None:
    names = schema_test_names(source)
    expected = [test_id.split("::", 1)[1] for test_id in SCHEMA_TESTS]
    if names != expected:
        raise SystemExit(f"schema test list mismatch: {names}")


def schema_test_function(source: str) -> ast.FunctionDef:
    tree = ast.parse(source)
    for node in tree.body:
        if isinstance(node, ast.FunctionDef) and node.name == "test_stats_json_schema":
            return node
    raise SystemExit("test_stats_json_schema missing")


def assert_schema_test_is_a_sweep(source: str) -> None:
    function = schema_test_function(source)
    asserts = [node for node in ast.walk(function) if isinstance(node, ast.Assert)]
    if len(asserts) != 6:
        raise SystemExit(f"schema test assert count changed: {len(asserts)}")
    calls: set[str] = set()
    for node in ast.walk(function):
        if not isinstance(node, ast.Call):
            continue
        func = node.func
        if isinstance(func, ast.Name):
            calls.add(func.id)
        elif isinstance(func, ast.Attribute):
            calls.add(func.attr)
    required = {"_write_jsonl", "main", "loads", "load_stats_schema", "dumps", "readouterr"}
    if not required <= calls:
        raise SystemExit(f"schema test calls changed: {sorted(calls)}")
    if "validate" in calls:
        raise SystemExit("schema test calls validate; refusing to guess coverage")


def literal_assign(source: str, name: str) -> object:
    tree = ast.parse(source)
    for node in tree.body:
        value: ast.expr | None = None
        if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
            if node.target.id == name:
                value = node.value
        elif isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name) and target.id == name:
                    value = node.value
        if value is None:
            continue
        try:
            return ast.literal_eval(value)
        except (ValueError, SyntaxError) as exc:
            raise SystemExit(f"{name} is not a literal") from exc
    raise SystemExit(f"{name} missing")


def integer_value(value: object) -> int | None:
    """Return a proven i128. ``i128::MIN`` is not proven: its magnitude does not fit."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if isinstance(value, int):
        if -(2**127) < value < 2**127:
            return value
        return None
    if not math.isfinite(value) or abs(value) > 2**53 or not value.is_integer():
        return None
    return int(value)


def json_equal(left: object, right: object) -> bool:
    if left is None or right is None:
        return left is None and right is None
    if isinstance(left, bool) or isinstance(right, bool):
        return isinstance(left, bool) and isinstance(right, bool) and left == right
    if isinstance(left, str) or isinstance(right, str):
        return isinstance(left, str) and isinstance(right, str) and left == right
    if isinstance(left, list) or isinstance(right, list):
        if not isinstance(left, list) or not isinstance(right, list) or len(left) != len(right):
            return False
        return all(json_equal(item, other) for item, other in zip(left, right, strict=True))
    if isinstance(left, dict) or isinstance(right, dict):
        if not isinstance(left, dict) or not isinstance(right, dict) or set(left) != set(right):
            return False
        return all(json_equal(left[key], right[key]) for key in left)
    if isinstance(left, (int, float)) and isinstance(right, (int, float)):
        left_int = integer_value(left)
        right_int = integer_value(right)
        if left_int is None or right_int is None:
            raise Unproven()
        return left_int == right_int
    raise Unproven()


def equal_result(left: object, right: object) -> bool | None:
    try:
        return json_equal(left, right)
    except Unproven:
        return None


def type_ok(spec: object, value: object) -> bool:
    if isinstance(spec, list):
        return any(type_ok(item, value) for item in spec)
    if spec == "object":
        return isinstance(value, dict)
    if spec == "array":
        return isinstance(value, list)
    if spec == "string":
        return isinstance(value, str)
    if spec == "boolean":
        return isinstance(value, bool)
    if spec == "null":
        return value is None
    if spec == "integer":
        return integer_value(value) is not None
    if spec == "number":
        return not isinstance(value, bool) and isinstance(value, (int, float))
    raise Unproven()


def pointer(parent: str, key: str) -> str:
    return parent + "/" + key.replace("~", "~0").replace("/", "~1")


def unescape_pointer(token: str) -> str | None:
    out: list[str] = []
    index = 0
    while index < len(token):
        if token[index] != "~":
            out.append(token[index])
            index += 1
            continue
        if index + 1 >= len(token):
            return None
        nxt = token[index + 1]
        if nxt == "0":
            out.append("~")
        elif nxt == "1":
            out.append("/")
        else:
            return None
        index += 2
    return "".join(out)


def resolve_ref(root: object, reference: object) -> object | None:
    if not isinstance(reference, str):
        return None
    if reference == "#":
        return root
    if not reference.startswith("#/"):
        return None
    current = root
    for token in reference[2:].split("/"):
        key = unescape_pointer(token)
        if key is None or not isinstance(current, dict) or key not in current:
            return None
        current = current[key]
    return current


def check(
    schema: object,
    value: object,
    path: str,
    root: object,
    depth: int,
) -> tuple[str, str, str] | None:
    if depth >= CHECK_MAX_DEPTH:
        return ("unsupported", path, "depth")
    if not isinstance(schema, dict):
        return ("unsupported", path, "schema")
    for key in schema:
        if key not in ANNOTATIONS and key not in KNOWN:
            return ("unsupported", path, str(key))
    if "type" in schema:
        try:
            matched = type_ok(schema["type"], value)
        except Unproven:
            return ("unsupported", path, "type")
        if not matched:
            return ("type", path, "")
    if "const" in schema:
        compared = equal_result(value, schema["const"])
        if compared is None:
            return ("unsupported", path, "const")
        if not compared:
            return ("const", path, "")
    if "enum" in schema:
        choices = schema["enum"]
        if not isinstance(choices, list):
            return ("unsupported", path, "enum")
        matched = False
        for choice in choices:
            compared = equal_result(value, choice)
            if compared is None:
                return ("unsupported", path, "enum")
            if compared:
                matched = True
                break
        if not matched:
            return ("enum", path, "")
    failure = check_minimum(schema, value, path)
    if failure is not None:
        return failure
    failure = check_object(schema, value, path, root, depth)
    if failure is not None:
        return failure
    failure = check_array(schema, value, path, root, depth)
    if failure is not None:
        return failure
    if "$ref" in schema:
        target = resolve_ref(root, schema["$ref"])
        if target is None:
            return ("unsupported", path, "$ref")
        return check(target, value, path, root, depth + 1)
    return None


def check_minimum(schema: dict[str, Any], value: object, path: str) -> tuple[str, str, str] | None:
    if "minimum" not in schema:
        return None
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    number = integer_value(value)
    if number is None:
        return ("unsupported", path, "minimum")
    limit = schema["minimum"]
    if isinstance(limit, bool) or not isinstance(limit, int):
        return ("unsupported", path, "minimum")
    if number < limit:
        return ("minimum", path, "")
    return None


def check_object(
    schema: dict[str, Any],
    value: object,
    path: str,
    root: object,
    depth: int,
) -> tuple[str, str, str] | None:
    if not isinstance(value, dict):
        return None
    if "required" in schema:
        required = schema["required"]
        if not isinstance(required, list):
            return ("unsupported", path, "required")
        for name in required:
            if not isinstance(name, str):
                return ("unsupported", path, "required")
            if name not in value:
                return ("required", path, name)
    if "additionalProperties" in schema:
        failure = check_additional(schema, value, path, root, depth)
        if failure is not None:
            return failure
    if "properties" in schema:
        props = schema["properties"]
        if not isinstance(props, dict):
            return ("unsupported", path, "properties")
        for name, sub in props.items():
            if name in value:
                failure = check(sub, value[name], pointer(path, str(name)), root, depth + 1)
                if failure is not None:
                    return failure
    return None


def check_additional(
    schema: dict[str, Any],
    value: dict[str, Any],
    path: str,
    root: object,
    depth: int,
) -> tuple[str, str, str] | None:
    flag = schema["additionalProperties"]
    props = schema.get("properties", {})
    if not isinstance(props, dict):
        return ("unsupported", path, "properties")
    if flag is False:
        for key in value:
            if key not in props:
                return ("additionalProperties", path, str(key))
        return None
    if flag is True:
        return None
    if isinstance(flag, dict):
        for key, item in value.items():
            if key not in props:
                failure = check(flag, item, pointer(path, str(key)), root, depth + 1)
                if failure is not None:
                    return failure
        return None
    return ("unsupported", path, "additionalProperties")


def check_array(
    schema: dict[str, Any],
    value: object,
    path: str,
    root: object,
    depth: int,
) -> tuple[str, str, str] | None:
    if not isinstance(value, list):
        return None
    if "items" in schema:
        item_schema = schema["items"]
        if not isinstance(item_schema, dict):
            return ("unsupported", path, "items")
        for index, item in enumerate(value):
            failure = check(item_schema, item, f"{path}/{index}", root, depth + 1)
            if failure is not None:
                return failure
    return None


def first_unknown(schema: object) -> str | None:
    if not isinstance(schema, dict):
        return None
    for key in schema:
        if key not in ANNOTATIONS and key not in KNOWN:
            return str(key)
    for key, value in schema.items():
        if key in {"properties", "$defs"}:
            if isinstance(value, dict):
                for sub in value.values():
                    found = first_unknown(sub)
                    if found is not None:
                        return found
            continue
        if key in {"items", "additionalProperties"} and isinstance(value, dict):
            found = first_unknown(value)
            if found is not None:
                return found
    return None


def assert_absent(value: object) -> None:
    if isinstance(value, dict):
        for key, child in value.items():
            if key in ABSENT:
                raise SystemExit(f"pinned schema states {key}")
            assert_absent(child)
    elif isinstance(value, list):
        for item in value:
            assert_absent(item)


def subschema(schema: dict[str, Any], path: tuple[str, ...]) -> dict[str, Any]:
    current: object = schema
    for key in path:
        if not isinstance(current, dict) or key not in current:
            raise SystemExit(f"schema path missing: {path}")
        current = current[key]
    if not isinstance(current, dict):
        raise SystemExit(f"schema path is not an object: {path}")
    return current


def assert_integer_schema(node: object) -> None:
    if node != {"type": "integer", "minimum": 0}:
        raise SystemExit(f"integer schema changed: {node}")


def assert_map_schema(node: object) -> None:
    if node != {
        "type": "object",
        "additionalProperties": {"type": "integer", "minimum": 0},
    }:
        raise SystemExit(f"map schema changed: {node}")


def assert_schema_shape(schema: dict[str, Any], version: str, max_tool_rows: int) -> None:
    unknown = first_unknown(schema)
    if unknown is not None:
        raise SystemExit(f"pinned schema states {unknown}, which this checker does not prove")
    assert_absent(schema)
    if schema.get("$schema") != "https://json-schema.org/draft/2020-12/schema":
        raise SystemExit("pinned schema dialect changed")
    if schema.get("$id") != SCHEMA_ID:
        raise SystemExit("pinned schema id changed")
    if schema.get("type") != "object":
        raise SystemExit("root type changed")
    if schema.get("additionalProperties") is not False:
        raise SystemExit("root additionalProperties changed")
    if schema.get("required") != ROOT_REQUIRED:
        raise SystemExit("root required changed")
    properties = schema.get("properties")
    if not isinstance(properties, dict) or list(properties) != ROOT_PROPERTIES:
        raise SystemExit("root properties changed")
    if version != properties["schema_version"].get("const"):
        raise SystemExit("STATS_SCHEMA_VERSION disagrees with the pinned const")
    if properties["schema_version"] != {"const": version}:
        raise SystemExit("schema_version schema changed")
    if properties["tool_version"] != {"type": "string"}:
        raise SystemExit("tool_version schema changed")
    if properties["root_path"] != {"type": "string"}:
        raise SystemExit("root_path schema changed")
    if max_tool_rows != 100:
        raise SystemExit("MAX_TOOL_ROWS changed; the schema still has no maxProperties")
    files = properties["files"]
    events = properties["events"]
    tool_calls = properties["tool_calls"]
    file_bytes = properties["file_bytes"]
    events_per_file = properties["events_per_file"]
    for node, required in (
        (files, FILES_REQUIRED),
        (file_bytes, DIST_REQUIRED),
        (events_per_file, DIST_REQUIRED),
    ):
        if not isinstance(node, dict) or node.get("type") != "object":
            raise SystemExit("closed object type changed")
        if node.get("additionalProperties") is not False:
            raise SystemExit("closed object additionalProperties changed")
        if node.get("required") != required:
            raise SystemExit(f"closed required changed: {required}")
        props = node.get("properties")
        if not isinstance(props, dict) or list(props) != required:
            raise SystemExit(f"closed properties changed: {required}")
        for child in props.values():
            assert_integer_schema(child)
    if events.get("type") != "object" or events.get("additionalProperties") is not False:
        raise SystemExit("events object changed")
    if events.get("required") != EVENTS_REQUIRED:
        raise SystemExit("events required changed")
    event_props = events.get("properties")
    if not isinstance(event_props, dict) or list(event_props) != ["total", "by_kind", "by_actor"]:
        raise SystemExit("events properties changed")
    assert_integer_schema(event_props["total"])
    assert_map_schema(event_props["by_kind"])
    assert_map_schema(event_props["by_actor"])
    if tool_calls.get("type") != "object" or tool_calls.get("additionalProperties") is not False:
        raise SystemExit("tool_calls object changed")
    if tool_calls.get("required") != TOOL_CALLS_REQUIRED:
        raise SystemExit("tool_calls required changed")
    tool_props = tool_calls.get("properties")
    if not isinstance(tool_props, dict) or list(tool_props) != ["total", "by_tool_hash"]:
        raise SystemExit("tool_calls properties changed")
    assert_integer_schema(tool_props["total"])
    assert_map_schema(tool_props["by_tool_hash"])
    assert_integer_schema(properties["compaction_boundaries"])
    assert_integer_schema(properties["checkpoints"])
    assert_map_schema(properties["by_adapter"])
    if expect(schema, base_document(schema)) != {"ok": True}:
        raise SystemExit("synthetic minimal document is not valid")


def expect(schema: dict[str, Any], value: object) -> dict[str, Any]:
    failure = check(schema, value, "", schema, 0)
    if failure is None:
        return {"ok": True}
    keyword, path, detail = failure
    if keyword not in ALLOWED_FAILURES:
        raise SystemExit(f"oracle unsupported at {path} ({detail}) via {keyword}")
    return {"detail": detail, "keyword": keyword, "ok": False, "path": path}


def dumps(value: object) -> str:
    text = json.dumps(value, ensure_ascii=True, indent=2, sort_keys=True, allow_nan=False)
    return text + "\n"


def assert_clean(text: str) -> None:
    if "\r" in text or "FOR_WORK" in text or "sesslint-wt-" in text or "02694d5" in text:
        raise SystemExit("refusing banned text in parity output")
    if _SBP.search(text):
        raise SystemExit("refusing sbp hash in parity output")


def write_text(path: Path, text: str) -> None:
    assert_clean(text)
    path.write_bytes(text.encode("utf-8"))


def clone_doc(value: dict[str, Any]) -> dict[str, Any]:
    cloned = json.loads(json.dumps(value))
    if not isinstance(cloned, dict):
        raise SystemExit("clone did not return an object")
    return cloned


def base_document(schema: dict[str, Any]) -> dict[str, Any]:
    version = schema["properties"]["schema_version"]["const"]
    return {
        "by_adapter": {},
        "checkpoints": 0,
        "compaction_boundaries": 0,
        "events": {"by_actor": {}, "by_kind": {}, "total": 0},
        "events_per_file": {"max": 0, "p50": 0, "p95": 0, "total": 0},
        "file_bytes": {"max": 0, "p50": 0, "p95": 0, "total": 0},
        "files": {"processed": 0, "total": 0, "undetected": 0, "unreadable": 0},
        "root_path": "corpus",
        "schema_version": version,
        "tool_calls": {"by_tool_hash": {}, "total": 0},
        "tool_version": "0",
    }


def compact(document: dict[str, Any]) -> str:
    return json.dumps(document, ensure_ascii=True, separators=(",", ":"), sort_keys=True)


def rewrite_number(document: dict[str, Any], field: str, token: str) -> str:
    text = compact(document)
    needle = f'"{field}":0'
    if text.count(needle) != 1:
        raise SystemExit(f"{needle} is not unique")
    return text.replace(needle, f'"{field}":{token}', 1)


def rewrite_tool_version(document: dict[str, Any], token: str) -> str:
    text = compact(document)
    needle = '"tool_version":"0"'
    if text.count(needle) != 1:
        raise SystemExit("tool_version zero is not unique")
    return text.replace(needle, f'"tool_version":"{token}"', 1)


def with_path(document: dict[str, Any], path: tuple[str, ...], value: object) -> dict[str, Any]:
    cloned = clone_doc(document)
    current: Any = cloned
    if not path:
        raise SystemExit("path is empty")
    for key in path[:-1]:
        if not isinstance(current, dict):
            raise SystemExit("path left the object")
        current = current[key]
    if not isinstance(current, dict):
        raise SystemExit("path left the object")
    current[path[-1]] = value
    return cloned


def without_key(document: dict[str, Any], path: tuple[str, ...], key: str) -> dict[str, Any]:
    cloned = clone_doc(document)
    current: Any = cloned
    for part in path:
        if not isinstance(current, dict):
            raise SystemExit("path left the object")
        current = current[part]
    if not isinstance(current, dict) or key not in current:
        raise SystemExit(f"{key} missing")
    current.pop(key)
    return cloned


def positive_document(schema: dict[str, Any]) -> dict[str, Any]:
    document = clone_doc(base_document(schema))
    document["by_adapter"] = {"adapter-a": 2}
    document["checkpoints"] = 3
    document["compaction_boundaries"] = 4
    document["events"] = {"by_actor": {"actor-a": 5}, "by_kind": {"kind-a": 6}, "total": 7}
    document["events_per_file"] = {"max": 8, "p50": 9, "p95": 10, "total": 11}
    document["file_bytes"] = {"max": 12, "p50": 13, "p95": 14, "total": 15}
    document["files"] = {"processed": 1, "total": 1, "undetected": 0, "unreadable": 0}
    document["root_path"] = "corpus/child"
    document["tool_calls"] = {"by_tool_hash": {"hash-a": 16}, "total": 16}
    document["tool_version"] = "1"
    return document


def build_vectors(schema: dict[str, Any]) -> list[dict[str, Any]]:
    vectors: list[dict[str, Any]] = []
    base = base_document(schema)

    def add(vector_id: str, instance: object = _MISSING, raw: str | None = None) -> None:
        if raw is None:
            if instance is _MISSING:
                raise SystemExit(f"{vector_id} has no instance")
            vectors.append(
                {"expected": expect(schema, instance), "id": vector_id, "instance": instance}
            )
            return
        if instance is not _MISSING:
            raise SystemExit(f"{vector_id} has both raw and instance")
        loaded = json.loads(raw)
        vectors.append({"expected": expect(schema, loaded), "id": vector_id, "raw": raw})

    add("synthetic_minimal", clone_doc(base))
    empty_version = clone_doc(base)
    empty_version["tool_version"] = ""
    add("tool_version_empty", empty_version)
    empty_root = clone_doc(base)
    empty_root["root_path"] = ""
    add("root_path_empty", empty_root)
    add("counters_positive", positive_document(schema))
    unbalanced = clone_doc(base)
    unbalanced["files"] = {"processed": 2, "total": 0, "undetected": 3, "unreadable": 4}
    add("files_total_not_sum", unbalanced)
    add("by_adapter_slash_key", with_path(base, ("by_adapter",), {"a/b": 1}))
    add("by_adapter_tilde_key", with_path(base, ("by_adapter",), {"a~b": 1}))
    add("by_adapter_empty_key", with_path(base, ("by_adapter",), {"": 1}))
    add("by_adapter_tilde_slash_key", with_path(base, ("by_adapter",), {"a~/b": 1}))
    over = clone_doc(base)
    over["tool_calls"]["by_tool_hash"] = {f"h{index:03d}": 1 for index in range(101)}
    over["tool_calls"]["total"] = 101
    add("tool_hashes_over_producer_cap", over)
    add("raw_checkpoints_one_point_zero", raw=rewrite_number(base, "checkpoints", "1.0"))
    add("raw_checkpoints_exponent", raw=rewrite_number(base, "checkpoints", "1e1"))
    add("raw_checkpoints_neg_zero", raw=rewrite_number(base, "checkpoints", "-0"))
    add("raw_checkpoints_i128_max", raw=rewrite_number(base, "checkpoints", str(2**127 - 1)))
    add("raw_tool_version_unicode", raw=rewrite_tool_version(base, r"caf\u00e9"))
    add("raw_minimal_spaced", raw=json.dumps(base, indent=2, sort_keys=True) + "\n")

    add("empty_object", {})
    add("root_array", [])
    add("root_string", "x")
    add("root_null", None)
    add("root_bool", True)
    add("root_number", 1)
    for name in schema["required"]:
        add(f"missing_{name}", without_key(base, (), name))
    extra = clone_doc(base)
    extra["extra"] = 1
    add("root_additional_property", extra)
    missing_and_extra = without_key(base, (), "by_adapter")
    missing_and_extra["extra"] = 1
    add("root_missing_by_adapter_and_extra", missing_and_extra)
    const_bad = clone_doc(base)
    const_bad["schema_version"] = "other"
    add("schema_version_const", const_bad)
    const_empty = clone_doc(base)
    const_empty["schema_version"] = ""
    add("schema_version_empty", const_empty)
    add("schema_version_number", with_path(base, ("schema_version",), 1))
    add("schema_version_null", with_path(base, ("schema_version",), None))
    add("schema_version_bool", with_path(base, ("schema_version",), True))
    add("tool_version_number", with_path(base, ("tool_version",), 1))
    add("tool_version_null", with_path(base, ("tool_version",), None))
    add("tool_version_bool", with_path(base, ("tool_version",), True))
    add("root_path_number", with_path(base, ("root_path",), 1))
    add("root_path_null", with_path(base, ("root_path",), None))

    for path in CLOSED_PATHS:
        owner = "_".join(path)
        add(f"{owner}_type", with_path(base, path, []))
        node = subschema(schema, ("properties", *path))
        for name in node["required"]:
            add(f"{owner}_missing_{name}", without_key(base, path, name))
        document = clone_doc(base)
        target: Any = document
        for key in path:
            target = target[key]
        target["extra"] = 1
        add(f"{owner}_additional", document)

    files_gap = without_key(base, ("files",), "processed")
    files_gap["files"]["extra"] = 1
    add("files_missing_processed_and_extra", files_gap)
    files_bad = with_path(base, ("files", "processed"), "bad")
    files_bad["files"]["extra"] = 1
    add("files_extra_and_bad_processed", files_bad)

    for path in MAP_PATHS:
        owner = "_".join(path)
        add(f"{owner}_type", with_path(base, path, []))
        for suffix, bad in INTEGER_BAD:
            add(f"{owner}_value_{suffix}", with_path(base, path, {"k": bad}))
        add(f"{owner}_value_object", with_path(base, path, {"k": {}}))

    for path in INTEGER_PATHS:
        owner = "_".join(path)
        for suffix, bad in INTEGER_BAD:
            add(f"{owner}_{suffix}", with_path(base, path, bad))

    add("by_adapter_slash_string", with_path(base, ("by_adapter",), {"a/b": "x"}))
    add("by_adapter_tilde_negative", with_path(base, ("by_adapter",), {"a~b": -1}))
    add("by_adapter_tilde_slash_string", with_path(base, ("by_adapter",), {"a~/b": "x"}))
    add("by_adapter_empty_string", with_path(base, ("by_adapter",), {"": "x"}))
    add("raw_checkpoints_fraction", raw=rewrite_number(base, "checkpoints", "1.5"))
    add("raw_checkpoints_exponent_fraction", raw=rewrite_number(base, "checkpoints", "1e-1"))
    add("raw_checkpoints_i128_overflow", raw=rewrite_number(base, "checkpoints", str(2**127)))

    ids = [item["id"] for item in vectors]
    if len(ids) != len(set(ids)):
        raise SystemExit("duplicate vector id")
    for vector_id, want in ORACLE_CHECKS.items():
        found = next(item for item in vectors if item["id"] == vector_id)
        if found["expected"] != want:
            raise SystemExit(f"{vector_id} oracle {found['expected']} != {want}")
    seen = {item["expected"]["keyword"] for item in vectors if not item["expected"]["ok"]}
    missing = sorted(ALLOWED_FAILURES - seen)
    if missing:
        raise SystemExit(f"missing failure keywords: {missing}")
    if not any(item["expected"]["ok"] for item in vectors):
        raise SystemExit("no accepted document")
    return vectors


def facts_from(schema: dict[str, Any], version: str, max_tool_rows: int) -> dict[str, Any]:
    properties = schema["properties"]
    return {
        "additional_properties": schema["additionalProperties"],
        "count_minimum": properties["checkpoints"]["minimum"],
        "events_per_file_required": properties["events_per_file"]["required"],
        "events_required": properties["events"]["required"],
        "file_bytes_required": properties["file_bytes"]["required"],
        "files_required": properties["files"]["required"],
        "id": schema["$id"],
        "map_value_minimum": properties["by_adapter"]["additionalProperties"]["minimum"],
        "map_value_type": properties["by_adapter"]["additionalProperties"]["type"],
        "max_tool_rows": max_tool_rows,
        "pin_schema_version": version,
        "property_names": list(properties.keys()),
        "required": schema["required"],
        "root_type": schema["type"],
        "schema_version_const": properties["schema_version"]["const"],
        "tool_calls_required": properties["tool_calls"]["required"],
    }


def coverage_doc() -> dict[str, Any]:
    rows = [
        {
            "note": SCHEMA_NOTE,
            "status": "not_applicable",
            "test": test_id,
            "vector_id": None,
        }
        for test_id in SCHEMA_TESTS
    ]
    return {
        "covered_count": 0,
        "module": "sesslint.stats",
        "not_applicable_count": len(rows),
        "python_commit": PYTHON_COMMIT,
        "rows": rows,
        "schema_file": "schemas/sesslint.stats.v1.json",
    }


def main() -> None:
    install_refusal()
    assert_checkout_import_refused()
    schema_bytes = git_show_bytes(SCHEMA_GIT)
    stats_bytes = git_show_bytes(STATS_GIT)
    test_bytes = git_show_bytes(TEST_GIT)
    if b"\r" in schema_bytes or b"\r" in stats_bytes or b"\r" in test_bytes:
        raise SystemExit("pin blob contains CR")
    stats_source = stats_bytes.decode("utf-8")
    test_source = test_bytes.decode("utf-8")
    exec_pin_blob(stats_source)
    assert_test_list(test_source)
    assert_schema_test_is_a_sweep(test_source)
    embedded = embedded_schema()
    if embedded.encode("utf-8") != schema_bytes:
        raise SystemExit("embedded schema bytes differ from the pin")
    schema = json.loads(schema_bytes.decode("utf-8"))
    if not isinstance(schema, dict):
        raise SystemExit("pinned schema is not an object")
    version = literal_assign(stats_source, "STATS_SCHEMA_VERSION")
    max_tool_rows = literal_assign(stats_source, "MAX_TOOL_ROWS")
    if not isinstance(version, str):
        raise SystemExit("STATS_SCHEMA_VERSION is not a string")
    if not isinstance(max_tool_rows, int) or isinstance(max_tool_rows, bool):
        raise SystemExit("MAX_TOOL_ROWS is not an int")
    assert_schema_shape(schema, version, max_tool_rows)
    vectors = build_vectors(schema)
    document = {
        "facts": facts_from(schema, version, max_tool_rows),
        "python_commit": PYTHON_COMMIT,
        "schema": "sesslint.parity-schema-vectors/v1",
        "vectors": vectors,
    }
    vectors_text = dumps(document)
    round_trip = json.loads(vectors_text)
    for case in round_trip["vectors"]:
        if "raw" in case:
            value = json.loads(case["raw"])
        else:
            value = case["instance"]
        again = expect(schema, value)
        if again != case["expected"]:
            raise SystemExit(f"round trip changed {case['id']}")
    vectors_sha = hashlib.sha256(vectors_text.encode("utf-8")).hexdigest()
    manifest = {
        "generator": GENERATOR,
        "python_commit": PYTHON_COMMIT,
        "schema": "sesslint.parity-schema-vectors/v1",
        "schema_file": "schemas/sesslint.stats.v1.json",
        "schema_sha256": hashlib.sha256(schema_bytes).hexdigest(),
        "stats_py_sha256": hashlib.sha256(stats_bytes).hexdigest(),
        "test_stats_py_sha256": hashlib.sha256(test_bytes).hexdigest(),
        "vector_count": len(vectors),
        "vectors_sha256": vectors_sha,
    }
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.stats.v1 schema parity. Constraints and expected "
            "rejections come from the pinned schema. Documents are constructed "
            "objects, not SessionStats.to_dict output. No session text is stored."
        ),
        "generator": GENERATOR,
        "known_parity_gaps": [
            (
                "stats.py imports sesslint._version, sesslint.adapters.detect, and "
                "sesslint.canonical at module scope. Those imports are refused, so "
                "SessionStats.to_dict is not executed."
            ),
            (
                "tests/cli/test_stats.py::test_stats_json_schema writes a corpus, "
                "calls main, and checks schema_version, required keys, the files "
                "sum, and path redaction. validate is one document, not that sweep."
            ),
            (
                "The files total equation and MAX_TOOL_ROWS are producer behavior. "
                "The pinned schema does not state them."
            ),
            (
                "Duplicate JSON object keys are a syntax refusal. Python json.loads "
                "keeps the last key, so that case is not a vector."
            ),
            (
                "enum, items, and $ref are absent from the pinned schema. No vector "
                "claims those keywords."
            ),
            (
                "uniqueItems, minLength, maxLength, minItems, maxItems, and pattern "
                "are absent from the pinned schema. A schema that stated them fails "
                "closed as unsupported."
            ),
            (
                "i128::MIN is inside the signed 128-bit range, but the checker does "
                "not prove that token. It is not a vector."
            ),
        ],
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
    }
    write_text(OUT / "vectors.json", vectors_text)
    write_text(OUT / "coverage.json", dumps(coverage_doc()))
    write_text(OUT / "manifest.json", dumps(manifest))
    write_text(OUT / "PROVENANCE.json", dumps(provenance))
    encoded = vectors_text.encode("utf-8")
    print(f"vector_count={len(vectors)}")
    print("covered_count=0")
    print(f"not_applicable_count={len(SCHEMA_TESTS)}")
    print(f"vectors_sha256={vectors_sha}")
    print(f"vectors_bytes={len(encoded)}")
    print(f"vectors_lf={encoded.count(bytes((10,)))}")
    print(f"vectors_cr={encoded.count(bytes((13,)))}")


if __name__ == "__main__":
    main()
