class CheckoutImportRefused(Exception):
    """A sesslint import missed the pin and must not use the checkout."""


class Unproven(Exception):
    """A keyword or number cannot be proven."""


class _PinOnly(importlib.abc.MetaPathFinder):
    """Reject sesslint imports so the checkout package cannot satisfy them."""

    def find_spec(
        self,
        fullname: str,
        path: object = None,
        target: object = None,
    ) -> None:
        del path, target
        if fullname == "sesslint" or fullname.startswith("sesslint."):
            raise CheckoutImportRefused(fullname)
        return None


def install_pin_guard() -> None:
    sys.dont_write_bytecode = True
    blocked = {str(ROOT), str(ROOT / "src"), "", "."}
    sys.path[:] = [item for item in sys.path if item not in blocked and "02694d5" not in item]
    sys.meta_path.insert(0, _PinOnly())


def git_show_bytes(rev_path: str) -> bytes:
    if "02694d5" in rev_path:
        raise SystemExit("refusing 02694d5")
    if not rev_path.startswith(f"{PYTHON_COMMIT}:"):
        raise SystemExit("git show is limited to the pin")
    return subprocess.check_output(["git", "show", rev_path], cwd=ROOT)


def embedded_schema() -> str:
    text = RS_PATH.read_text(encoding="utf-8")
    marker = 'TRIAGE_SCHEMA_JSON: &str = r##"'
    start = text.find(marker)
    if start < 0:
        raise SystemExit("schema const missing")
    start += len(marker)
    end = text.find('"##;', start)
    if end < 0:
        raise SystemExit("schema const end missing")
    body = text[start:end]
    if "___PIN_SCHEMA___" in body:
        raise SystemExit("schema placeholder was not spliced")
    return body


def schema_version_const(source: str) -> str:
    tree = ast.parse(source)
    for node in tree.body:
        if not isinstance(node, ast.Assign):
            continue
        for target in node.targets:
            if not isinstance(target, ast.Name) or target.id != "TRIAGE_SCHEMA_VERSION":
                continue
            if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
                return node.value.value
    raise SystemExit("TRIAGE_SCHEMA_VERSION missing from the pin")


def iter_tests(tree: ast.AST) -> list[tuple[str, ast.FunctionDef]]:
    if not isinstance(tree, ast.Module):
        raise SystemExit("test file is not a module")
    found: list[tuple[str, ast.FunctionDef]] = []
    for node in tree.body:
        if isinstance(node, ast.ClassDef):
            for item in node.body:
                if isinstance(item, ast.AsyncFunctionDef) and item.name.startswith("test_"):
                    raise SystemExit(f"async test is not proven: {node.name}.{item.name}")
                if isinstance(item, ast.FunctionDef) and item.name.startswith("test_"):
                    found.append((f"{node.name}.{item.name}", item))
        elif isinstance(node, ast.AsyncFunctionDef) and node.name.startswith("test_"):
            raise SystemExit(f"async test is not proven: {node.name}")
        elif isinstance(node, ast.FunctionDef) and node.name.startswith("test_"):
            found.append((node.name, node))
    return found


def is_direct_schema_call(node: ast.AST) -> bool:
    if not isinstance(node, ast.Call) or len(node.args) != 1:
        return False
    func = node.func
    if not isinstance(func, ast.Attribute) or func.attr != "validate":
        return False
    owner = func.value
    if not isinstance(owner, ast.Call):
        return False
    owner_func = owner.func
    if isinstance(owner_func, ast.Attribute):
        return owner_func.attr == "Draft202012Validator"
    return isinstance(owner_func, ast.Name) and owner_func.id == "Draft202012Validator"


def is_schema_only(fn: ast.FunctionDef) -> bool:
    """True only for one Draft 2020-12 validate call and no other outcome."""
    if fn.decorator_list:
        return False
    interesting = [
        stmt
        for stmt in fn.body
        if not (isinstance(stmt, ast.Expr) and isinstance(stmt.value, ast.Constant))
    ]
    if len(interesting) != 1:
        return False
    stmt = interesting[0]
    if isinstance(stmt, ast.Expr):
        return is_direct_schema_call(stmt.value)
    if isinstance(stmt, ast.With) and len(stmt.body) == 1:
        inner = stmt.body[0]
        return isinstance(inner, ast.Expr) and is_direct_schema_call(inner.value)
    return False


def integer_value(value: object) -> int | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if isinstance(value, int):
        if -(2**127) <= value < 2**127:
            return value
        return None
    if not math.isfinite(value) or abs(value) > 2**53 or not value.is_integer():
        return None
    return int(value)


def json_equal(left: object, right: object) -> bool | None:
    if left is None or right is None:
        return left is None and right is None
    if isinstance(left, bool) or isinstance(right, bool):
        if isinstance(left, bool) and isinstance(right, bool):
            return left == right
        return False
    if isinstance(left, str) or isinstance(right, str):
        return isinstance(left, str) and isinstance(right, str) and left == right
    if isinstance(left, list) or isinstance(right, list):
        if not isinstance(left, list) or not isinstance(right, list) or len(left) != len(right):
            return False
        for item, other in zip(left, right, strict=True):
            compared = json_equal(item, other)
            if compared is None:
                return None
            if not compared:
                return False
        return True
    if isinstance(left, dict) or isinstance(right, dict):
        if not isinstance(left, dict) or not isinstance(right, dict) or set(left) != set(right):
            return False
        for key in left:
            compared = json_equal(left[key], right[key])
            if compared is None:
                return None
            if not compared:
                return False
        return True
    if isinstance(left, (int, float)) and isinstance(right, (int, float)):
        left_int = integer_value(left)
        right_int = integer_value(right)
        if left_int is None or right_int is None:
            return None
        return left_int == right_int
    return None


def type_ok(spec: object, value: object) -> bool:
    if isinstance(spec, list):
        return any(type_ok(item, value) for item in spec)
    if spec == "object":
        return isinstance(value, dict)
    if spec == "array":
        return isinstance(value, list)
    if spec == "string":
        return isinstance(value, str)
    if spec == "boolean":
        return isinstance(value, bool)
    if spec == "null":
        return value is None
    if spec == "integer":
        return integer_value(value) is not None
    if spec == "number":
        return not isinstance(value, bool) and isinstance(value, (int, float))
    raise Unproven()


def pointer(parent: str, key: str) -> str:
    return parent + "/" + key.replace("~", "~0").replace("/", "~1")


def pattern_match(pattern: str, text: str) -> bool:
    if pattern == HASH_PATTERN:
        return len(text) == 64 and all(ch in "0123456789abcdef" for ch in text)
    if pattern == CODE_PATTERN:
        return (
            len(text) == 5 and text.startswith("SL") and text[2:].isascii() and text[2:].isdigit()
        )
    raise Unproven()


def length_bound(bound: object) -> int | None:
    if isinstance(bound, bool) or not isinstance(bound, int) or bound < 0:
        return None
    return bound


def check(
    root: dict[str, Any],
    schema: object,
    value: object,
    path: str,
    depth: int,
) -> tuple[str, str, str] | None:
    if depth > MAX_SCHEMA_DEPTH:
        return ("unsupported", path, "depth")
    if not isinstance(schema, dict):
        return ("unsupported", path, "schema")
    for key in schema:
        if key not in ANNOTATIONS and key not in KNOWN:
            return ("unsupported", path, str(key))
    failure = apply_ref(root, schema, value, path, depth)
    if failure is not None:
        return failure
    if "type" in schema:
        try:
            matched = type_ok(schema["type"], value)
        except Unproven:
            return ("unsupported", path, "type")
        if not matched:
            return ("type", path, "")
    if "const" in schema:
        compared = json_equal(value, schema["const"])
        if compared is None:
            return ("unsupported", path, "const")
        if not compared:
            return ("const", path, "")
    if "enum" in schema:
        failure = check_enum(schema["enum"], value, path)
        if failure is not None:
            return failure
    failure = check_string(schema, value, path)
    if failure is not None:
        return failure
    failure = check_minimum(schema, value, path)
    if failure is not None:
        return failure
    failure = check_union(root, schema, value, path, depth)
    if failure is not None:
        return failure
    failure = check_object(root, schema, value, path, depth)
    if failure is not None:
        return failure
    return check_array(root, schema, value, path, depth)


