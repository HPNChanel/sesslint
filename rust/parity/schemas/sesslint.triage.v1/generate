def dump_doc(document: dict[str, Any]) -> str:
    return json.dumps(document, ensure_ascii=True, sort_keys=True, separators=(", ", ": "))


def raw_count(token: str) -> str:
    text = dump_doc(base())
    needle = '"finding_count": 0'
    if text.count(needle) != 1:
        raise SystemExit("finding_count needle missing")
    return text.replace(needle, f'"finding_count": {token}', 1)


def build_vectors(schema: dict[str, Any], oracle: Any | None) -> list[dict[str, Any]]:
    vectors: list[dict[str, Any]] = []

    def add(vector_id: str, instance: object = None, raw: str | None = None) -> None:
        if raw is None:
            loaded: object = instance
            row: dict[str, Any] = {
                "expected": expect(schema, loaded),
                "id": vector_id,
                "instance": loaded,
            }
        else:
            loaded = json.loads(raw)
            row = {"expected": expect(schema, loaded), "id": vector_id, "raw": raw}
        assert_oracle(oracle, schema, loaded, row["expected"], vector_id)
        vectors.append(row)

    minimal = base()
    add("minimal", minimal)
    add("minimal_text", raw=dump_doc(minimal))
    add("root_array", [])
    add("root_string", "x")
    add("root_number", 1)
    add("root_null", None)
    add("root_bool", True)
    required = schema["required"]
    if not isinstance(required, list):
        raise SystemExit("required is not an array")
    for name in required:
        if not isinstance(name, str):
            raise SystemExit("required name is not a string")
        document = clone(minimal)
        document.pop(name)
        add(f"missing_{name}", document)
    extra = clone(minimal)
    extra["z"] = 1
    add("root_additional", extra)
    bad_const = clone(minimal)
    bad_const["schema_version"] = "nope"
    add("schema_version_const", bad_const)
    bad_status = clone(minimal)
    bad_status["status"] = "nope"
    add("status_enum", bad_status)
    bad_adapter = clone(minimal)
    bad_adapter["adapter"] = "nope"
    add("adapter_enum", bad_adapter)
    bad_assurance = clone(minimal)
    bad_assurance["assurance"] = "nope"
    add("assurance_enum", bad_assurance)
    add("source_sha256_null", clone(minimal))
    hashed = clone(minimal)
    hashed["source_sha256"] = HASH
    add("source_sha256_hash", hashed)
    upper = clone(minimal)
    upper["source_sha256"] = "A" * 64
    add("source_sha256_upper", upper)
    short = clone(minimal)
    short["source_sha256"] = "ab"
    add("source_sha256_short", short)
    number = clone(minimal)
    number["source_sha256"] = 1
    add("source_sha256_number", number)
    tool = clone(minimal)
    tool["tool_version"] = 1
    add("tool_version_type", tool)
    covered = clone(minimal)
    covered["coverage"] = {
        "adapter": {"id": "a", "version": "1"},
        "performed": ["graph"],
        "profile": {"id": "p", "name": "n", "version": "1"},
        "skipped": [{"check": "graph", "detail": "n", "reason": "cap-exceeded"}],
    }
    add("coverage_skip", covered)
    coverage_extra = clone(minimal)
    coverage_extra["coverage"] = {"performed": [], "skipped": [], "z": 1}
    add("coverage_additional", coverage_extra)
    line_null = clone(minimal)
    line_null["findings"] = [finding(None)]
    add("finding_line_null", line_null)
    line_one = clone(minimal)
    line_one["findings"] = [finding(1)]
    add("finding_line_one", line_one)
    line_zero = clone(minimal)
    line_zero["findings"] = [finding(0)]
    add("finding_line_zero", line_zero)
    bad_code = clone(minimal)
    bad_code["findings"] = [finding(None, code="NOPE")]
    add("finding_code_pattern", bad_code)
    at_max = clone(minimal)
    at_max["findings"] = [finding(None) for _ in range(100)]
    add("findings_at_max", at_max)
    over_max = clone(minimal)
    over_max["findings"] = [finding(None) for _ in range(101)]
    add("findings_max_items", over_max)
    negative = clone(minimal)
    negative["finding_count"] = -1
    add("finding_count_negative", negative)
    add("finding_count_one_point_zero", raw=raw_count("1.0"))
    add("finding_count_exponent", raw=raw_count("1e1"))
    add("finding_count_fraction", raw=raw_count("1.5"))
    add("count_zero_point_zero", raw=raw_count("0.0"))
    by_code = clone(minimal)
    by_code["by_code"] = {"SL001": -1}
    add("by_code_negative", by_code)
    applied = clone(minimal)
    applied_preview = preview()
    applied_preview["applied"] = True
    applied["previews"] = [applied_preview]
    add("preview_applied_const", applied)
    fingerprint = clone(minimal)
    bad_preview = preview()
    bad_preview["plan_fingerprint"] = "ab"
    fingerprint["previews"] = [bad_preview]
    add("preview_fingerprint_pattern", fingerprint)
    many_previews = clone(minimal)
    many_previews["previews"] = [preview(), preview(), preview()]
    add("previews_max_items", many_previews)
    steps_ok = clone(minimal)
    steps_ok["previews"] = [preview([step() for _ in range(256)])]
    add("steps_at_max", steps_ok)
    steps_over = clone(minimal)
    steps_over["previews"] = [preview([step() for _ in range(257)])]
    add("steps_max_items", steps_over)
    impact_ok = clone(minimal)
    impact_ok["impact"] = mapped([1])
    add("impact_mapped", impact_ok)
    impact_blank = clone(minimal)
    impact_blank["impact"] = {}
    add("impact_empty", impact_blank)
    impact_bad = clone(minimal)
    impact_bad["impact"] = {"status": "unverified", "z": 1}
    add("impact_extra", impact_bad)
    lines_zero = clone(minimal)
    lines_zero["impact"] = mapped([0])
    add("source_lines_zero", lines_zero)
    lines_over = clone(minimal)
    lines_over["impact"] = mapped([1] * 101)
    add("source_lines_max_items", lines_over)
    native = clone(minimal)
    native["native_state"] = {"detail": "n", "status": "nope"}
    add("native_enum", native)
    empty_actions = clone(minimal)
    empty_actions["next_actions"] = []
    add("next_actions_min_items", empty_actions)
    too_many = clone(minimal)
    too_many["next_actions"] = [action(), action(), action(), action()]
    add("next_actions_max_items", too_many)
    at_actions = clone(minimal)
    at_actions["next_actions"] = [action(), action(), action()]
    add("next_actions_at_max", at_actions)
    for status in schema["properties"]["status"]["enum"]:
        if status == "checked":
            continue
        document = clone(minimal)
        document["status"] = status
        add(f"status_{str(status).replace('-', '_')}", document)
    for adapter in schema["properties"]["adapter"]["enum"]:
        if adapter == "unknown":
            continue
        document = clone(minimal)
        document["adapter"] = adapter
        add(f"adapter_{str(adapter).replace('-', '_')}", document)
    for assurance in schema["properties"]["assurance"]["enum"]:
        if assurance == "A0":
            continue
        document = clone(minimal)
        document["assurance"] = assurance
        add(f"assurance_{assurance}", document)
    ids = [item["id"] for item in vectors]
    if len(ids) != len(set(ids)):
        raise SystemExit("duplicate vector id")
    missing = [item for item in REQUIRED_IDS if item not in set(ids)]
    if missing:
        raise SystemExit(f"missing vectors {missing}")
    return vectors


def facts_from(schema: dict[str, Any], emitter_version: str) -> dict[str, Any]:
    properties = schema["properties"]
    defs = schema["$defs"]
    preview_props = properties["previews"]["items"]["properties"]
    mapped_branch = properties["impact"]["oneOf"][1]
    keywords: set[str] = set()
    walk_keywords(schema, keywords)
    if properties["schema_version"]["const"] != emitter_version:
        raise SystemExit("emitter schema_version disagrees with the pinned const")
    if defs["hash"]["pattern"] != HASH_PATTERN or defs["code"]["pattern"] != CODE_PATTERN:
        raise SystemExit("pinned pattern changed")
    return {
        "adapter_enum": properties["adapter"]["enum"],
        "applied_const": preview_props["applied"]["const"],
        "assurance_enum": properties["assurance"]["enum"],
        "code_pattern": defs["code"]["pattern"],
        "count_minimum": defs["count"]["minimum"],
        "emitter_schema_version": emitter_version,
        "findings_max_items": properties["findings"]["maxItems"],
        "hash_pattern": defs["hash"]["pattern"],
        "keywords": sorted(keywords),
        "line_minimum": defs["line"]["minimum"],
        "next_actions_max_items": properties["next_actions"]["maxItems"],
        "next_actions_min_items": properties["next_actions"]["minItems"],
        "previews_max_items": properties["previews"]["maxItems"],
        "property_names": list(properties),
        "required": schema["required"],
        "root_additional_properties": schema["additionalProperties"],
        "schema_id": schema["$id"],
        "schema_version_const": properties["schema_version"]["const"],
        "source_lines_max_items": mapped_branch["properties"]["source_lines"]["maxItems"],
        "status_enum": properties["status"]["enum"],
        "steps_max_items": preview_props["steps"]["maxItems"],
    }


def coverage_rows(functions: list[tuple[str, ast.FunctionDef]]) -> list[dict[str, Any]]:
    names = [name for name, _fn in functions]
    if names != list(NOTES):
        raise SystemExit(f"pinned test list does not match NOTES: {names}")
    rows: list[dict[str, Any]] = []
    for name, fn in functions:
        if is_schema_only(fn):
            raise SystemExit(f"entire schema test has no proven vector: {name}")
        rows.append(
            {
                "note": NOTES[name],
                "status": "not_applicable",
                "test": f"{TEST_FILE}::{name}",
                "vector_id": None,
            }
        )
    return rows


def assert_self() -> None:
    if integer_value(True) is not None or integer_value(False) is not None:
        raise SystemExit("bool is not an integer")
    if integer_value(1.0) != 1 or integer_value(0.0) != 0 or integer_value(10.0) != 10:
        raise SystemExit("integral float mismatch")
    if integer_value(1.5) is not None or integer_value(0.1) is not None:
        raise SystemExit("fraction was treated as an integer")
    if pattern_match(HASH_PATTERN, HASH) is not True:
        raise SystemExit("hash pattern rejected a lowercase digest")
    if pattern_match(HASH_PATTERN, "A" * 64) is not False:
        raise SystemExit("hash pattern accepted uppercase")
    if pattern_match(CODE_PATTERN, "SL001") is not True:
        raise SystemExit("code pattern rejected SL001")
    if pattern_match(CODE_PATTERN, "sl001") is not False:
        raise SystemExit("code pattern accepted lowercase")


def main() -> None:
    assert_self()
    install_pin_guard()
    oracle = load_oracle()
    schema_bytes = git_show_bytes(SCHEMA_GIT)
    triage_bytes = git_show_bytes(TRIAGE_GIT)
    test_bytes = git_show_bytes(TEST_GIT)
    if b"\r" in schema_bytes or b"\r" in triage_bytes or b"\r" in test_bytes:
        raise SystemExit("pin blob contains CR")
    embedded = embedded_schema()
    if embedded.encode("utf-8") != schema_bytes:
        raise SystemExit("embedded schema bytes differ from the pin")
    schema = json.loads(schema_bytes.decode("utf-8"))
    if not isinstance(schema, dict):
        raise SystemExit("pinned schema is not an object")
    emitter_version = schema_version_const(triage_bytes.decode("utf-8"))
    functions = iter_tests(ast.parse(test_bytes.decode("utf-8")))
    rows = coverage_rows(functions)
    vectors = build_vectors(schema, oracle)
    document = {
        "facts": facts_from(schema, emitter_version),
        "python_commit": PYTHON_COMMIT,
        "schema": "sesslint.parity-schema-vectors/v1",
        "schema_id": schema["$id"],
        "schema_sha256": hashlib.sha256(schema_bytes).hexdigest(),
        "vectors": vectors,
    }
    vectors_text = dumps(document)
    vectors_sha = hashlib.sha256(vectors_text.encode("utf-8")).hexdigest()
    manifest = {
        "covered_count": 0,
        "generator": GENERATOR,
        "module": "sesslint.triage",
        "not_applicable_count": len(rows),
        "python_commit": PYTHON_COMMIT,
        "schema": "sesslint.parity-schema-vectors/v1",
        "schema_file": "schemas/sesslint.triage.v1.json",
        "schema_id": schema["$id"],
        "schema_sha256": hashlib.sha256(schema_bytes).hexdigest(),
        "test_file": TEST_FILE,
        "triage_py_sha256": hashlib.sha256(triage_bytes).hexdigest(),
        "vector_count": len(vectors),
        "vectors_sha256": vectors_sha,
    }
    coverage = {
        "covered_count": 0,
        "module": "sesslint.triage",
        "not_applicable_count": len(rows),
        "python_commit": PYTHON_COMMIT,
        "rows": rows,
        "schema_file": "schemas/sesslint.triage.v1.json",
        "test_file": TEST_FILE,
    }
    provenance = {
        "contains_real_data": False,
        "description": (
            "Synthetic sesslint.triage.v1 schema vectors. Accept and reject rows "
            "are constraints from the pinned schema. Session text is not stored."
        ),
        "generator": GENERATOR,
        "known_parity_gaps": [
            "tests/test_triage.py drives triage, main, latest_session, or state_db.",
            "A parametrized sweep is not one success or failure mode.",
            "The helper validate also checks next_actions and applied.",
        ],
        "origin": "synthetic",
        "python_commit": PYTHON_COMMIT,
    }
    write_text(OUT / "vectors.json", vectors_text)
    write_text(OUT / "coverage.json", dumps(coverage))
    write_text(OUT / "manifest.json", dumps(manifest))
    write_text(OUT / "PROVENANCE.json", dumps(provenance))
    print(f"vector_count={len(vectors)}")
    print("covered_count=0")
    print(f"not_applicable_count={len(rows)}")
    print(f"vectors_sha256={vectors_sha}")
    print("oracle=skipped" if oracle is None else "oracle=jsonschema")


if __name__ == "__main__":
    main()
