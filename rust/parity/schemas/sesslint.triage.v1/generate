def apply_ref(
    root: dict[str, Any],
    schema: dict[str, Any],
    value: object,
    path: str,
    depth: int,
) -> tuple[str, str, str] | None:
    if "$ref" not in schema:
        return None
    reference = schema["$ref"]
    if not isinstance(reference, str) or not reference.startswith("#/$defs/"):
        return ("unsupported", path, "$ref")
    name = reference.removeprefix("#/$defs/")
    if name == "" or not all(ch.isalnum() or ch in "_-" for ch in name):
        return ("unsupported", path, "$ref")
    defs = root.get("$defs")
    if not isinstance(defs, dict) or name not in defs:
        return ("unsupported", path, "$ref")
    return check(root, defs[name], value, path, depth + 1)


def check_enum(choices: object, value: object, path: str) -> tuple[str, str, str] | None:
    if not isinstance(choices, list):
        return ("unsupported", path, "enum")
    for choice in choices:
        compared = json_equal(value, choice)
        if compared is None:
            return ("unsupported", path, "enum")
        if compared:
            return None
    return ("enum", path, "")


def check_string(schema: dict[str, Any], value: object, path: str) -> tuple[str, str, str] | None:
    if not isinstance(value, str):
        return None
    if "minLength" in schema:
        limit = length_bound(schema["minLength"])
        if limit is None:
            return ("unsupported", path, "length")
        if len(value) < limit:
            return ("minLength", path, "")
    if "maxLength" in schema:
        limit = length_bound(schema["maxLength"])
        if limit is None:
            return ("unsupported", path, "length")
        if len(value) > limit:
            return ("maxLength", path, "")
    if "pattern" in schema:
        pattern = schema["pattern"]
        if not isinstance(pattern, str):
            return ("unsupported", path, "pattern")
        try:
            matched = pattern_match(pattern, value)
        except Unproven:
            return ("unsupported", path, "pattern")
        if not matched:
            return ("pattern", path, "")
    return None


def check_minimum(schema: dict[str, Any], value: object, path: str) -> tuple[str, str, str] | None:
    if "minimum" not in schema:
        return None
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    number = integer_value(value)
    if number is None:
        return ("unsupported", path, "minimum")
    limit = schema["minimum"]
    if isinstance(limit, bool) or not isinstance(limit, int):
        return ("unsupported", path, "minimum")
    if number < limit:
        return ("minimum", path, "")
    return None


def check_union(
    root: dict[str, Any],
    schema: dict[str, Any],
    value: object,
    path: str,
    depth: int,
) -> tuple[str, str, str] | None:
    for keyword in ("anyOf", "oneOf"):
        if keyword not in schema:
            continue
        branches = schema[keyword]
        if not isinstance(branches, list):
            return ("unsupported", path, keyword)
        matched = 0
        unsupported: tuple[str, str, str] | None = None
        for branch in branches:
            failure = check(root, branch, value, path, depth + 1)
            if failure is None:
                matched += 1
            elif failure[0] == "unsupported":
                unsupported = failure
            if keyword == "anyOf" and matched >= 1 and unsupported is None:
                break
        if keyword == "anyOf":
            if matched >= 1:
                continue
            if unsupported is not None:
                return unsupported
            return ("anyOf", path, "")
        if matched > 1:
            return ("oneOf", path, "")
        if unsupported is not None:
            return unsupported
        if matched != 1:
            return ("oneOf", path, "")
    return None


def check_object(
    root: dict[str, Any],
    schema: dict[str, Any],
    value: object,
    path: str,
    depth: int,
) -> tuple[str, str, str] | None:
    if not isinstance(value, dict):
        return None
    if "required" in schema:
        required = schema["required"]
        if not isinstance(required, list):
            return ("unsupported", path, "required")
        for name in required:
            if not isinstance(name, str):
                return ("unsupported", path, "required")
            if name not in value:
                return ("required", path, name)
    if "additionalProperties" in schema:
        failure = check_additional(root, schema, value, path, depth)
        if failure is not None:
            return failure
    if "properties" in schema:
        props = schema["properties"]
        if not isinstance(props, dict):
            return ("unsupported", path, "properties")
        for name, sub in props.items():
            if name in value:
                failure = check(root, sub, value[name], pointer(path, str(name)), depth + 1)
                if failure is not None:
                    return failure
    return None


def property_names(schema: dict[str, Any]) -> set[str] | None:
    props = schema.get("properties", {})
    if props is None:
        return set()
    if not isinstance(props, dict):
        return None
    return set(props)


def check_additional(
    root: dict[str, Any],
    schema: dict[str, Any],
    value: dict[str, Any],
    path: str,
    depth: int,
) -> tuple[str, str, str] | None:
    flag = schema["additionalProperties"]
    allowed = property_names(schema)
    if allowed is None:
        return ("unsupported", path, "properties")
    if flag is False:
        for key in value:
            if key not in allowed:
                return ("additionalProperties", path, str(key))
        return None
    if flag is True:
        return None
    if isinstance(flag, dict):
        for key, child in value.items():
            if key in allowed:
                continue
            failure = check(root, flag, child, pointer(path, str(key)), depth + 1)
            if failure is not None:
                return failure
        return None
    return ("unsupported", path, "additionalProperties")


def check_array(
    root: dict[str, Any],
    schema: dict[str, Any],
    value: object,
    path: str,
    depth: int,
) -> tuple[str, str, str] | None:
    if not isinstance(value, list):
        return None
    if "minItems" in schema:
        limit = length_bound(schema["minItems"])
        if limit is None:
            return ("unsupported", path, "length")
        if len(value) < limit:
            return ("minItems", path, "")
    if "maxItems" in schema:
        limit = length_bound(schema["maxItems"])
        if limit is None:
            return ("unsupported", path, "length")
        if len(value) > limit:
            return ("maxItems", path, "")
    if "items" in schema:
        item_schema = schema["items"]
        if not isinstance(item_schema, dict):
            return ("unsupported", path, "items")
        for index, item in enumerate(value):
            failure = check(root, item_schema, item, f"{path}/{index}", depth + 1)
            if failure is not None:
                return failure
    if schema.get("uniqueItems") is True:
        for right in range(1, len(value)):
            for left in range(right):
                compared = json_equal(value[left], value[right])
                if compared is None:
                    return ("unsupported", path, "uniqueItems")
                if compared:
                    return ("uniqueItems", path, "")
    elif "uniqueItems" in schema and schema["uniqueItems"] is not False:
        return ("unsupported", path, "uniqueItems")
    return None


def expect(schema: dict[str, Any], value: object) -> dict[str, Any]:
    failure = check(schema, schema, value, "", 0)
    if failure is None:
        return {"ok": True}
    keyword, path, detail = failure
    if keyword == "unsupported":
        raise SystemExit(f"unsupported at {path} ({detail})")
    return {"detail": detail, "keyword": keyword, "ok": False, "pointer": path}


def walk_keywords(schema: object, found: set[str]) -> None:
    if not isinstance(schema, dict):
        return
    for key, value in schema.items():
        if key not in ANNOTATIONS:
            found.add(str(key))
        if key in {"properties", "$defs"} and isinstance(value, dict):
            for sub in value.values():
                walk_keywords(sub, found)
        elif key in {"anyOf", "oneOf", "allOf"} and isinstance(value, list):
            for sub in value:
                walk_keywords(sub, found)
        elif key in {"items", "additionalProperties", "not", "if", "then", "else"}:
            walk_keywords(value, found)


def load_oracle() -> Any | None:
    try:
        import jsonschema
    except ModuleNotFoundError:
        return None
    return jsonschema.Draft202012Validator


def assert_oracle(
    oracle: Any | None,
    schema: dict[str, Any],
    value: object,
    expected: dict[str, Any],
    vector_id: str,
) -> None:
    if oracle is None:
        return
    valid = bool(oracle(schema).is_valid(value))
    if valid != expected["ok"]:
        raise SystemExit(f"oracle mismatch for {vector_id}")


def dumps(value: object) -> str:
    text = json.dumps(value, ensure_ascii=True, indent=2, sort_keys=True, allow_nan=False)
    return text + "\n"


def assert_clean(text: str) -> None:
    if "\r" in text or "FOR_WORK" in text or "sesslint-wt-" in text or "02694d5" in text:
        raise SystemExit("refusing banned text in parity output")
    if _SBP.search(text):
        raise SystemExit("refusing sbp hash in parity output")
    if "PRIVATE-PAYLOAD-CANARY" in text or "private-id-canary" in text:
        raise SystemExit("refusing session text in parity output")


def write_text(path: Path, text: str) -> None:
    assert_clean(text)
    path.write_bytes(text.encode("utf-8"))


def clone(value: dict[str, Any]) -> dict[str, Any]:
    copied = json.loads(json.dumps(value))
    if not isinstance(copied, dict):
        raise SystemExit("clone did not return an object")
    return copied


