class CheckoutImportRefused(Exception):
    """A sesslint import missed the pin and must not fall through to the checkout."""


class Unproven(Exception):
    """A comparison cannot be proven."""


class _PinOnly(importlib.abc.MetaPathFinder):
    def find_spec(
        self,
        fullname: str,
        path: object = None,
        target: object = None,
    ) -> None:
        del path, target
        if fullname == "sesslint" or fullname.startswith("sesslint."):
            raise CheckoutImportRefused(fullname)
        return None


def install_refusal() -> None:
    sys.dont_write_bytecode = True
    blocked = {str(ROOT), str(ROOT / "src"), "", "."}
    sys.path[:] = [item for item in sys.path if item not in blocked]
    sys.meta_path.insert(0, _PinOnly())


def assert_checkout_import_refused() -> None:
    try:
        importlib.import_module("sesslint.outcome.contract")
    except CheckoutImportRefused:
        return
    except ModuleNotFoundError as exc:
        raise SystemExit("isolated ModuleNotFoundError is not a pin result") from exc
    raise SystemExit("sesslint import was not refused")


def git_show_bytes(rev_path: str) -> bytes:
    if not rev_path.startswith(f"{PYTHON_COMMIT}:"):
        raise SystemExit("git show is limited to the pin")
    return subprocess.check_output(["git", "show", rev_path], cwd=ROOT)


def embedded_schema() -> str:
    text = RS_PATH.read_text(encoding="utf-8")
    marker = 'OUTCOME_CONTRACT_SCHEMA_JSON: &str = r##"'
    start = text.find(marker)
    if start < 0:
        raise SystemExit("schema const missing")
    start += len(marker)
    end = text.find('"##;', start)
    if end < 0:
        raise SystemExit("schema const end missing")
    body = text[start:end]
    if body == "___PIN_SCHEMA___":
        raise SystemExit("schema placeholder was not spliced")
    return body


def value_node(source: str, name: str) -> ast.AST:
    tree = ast.parse(source)
    for node in tree.body:
        if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
            if node.target.id == name and node.value is not None:
                return node.value
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name) and target.id == name:
                    return node.value
    raise SystemExit(f"{name} missing")


def eval_int(node: ast.AST) -> int:
    if isinstance(node, ast.Constant) and type(node.value) is int:
        return node.value
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Mult):
        return eval_int(node.left) * eval_int(node.right)
    raise SystemExit("unproven int expression")


def eval_str_constant(node: ast.AST) -> str:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    raise SystemExit("unproven string")


def eval_str_set(node: ast.AST) -> set[str]:
    if isinstance(node, ast.Call) and len(node.args) == 1:
        func = node.func
        if isinstance(func, ast.Name) and func.id == "frozenset":
            node = node.args[0]
        else:
            raise SystemExit("unproven set")
    value = ast.literal_eval(node)
    if not isinstance(value, set) or not all(isinstance(item, str) for item in value):
        raise SystemExit("unproven set")
    return value


def eval_str_tuple(node: ast.AST) -> tuple[str, ...]:
    value = ast.literal_eval(node)
    if not isinstance(value, tuple) or not all(isinstance(item, str) for item in value):
        raise SystemExit("unproven tuple")
    return value


def regex_source(node: ast.AST) -> str:
    if not isinstance(node, ast.Call) or len(node.args) != 1:
        raise SystemExit("unproven regex")
    func = node.func
    if not isinstance(func, ast.Attribute) or func.attr != "compile":
        raise SystemExit("unproven regex")
    return eval_str_constant(node.args[0])


def iter_tests(tree: ast.AST) -> list[tuple[str, ast.FunctionDef]]:
    found: list[tuple[str, ast.FunctionDef]] = []
    for node in tree.body:
        if isinstance(node, ast.ClassDef):
            for item in node.body:
                if isinstance(item, ast.FunctionDef) and item.name.startswith("test_"):
                    raise SystemExit(f"class schema test is not flat: {node.name}.{item.name}")
        elif isinstance(node, ast.FunctionDef) and node.name.startswith("test_"):
            found.append((node.name, node))
    return found


def is_direct_schema_call(node: ast.AST) -> bool:
    if not isinstance(node, ast.Call):
        return False
    func = node.func
    if isinstance(func, ast.Attribute):
        return func.attr in {"validate", "is_valid", "iter_errors", "assert_schema"}
    if isinstance(func, ast.Name):
        return func.id in {"validate", "assert_schema"}
    return False


def is_schema_only(fn: ast.FunctionDef) -> bool:
    if fn.decorator_list:
        return False
    interesting = [
        stmt
        for stmt in fn.body
        if not (isinstance(stmt, ast.Expr) and isinstance(stmt.value, ast.Constant))
    ]
    if len(interesting) != 1 or not isinstance(interesting[0], ast.Expr):
        return False
    return is_direct_schema_call(interesting[0].value)


def integer_value(value: object) -> int | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if isinstance(value, int):
        if -(2**127) < value < 2**127:
            return value
        return None
    if not math.isfinite(value) or abs(value) > 2**53 or not value.is_integer():
        return None
    return int(value)


def json_equal(left: object, right: object) -> bool | None:
    if left is None or right is None:
        return left is None and right is None
    if isinstance(left, bool) or isinstance(right, bool):
        if isinstance(left, bool) and isinstance(right, bool):
            return left == right
        return False
    if isinstance(left, str) or isinstance(right, str):
        return isinstance(left, str) and isinstance(right, str) and left == right
    if isinstance(left, list) or isinstance(right, list):
        if not isinstance(left, list) or not isinstance(right, list) or len(left) != len(right):
            return False
        for item, other in zip(left, right, strict=True):
            compared = json_equal(item, other)
            if compared is None:
                return None
            if not compared:
                return False
        return True
    if isinstance(left, dict) or isinstance(right, dict):
        if not isinstance(left, dict) or not isinstance(right, dict) or set(left) != set(right):
            return False
        for key in left:
            compared = json_equal(left[key], right[key])
            if compared is None:
                return None
            if not compared:
                return False
        return True
    if isinstance(left, (int, float)) and isinstance(right, (int, float)):
        left_int = integer_value(left)
        right_int = integer_value(right)
        if left_int is None or right_int is None:
            return None
        return left_int == right_int
    raise Unproven()


def type_ok(spec: object, value: object) -> bool:
    if isinstance(spec, list):
        if not spec:
            raise Unproven()
        return any(type_ok(item, value) for item in spec)
    if spec == "object":
        return isinstance(value, dict)
    if spec == "array":
        return isinstance(value, list)
    if spec == "string":
        return isinstance(value, str)
    if spec == "boolean":
        return isinstance(value, bool)
    if spec == "null":
        return value is None
    if spec == "integer":
        return integer_value(value) is not None
    if spec == "number":
        return not isinstance(value, bool) and isinstance(value, (int, float))
    raise Unproven()


def pointer(parent: str, key: str) -> str:
    return parent + "/" + key.replace("~", "~0").replace("/", "~1")


def unescape_pointer(token: str) -> str | None:
    out: list[str] = []
    index = 0
    while index < len(token):
        if token[index] != "~":
            out.append(token[index])
            index += 1
            continue
        if index + 1 >= len(token):
            return None
        nxt = token[index + 1]
        if nxt == "0":
            out.append("~")
        elif nxt == "1":
            out.append("/")
        else:
            return None
        index += 2
    return "".join(out)


def canonical_index(token: str, length: int) -> int | None:
    if not token or not token.isascii() or not token.isdigit():
        return None
    if len(token) > 1 and token.startswith("0"):
        return None
    index = int(token)
    if index >= length:
        return None
    return index


def resolve_pointer(root: object, pointer_text: str) -> object:
    if pointer_text == "":
        return root
    if not pointer_text.startswith("/"):
        raise SystemExit(f"bad pointer {pointer_text}")
    current = root
    rest = pointer_text[1:]
    if rest == "":
        return root
    for token in rest.split("/"):
        key = unescape_pointer(token)
        if key is None:
            raise SystemExit(f"bad pointer token {pointer_text}")
        if isinstance(current, dict):
            if key not in current:
                raise SystemExit(f"missing pointer {pointer_text}")
            current = current[key]
        elif isinstance(current, list):
            index = canonical_index(key, len(current))
            if index is None:
                raise SystemExit(f"bad pointer index {pointer_text}")
            current = current[index]
        else:
            raise SystemExit(f"pointer left container {pointer_text}")
    return current


def resolve_ref(root: object, reference: object) -> object | None:
    if not isinstance(reference, str) or not reference.startswith("#/$defs/"):
        return None
    name = reference[len("#/$defs/") :]
    if not name or not all(char.isalnum() or char in "_-" for char in name):
        return None
    if not isinstance(root, dict):
        return None
    defs = root.get("$defs")
    if not isinstance(defs, dict) or name not in defs:
        return None
    return defs[name]


def length_bound(bound: object) -> int | None:
    if isinstance(bound, bool) or not isinstance(bound, int) or bound < 0:
        return None
    return bound


def space_class(ch: str) -> str:
    code = ord(ch)
    if code in PROVEN_SPACE or 0x2000 <= code <= 0x200A:
        return "ws"
    if code in AMBIGUOUS_SPACE:
        return "amb"
    return "other"


def match_non_whitespace(text: str) -> bool | None:
    ambiguous = False
    for ch in text:
        kind = space_class(ch)
        if kind == "other":
            return True
        if kind == "amb":
            ambiguous = True
    if ambiguous:
        return None
    return False


def is_id(text: str) -> bool:
    if not text or not text[0].isascii() or not text[0].isalnum():
        return False
    if len(text) > 64:
        return False
    return all(ch.isascii() and (ch.isalnum() or ch in "._-") for ch in text[1:])


def pattern_match(pattern: str, text: str) -> bool | None:
    if pattern == TEXT_PATTERN:
        return match_non_whitespace(text)
    if pattern == ID_PATTERN:
        return is_id(text)
    return None


def check(
    schema: object,
    value: object,
    path: str,
    root: object,
    depth: int,
) -> tuple[str, str, str] | None:
    if depth >= CHECK_MAX_DEPTH:
        return ("unsupported", path, "depth")
    if not isinstance(schema, dict):
        return ("unsupported", path, "schema")
    for key in schema:
        if key not in ANNOTATIONS and key not in KNOWN:
            return ("unsupported", path, str(key))
    if "$ref" in schema:
        target = resolve_ref(root, schema["$ref"])
        if target is None:
            return ("unsupported", path, "$ref")
        failure = check(target, value, path, root, depth + 1)
        if failure is not None:
            return failure
    if "type" in schema:
        try:
            matched = type_ok(schema["type"], value)
        except Unproven:
            return ("unsupported", path, "type")
        if not matched:
            return ("type", path, "")
    if "const" in schema:
        compared = json_equal(value, schema["const"])
        if compared is None:
            return ("unsupported", path, "const")
        if not compared:
            return ("const", path, "")
    if "enum" in schema:
        failure = check_enum(schema["enum"], value, path)
        if failure is not None:
            return failure
    failure = check_string(schema, value, path)
    if failure is not None:
        return failure
    failure = check_bound(schema, value, path, "minimum", True)
    if failure is not None:
        return failure
    failure = check_bound(schema, value, path, "maximum", False)
    if failure is not None:
        return failure
    failure = check_object(schema, value, path, root, depth)
    if failure is not None:
        return failure
    failure = check_array(schema, value, path, root, depth)
    if failure is not None:
        return failure
    if "anyOf" in schema:
        failure = check_some_of(schema, value, path, root, depth, "anyOf")
        if failure is not None:
            return failure
    if "oneOf" in schema:
        return check_some_of(schema, value, path, root, depth, "oneOf")
    return None


def check_enum(choices: object, value: object, path: str) -> tuple[str, str, str] | None:
    if not isinstance(choices, list) or not choices:
        return ("unsupported", path, "enum")
    for choice in choices:
        compared = json_equal(value, choice)
        if compared is None:
            return ("unsupported", path, "enum")
        if compared:
            return None
    return ("enum", path, "")


def check_string(schema: dict[str, Any], value: object, path: str) -> tuple[str, str, str] | None:
    if not isinstance(value, str):
        return None
    if "minLength" in schema:
        limit = length_bound(schema["minLength"])
        if limit is None:
            return ("unsupported", path, "length")
        if len(value) < limit:
            return ("minLength", path, "")
    if "maxLength" in schema:
        limit = length_bound(schema["maxLength"])
        if limit is None:
            return ("unsupported", path, "length")
        if len(value) > limit:
            return ("maxLength", path, "")
    if "pattern" in schema:
        pattern = schema["pattern"]
        if not isinstance(pattern, str):
            return ("unsupported", path, "pattern")
        matched = pattern_match(pattern, value)
        if matched is None:
            return ("unsupported", path, "pattern")
        if not matched:
            return ("pattern", path, "")
    return None


def check_bound(
    schema: dict[str, Any],
    value: object,
    path: str,
    keyword: str,
    minimum: bool,
) -> tuple[str, str, str] | None:
    if keyword not in schema:
        return None
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    number = integer_value(value)
    if number is None:
        return ("unsupported", path, keyword)
    limit = schema[keyword]
    if isinstance(limit, bool) or not isinstance(limit, int):
        return ("unsupported", path, keyword)
    failed = number < limit if minimum else number > limit
    if failed:
        return (keyword, path, "")
    return None


def check_some_of(
    schema: dict[str, Any],
    value: object,
    path: str,
    root: object,
    depth: int,
    keyword: str,
) -> tuple[str, str, str] | None:
    branches = schema.get(keyword)
    if not isinstance(branches, list) or not branches:
        return ("unsupported", path, keyword)
    matched = 0
    unsupported: tuple[str, str, str] | None = None
    for branch in branches:
        failure = check(branch, value, path, root, depth + 1)
        if failure is None:
            matched += 1
        elif failure[0] == "unsupported":
            unsupported = failure
    if keyword == "anyOf":
        if matched >= 1:
            return None
        if unsupported is not None:
            return unsupported
        return ("anyOf", path, "")
    if matched > 1:
        return ("oneOf", path, "")
    if unsupported is not None:
        return unsupported
    if matched != 1:
        return ("oneOf", path, "")
    return None


def check_object(
    schema: dict[str, Any],
    value: object,
    path: str,
    root: object,
    depth: int,
) -> tuple[str, str, str] | None:
    if not isinstance(value, dict):
        return None
    if "required" in schema:
        required = schema["required"]
        if not isinstance(required, list):
            return ("unsupported", path, "required")
        for name in required:
            if not isinstance(name, str):
                return ("unsupported", path, "required")
            if name not in value:
                return ("required", path, name)
    if "additionalProperties" in schema:
        failure = check_additional(schema, value, path, root, depth)
        if failure is not None:
            return failure
    if "properties" in schema:
        props = schema["properties"]
        if not isinstance(props, dict):
            return ("unsupported", path, "properties")
        for name, sub in props.items():
            if name in value:
                failure = check(sub, value[name], pointer(path, str(name)), root, depth + 1)
                if failure is not None:
                    return failure
    return None


def check_additional(
    schema: dict[str, Any],
    value: dict[str, Any],
    path: str,
    root: object,
    depth: int,
) -> tuple[str, str, str] | None:
    flag = schema["additionalProperties"]
    props = schema.get("properties", {})
    if not isinstance(props, dict):
        return ("unsupported", path, "properties")
    if flag is False:
        for key in value:
            if key not in props:
                return ("additionalProperties", path, str(key))
        return None
    if flag is True:
        return None
    if isinstance(flag, dict):
        for key, item in value.items():
            if key not in props:
                failure = check(flag, item, pointer(path, str(key)), root, depth + 1)
                if failure is not None:
                    return failure
        return None
    return ("unsupported", path, "additionalProperties")


def check_array(
    schema: dict[str, Any],
    value: object,
    path: str,
    root: object,
    depth: int,
) -> tuple[str, str, str] | None:
    if not isinstance(value, list):
        return None
    if "minItems" in schema:
        limit = length_bound(schema["minItems"])
        if limit is None:
            return ("unsupported", path, "length")
        if len(value) < limit:
            return ("minItems", path, "")
    if "maxItems" in schema:
        limit = length_bound(schema["maxItems"])
        if limit is None:
            return ("unsupported", path, "length")
        if len(value) > limit:
            return ("maxItems", path, "")
    if "items" in schema:
        item_schema = schema["items"]
        if not isinstance(item_schema, dict):
            return ("unsupported", path, "items")
        for index, item in enumerate(value):
            failure = check(item_schema, item, f"{path}/{index}", root, depth + 1)
            if failure is not None:
                return failure
    if "uniqueItems" not in schema:
        return None
    flag = schema["uniqueItems"]
    if flag is False:
        return None
    if flag is not True:
        return ("unsupported", path, "uniqueItems")
    for right in range(1, len(value)):
        for left in range(right):
            compared = json_equal(value[left], value[right])
            if compared is None:
                return ("unsupported", path, "uniqueItems")
            if compared:
                return ("uniqueItems", path, "")
    return None


def expect(schema_node: object, value: object, root: object) -> dict[str, Any]:
    failure = check(schema_node, value, "", root, 0)
    if failure is None:
        return {"ok": True}
    keyword, path, detail = failure
    if keyword not in ALLOWED_FAILURES:
        raise SystemExit(f"oracle unsupported at {path} ({detail}) via {keyword}")
    return {"detail": detail, "keyword": keyword, "ok": False, "path": path}


def walk_keywords(schema: object, seen: set[str]) -> None:
    if not isinstance(schema, dict):
        return
    for key, value in schema.items():
        seen.add(str(key))
        if key in {"properties", "$defs"} and isinstance(value, dict):
            for child in value.values():
                walk_keywords(child, seen)
        elif key in {"additionalProperties", "items"}:
            walk_keywords(value, seen)
        elif key in {"anyOf", "oneOf"} and isinstance(value, list):
            for child in value:
                walk_keywords(child, seen)


def branch_index(schema: dict[str, Any], type_name: str, basis: str | None = None) -> int:
    found: int | None = None
    for index, branch in enumerate(schema["$defs"]["branch"]["oneOf"]):
        if branch["properties"]["type"]["const"] != type_name:
            continue
        got = branch["properties"].get("basis", {}).get("const")
        if basis is None and "basis" in branch["properties"]:
            continue
        if basis is not None and got != basis:
            continue
        if found is not None:
            raise SystemExit(f"duplicate branch {type_name}")
        found = index
    if found is None:
        raise SystemExit(f"missing branch {type_name}")
    return found


def predicate_index(schema: dict[str, Any], op: str) -> int:
    found: int | None = None
    for index, branch in enumerate(schema["$defs"]["predicate"]["oneOf"]):
        choices = branch["properties"]["op"]["enum"]
        if op not in choices:
            continue
        if found is not None and found != index:
            raise SystemExit(f"op {op} is in two branches")
        found = index
    if found is None:
        raise SystemExit(f"missing op {op}")
    return found


def assert_schema_shape(schema: dict[str, Any], constants: dict[str, Any]) -> None:
    seen: set[str] = set()
    walk_keywords(schema, seen)
    unknown = sorted(seen - ANNOTATIONS - KNOWN)
    if unknown:
        raise SystemExit(f"pinned schema states {unknown}")
    if schema.get("$schema") != "https://json-schema.org/draft/2020-12/schema":
        raise SystemExit("dialect changed")
    if schema.get("$id") != "https://sesslint.dev/schemas/sesslint.outcome-contract.v1.json":
        raise SystemExit("schema id changed")
    if schema.get("type") != "object" or schema.get("additionalProperties") is not False:
        raise SystemExit("root object changed")
    if schema.get("required") != ["schema_version", "name", "version", "key", "conditions"]:
        raise SystemExit("root required changed")
    props = schema.get("properties")
    if not isinstance(props, dict) or list(props) != [
        "schema_version",
        "name",
        "version",
        "description",
        "key",
        "eligibility",
        "due",
        "conditions",
    ]:
        raise SystemExit("root properties changed")
    version = props["schema_version"].get("const")
    if version != "sesslint.outcome-contract/v1" or version != constants["version"]:
        raise SystemExit("schema_version const changed")
    defs = schema["$defs"]
    if defs["text"] != {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": TEXT_PATTERN,
    }:
        raise SystemExit("text schema changed")
    if defs["id"] != {"type": "string", "pattern": ID_PATTERN}:
        raise SystemExit("id schema changed")
    if defs["field"] != {"type": "string", "minLength": 1, "maxLength": 256}:
        raise SystemExit("field schema changed")
    if defs["scalar"] != {"type": ["string", "number", "boolean", "null"]}:
        raise SystemExit("scalar schema changed")
    if defs["values"] != {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "items": {"$ref": "#/$defs/scalar"},
    }:
        raise SystemExit("values schema changed")
    if defs["normalize"] != {
        "type": "array",
        "uniqueItems": True,
        "items": {"enum": ["trim", "casefold"]},
    }:
        raise SystemExit("normalize schema changed")
    if defs["predicates"] != {
        "type": "array",
        "maxItems": 32,
        "items": {"$ref": "#/$defs/predicate"},
    }:
        raise SystemExit("predicates schema changed")
    if props["name"] != {"$ref": "#/$defs/text"} or props["description"] != {"$ref": "#/$defs/text"}:
        raise SystemExit("text ref changed")
    if props["version"] != {"type": "string", "minLength": 1, "maxLength": 64}:
        raise SystemExit("version schema changed")
    if props["conditions"] != {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {"$ref": "#/$defs/condition"},
    }:
        raise SystemExit("conditions schema changed")
    if props["eligibility"] != {"$ref": "#/$defs/predicates"}:
        raise SystemExit("eligibility ref changed")
    within = resolve_pointer(schema, "/properties/due/anyOf/1/properties/within_seconds")
    if within != {"type": "integer", "minimum": 0, "maximum": 316224000}:
        raise SystemExit(f"within_seconds schema changed: {within}")
    if constants["within"] != 316224000 or constants["conditions"] != 64:
        raise SystemExit("producer limit disagrees with the schema")
    if constants["predicates"] != 32 or constants["values"] != 1000 or constants["key_fields"] != 8:
        raise SystemExit("producer array limit disagrees with the schema")
    if constants["field_chars"] != 256 or constants["text_chars"] != 2000:
        raise SystemExit("producer length disagrees with the schema")
    if constants["id_pattern"] != ID_PATTERN:
        raise SystemExit("producer id pattern disagrees with the schema")
    if constants["normalizations"] != ("trim", "casefold"):
        raise SystemExit("producer normalizations changed")
    if constants["condition_types"] != condition_type_set(schema):
        raise SystemExit("producer condition types disagree with the schema")
    if constants["predicate_ops"] != predicate_op_set(schema):
        raise SystemExit("producer predicate ops disagree with the schema")
    if constants["value_kinds"] != set(kind_enum(schema)):
        raise SystemExit("producer value kinds disagree with the schema")
    if constants["deadline_bases"] != deadline_bases(schema):
        raise SystemExit("producer deadline bases disagree with the schema")
    if expect(schema, base_document(schema), schema) != {"ok": True}:
        raise SystemExit("synthetic minimal document is not valid")


def condition_type_set(schema: dict[str, Any]) -> set[str]:
    found = set()
    for branch in schema["$defs"]["branch"]["oneOf"]:
        found.add(branch["properties"]["type"]["const"])
    any_of = schema["$defs"]["condition"]["oneOf"][1]
    found.add(any_of["properties"]["type"]["const"])
    return found


def predicate_op_set(schema: dict[str, Any]) -> set[str]:
    found: set[str] = set()
    for branch in schema["$defs"]["predicate"]["oneOf"]:
        found.update(branch["properties"]["op"]["enum"])
    return found


def kind_enum(schema: dict[str, Any]) -> list[str]:
    index = branch_index(schema, "type")
    values = schema["$defs"]["branch"]["oneOf"][index]["properties"]["kind"]["enum"]
    if not isinstance(values, list):
        raise SystemExit("kind enum changed")
    return list(values)


def deadline_bases(schema: dict[str, Any]) -> set[str]:
    found = set()
    for branch in schema["$defs"]["branch"]["oneOf"]:
        basis = branch["properties"].get("basis")
        if isinstance(basis, dict) and "const" in basis:
            found.add(basis["const"])
    return found


def clone(value: dict[str, Any]) -> dict[str, Any]:
    cloned = json.loads(json.dumps(value))
    if not isinstance(cloned, dict):
        raise SystemExit("clone did not return an object")
    return cloned


def base_document(schema: dict[str, Any]) -> dict[str, Any]:
    return {
        "conditions": [{"id": "e", "type": "exists"}],
        "key": {"source": "id", "target": "ref"},
        "name": "c",
        "schema_version": schema["properties"]["schema_version"]["const"],
        "version": "1",
    }


def compact(document: dict[str, Any]) -> str:
    return json.dumps(document, ensure_ascii=True, separators=(",", ":"), sort_keys=True)


