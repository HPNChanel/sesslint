    add("text_ok", " a", pointer="/$defs/text")
    add("within_negative", -1, pointer=within_pointer)
    add("within_above_max", 316224001, pointer=within_pointer)
    add("within_zero", 0, pointer=within_pointer)
    add("within_max", 316224000, pointer=within_pointer)
    add("within_bool", True, pointer=within_pointer)
    add("within_one_point_zero", raw="1.0", pointer=within_pointer)
    add("within_exponent", raw="1e2", pointer=within_pointer)
    add("within_neg_zero", raw="-0", pointer=within_pointer)
    add("within_fraction", raw="1.5", pointer=within_pointer)
    add("within_i128_overflow", raw=str(2**127), pointer=within_pointer)
    add("normalize_duplicate", ["trim", "trim"], pointer="/$defs/normalize")
    add("normalize_ok", ["trim", "casefold"], pointer="/$defs/normalize")
    add("normalize_unknown", ["stem"], pointer="/$defs/normalize")
    add("normalize_empty", [], pointer="/$defs/normalize")
    add("kind_unknown", "magic", pointer=kind_pointer)
    add("kind_string", "string", pointer=kind_pointer)
    add("count_max_zero", 0, pointer=count_max_pointer)
    add("count_max_null", None, pointer=count_max_pointer)
    add("count_max_one", 1, pointer=count_max_pointer)
    add("range_missing_bounds", {"field": "n"}, pointer=range_pointer)
    add("range_missing_field", {"min": 1}, pointer=range_pointer)
    add(
        "present_extra_value",
        {"field": "f", "op": "present", "value": 1},
        pointer=present_pointer,
    )
    add("number_value_bool", True, pointer=number_pointer)
    add("number_value_fraction", 1.5, pointer=number_pointer)
    add("values_empty", [], pointer="/$defs/values")
    add("values_ok", ["a", 1, False, None], pointer="/$defs/values")
    add("values_bad_item", [1, {}], pointer="/$defs/values")
    add("values_too_many", [None] * 1001, pointer="/$defs/values")
    add("values_full", [None] * 1000, pointer="/$defs/values")
    add("key_array_duplicate", ["a", "a"], pointer=key_array_pointer)
    add("key_array_ok", ["a", "b"], pointer=key_array_pointer)

    ids = [item["id"] for item in vectors]
    if len(ids) != len(set(ids)):
        raise SystemExit("duplicate vector id")
    for vector_id, want in ORACLE_CHECKS.items():
        found = next(item for item in vectors if item["id"] == vector_id)
        if found["expected"] != want:
            raise SystemExit(f"{vector_id} oracle {found['expected']} != {want}")
    seen_failures = {item["expected"]["keyword"] for item in vectors if not item["expected"]["ok"]}
    missing = sorted(ALLOWED_FAILURES - seen_failures)
    if missing:
        raise SystemExit(f"missing failure keywords: {missing}")
    if not any(item["expected"]["ok"] for item in vectors):
        raise SystemExit("no accepted document")
    return vectors


def facts_from(schema: dict[str, Any], constants: dict[str, Any]) -> dict[str, Any]:
    properties = schema["properties"]
    defs = schema["$defs"]
    within = resolve_pointer(schema, "/properties/due/anyOf/1/properties/within_seconds")
    keywords: set[str] = set()
    walk_keywords(schema, keywords)
    return {
        "condition_types": sorted(condition_type_set(schema)),
        "conditions_max_items": properties["conditions"]["maxItems"],
        "conditions_min_items": properties["conditions"]["minItems"],
        "field_max_length": defs["field"]["maxLength"],
        "id": schema["$id"],
        "id_pattern": defs["id"]["pattern"],
        "keywords": sorted(keywords),
        "pin_schema_version": constants["version"],
        "predicate_ops": sorted(predicate_op_set(schema)),
        "property_names": list(properties),
        "required": schema["required"],
        "schema_version_const": properties["schema_version"]["const"],
        "text_pattern": defs["text"]["pattern"],
        "value_kinds": kind_enum(schema),
        "within_seconds_maximum": within["maximum"],
        "within_seconds_minimum": within["minimum"],
    }


def coverage_rows(functions: list[tuple[str, ast.FunctionDef]]) -> list[dict[str, Any]]:
    names = [name for name, _fn in functions]
    if names != list(NOTES):
        raise SystemExit(f"pinned test list does not match NOTES: {names}")
    rows = []
    for name, fn in functions:
        if is_schema_only(fn):
            raise SystemExit(f"entire schema test has no proven vector: {name}")
        rows.append(
            {
                "note": NOTES[name],
                "status": "not_applicable",
                "test": f"{TEST_FILE}::{name}",
                "vector_id": None,
            }
        )
    return rows


def constants_from(source: str) -> dict[str, Any]:
    return {
        "condition_types": eval_str_set(value_node(source, "CONDITION_TYPES")),
        "conditions": eval_int(value_node(source, "MAX_CONDITIONS")),
        "deadline_bases": eval_str_set(value_node(source, "DEADLINE_BASES")),
        "field_chars": eval_int(value_node(source, "_MAX_FIELD_CHARS")),
        "id_pattern": regex_source(value_node(source, "_ID_RE")),
        "key_fields": eval_int(value_node(source, "MAX_KEY_FIELDS")),
        "normalizations": eval_str_tuple(value_node(source, "NORMALIZATIONS")),
        "predicate_ops": eval_str_set(value_node(source, "PREDICATE_OPS")),
        "predicates": eval_int(value_node(source, "MAX_PREDICATES")),
        "text_chars": eval_int(value_node(source, "_MAX_TEXT_CHARS")),
        "value_kinds": eval_str_set(value_node(source, "VALUE_KINDS")),
        "values": eval_int(value_node(source, "MAX_VALUES")),
        "version": eval_str_constant(value_node(source, "CONTRACT_SCHEMA_VERSION")),
        "within": eval_int(value_node(source, "MAX_WITHIN_SECONDS")),
    }


def dumps(value: object) -> str:
    return json.dumps(value, ensure_ascii=True, indent=2, sort_keys=True, allow_nan=False) + "\n"


def assert_clean(text: str) -> None:
    if (
        "\r" in text
        or "FOR_WORK" in text
        or "sesslint-wt-" in text
        or "shipment-exists" in text
        or "order_id" in text
    ):
        raise SystemExit("refusing banned text in parity output")
    if _SBP.search(text):
        raise SystemExit("refusing sbp hash in parity output")


def write_text(path: Path, text: str) -> None:
    assert_clean(text)
    path.write_bytes(text.encode("utf-8"))


def load_oracle() -> object | None:
    try:
        import jsonschema
    except ModuleNotFoundError:
        return None
    return jsonschema.Draft202012Validator


def assert_jsonschema(validator_cls: object, schema: dict[str, Any], vectors: list[dict[str, Any]]) -> None:
    if validator_cls is None:
        return
    validator = validator_cls(schema)
    for case in vectors:
        if case["schema_pointer"]:
            continue
        value = json.loads(case["raw"]) if "raw" in case else case["instance"]
        valid = validator.is_valid(value)
        if bool(case["expected"]["ok"]) != bool(valid):
            raise SystemExit(
                f"jsonschema mismatch {case['id']}: checker {case['expected']['ok']} jsonschema {valid}"
            )


def assert_self() -> None:
    if integer_value(True) is not None or integer_value(False) is not None:
        raise SystemExit("bool is not an integer")
    if integer_value(1.0) != 1 or integer_value(-0.0) != 0:
        raise SystemExit("integral float mismatch")
    if integer_value(1.5) is not None:
        raise SystemExit("fraction was treated as an integer")
    if integer_value(2**127) is not None or integer_value(-(2**127)) is not None:
        raise SystemExit("i128 boundary was proven")
    if integer_value(2**127 - 1) != 2**127 - 1:
        raise SystemExit("i128 max was not proven")
    if pattern_match(TEXT_PATTERN, "a") is not True or pattern_match(TEXT_PATTERN, " ") is not False:
        raise SystemExit("text pattern mismatch")
    if pattern_match(TEXT_PATTERN, "\ufeff") is not None:
        raise SystemExit("ambiguous space was proven")
    if pattern_match(ID_PATTERN, "A.b_c-1") is not True or pattern_match(ID_PATTERN, "-a") is not False:
        raise SystemExit("id pattern mismatch")
    if pattern_match(".*", "a") is not None:
        raise SystemExit("unknown pattern was proven")


def main() -> None:
    assert_self()
    install_refusal()
    assert_checkout_import_refused()
    schema_bytes = git_show_bytes(SCHEMA_GIT)
    contract_bytes = git_show_bytes(CONTRACT_GIT)
    test_bytes = git_show_bytes(TEST_GIT)
    if b"\r" in schema_bytes or b"\r" in contract_bytes or b"\r" in test_bytes:
        raise SystemExit("pin blob contains CR")
    embedded = embedded_schema()
    if embedded.encode("utf-8") != schema_bytes:
        raise SystemExit("embedded schema bytes differ from the pin")
    schema = json.loads(schema_bytes.decode("utf-8"))
    if not isinstance(schema, dict):
        raise SystemExit("pinned schema is not an object")
    contract_source = contract_bytes.decode("utf-8")
    test_source = test_bytes.decode("utf-8")
    constants = constants_from(contract_source)
    functions = iter_tests(ast.parse(test_source))
    rows = coverage_rows(functions)
    assert_schema_shape(schema, constants)
    vectors = build_vectors(schema)
    document = {
        "facts": facts_from(schema, constants),
        "python_commit": PYTHON_COMMIT,
        "schema": "sesslint.parity-schema-vectors/v1",
        "vectors": vectors,
    }
    vectors_text = dumps(document)
    loaded = json.loads(vectors_text)
    for case in loaded["vectors"]:
        node = resolve_pointer(schema, case["schema_pointer"])
        value = json.loads(case["raw"]) if "raw" in case else case["instance"]
        again = expect(node, value, schema)
        if again != case["expected"]:
            raise SystemExit(f"round trip changed {case['id']}: {again} != {case['expected']}")
    assert_jsonschema(load_oracle(), schema, vectors)
    vectors_sha = hashlib.sha256(vectors_text.encode("utf-8")).hexdigest()
    schema_sha = hashlib.sha256(schema_bytes).hexdigest()
    manifest = {
        "contract_py_sha256": hashlib.sha256(contract_bytes).hexdigest(),
