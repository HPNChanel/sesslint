    coverage = {
        "covered_count": 0,
        "module": "sesslint.outcome.contract",
        "not_applicable_count": len(rows),
        "python_commit": PYTHON_COMMIT,
        "rows": rows,
        "schema_file": "schemas/sesslint.outcome-contract.v1.json",
        "test_file": TEST_FILE,
    }
    provenance = {
        "contains_real_data": False,
        "description": (
