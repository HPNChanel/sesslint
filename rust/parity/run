def assigned_corpora() -> set[str]:
    assigned: set[str] = set()
    for paths in CRATE_CORPORA.values():
        for path in paths:
            if path in assigned:
                raise RuntimeError("corpus_assigned_twice")
            assigned.add(path)
    return assigned


def unmapped_corpora() -> list[str]:
    """Corpus directories that contain vectors.json and have no crate."""
    assigned = assigned_corpora()
    missing: list[str] = []
    for root in ("vectors", "schemas"):
        base = HERE / root
        if not base.is_dir():
            continue
        for child in sorted(base.iterdir()):
            if not child.is_dir() or not (child / "vectors.json").is_file():
                continue
            rel = f"{root}/{child.name}"
            if rel not in assigned:
                missing.append(rel)
    return missing


def _load_object(path: Path) -> dict[str, object] | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict):
        return None
    return data


def _gap_line(corpus: str, gap: object) -> str | None:
    if not isinstance(gap, str):
        return None
    text = " ".join(gap.split())
    if not text:
        return None
    return f"{corpus}:{text}"


def _census_coverage(corpus: Path, stats: dict[str, int]) -> None:
    """Count coverage rows. A not_applicable row is reported and is not a skip."""
    path = corpus / "coverage.json"
    if not path.is_file():
        return
    data = _load_object(path)
    rows = data.get("rows") if data is not None else None
    if not isinstance(rows, list):
        stats["skip"] += 1
        return
    for row in rows:
        if not isinstance(row, dict) or row.get("status") != "covered":
            stats["na"] += 1
            continue
        stats["covered"] += 1


def _vector_rows(data: dict[str, object]) -> list[dict[str, object]]:
    rows: list[dict[str, object]] = []
    for key in ("vectors", "cases", "emissions", "validation"):
        raw = data.get(key)
        if not isinstance(raw, list):
            continue
        rows.extend(row for row in raw if isinstance(row, dict))
    return rows


def _row_id_ok(row: dict[str, object]) -> bool:
    ident = row.get("id")
    if isinstance(ident, str):
        return ident != ""
    return isinstance(ident, int) and not isinstance(ident, bool)


def _oracle(row: dict[str, object]) -> object | None:
    if "expected" in row:
        return row["expected"]
    if "expected_json" in row:
        return row["expected_json"]
    if "input" in row and isinstance(row.get("valid"), bool):
        return row["valid"]
    if "hash" in row and ("json" in row or "input" in row):
        return row["hash"]
    return None


def _record_gaps(
    corpus: Path, data: dict[str, object], stats: dict[str, int], gaps: list[str]
) -> None:
    sources: list[object] = []
    raw = data.get("known_parity_gaps")
    if isinstance(raw, list):
        sources.extend(raw)
    provenance = _load_object(corpus / "PROVENANCE.json")
    if provenance is not None:
        extra = provenance.get("known_parity_gaps")
        if isinstance(extra, list):
            sources.extend(extra)
    seen: set[str] = set()
    for gap in sources:
        line = _gap_line(corpus.name, gap)
        if line is None or line in seen:
            if line is None:
                stats["skip"] += 1
            continue
        seen.add(line)
        gaps.append(line)
        stats["gaps"] += 1
        stats["skip"] += 1


def _census_vectors(corpus: Path, pin: str, stats: dict[str, int], gaps: list[str]) -> None:
    path = corpus / "vectors.json"
    data = _load_object(path)
    if data is None:
        stats["skip"] += 1
        return
    vectors = _vector_rows(data)
    stats["vectors"] += len(vectors)
    gaps_before = stats["gaps"]
    _record_gaps(corpus, data, stats, gaps)
    named = stats["gaps"] - gaps_before
    if data.get("python_commit") != pin:
        stats["pin_skip"] += max(len(vectors), 1)
        stats["skip"] += max(len(vectors), 1)
        return
    if not vectors and named == 0:
        stats["skip"] += 1
        return
    for row in vectors:
        oracle = _oracle(row)
        if not _row_id_ok(row) or oracle is None:
            stats["skip"] += 1
            continue
        if "rust" not in row:
            stats["unexecuted"] += 1
            stats["skip"] += 1
            continue
        if row["rust"] != oracle:
            stats["diff"] += 1
            continue
        stats["match"] += 1


def _loads_corpus(text: str, rel: str) -> bool:
    needle = f"parity/{rel}"
    start = 0
    while True:
        at = text.find(needle, start)
        if at < 0:
            return False
        after = text[at + len(needle) : at + len(needle) + 1]
        if after not in set("._abcdefghijklmnopqrstuvwxyz"):
            return True
        start = at + len(needle)


def corpus_referenced(name: str, rel: str) -> bool:
    """True when this crate's Rust sources load this corpus path."""
    root = HERE.parent / "crates" / name
    if not root.is_dir():
        return False
    for path in root.rglob("*.rs"):
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        if _loads_corpus(text, rel):
            return True
    return False


def referencing_tests(rel: str) -> list[tuple[str, str]]:
    """Integration tests outside the gate crate that load this corpus."""
    crates = HERE.parent / "crates"
    if not crates.is_dir():
        return []
    found: list[tuple[str, str]] = []
    for crate_dir in sorted(crates.iterdir()):
        tests = crate_dir / "tests"
        if not tests.is_dir():
            continue
        for path in sorted(tests.glob("*.rs")):
            try:
                text = path.read_text(encoding="utf-8")
            except OSError:
                continue
            if _loads_corpus(text, rel):
                found.append((crate_dir.name, path.stem))
    return found


def _cargo(args: list[str]) -> bool:
    proc = subprocess.run(
        args,
        cwd=HERE.parent,
        capture_output=True,
        timeout=1800,
        check=False,
    )
    if proc.returncode != 0:
        sys.stderr.write("reason=cargo_test_failed\n")
        return False
    return True


def _promote(stats: dict[str, int], count: int) -> None:
    stats["match"] += count
    stats["skip"] -= count
    stats["unexecuted"] -= count


def prove_referenced(name: str, stats: dict[str, int], promotable: int) -> None:
    """A passing crate test has already compared the referenced rows."""
    if promotable <= 0 or os.environ.get("PARITY_EXECUTE") == "0":
        return
    if not (HERE.parent / "crates" / name).is_dir():
        return
    if _cargo(["cargo", "test", "-p", name, "--offline", "--", "--test-threads=8"]):
        _promote(stats, promotable)


def emit_census(fields: dict[str, str]) -> None:
    for key in CENSUS_KEYS:
        sys.stdout.write(f"{key}={fields[key]}\n")
    sys.stdout.flush()


def census_crate(name: str, pin: str) -> int:
    """Count one crate. Exit 0 only when every selected vector was executed and equal."""
    if name not in CRATE_CORPORA:
        sys.stderr.write("reason=unknown_crate\n")
        return 2
    try:
        unmapped = unmapped_corpora()
    except RuntimeError:
        sys.stderr.write("reason=corpus_assigned_twice\n")
        return 2
    if unmapped:
        sys.stderr.write("reason=corpus_unmapped\n")
        for rel in unmapped:
            sys.stderr.write(f"unmapped={rel}\n")
        return 2
    corpora = CRATE_CORPORA[name]
    if not corpora:
        sys.stderr.write("reason=corpus_absent\n")
        return 2
    roots = [HERE / rel for rel in corpora]
    for root in roots:
        if not (root / "vectors.json").is_file():
            sys.stderr.write("reason=corpus_missing\n")
            sys.stderr.write(f"missing={root.name}\n")
            return 2
    stats = {key: 0 for key in CENSUS_KEYS if key not in {"crate", "pin"}}
    gap_lines: list[str] = []
    promotable = 0
    external: dict[tuple[str, str], int] = {}
    for rel, root in zip(corpora, roots, strict=True):
        before = stats["unexecuted"]
        _census_vectors(root, pin, stats, gap_lines)
        added = stats["unexecuted"] - before
        if added and corpus_referenced(name, rel):
            promotable += added
        elif added:
            owners = referencing_tests(rel)
            if len(owners) == 1:
                external[owners[0]] = external.get(owners[0], 0) + added
        _census_coverage(root, stats)
    prove_referenced(name, stats, promotable)
    if os.environ.get("PARITY_EXECUTE") != "0":
        for (crate, test), count in external.items():
            command = ["cargo", "test", "-p", crate, "--offline", "--test", test]
            if _cargo(command):
                _promote(stats, count)
    fields = {
        "crate": name,
        "pin": pin,
        "corpora": str(len(roots)),
        "vectors": str(stats["vectors"]),
        "covered": str(stats["covered"]),
        "na": str(stats["na"]),
        "gaps": str(stats["gaps"]),
        "pin_skip": str(stats["pin_skip"]),
        "unexecuted": str(stats["unexecuted"]),
        "diff": str(stats["diff"]),
        "skip": str(stats["skip"]),
        "match": str(stats["match"]),
    }
    emit_census(fields)
    for line in gap_lines:
        sys.stdout.write(f"gap={line}\n")
    sys.stdout.flush()
    if stats["diff"] or stats["skip"] or stats["match"] == 0:
        return 1
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="run", add_help=False)
    parser.add_argument("--strict", action="store_true")
    parser.add_argument("--crate", default=None)
    parser.add_argument("--rust-bin", default=None)
    parser.add_argument("--fixture", default=None)
    parser.add_argument("rest", nargs=argparse.REMAINDER)
    return parser.parse_args(argv)


def scratch_path_ok(repo: Path) -> bool:
    try:
        rel = WORK.resolve().relative_to(repo.resolve()).as_posix()
    except ValueError:
        return False
    return rel == SCRATCH_IGNORE.rstrip("/")


def main(argv: list[str]) -> int:
    if sys.version_info < (3, 11):  # noqa: UP036 - standalone script's runtime guard
        return refuse("python_too_old")
    try:
        args = parse_args(argv)
    except SystemExit as exc:
        code = exc.code
        return code if isinstance(code, int) else 2
    pin = load_pin()
    if pin is None:
        return refuse("pin_mismatch", pin="refused")
    if args.crate is not None:
        if args.fixture is not None or list(args.rest):
            return refuse("crate_and_fixture", pin=pin)
        return census_crate(args.crate, pin)
    try:
        divergences = load_registry(HERE / "KNOWN_DIVERGENCES.md")
    except RegistryError as exc:
        return refuse(str(exc), pin=pin)
    repo = repo_root()
    if repo is None or not scratch_path_ok(repo):
        return refuse("repo_mismatch", pin=pin)
    args = parse_args(argv)
    work_reason = ensure_worktree(repo, pin)
    if work_reason is not None:
        return refuse(work_reason, pin=pin)
    venv_reason = ensure_venv(WORK)
    if venv_reason is not None:
        return refuse(venv_reason, pin=pin)
    if git_head(WORK) != pin:
        return refuse("worktree_pin_mismatch", pin=pin)
    resolved = resolve_invocation(WORK, args.fixture, list(args.rest))
    if resolved is None:
        return refuse("fixture_refused", pin=pin)
    fixture, command = resolved
    try:
        fixture_before = hash_fixture(WORK / fixture) if divergences else None
    except OSError:
        return refuse("fixture_unreadable", pin=pin, fixture=fixture)
    exe = sesslint_bin(WORK / ".venv")
    if exe is None:
        return refuse("sesslint_missing", pin=pin, fixture=fixture)
    captured = capture([str(exe), *command], WORK)
    if captured is None:
        return refuse("python_run_failed", pin=pin, fixture=fixture)
    python_code, python_out, python_err = captured
    rust_exit = "absent"
    rust_out_hash = ""
    rust_err_hash = ""
    rust_code: int | None = None
    rust_out = b""
    rust_err = b""
    if args.rust_bin is not None:
        rust_path = resolve_rust_bin(args.rust_bin)
        if not rust_path.is_file():
            sys.stderr.write("reason=rust_bin_missing\n")
            emit(
                {
                    "pin": pin,
                    "fixture": fixture,
                    "python_exit": str(python_code),
                    "rust_exit": "absent",
                    "compare": "abstain",
                    "python_stdout_sha256": sha256(python_out),
                    "python_stderr_sha256": sha256(python_err),
                }
            )
            return 2
        rust_captured = capture([str(rust_path), *command], WORK)
        if rust_captured is None:
            return refuse("rust_run_failed", pin=pin, fixture=fixture)
        rust_code, rust_out, rust_err = rust_captured
        rust_exit = str(rust_code)
        rust_out_hash = sha256(rust_out)
        rust_err_hash = sha256(rust_err)
    cmp_mod = compare_module()
    compare_label = "abstain"
    diff = None
    divergence_id = None
    if rust_code is not None:
        left = cmp_mod.Capture(python_out, python_err, python_code)
        right = cmp_mod.Capture(rust_out, rust_err, rust_code)
        diff = cmp_mod.compare(left, right)
        compare_label = "match" if diff.equal else "mismatch"
        if divergences:
            try:
                fixture_after = hash_fixture(WORK / fixture)
            except OSError:
                return refuse("fixture_unreadable", pin=pin, fixture=fixture)
            if fixture_before != fixture_after:
                return refuse("fixture_changed", pin=pin, fixture=fixture)
            if not diff.equal:
                observed = fingerprint(
                    pin,
                    fixture,
                    fixture_after,
                    command,
                    captured,
                    (rust_code, rust_out, rust_err),
                )
                divergence_id = classify(divergences, observed)
                if divergence_id is not None:
                    compare_label = "approved_divergence"
    fields = {
        "pin": pin,
        "fixture": fixture,
        "python_exit": str(python_code),
        "rust_exit": rust_exit,
        "compare": compare_label,
        "python_stdout_sha256": sha256(python_out),
        "python_stderr_sha256": sha256(python_err),
    }
    emit(fields)
    if divergence_id is not None:
        sys.stdout.write(f"divergence_id={divergence_id}\n")
    if rust_out_hash:
        sys.stdout.write(f"rust_stdout_sha256={rust_out_hash}\n")
        sys.stdout.write(f"rust_stderr_sha256={rust_err_hash}\n")
        sys.stdout.flush()
    if diff is not None and not diff.equal:
        sys.stderr.write(cmp_mod.format_diff(diff))
    exit_code = 0
    if args.strict:
        if rust_code is None:
            exit_code = 1
        elif diff is not None and not diff.equal:
            exit_code = cmp_mod.status_code(diff)
    return exit_code


if __name__ == "__main__":
    sys.stdout.reconfigure(encoding="utf-8", newline="\n")
    sys.stderr.reconfigure(encoding="utf-8", newline="\n")
    raise SystemExit(main(sys.argv[1:]))
